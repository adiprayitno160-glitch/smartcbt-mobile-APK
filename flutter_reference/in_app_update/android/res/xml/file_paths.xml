<?xml version="1.0" encoding="utf-8"?>
<!--
    Konfigurasi FileProvider Paths untuk In-App Update APK
    Mencakup semua lokasi direktori penyimpanan yang aman dan valid di Android:
    1. external-cache-path: getExternalCacheDir() -> direktori unduh utama APK
    2. external-path: Environment.getExternalStorageDirectory()
    3. cache-path: getCacheDir()
    4. files-path: getFilesDir()
    5. external-files-path: getExternalFilesDir(null)
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Direktori Cache Eksternal Khusus Aplikasi (/storage/emulated/0/Android/data/<package>/cache) -->
    <external-cache-path
        name="external_cache"
        path="." />

    <!-- Direktori Cache Internal Aplikasi (/data/user/0/<package>/cache) -->
    <cache-path
        name="internal_cache"
        path="." />

    <!-- Direktori Files Internal Aplikasi (/data/user/0/<package>/files) -->
    <files-path
        name="internal_files"
        path="." />

    <!-- Direktori Files Eksternal Khusus Aplikasi (/storage/emulated/0/Android/data/<package>/files) -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- Root Storage Eksternal (Fallback untuk Android 8-9) -->
    <external-path
        name="external_storage_root"
        path="." />
</paths>
