<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Tugas & PR Siswa - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex">
    <!-- Sidebar -->
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <div class="flex justify-between items-center mb-6">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>📚</span> Manajemen Tugas &amp; PR Siswa
                    </h1>
                    <p class="text-slate-500 text-xs">Pemberian Tugas Kelas, Monitoring Pengumpulan Siswa APK &amp; Penilaian Langsung</p>
                </div>
            </div>
            <button onclick="openAddHomeworkModal()" class="bg-unbk-blue hover:bg-blue-800 text-white px-5 py-2.5 rounded-xl shadow-md font-bold flex items-center gap-2 text-xs transition-all">
                <span>+</span> Berikan Tugas Baru
            </button>
        </div>

        <!-- Summary Stats -->
        <div class="grid grid-cols-3 gap-5 mb-6">
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-blue-100 flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Total Tugas Aktif</p>
                    <p class="text-2xl font-extrabold text-blue-900" id="statTotalHw">0</p>
                </div>
                <span class="text-3xl">📑</span>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-green-100 flex items-center justify-between">
                <div>
                    <p class="text-xs text-green-700 font-semibold uppercase">Tugas Terkumpul</p>
                    <p class="text-2xl font-extrabold text-green-700" id="statTotalSubmissions">0</p>
                </div>
                <span class="text-3xl">📥</span>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-amber-100 flex items-center justify-between">
                <div>
                    <p class="text-xs text-amber-700 font-semibold uppercase">Terkunci / Lewat Deadline</p>
                    <p class="text-2xl font-extrabold text-amber-700" id="statClosedHw">0</p>
                </div>
                <span class="text-3xl">⏰</span>
            </div>
        </div>

        <!-- Table Container -->
        <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
            <div class="p-4 border-b bg-gray-50 flex justify-between items-center">
                <h3 class="font-bold text-gray-800 text-sm">Daftar Penugasan & Status Pengumpulan Siswa</h3>
                <span class="text-xs text-gray-500">Klik <b>📥 Periksa Submisi & Nilai</b> untuk melihat berkas siswa dan memberi nilai</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse whitespace-nowrap text-xs">
                    <thead>
                        <tr class="bg-gray-100 text-gray-700 uppercase tracking-wider border-b">
                            <th class="p-4">Judul Tugas</th>
                            <th class="p-4">Mata Pelajaran</th>
                            <th class="p-4">Kelas</th>
                            <th class="p-4">Batas Deadline</th>
                            <th class="p-4">Status Pengumpulan</th>
                            <th class="p-4">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="homeworkTableBody">
                        <tr><td colspan="6" class="p-4 text-center text-gray-500">Memuat daftar tugas...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Modal Review Submisi & Penilaian Siswa -->
    <div id="modalSubmissions" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto shadow-2xl p-6">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <div>
                    <h2 class="text-base font-bold text-gray-900" id="subModalTitle">Pengumpulan Tugas: -</h2>
                    <p class="text-xs text-gray-500" id="subModalSub">Daftar seluruh siswa di kelas dan status penyerahan tugas</p>
                </div>
                <button onclick="document.getElementById('modalSubmissions').classList.add('hidden')" class="text-gray-400 text-2xl font-bold">&times;</button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-gray-50 text-gray-600 border-b">
                            <th class="p-3">Nama Siswa</th>
                            <th class="p-3">NISN</th>
                            <th class="p-3">Waktu Kumpul</th>
                            <th class="p-3">Lampiran Jawaban</th>
                            <th class="p-3">Nilai (0-100)</th>
                            <th class="p-3">Catatan Guru</th>
                            <th class="p-3">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="subTableBody">
                        <!-- Dynamic Submissions -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Buat Tugas Baru -->
    <div id="modalAddHomework" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-3xl w-full max-w-3xl max-h-[92vh] overflow-y-auto shadow-2xl border">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">📝</span>
                    <div>
                        <h2 class="text-lg font-black text-gray-800">Berikan Tugas &amp; PR Baru</h2>
                        <p class="text-xs text-gray-500">Mendukung Tugas Objektif CBT (Auto-grading), Upload Berkas, atau Campuran</p>
                    </div>
                </div>
                <button onclick="document.getElementById('modalAddHomework').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
            </div>

            <form id="addHomeworkForm" class="space-y-4 text-xs">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="md:col-span-2">
                        <label class="block font-bold text-gray-700 mb-1">Judul Tugas *</label>
                        <input type="text" id="hwTitle" placeholder="Cth: Latihan Harian Bab 3 - Persamaan Linear" class="w-full border p-2.5 rounded-xl text-xs font-semibold focus:outline-none focus:border-blue-600" required>
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Mata Pelajaran *</label>
                        <input type="text" id="hwSubject" placeholder="Cth: Matematika" class="w-full border p-2.5 rounded-xl text-xs font-semibold focus:outline-none focus:border-blue-600" required>
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Target Kelas *</label>
                        <select id="hwClass" class="w-full border p-2.5 rounded-xl text-xs font-bold bg-gray-50 focus:outline-none focus:border-blue-600" required>
                            <!-- Injected by JS -->
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Tipe Penugasan *</label>
                        <select id="hwType" onchange="handleHwTypeChange()" class="w-full border-2 border-blue-200 bg-blue-50/60 p-2.5 rounded-xl text-xs font-bold text-blue-900 focus:outline-none focus:border-blue-600">
                            <option value="MULTIPLE_CHOICE">🎯 CBT Objektif (Dinilai Otomatis)</option>
                            <option value="ESSAY">📷 Upload Berkas / Foto Fisik (Dinilai Manual)</option>
                            <option value="MIXED">⚡ Campuran (Soal CBT + Upload Berkas Tambahan)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Batas Waktu (Deadline) *</label>
                        <input type="datetime-local" id="hwDeadline" class="w-full border p-2.5 rounded-xl text-xs font-mono font-bold focus:outline-none focus:border-blue-600" required>
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-gray-700 mb-1">Petunjuk / Deskripsi Tugas</label>
                    <textarea id="hwDesc" placeholder="Berikan petunjuk pengerjaan kepada siswa..." class="w-full border p-2.5 rounded-xl text-xs" rows="2"></textarea>
                </div>

                <!-- Bagian Pengaturan Soal CBT (Muncul jika tipe MULTIPLE_CHOICE atau MIXED) -->
                <div id="cbtQuestionsSection" class="border border-indigo-200 rounded-2xl p-4 bg-indigo-50/40 space-y-3">
                    <div class="flex justify-between items-center">
                        <div>
                            <h4 class="font-black text-indigo-900 text-xs flex items-center gap-1.5">
                                <span>🧠</span> Bank &amp; Butir Soal CBT (<span id="cbtQuestionCountBadge">0 Soal Siap</span>)
                            </h4>
                            <p class="text-[11px] text-indigo-700">Pilih salah satu dari 3 sumber soal di bawah ini:</p>
                        </div>
                    </div>

                    <!-- 3 Tabs Sumber Soal -->
                    <div class="flex border-b border-indigo-200 gap-2">
                        <button type="button" onclick="switchSoalTab('manual')" id="tabBtnManual" class="px-3 py-1.5 font-bold text-xs border-b-2 border-indigo-600 text-indigo-900 bg-white rounded-t-lg">
                            ✍️ 1. Input Manual
                        </button>
                        <button type="button" onclick="switchSoalTab('bank')" id="tabBtnBank" class="px-3 py-1.5 font-bold text-xs text-indigo-600 hover:text-indigo-900">
                            🏦 2. Ambil dari Bank Soal
                        </button>
                        <button type="button" onclick="switchSoalTab('pdf')" id="tabBtnPdf" class="px-3 py-1.5 font-bold text-xs text-indigo-600 hover:text-indigo-900">
                            📄 3. Import dari PDF
                        </button>
                    </div>

                    <!-- Tab 1: Input Manual -->
                    <div id="tabContentManual" class="space-y-3 pt-2">
                        <div class="bg-white p-3.5 rounded-xl border border-indigo-100 space-y-2">
                            <label class="block font-bold text-gray-700">Teks Pertanyaan / Soal:</label>
                            <textarea id="manualQText" rows="2" class="w-full border p-2 rounded-lg text-xs" placeholder="Tuliskan butir soal di sini..."></textarea>
                            
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div><input type="text" id="manualOptA" placeholder="Pilihan A..." class="w-full border p-1.5 rounded text-xs"></div>
                                <div><input type="text" id="manualOptB" placeholder="Pilihan B..." class="w-full border p-1.5 rounded text-xs"></div>
                                <div><input type="text" id="manualOptC" placeholder="Pilihan C..." class="w-full border p-1.5 rounded text-xs"></div>
                                <div><input type="text" id="manualOptD" placeholder="Pilihan D..." class="w-full border p-1.5 rounded text-xs"></div>
                                <div class="col-span-2"><input type="text" id="manualOptE" placeholder="Pilihan E (Opsional)..." class="w-full border p-1.5 rounded text-xs"></div>
                            </div>

                            <div class="flex items-center justify-between pt-2 border-t">
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-gray-700">Kunci Jawaban:</span>
                                    <select id="manualCorrectOpt" class="border rounded px-2 py-1 font-bold text-xs">
                                        <option value="A">A</option>
                                        <option value="B">B</option>
                                        <option value="C">C</option>
                                        <option value="D">D</option>
                                        <option value="E">E</option>
                                    </select>
                                </div>
                                <button type="button" onclick="addManualQuestion()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-3 py-1.5 rounded-lg text-xs shadow">
                                    + Tambahkan ke Daftar Soal
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Ambil dari Bank Soal -->
                    <div id="tabContentBank" class="hidden space-y-3 pt-2">
                        <div class="flex items-center gap-2">
                            <input type="text" id="bankSearchInput" oninput="filterBankQuestions()" placeholder="Cari soal di Bank Soal..." class="flex-1 border p-2 rounded-lg text-xs">
                            <button type="button" onclick="loadBankQuestions()" class="bg-slate-700 hover:bg-slate-800 text-white font-bold px-3 py-2 rounded-lg text-xs">🔄 Muat Bank Soal</button>
                        </div>
                        <div id="bankQuestionsList" class="max-h-48 overflow-y-auto space-y-2 bg-white p-3 rounded-xl border border-indigo-100">
                            <p class="text-gray-400 text-center py-4">Klik 'Muat Bank Soal' untuk melihat koleksi soal tersimpan</p>
                        </div>
                    </div>

                    <!-- Tab 3: Import dari File PDF -->
                    <div id="tabContentPdf" class="hidden space-y-3 pt-2">
                        <div class="bg-white p-3.5 rounded-xl border border-indigo-100 space-y-2.5">
                            <div class="flex flex-col sm:flex-row items-center gap-2.5">
                                <input type="file" id="pdfFileInput" accept="application/pdf" class="w-full text-xs file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                                <button type="button" id="btnParsePdf" onclick="handleParsePdf()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-xl text-xs flex-shrink-0 shadow flex items-center gap-1.5">
                                    <span>⚙️</span> <span>Ekstrak Soal PDF</span>
                                </button>
                            </div>
                            <p class="text-[11px] text-gray-500">Sistem otomatis mengekstrak nomor soal, opsi jawaban (A/B/C/D/E), dan mendeteksi kunci jawaban dari dokumen PDF Anda.</p>
                        </div>

                        <!-- Preview Hasil Parsing PDF Side-by-Side / Edit Tabel -->
                        <div id="pdfParsePreviewContainer" class="hidden space-y-2">
                            <div class="flex justify-between items-center">
                                <span class="font-bold text-emerald-800 text-xs flex items-center gap-1">
                                    <span>✅</span> Hasil Deteksi (<span id="parsedPdfCount">0</span> Soal). Guru dapat mengoreksi kunci langsung di bawah:
                                </span>
                                <label class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-700">
                                    <input type="checkbox" id="savePdfToBankCheckbox" checked class="rounded"> Simpan juga ke Bank Soal
                                </label>
                            </div>
                            <div class="max-h-56 overflow-y-auto border rounded-xl bg-white">
                                <table class="w-full text-left text-xs border-collapse">
                                    <thead class="bg-slate-100 sticky top-0 border-b">
                                        <tr>
                                            <th class="p-2 w-10 text-center">No</th>
                                            <th class="p-2">Teks Soal</th>
                                            <th class="p-2 w-28">Kunci Jawaban</th>
                                        </tr>
                                    </thead>
                                    <tbody id="pdfParsedTableBody" class="divide-y"></tbody>
                                </table>
                            </div>
                            <div class="flex justify-end">
                                <button type="button" onclick="applyPdfQuestionsToHomework()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-4 py-2 rounded-xl text-xs shadow">
                                    📥 Masukkan Semua Soal Hasil PDF ke Tugas
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Ringkasan Soal yang Aktif Dipilih untuk Tugas Ini -->
                    <div class="bg-white p-3 rounded-xl border border-indigo-100 space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-gray-800 text-xs">📋 Daftar Soal yang Akan Dikerjakan Siswa:</span>
                            <button type="button" onclick="clearSelectedQuestions()" class="text-rose-600 hover:underline font-bold text-[11px]">Kosongkan Soal</button>
                        </div>
                        <div id="activeQuestionsSummary" class="max-h-36 overflow-y-auto text-[11px] divide-y">
                            <p class="text-gray-400 py-2">Belum ada soal dimasukkan. Gunakan Tab di atas untuk menambah soal.</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 bg-gray-50 p-3 rounded-xl border">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">📄 Lampiran PDF/Dokumen Tambahan (Opsional)</label>
                        <input type="url" id="hwFileUrl" placeholder="https://.../lampiran.pdf" class="w-full border p-2 rounded-lg text-xs">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">🔊 URL Audio / Listening (Opsional)</label>
                        <input type="url" id="hwAudioUrl" placeholder="https://.../audio.mp3" class="w-full border p-2 rounded-lg text-xs">
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-3 border-t">
                    <button type="button" onclick="document.getElementById('modalAddHomework').classList.add('hidden')" class="bg-gray-200 text-gray-700 px-4 py-2.5 rounded-xl font-semibold">Batal</button>
                    <button type="submit" class="bg-unbk-blue hover:bg-blue-800 text-white px-6 py-2.5 rounded-xl font-bold shadow transition-all">🚀 Terbitkan Tugas ke Siswa</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if(!token) window.location.href = '/';

        let allHomeworks = [];
        let activeHwId = null;
        let selectedQuestions = []; // Array of { id, text, options: {A,B,C,D,E}, correctOption, explanation }
        let loadedBankQuestions = [];
        let tempParsedPdfQuestions = [];

        loadClasses();
        loadHomeworks();

        function handleHwTypeChange() {
            const type = document.getElementById('hwType').value;
            const cbtSection = document.getElementById('cbtQuestionsSection');
            if (type === 'ESSAY') {
                cbtSection.classList.add('hidden');
            } else {
                cbtSection.classList.remove('hidden');
            }
        }

        function switchSoalTab(tab) {
            document.getElementById('tabContentManual').classList.add('hidden');
            document.getElementById('tabContentBank').classList.add('hidden');
            document.getElementById('tabContentPdf').classList.add('hidden');

            document.getElementById('tabBtnManual').className = "px-3 py-1.5 font-bold text-xs text-indigo-600 hover:text-indigo-900";
            document.getElementById('tabBtnBank').className = "px-3 py-1.5 font-bold text-xs text-indigo-600 hover:text-indigo-900";
            document.getElementById('tabBtnPdf').className = "px-3 py-1.5 font-bold text-xs text-indigo-600 hover:text-indigo-900";

            if (tab === 'manual') {
                document.getElementById('tabContentManual').classList.remove('hidden');
                document.getElementById('tabBtnManual').className = "px-3 py-1.5 font-bold text-xs border-b-2 border-indigo-600 text-indigo-900 bg-white rounded-t-lg";
            } else if (tab === 'bank') {
                document.getElementById('tabContentBank').classList.remove('hidden');
                document.getElementById('tabBtnBank').className = "px-3 py-1.5 font-bold text-xs border-b-2 border-indigo-600 text-indigo-900 bg-white rounded-t-lg";
                if (loadedBankQuestions.length === 0) loadBankQuestions();
            } else if (tab === 'pdf') {
                document.getElementById('tabContentPdf').classList.remove('hidden');
                document.getElementById('tabBtnPdf').className = "px-3 py-1.5 font-bold text-xs border-b-2 border-indigo-600 text-indigo-900 bg-white rounded-t-lg";
            }
        }

        function addManualQuestion() {
            const text = document.getElementById('manualQText').value.trim();
            const a = document.getElementById('manualOptA').value.trim();
            const b = document.getElementById('manualOptB').value.trim();
            const c = document.getElementById('manualOptC').value.trim();
            const d = document.getElementById('manualOptD').value.trim();
            const e = document.getElementById('manualOptE').value.trim();
            const correct = document.getElementById('manualCorrectOpt').value;

            if (!text || !a || !b) {
                alert('Teks pertanyaan dan minimal pilihan A dan B wajib diisi!');
                return;
            }

            const qObj = {
                id: 'q_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
                text,
                options: { A: a, B: b, C: c || '', D: d || '', E: e || '' },
                correctOption: correct
            };

            selectedQuestions.push(qObj);
            renderSelectedQuestions();

            // Reset manual form
            document.getElementById('manualQText').value = '';
            document.getElementById('manualOptA').value = '';
            document.getElementById('manualOptB').value = '';
            document.getElementById('manualOptC').value = '';
            document.getElementById('manualOptD').value = '';
            document.getElementById('manualOptE').value = '';
        }

        function renderSelectedQuestions() {
            document.getElementById('cbtQuestionCountBadge').innerText = selectedQuestions.length + ' Soal Siap';
            const container = document.getElementById('activeQuestionsSummary');
            if (selectedQuestions.length === 0) {
                container.innerHTML = '<p class="text-gray-400 py-2">Belum ada soal dimasukkan. Gunakan Tab di atas untuk menambah soal.</p>';
                return;
            }

            container.innerHTML = selectedQuestions.map((q, idx) => `
                <div class="py-2 flex justify-between items-start gap-2">
                    <div>
                        <span class="font-bold text-slate-800">${idx + 1}. ${q.text.substring(0, 80)}${q.text.length > 80 ? '...' : ''}</span>
                        <div class="text-[10px] text-emerald-700 font-bold mt-0.5">Kunci: Opsi (${q.correctOption})</div>
                    </div>
                    <button type="button" onclick="removeSelectedQuestion(${idx})" class="text-rose-500 hover:text-rose-700 font-bold text-xs">&times;</button>
                </div>
            `).join('');
        }

        function removeSelectedQuestion(idx) {
            selectedQuestions.splice(idx, 1);
            renderSelectedQuestions();
        }

        function clearSelectedQuestions() {
            selectedQuestions = [];
            renderSelectedQuestions();
        }

        async function loadBankQuestions() {
            try {
                const res = await fetch('/api/soal/bank', { headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                if (data.success && Array.isArray(data.questions)) {
                    loadedBankQuestions = data.questions;
                    filterBankQuestions();
                } else {
                    document.getElementById('bankQuestionsList').innerHTML = '<p class="text-gray-400 text-center py-4">Belum ada bank soal tersimpan.</p>';
                }
            } catch (err) {
                document.getElementById('bankQuestionsList').innerHTML = '<p class="text-rose-500 text-center py-4">Gagal memuat bank soal: ' + err.message + '</p>';
            }
        }

        function filterBankQuestions() {
            const query = (document.getElementById('bankSearchInput')?.value || '').toLowerCase();
            const filtered = loadedBankQuestions.filter(q => (q.content || '').toLowerCase().includes(query) || (q.subjectName || '').toLowerCase().includes(query));
            const container = document.getElementById('bankQuestionsList');

            if (filtered.length === 0) {
                container.innerHTML = '<p class="text-gray-400 text-center py-4">Tidak ada soal yang cocok.</p>';
                return;
            }

            container.innerHTML = filtered.map(q => {
                let opts = {};
                try { opts = typeof q.options === 'string' ? JSON.parse(q.options) : (q.options || {}); } catch(e) {}
                const isSelected = selectedQuestions.some(sq => sq.text === q.content);

                return `
                    <div class="p-2 border rounded-lg flex justify-between items-center text-xs hover:bg-indigo-50/50">
                        <div class="pr-2">
                            <span class="bg-indigo-100 text-indigo-800 text-[10px] font-bold px-1.5 py-0.5 rounded">${q.subjectName || 'Umum'}</span>
                            <p class="font-semibold text-slate-800 mt-1">${q.content.substring(0, 90)}...</p>
                            <span class="text-[10px] text-emerald-700 font-bold">Kunci: ${q.correctOption || 'A'}</span>
                        </div>
                        <button type="button" onclick="toggleBankQuestionToHomework('${q.id}')" class="px-2.5 py-1 rounded text-xs font-bold ${isSelected ? 'bg-rose-100 text-rose-700' : 'bg-indigo-600 text-white'}">
                            ${isSelected ? 'Batal' : '+ Tambah'}
                        </button>
                    </div>
                `;
            }).join('');
        }

        function toggleBankQuestionToHomework(qId) {
            const q = loadedBankQuestions.find(item => item.id === qId);
            if (!q) return;
            const existingIdx = selectedQuestions.findIndex(sq => sq.text === q.content);
            if (existingIdx >= 0) {
                selectedQuestions.splice(existingIdx, 1);
            } else {
                let opts = {};
                try { opts = typeof q.options === 'string' ? JSON.parse(q.options) : (q.options || {}); } catch(e) {}
                selectedQuestions.push({
                    id: q.id,
                    text: q.content,
                    options: opts,
                    correctOption: q.correctOption || 'A',
                    explanation: q.explanation
                });
            }
            filterBankQuestions();
            renderSelectedQuestions();
        }

        async function handleParsePdf() {
            const fileInput = document.getElementById('pdfFileInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Pilih berkas PDF soal terlebih dahulu!');
                return;
            }

            const btn = document.getElementById('btnParsePdf');
            btn.disabled = true;
            btn.innerText = '⏳ Mengekstrak...';

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            try {
                const res = await fetch('/api/pdf-soal/parse', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token },
                    body: formData
                });
                const data = await res.json();
                if (data.success && Array.isArray(data.questions) && data.questions.length > 0) {
                    tempParsedPdfQuestions = data.questions;
                    renderParsedPdfTable(tempParsedPdfQuestions);
                    document.getElementById('pdfParsePreviewContainer').classList.remove('hidden');
                } else {
                    alert(data.message || 'Tidak ada butir soal yang berhasil diekstrak dari PDF.');
                }
            } catch (err) {
                alert('Gagal mengekstrak PDF: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>⚙️</span> <span>Ekstrak Soal PDF</span>';
            }
        }

        function renderParsedPdfTable(qList) {
            document.getElementById('parsedPdfCount').innerText = qList.length;
            const tbody = document.getElementById('pdfParsedTableBody');
            tbody.innerHTML = qList.map((q, idx) => {
                const optA = q.options?.A || '';
                const optB = q.options?.B || '';
                const optC = q.options?.C || '';
                const optD = q.options?.D || '';
                const optE = q.options?.E || '';

                return `
                    <tr class="hover:bg-slate-50 border-b">
                        <td class="p-2 text-center font-bold">${idx + 1}</td>
                        <td class="p-2">
                            <textarea id="pdfQText_${idx}" class="w-full border p-1 rounded text-xs" rows="2">${q.text || ''}</textarea>
                            <div class="grid grid-cols-2 gap-1 text-[11px] mt-1 text-slate-600">
                                <div><b>A:</b> <input type="text" id="pdfQOptA_${idx}" value="${optA}" class="border rounded px-1 w-4/5 text-[11px]"></div>
                                <div><b>B:</b> <input type="text" id="pdfQOptB_${idx}" value="${optB}" class="border rounded px-1 w-4/5 text-[11px]"></div>
                                <div><b>C:</b> <input type="text" id="pdfQOptC_${idx}" value="${optC}" class="border rounded px-1 w-4/5 text-[11px]"></div>
                                <div><b>D:</b> <input type="text" id="pdfQOptD_${idx}" value="${optD}" class="border rounded px-1 w-4/5 text-[11px]"></div>
                            </div>
                        </td>
                        <td class="p-2">
                            <select id="pdfQCorrect_${idx}" class="border rounded font-bold text-xs p-1 bg-emerald-50 text-emerald-800">
                                <option value="A" ${q.correctOption === 'A' ? 'selected' : ''}>A</option>
                                <option value="B" ${q.correctOption === 'B' ? 'selected' : ''}>B</option>
                                <option value="C" ${q.correctOption === 'C' ? 'selected' : ''}>C</option>
                                <option value="D" ${q.correctOption === 'D' ? 'selected' : ''}>D</option>
                                <option value="E" ${q.correctOption === 'E' ? 'selected' : ''}>E</option>
                            </select>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function applyPdfQuestionsToHomework() {
            if (tempParsedPdfQuestions.length === 0) return;

            const finalQuestions = tempParsedPdfQuestions.map((q, idx) => {
                const text = document.getElementById('pdfQText_' + idx)?.value || q.text;
                const a = document.getElementById('pdfQOptA_' + idx)?.value || q.options?.A || '';
                const b = document.getElementById('pdfQOptB_' + idx)?.value || q.options?.B || '';
                const c = document.getElementById('pdfQOptC_' + idx)?.value || q.options?.C || '';
                const d = document.getElementById('pdfQOptD_' + idx)?.value || q.options?.D || '';
                const correct = document.getElementById('pdfQCorrect_' + idx)?.value || q.correctOption || 'A';

                return {
                    id: 'pdf_' + idx + '_' + Date.now(),
                    text,
                    options: { A: a, B: b, C: c, D: d },
                    correctOption: correct
                };
            });

            // Masukkan ke tugas
            selectedQuestions.push(...finalQuestions);
            renderSelectedQuestions();

            // Jika centang simpan ke bank soal diaktifkan
            const shouldSaveToBank = document.getElementById('savePdfToBankCheckbox')?.checked;
            if (shouldSaveToBank) {
                const subject = document.getElementById('hwSubject')?.value || 'Umum';
                try {
                    await fetch('/api/soal/bank', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                        body: JSON.stringify({
                            subjectName: subject,
                            questions: finalQuestions.map(fq => ({
                                content: fq.text,
                                options: fq.options,
                                correctOption: fq.correctOption
                            }))
                        })
                    });
                } catch(e) {}
            }

            alert('Berhasil memasukkan ' + finalQuestions.length + ' butir soal ke tugas!');
            document.getElementById('pdfParsePreviewContainer').classList.add('hidden');
            switchSoalTab('manual');
        }

        document.getElementById('addHomeworkForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const typeVal = document.getElementById('hwType').value;

            if ((typeVal === 'MULTIPLE_CHOICE' || typeVal === 'MIXED') && selectedQuestions.length === 0) {
                if (!confirm('Anda memilih tipe tugas CBT tetapi belum menambahkan butir soal. Lanjutkan membuat tugas tanpa soal CBT?')) {
                    return;
                }
            }

            const payload = {
                title: document.getElementById('hwTitle').value,
                subjectName: document.getElementById('hwSubject').value,
                className: document.getElementById('hwClass').value,
                deadline: document.getElementById('hwDeadline').value,
                description: document.getElementById('hwDesc').value,
                type: typeVal,
                questions: selectedQuestions.length > 0 ? selectedQuestions : null,
                fileUrl: document.getElementById('hwFileUrl').value || null,
                audioUrl: document.getElementById('hwAudioUrl').value || null,
                allowUpload: typeVal !== 'MULTIPLE_CHOICE'
            };

            try {
                const res = await fetch('/api/homeworks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });

                if(res.ok) {
                    alert('Tugas berhasil diterbitkan untuk siswa!');
                    document.getElementById('modalAddHomework').classList.add('hidden');
                    document.getElementById('addHomeworkForm').reset();
                    selectedQuestions = [];
                    renderSelectedQuestions();
                    loadHomeworks();
                } else {
                    const errData = await res.json();
                    alert('Gagal membuat tugas: ' + (errData.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Gagal menghubungi server: ' + err.message);
            }
        });

        async function loadClasses() {
            try {
                const res = await fetch('/api/kelas', { headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                if(Array.isArray(data)) {
                    const sel = document.getElementById('hwClass');
                    sel.innerHTML = '';
                    data.forEach(k => {
                        sel.innerHTML += `<option value="${k.nama}">Kelas ${k.nama}</option>`;
                    });
                }
            } catch(e) {}
        }

        async function loadHomeworks() {
            try {
                const res = await fetch('/api/homeworks', { headers: { 'Authorization': 'Bearer ' + token } });
                allHomeworks = await res.json();
                const tbody = document.getElementById('homeworkTableBody');
                tbody.innerHTML = '';

                let totalSub = 0;
                let closedCount = 0;
                const now = new Date();

                if(Array.isArray(allHomeworks) && allHomeworks.length > 0) {
                    document.getElementById('statTotalHw').innerText = allHomeworks.length;

                    allHomeworks.forEach(hw => {
                        const d = new Date(hw.deadline);
                        const isExpired = d < now;
                        if(isExpired) closedCount++;
                        const subCount = hw._count ? hw._count.submissions : 0;
                        totalSub += subCount;

                        const deadlineStr = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                        const statusBadge = isExpired
                            ? '<span class="bg-gray-100 text-gray-600 px-2.5 py-0.5 rounded font-bold">🔒 Ditutup</span>'
                            : '<span class="bg-green-100 text-green-800 px-2.5 py-0.5 rounded font-bold">🟢 Aktif</span>';

                        tbody.innerHTML += `
                            <tr class="hover:bg-blue-50 border-b">
                                <td class="p-4">
                                    <p class="font-bold text-gray-900 text-sm">${hw.title}</p>
                                    <p class="text-[11px] text-gray-500">${hw.description ? hw.description.substring(0, 50) + '...' : 'Tidak ada deskripsi'}</p>
                                </td>
                                <td class="p-4"><span class="bg-blue-50 text-blue-800 px-2 py-0.5 rounded font-bold border border-blue-200">${hw.subject ? hw.subject.name : '-'}</span></td>
                                <td class="p-4"><span class="bg-purple-50 text-purple-800 px-2.5 py-0.5 rounded font-bold">${hw.class ? hw.class.name : '-'}</span></td>
                                <td class="p-4 font-mono text-gray-600 font-semibold">${deadlineStr}</td>
                                <td class="p-4">
                                    <div class="flex items-center gap-2">
                                        ${statusBadge}
                                        <span class="font-bold text-blue-700">${subCount} Siswa Mengumpul</span>
                                    </div>
                                </td>
                                <td class="p-4 space-x-1.5 whitespace-nowrap">
                                    <button onclick="viewSubmissions('${hw.id}', '${hw.title}', '${hw.class ? hw.class.name : ''}')" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-3 py-1.5 rounded-lg text-xs shadow">📥 Periksa Submisi & Nilai</button>
                                    <button onclick="deleteHomework('${hw.id}')" class="bg-red-50 hover:bg-red-100 text-red-600 font-bold px-2.5 py-1.5 rounded-lg text-xs border border-red-200">Hapus</button>
                                </td>
                            </tr>
                        `;
                    });

                    document.getElementById('statTotalSubmissions').innerText = totalSub;
                    document.getElementById('statClosedHw').innerText = closedCount;
                } else {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-gray-500">Belum ada tugas yang diberikan</td></tr>';
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function viewSubmissions(hwId, title, className) {
            activeHwId = hwId;
            document.getElementById('subModalTitle').innerText = 'Pengumpulan Tugas: ' + title;
            document.getElementById('subModalSub').innerText = 'Daftar seluruh siswa di Kelas ' + className + ' dan berkas penyerahan tugas';
            document.getElementById('modalSubmissions').classList.remove('hidden');

            try {
                const res = await fetch('/api/homeworks/' + hwId + '/submissions', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                const tbody = document.getElementById('subTableBody');
                tbody.innerHTML = '';

                if(data.records && data.records.length > 0) {
                    data.records.forEach((s, idx) => {
                        const timeStr = s.submittedAt ? new Date(s.submittedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '-';
                        const fileBtn = s.isSubmitted
                            ? (s.fileUrl && s.fileUrl !== 'Pilihan Ganda CBT' ? `<a href="${s.fileUrl}" target="_blank" class="text-blue-600 underline font-semibold">Lihat Berkas</a>` : '<span class="text-indigo-600 font-semibold">Jawaban CBT</span>')
                            : '<span class="text-red-500 font-bold">Belum Kumpul</span>';

                        const scoreVal = s.score !== null ? s.score : (s.autoScore !== null ? s.autoScore : '');
                        const autoBadge = s.autoScore !== null ? `<span class="block text-[10px] text-emerald-600 font-bold">Auto CBT: ${s.autoScore}</span>` : '';
                        const noteVal = s.teacherNote || '';

                        tbody.innerHTML += `
                            <tr class="hover:bg-blue-50/50 border-b">
                                <td class="p-3 font-bold text-gray-900">${s.name}</td>
                                <td class="p-3 font-mono text-gray-500">${s.nisn || s.username}</td>
                                <td class="p-3 font-mono text-gray-600">${timeStr}</td>
                                <td class="p-3">${fileBtn}</td>
                                <td class="p-3">
                                    <input type="number" id="score-${s.studentId}" value="${scoreVal}" min="0" max="100" class="w-16 border p-1 rounded font-mono font-bold text-center text-xs" placeholder="0-100">
                                    ${autoBadge}
                                </td>
                                <td class="p-3">
                                    <input type="text" id="note-${s.studentId}" value="${noteVal}" class="border p-1 rounded text-xs w-44" placeholder="Feedback...">
                                </td>
                                <td class="p-3">
                                    <button onclick="saveGrade('${s.studentId}')" class="bg-green-600 hover:bg-green-700 text-white font-bold px-3 py-1 rounded text-xs shadow">💾 Simpan Nilai</button>
                                </td>
                            </tr>
                        `;
                    });
                } else {
                    tbody.innerHTML = '<tr><td colspan="7" class="p-4 text-center text-gray-400">Tidak ada siswa terdaftar di kelas ini</td></tr>';
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function saveGrade(studentId) {
            const score = document.getElementById('score-' + studentId).value;
            const note = document.getElementById('note-' + studentId).value;

            if(!score) {
                alert('Masukkan nilai angka (0-100)');
                return;
            }

            const res = await fetch('/api/homeworks/grade', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({
                    homeworkId: activeHwId,
                    studentId,
                    score: Number(score),
                    teacherNote: note
                })
            });

            if(res.ok) {
                alert('Nilai dan catatan evaluasi berhasil disimpan!');
            } else {
                alert('Gagal menyimpan nilai');
            }
        }

        function openAddHomeworkModal() {
            document.getElementById('modalAddHomework').classList.remove('hidden');
        }

        document.getElementById('addHomeworkForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
                title: document.getElementById('hwTitle').value,
                subjectName: document.getElementById('hwSubject').value,
                className: document.getElementById('hwClass').value,
                deadline: document.getElementById('hwDeadline').value,
                description: document.getElementById('hwDesc').value,
                fileUrl: document.getElementById('hwFileUrl').value || null,
                audioUrl: document.getElementById('hwAudioUrl').value || null
            };

            const res = await fetch('/api/homeworks', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify(payload)
            });

            if(res.ok) {
                alert('Tugas berhasil diberikan ke siswa');
                document.getElementById('modalAddHomework').classList.add('hidden');
                document.getElementById('addHomeworkForm').reset();
                loadHomeworks();
            } else {
                alert('Gagal membuat tugas');
            }
        });

        async function deleteHomework(id) {
            if(confirm('Hapus tugas ini beserta seluruh submisi siswa?')) {
                await fetch('/api/homeworks/' + id, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                loadHomeworks();
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }
    </script>
</body>
</html>