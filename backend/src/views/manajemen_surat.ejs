<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Surat Resmi & Edaran Orang Tua - SMPN 1 Boyolangu</title>
    <script src="/js/tailwind.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex min-h-screen">

    <!-- Sidebar Admin -->
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <header class="flex flex-wrap justify-between items-center mb-6 gap-4 border-b border-slate-200/80 pb-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-extrabold text-slate-800 flex items-center gap-2.5">
                        <span>📜</span> Portal Surat Resmi &amp; Edaran Orang Tua
                    </h1>
                    <p class="text-slate-500 text-xs mt-1">
                        Kirimkan surat edaran resmi berformat PDF ke Orang Tua Siswa secara tertarget.
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="openLetterModal()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl text-sm shadow-md flex items-center gap-2 transition-all">
                    <span>➕</span> Buat &amp; Terbitkan Surat Baru
                </button>
            </div>
        </header>

        <!-- Filter & Stats Bar -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-xl font-bold">📬</div>
                <div>
                    <p class="text-xs text-gray-500 uppercase font-semibold">Total Surat Diterbitkan</p>
                    <p class="text-xl font-extrabold text-gray-800" id="statTotalLetters">0</p>
                </div>
            </div>
            <div class="bg-white p-4 rounded-xl border border-blue-200 shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center text-xl font-bold">👥</div>
                <div>
                    <p class="text-xs text-blue-600 uppercase font-semibold">Surat Seluruh Siswa</p>
                    <p class="text-xl font-extrabold text-blue-700" id="statAllLetters">0</p>
                </div>
            </div>
            <div class="bg-white p-4 rounded-xl border border-indigo-200 shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xl font-bold">🏫</div>
                <div>
                    <p class="text-xs text-indigo-600 uppercase font-semibold">Surat Tingkat / Rombel</p>
                    <p class="text-xl font-extrabold text-indigo-700" id="statClassLetters">0</p>
                </div>
            </div>
            <div class="bg-white p-4 rounded-xl border border-amber-200 shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center text-xl font-bold">👤</div>
                <div>
                    <p class="text-xs text-amber-600 uppercase font-semibold">Surat Khusus Personal</p>
                    <p class="text-xl font-extrabold text-amber-700" id="statStudentLetters">0</p>
                </div>
            </div>
        </div>

        <!-- Tabel Daftar Surat Resmi -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="p-4 bg-gray-50 border-b flex flex-wrap justify-between items-center gap-3">
                <div class="flex items-center gap-2">
                    <input type="text" id="searchLetterInput" oninput="filterLettersLocal()" placeholder="🔍 Cari nomor surat, perihal, atau tujuan..." class="border border-gray-300 rounded-lg px-3 py-1.5 text-xs w-72 focus:outline-none focus:border-blue-500">
                    <select id="filterTargetType" onchange="filterLettersLocal()" class="border border-gray-300 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-blue-500 bg-white">
                        <option value="ALL_TARGET">Semua Jenis Sasaran</option>
                        <option value="ALL">👥 Seluruh Orang Tua Siswa</option>
                        <option value="GRADE">🎓 Per Tingkat (7, 8, 9)</option>
                        <option value="CLASS">🏫 Per Kelas (Rombel)</option>
                        <option value="STUDENT">👤 Per Siswa (Personal)</option>
                    </select>
                </div>
                <button onclick="loadLetters()" class="text-xs text-blue-600 hover:text-blue-800 font-bold flex items-center gap-1 bg-blue-50 px-3 py-1.5 rounded-lg border border-blue-200">
                    ⟳ Refresh
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-gray-100 text-gray-600 text-xs uppercase tracking-wider border-b">
                            <th class="p-3.5">No. Surat</th>
                            <th class="p-3.5">Perihal / Judul Surat</th>
                            <th class="p-3.5">Sasaran Penerima</th>
                            <th class="p-3.5">Lampiran Dokumen</th>
                            <th class="p-3.5">Tanggal Terbit</th>
                            <th class="p-3.5">Pengirim</th>
                            <th class="p-3.5 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="letterTableBody" class="divide-y divide-gray-100">
                        <tr>
                            <td colspan="7" class="p-6 text-center text-gray-500">Memuat daftar surat resmi...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- MODAL BUAT & KIRIM SURAT RESMI -->
    <div id="modalLetter" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-gray-100 animate-fade-in">
            <div class="p-5 bg-gradient-to-r from-blue-900 to-indigo-900 text-white flex justify-between items-center">
                <div>
                    <h3 class="font-bold text-lg flex items-center gap-2">
                        <span>✍️</span> Terbitkan Surat Edaran Resmi Orang Tua
                    </h3>
                    <p class="text-xs text-blue-200">Pilih sasaran pengiriman: Semua, Per Tingkat, Per Kelas, atau Per Siswa</p>
                </div>
                <button onclick="closeLetterModal()" class="text-gray-300 hover:text-white text-2xl font-bold">&times;</button>
            </div>

            <form id="formLetter" onsubmit="submitLetterForm(event)" class="p-6 space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Nomor Surat Resmi <span class="text-gray-400 font-normal">(Opsional)</span></label>
                        <input type="text" id="inputLetterNo" placeholder="(Kosongkan jika tanpa nomor surat)" class="w-full border p-2.5 rounded-xl text-xs font-mono font-semibold focus:border-blue-500 focus:outline-none">
                        <span class="text-[10px] text-gray-400">Default kosong (tanpa penomoran paksa)</span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Pengirim / Tanda Tangan <span class="text-gray-400 font-normal">(Opsional)</span></label>
                        <input type="text" id="inputSenderName" placeholder="(Kosongkan jika tanpa tanda tangan)" class="w-full border p-2.5 rounded-xl text-xs font-semibold focus:border-blue-500 focus:outline-none">
                        <span class="text-[10px] text-gray-400">Default kosong (tidak diberi tanda tangan)</span>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Perihal / Judul Surat *</label>
                    <input type="text" id="inputLetterTitle" placeholder="Cth: Pemberitahuan Penilaian Akhir Semester (PAS) & Pembagian Rapor" class="w-full border p-2.5 rounded-xl text-xs font-bold text-gray-800 focus:border-blue-500 focus:outline-none" required>
                </div>

                <!-- SASARAN PENERIMA (TARGETING) -->
                <div class="bg-blue-50/70 p-4 rounded-2xl border border-blue-100 space-y-3">
                    <label class="block text-xs font-extrabold text-blue-900">🎯 Sasaran Penerima Surat *</label>
                    
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-xl bg-white border border-gray-200 cursor-pointer text-xs font-bold text-gray-700 hover:border-blue-400">
                            <input type="radio" name="targetTypeRadio" value="ALL" checked onchange="updateTargetInputView()">
                            <span>👥 Semua Siswa</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-xl bg-white border border-gray-200 cursor-pointer text-xs font-bold text-gray-700 hover:border-blue-400">
                            <input type="radio" name="targetTypeRadio" value="GRADE" onchange="updateTargetInputView()">
                            <span>🎓 Per Tingkat</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-xl bg-white border border-gray-200 cursor-pointer text-xs font-bold text-gray-700 hover:border-blue-400">
                            <input type="radio" name="targetTypeRadio" value="CLASS" onchange="updateTargetInputView()">
                            <span>🏫 Per Kelas</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-xl bg-white border border-gray-200 cursor-pointer text-xs font-bold text-gray-700 hover:border-blue-400">
                            <input type="radio" name="targetTypeRadio" value="STUDENT" onchange="updateTargetInputView()">
                            <span>👤 Per Siswa</span>
                        </label>
                    </div>

                    <!-- Target Value Select / Input Dinamis -->
                    <div id="targetValueContainer" class="hidden pt-1">
                        <!-- Dropdown Tingkat -->
                        <div id="wrapperGrade" class="hidden">
                            <label class="block text-[11px] font-bold text-gray-600 mb-1">Pilih Jenjang Tingkat Kelas:</label>
                            <select id="selectGrade" class="w-full border p-2 rounded-xl text-xs font-semibold bg-white">
                                <option value="7">Kelas 7 (Tingkat VII)</option>
                                <option value="8">Kelas 8 (Tingkat VIII)</option>
                                <option value="9">Kelas 9 (Tingkat IX)</option>
                            </select>
                        </div>

                        <!-- Dropdown Kelas -->
                        <div id="wrapperClass" class="hidden">
                            <label class="block text-[11px] font-bold text-gray-600 mb-1">Pilih Rombongan Belajar / Kelas:</label>
                            <select id="selectClass" class="w-full border p-2 rounded-xl text-xs font-semibold bg-white">
                                <option value="VII-A">Kelas VII-A</option>
                                <option value="VII-B">Kelas VII-B</option>
                                <option value="VII-C">Kelas VII-C</option>
                                <option value="VIII-A">Kelas VIII-A</option>
                                <option value="VIII-B">Kelas VIII-B</option>
                                <option value="IX-A">Kelas IX-A</option>
                                <option value="IX-B">Kelas IX-B</option>
                            </select>
                        </div>

                        <!-- Pencarian Siswa -->
                        <div id="wrapperStudent" class="hidden">
                            <label class="block text-[11px] font-bold text-gray-600 mb-1">Ketik NISN atau Nama Siswa Spesifik:</label>
                            <input type="text" id="inputStudentTarget" placeholder="Cth: 0081234567 atau Merri Rosa Amelia" class="w-full border p-2 rounded-xl text-xs font-semibold bg-white focus:outline-none focus:border-blue-500">
                            <p class="text-[10px] text-gray-400 mt-1">Hanya orang tua dari siswa ini yang dapat menerima dan melihat surat ini di APK.</p>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Isi Ringkasan / Instruksi Surat *</label>
                    <textarea id="inputLetterContent" rows="3" placeholder="Tuliskan poin penting pengumuman untuk orang tua..." class="w-full border p-2.5 rounded-xl text-xs focus:border-blue-500 focus:outline-none" required></textarea>
                </div>

                <!-- LAMPIRAN DOKUMEN PDF -->
                <div class="border-2 border-dashed border-gray-300 p-4 rounded-2xl text-center bg-gray-50 hover:bg-gray-100 transition-colors">
                    <p class="text-xs font-bold text-gray-700 mb-1">📄 Berkas Dokumen PDF Resmi Sekolah (Opsional)</p>
                    <p class="text-[11px] text-gray-500 mb-2">Unggah file PDF resmi bertanda tangan & cap stempel sekolah</p>
                    <input type="file" id="inputPdfFile" accept="application/pdf,image/*" class="text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700">
                    <p class="text-[10px] text-gray-400 mt-1">Jika tidak diunggah, sistem otomatis men-generate template dokumen PDF resmi ber-kop sekolah.</p>
                </div>

                <div class="flex justify-end gap-2 pt-2 border-t">
                    <button type="button" onclick="closeLetterModal()" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold rounded-xl text-xs">
                        Batal
                    </button>
                    <button type="submit" id="btnSubmitLetter" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs shadow flex items-center gap-1.5">
                        <span>🚀</span> Terbitkan &amp; Kirim Notifikasi
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if(!token) window.location.href = '/';

        let lettersList = [];
        let filteredLetters = [];

        loadLetters();
        loadClassOptions();

        async function loadClassOptions() {
            try {
                const res = await fetch('/api/kelas', { headers: { 'Authorization': 'Bearer ' + token } });
                const classes = await res.json();
                if (Array.isArray(classes)) {
                    const sel = document.getElementById('selectClass');
                    sel.innerHTML = '';
                    classes.forEach(c => {
                        sel.innerHTML += `<option value="${c.nama}">Kelas ${c.nama}</option>`;
                    });
                }
            } catch (e) {}
        }

        async function loadLetters() {
            try {
                const res = await fetch('/api/letters', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                lettersList = await res.json();
                filteredLetters = [...lettersList];

                // Update Stats
                document.getElementById('statTotalLetters').innerText = lettersList.length;
                document.getElementById('statAllLetters').innerText = lettersList.filter(l => l.targetType === 'ALL').length;
                document.getElementById('statClassLetters').innerText = lettersList.filter(l => l.targetType === 'CLASS' || l.targetType === 'GRADE').length;
                document.getElementById('statStudentLetters').innerText = lettersList.filter(l => l.targetType === 'STUDENT').length;

                renderTable();
            } catch (e) {
                console.error(e);
            }
        }

        function renderTable() {
            const tbody = document.getElementById('letterTableBody');
            tbody.innerHTML = '';

            if (filteredLetters.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-gray-500">Belum ada surat edaran resmi yang diterbitkan</td></tr>';
                return;
            }

            filteredLetters.forEach(l => {
                let badgeTarget = '<span class="bg-blue-100 text-blue-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full">👥 Semua Orang Tua</span>';
                if (l.targetType === 'GRADE') {
                    badgeTarget = `<span class="bg-indigo-100 text-indigo-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full">🎓 Tingkat ${l.targetValue}</span>`;
                } else if (l.targetType === 'CLASS') {
                    badgeTarget = `<span class="bg-emerald-100 text-emerald-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full">🏫 Kelas ${l.targetValue}</span>`;
                } else if (l.targetType === 'STUDENT') {
                    badgeTarget = `<span class="bg-amber-100 text-amber-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full">👤 Khusus: ${l.targetValue}</span>`;
                }

                const dateStr = new Date(l.createdAt).toLocaleDateString('id-ID', {
                    day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
                });

                const letterNoText = l.letterNo && l.letterNo.trim() ? l.letterNo : '<span class="text-gray-400 font-normal italic">Tanpa No. Surat</span>';
                const senderText = l.senderName && l.senderName.trim() ? l.senderName : '<span class="text-gray-400 italic">Tanpa Tanda Tangan</span>';

                tbody.innerHTML += `
                    <tr class="hover:bg-blue-50/50 transition-colors">
                        <td class="p-3.5 font-mono text-xs font-bold text-gray-800">${letterNoText}</td>
                        <td class="p-3.5 font-bold text-gray-900 max-w-xs truncate">${l.title}</td>
                        <td class="p-3.5">${badgeTarget}</td>
                        <td class="p-3.5">
                            <a href="${l.fileUrl}" target="_blank" class="inline-flex items-center gap-1 bg-red-50 text-red-700 hover:bg-red-100 px-2.5 py-1 rounded-lg text-xs font-bold border border-red-200">
                                <span>📄 PDF</span> <span>(${l.fileSize || '320 KB'})</span>
                            </a>
                        </td>
                        <td class="p-3.5 text-xs text-gray-500">${dateStr}</td>
                        <td class="p-3.5 text-xs font-semibold text-gray-700">${senderText}</td>
                        <td class="p-3.5 text-center">
                            <button onclick="deleteLetter('${l.id}', '${l.title}')" class="text-red-500 hover:text-red-700 font-bold text-xs bg-red-50 hover:bg-red-100 px-2.5 py-1 rounded-lg border border-red-200">
                                🗑️ Hapus
                            </button>
                        </td>
                    </tr>
                `;
            });
        }

        function filterLettersLocal() {
            const query = document.getElementById('searchLetterInput').value.toLowerCase().trim();
            const targetFilter = document.getElementById('filterTargetType').value;

            filteredLetters = lettersList.filter(l => {
                const matchTarget = (targetFilter === 'ALL_TARGET' || l.targetType === targetFilter);
                const matchQuery = !query || 
                    (l.letterNo && l.letterNo.toLowerCase().includes(query)) ||
                    (l.title && l.title.toLowerCase().includes(query)) ||
                    (l.targetValue && l.targetValue.toLowerCase().includes(query));
                return matchTarget && matchQuery;
            });
            renderTable();
        }

        function openLetterModal() {
            document.getElementById('modalLetter').classList.remove('hidden');
            // Default KOSONG sesuai permintaan pengguna (tanpa nomor paksa dan tanpa tanda tangan otomatis)
            document.getElementById('inputLetterNo').value = '';
            document.getElementById('inputSenderName').value = '';
            document.getElementById('inputLetterTitle').value = '';
            document.getElementById('inputLetterContent').value = '';
            document.getElementById('inputPdfFile').value = '';
            updateTargetInputView();
        }

        function closeLetterModal() {
            document.getElementById('modalLetter').classList.add('hidden');
        }

        function updateTargetInputView() {
            const radios = document.getElementsByName('targetTypeRadio');
            let selectedType = 'ALL';
            for (let r of radios) {
                if (r.checked) {
                    selectedType = r.value;
                    break;
                }
            }

            const container = document.getElementById('targetValueContainer');
            const wrapGrade = document.getElementById('wrapperGrade');
            const wrapClass = document.getElementById('wrapperClass');
            const wrapStudent = document.getElementById('wrapperStudent');

            if (selectedType === 'ALL') {
                container.classList.add('hidden');
            } else {
                container.classList.remove('hidden');
                wrapGrade.classList.toggle('hidden', selectedType !== 'GRADE');
                wrapClass.classList.toggle('hidden', selectedType !== 'CLASS');
                wrapStudent.classList.toggle('hidden', selectedType !== 'STUDENT');
            }
        }

        async function submitLetterForm(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitLetter');
            btn.disabled = true;
            btn.innerHTML = '⏳ Menerbitkan...';

            const radios = document.getElementsByName('targetTypeRadio');
            let targetType = 'ALL';
            for (let r of radios) {
                if (r.checked) targetType = r.value;
            }

            let targetValue = '';
            if (targetType === 'GRADE') targetValue = document.getElementById('selectGrade').value;
            else if (targetType === 'CLASS') targetValue = document.getElementById('selectClass').value;
            else if (targetType === 'STUDENT') targetValue = document.getElementById('inputStudentTarget').value;

            // Baca file PDF jika ada
            let pdfBase64 = null;
            const fileInput = document.getElementById('inputPdfFile');
            if (fileInput.files && fileInput.files[0]) {
                pdfBase64 = await toBase64(fileInput.files[0]);
            }

            const payload = {
                letterNo: document.getElementById('inputLetterNo').value,
                title: document.getElementById('inputLetterTitle').value,
                content: document.getElementById('inputLetterContent').value,
                customSenderName: document.getElementById('inputSenderName').value,
                targetType,
                targetValue,
                pdfBase64
            };

            try {
                const res = await fetch('/api/letters', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (res.ok) {
                    alert(result.message || 'Surat berhasil diterbitkan');
                    closeLetterModal();
                    loadLetters();
                    document.getElementById('formLetter').reset();
                } else {
                    alert('Gagal: ' + (result.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Gagal menghubungi server');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>🚀</span> Terbitkan & Kirim Notifikasi';
            }
        }

        async function deleteLetter(id, title) {
            if (!confirm(`Apakah Anda yakin ingin menghapus surat "${title}"?`)) return;
            try {
                const res = await fetch(`/api/letters/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    loadLetters();
                } else {
                    alert('Gagal menghapus surat');
                }
            } catch (e) {
                alert('Gagal menghubungi server');
            }
        }

        function toBase64(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = () => resolve(reader.result);
                reader.onerror = error => reject(error);
            });
        }
    </script>
</body>
</html>
