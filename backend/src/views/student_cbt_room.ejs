<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ruang Ujian Online CBT - SMP Negeri 1 Boyolangu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col select-none">

    <!-- Header CBT Bar -->
    <header class="bg-slate-900 border-b border-slate-800 px-4 md:px-8 py-3.5 flex items-center justify-between sticky top-0 z-30 shadow-md">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400">
                <i class="fa-solid fa-graduation-cap text-lg"></i>
            </div>
            <div>
                <h1 class="text-base font-bold text-white leading-tight" id="examTitle">Memuat Ujian CBT...</h1>
                <p class="text-xs text-slate-400" id="examMeta">SMP Negeri 1 Boyolangu</p>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <!-- Countdown Timer -->
            <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-800/90 border border-slate-700 shadow-inner">
                <i class="fa-solid fa-stopwatch text-amber-400" id="timerIcon"></i>
                <div class="text-right">
                    <span class="text-[10px] text-slate-400 uppercase font-semibold block leading-none">Sisa Waktu</span>
                    <span class="font-mono text-base font-black text-white tracking-wider" id="timerDisplay">--:--:--</span>
                </div>
            </div>

            <!-- Auto-save indicator -->
            <div class="hidden sm:flex items-center gap-1.5 text-xs text-slate-400">
                <span class="w-2 h-2 rounded-full bg-emerald-400" id="saveIndicator"></span>
                <span id="saveStatus">Tersimpan</span>
            </div>

            <!-- Finish Button -->
            <button onclick="confirmSubmitExam()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-emerald-600/20 transition-all flex items-center gap-1.5">
                <i class="fa-solid fa-paper-plane"></i> <span>Selesai Ujian</span>
            </button>
        </div>
    </header>

    <!-- Main Exam Container -->
    <div class="flex-1 flex flex-col lg:flex-row max-w-7xl w-full mx-auto p-4 md:p-6 gap-6">
        <!-- Left: Question Panel -->
        <div class="flex-1 flex flex-col bg-slate-900 border border-slate-800 rounded-2xl p-5 md:p-7 shadow-xl">
            <!-- Question Header Info -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-800 text-xs">
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1 bg-blue-600 text-white font-bold rounded-lg text-sm" id="badgeCurrentQ">Soal No. 1</span>
                    <span class="px-2.5 py-1 bg-slate-800 text-slate-300 rounded-lg font-medium border border-slate-700" id="badgeCognitive">C3 (Aplikasi)</span>
                    <span class="px-2.5 py-1 bg-slate-800 text-slate-300 rounded-lg font-medium border border-slate-700" id="badgeKd">KD 3.1</span>
                </div>
                <div class="flex items-center gap-2">
                    <label class="flex items-center gap-2 cursor-pointer bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700 hover:border-amber-500/50 transition-all">
                        <input type="checkbox" id="checkRagu" onchange="toggleRaguRagu(this.checked)" class="w-4 h-4 rounded bg-slate-900 border-slate-600 text-amber-500 focus:ring-amber-500">
                        <span class="text-xs font-semibold text-amber-400">Ragu-Ragu</span>
                    </label>
                </div>
            </div>

            <!-- Question Content -->
            <div class="mt-5 flex-1 overflow-y-auto">
                <div class="text-base text-slate-100 leading-relaxed space-y-3" id="qContent">
                    Memuat pertanyaan...
                </div>

                <!-- Image Attachment if any -->
                <div id="qImageContainer" class="mt-4 hidden">
                    <img id="qImage" src="" alt="Gambar Soal" class="max-h-72 rounded-xl border border-slate-800 object-contain mx-auto">
                </div>

                <!-- Multiple Choice Options -->
                <div id="optionsContainer" class="mt-6 space-y-3">
                    <!-- Dynamic Options -->
                </div>

                <!-- Essay Textarea -->
                <div id="essayContainer" class="mt-6 hidden">
                    <label class="block text-xs font-semibold text-slate-400 mb-2">Tuliskan Jawaban Uraian Anda Secara Lengkap:</label>
                    <textarea id="essayInput" rows="6" oninput="handleEssayInput(this.value)" placeholder="Ketik jawaban Anda di sini..." class="w-full bg-slate-950 border border-slate-800 rounded-xl p-4 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-y"></textarea>
                    <p class="text-[11px] text-slate-500 mt-1" id="essayWordCount">0 karakter</p>
                </div>
            </div>

            <!-- Bottom Navigation Controls -->
            <div class="pt-5 mt-6 border-t border-slate-800 flex items-center justify-between gap-3">
                <button onclick="prevQuestion()" id="btnPrev" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold rounded-xl border border-slate-700 transition-all flex items-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-arrow-left"></i> Sebelumnya
                </button>

                <div class="flex items-center gap-2">
                    <button onclick="nextQuestion()" id="btnNext" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-600/20 transition-all flex items-center gap-2">
                        Berikutnya <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Right: Question Navigation Grid (Drawer) -->
        <div class="w-full lg:w-80 bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col h-fit">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-table-cells text-blue-400"></i> Nomor Soal
                </h3>
                <span class="text-xs font-bold text-slate-400" id="progressCount">0/0 Selesai</span>
            </div>

            <!-- Legend -->
            <div class="grid grid-cols-3 gap-2 py-3 border-b border-slate-800 text-[11px]">
                <div class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-md bg-emerald-500"></span>
                    <span class="text-slate-300">Dijawab</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-md bg-amber-500"></span>
                    <span class="text-slate-300">Ragu-ragu</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-md bg-slate-800 border border-slate-700"></span>
                    <span class="text-slate-400">Belum</span>
                </div>
            </div>

            <!-- Question Numbers Grid -->
            <div class="grid grid-cols-5 gap-2.5 mt-4 max-h-[360px] overflow-y-auto pr-1" id="qGrid">
                <!-- Numbers inserted dynamically -->
            </div>
        </div>
    </div>

    <!-- Client Script -->
    <script>
        const EXAM_ID = "<%= examId %>";
        let questions = [];
        let currentIndex = 0;
        let answers = {}; // { [qId]: optionKey or text }
        let doubtful = {}; // { [qId]: boolean }
        let timerInterval = null;
        let remainingSeconds = 90 * 60;
        let strikeCount = 0;

        // Auto Save to localStorage
        const STORAGE_KEY = `cbt_answers_${EXAM_ID}`;
        const DOUBTFUL_KEY = `cbt_doubtful_${EXAM_ID}`;

        async function loadExamRoom() {
            try {
                // Restore local cache if any
                const saved = localStorage.getItem(STORAGE_KEY);
                if (saved) answers = JSON.parse(saved);
                const savedD = localStorage.getItem(DOUBTFUL_KEY);
                if (savedD) doubtful = JSON.parse(savedD);

                const res = await fetch(`/api/guru/exams/${EXAM_ID}/questions`);
                if (!res.ok) throw new Error('Gagal memuat soal ujian');
                questions = await res.json();

                if (!questions || questions.length === 0) {
                    alert('Belum ada butir soal dalam ujian ini.');
                    return;
                }

                document.getElementById('examTitle').innerText = questions[0]?.exam?.title || 'Ujian CBT';
                document.getElementById('examMeta').innerText = `Mata Pelajaran: ${questions[0]?.exam?.subject?.name || 'Umum'} • Durasi: ${questions[0]?.exam?.durationMinutes || 90} Menit`;

                remainingSeconds = (questions[0]?.exam?.durationMinutes || 90) * 60;
                startTimer();
                renderQuestionGrid();
                showQuestion(0);
            } catch (e) {
                console.error(e);
                alert('Gagal memuat ruang ujian: ' + e.message);
            }
        }

        function startTimer() {
            timerInterval = setInterval(() => {
                remainingSeconds--;
                if (remainingSeconds <= 0) {
                    clearInterval(timerInterval);
                    alert('Waktu ujian telah habis! Jawaban Anda akan dikirimkan otomatis.');
                    submitExam(true);
                    return;
                }

                const h = Math.floor(remainingSeconds / 3600);
                const m = Math.floor((remainingSeconds % 3600) / 60);
                const s = remainingSeconds % 60;
                const formatted = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                const el = document.getElementById('timerDisplay');
                if (el) el.innerText = formatted;

                if (remainingSeconds < 300) {
                    el.className = 'font-mono text-base font-black text-rose-400 tracking-wider animate-pulse';
                }
            }, 1000);
        }

        function renderQuestionGrid() {
            const grid = document.getElementById('qGrid');
            grid.innerHTML = '';
            let answeredCount = 0;

            questions.forEach((q, idx) => {
                const btn = document.createElement('button');
                btn.className = getGridButtonClass(q.id, idx);
                btn.innerText = idx + 1;
                btn.onclick = () => showQuestion(idx);
                grid.appendChild(btn);

                if (answers[q.id]) answeredCount++;
            });

            document.getElementById('progressCount').innerText = `${answeredCount}/${questions.length} Selesai`;
        }

        function getGridButtonClass(qId, idx) {
            const isCurrent = idx === currentIndex;
            const isDoubt = doubtful[qId] === true;
            const isAnswered = answers[qId] !== undefined && answers[qId] !== '';

            let base = "h-11 rounded-xl font-bold text-xs flex items-center justify-center transition-all border ";
            if (isCurrent) base += "ring-2 ring-blue-400 ring-offset-2 ring-offset-slate-900 ";

            if (isDoubt) {
                return base + "bg-amber-500 text-white border-amber-400";
            } else if (isAnswered) {
                return base + "bg-emerald-600 text-white border-emerald-500";
            } else {
                return base + "bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700";
            }
        }

        function showQuestion(index) {
            if (index < 0 || index >= questions.length) return;
            currentIndex = index;

            const q = questions[index];
            document.getElementById('badgeCurrentQ').innerText = `Soal No. ${index + 1}`;
            document.getElementById('badgeCognitive').innerText = q.cognitiveLevel || 'C3';
            document.getElementById('badgeKd').innerText = q.kdTag || 'KD 3.1';
            document.getElementById('qContent').innerText = q.content;

            // Ragu-ragu checkbox
            document.getElementById('checkRagu').checked = doubtful[q.id] === true;

            // Image
            const imgBox = document.getElementById('qImageContainer');
            const img = document.getElementById('qImage');
            if (q.imageUrl) {
                img.src = q.imageUrl;
                imgBox.classList.remove('hidden');
            } else {
                imgBox.classList.add('hidden');
            }

            // Options or Essay
            const optContainer = document.getElementById('optionsContainer');
            const essayBox = document.getElementById('essayContainer');

            if (q.type === 'ESSAY') {
                optContainer.classList.add('hidden');
                essayBox.classList.remove('hidden');
                const area = document.getElementById('essayInput');
                area.value = answers[q.id] || '';
                document.getElementById('essayWordCount').innerText = `${area.value.length} karakter`;
            } else {
                optContainer.classList.remove('hidden');
                essayBox.classList.add('hidden');
                renderOptions(q);
            }

            // Update buttons
            document.getElementById('btnPrev').disabled = (index === 0);
            document.getElementById('btnNext').innerText = (index === questions.length - 1) ? 'Selesai' : 'Berikutnya →';

            renderQuestionGrid();
        }

        function renderOptions(q) {
            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';

            let opts = { A: '', B: '', C: '', D: '' };
            if (q.options) {
                try {
                    const parsed = JSON.parse(q.options);
                    if (Array.isArray(parsed)) {
                        ['A', 'B', 'C', 'D'].forEach((k, i) => opts[k] = parsed[i] || '');
                    } else if (typeof parsed === 'object') {
                        opts = parsed;
                    }
                } catch (e) {}
            }

            const currentAns = answers[q.id];

            ['A', 'B', 'C', 'D'].forEach(optKey => {
                const optText = opts[optKey];
                if (!optText) return;

                const isSelected = (currentAns === optKey);
                const optCard = document.createElement('div');
                optCard.className = `p-4 rounded-xl border cursor-pointer flex items-center gap-3.5 transition-all ${
                    isSelected ? 'bg-blue-600/20 border-blue-500 text-white font-semibold shadow-sm' : 'bg-slate-950/60 border-slate-800 text-slate-300 hover:bg-slate-800/60'
                }`;
                optCard.onclick = () => selectOption(q.id, optKey);

                optCard.innerHTML = `
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center font-bold text-xs ${
                        isSelected ? 'bg-blue-600 text-white' : 'bg-slate-800 text-slate-400'
                    }">${optKey}</div>
                    <span class="text-sm flex-1 leading-relaxed">${optText}</span>
                `;
                container.appendChild(optCard);
            });
        }

        function selectOption(qId, key) {
            answers[qId] = key;
            saveProgress();
            renderOptions(questions[currentIndex]);
            renderQuestionGrid();
        }

        function handleEssayInput(val) {
            const q = questions[currentIndex];
            answers[q.id] = val;
            document.getElementById('essayWordCount').innerText = `${val.length} karakter`;
            saveProgress();
            renderQuestionGrid();
        }

        function toggleRaguRagu(isDoubt) {
            const q = questions[currentIndex];
            doubtful[q.id] = isDoubt;
            localStorage.setItem(DOUBTFUL_KEY, JSON.stringify(doubtful));
            renderQuestionGrid();
        }

        function prevQuestion() {
            if (currentIndex > 0) showQuestion(currentIndex - 1);
        }

        function nextQuestion() {
            if (currentIndex < questions.length - 1) {
                showQuestion(currentIndex + 1);
            } else {
                confirmSubmitExam();
            }
        }

        function saveProgress() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(answers));
            localStorage.setItem(DOUBTFUL_KEY, JSON.stringify(doubtful));

            const ind = document.getElementById('saveIndicator');
            const stat = document.getElementById('saveStatus');
            if (ind && stat) {
                ind.className = 'w-2 h-2 rounded-full bg-blue-400 animate-ping';
                stat.innerText = 'Menyimpan...';
                setTimeout(() => {
                    ind.className = 'w-2 h-2 rounded-full bg-emerald-400';
                    stat.innerText = 'Tersimpan';
                }, 800);
            }
        }

        function confirmSubmitExam() {
            const total = questions.length;
            const answered = Object.keys(answers).length;
            const doubtCount = Object.values(doubtful).filter(v => v === true).length;

            let msg = `Anda telah menjawab ${answered} dari ${total} soal.`;
            if (doubtCount > 0) {
                msg += `\n⚠️ Perhatian: Terdapat ${doubtCount} soal yang masih ditandai RAGU-RAGU!`;
            }
            msg += `\n\nApakah Anda yakin ingin mengakhiri dan mengirimkan ujian sekarang?`;

            if (confirm(msg)) {
                submitExam(false);
            }
        }

        async function submitExam(isAuto) {
            try {
                clearInterval(timerInterval);
                const res = await fetch('/api/cbt/sync-exam', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        examId: EXAM_ID,
                        answers: answers,
                        isFinalSubmit: true
                    })
                });

                localStorage.removeItem(STORAGE_KEY);
                localStorage.removeItem(DOUBTFUL_KEY);

                alert('✅ Ujian berhasil diselesaikan dan lembar jawaban Anda telah diterima server!');
                window.location.href = '/siswa';
            } catch (e) {
                alert('Gagal mengirimkan ujian: ' + e.message);
            }
        }

        // Anti-Cheat fraud detection
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                strikeCount++;
                alert(`⚠️ PERINGATAN KECURANGAN (#${strikeCount})!\nAnda terdeteksi meninggalkan halaman ujian. Aktivitas ini tercatat di monitor pengawas.`);
                fetch('/api/cbt/strike', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ examId: EXAM_ID, reason: 'Pindah Tab Browser' })
                }).catch(() => {});
            }
        });

        document.addEventListener('DOMContentLoaded', loadExamRoom);
    </script>
</body>
</html>
