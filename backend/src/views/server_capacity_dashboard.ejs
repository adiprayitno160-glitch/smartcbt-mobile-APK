<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diagnostik Kapasitas Server CBT - Smart School SMPN 1 Boyolangu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex">

    <!-- Sidebar Admin -->
    <%- include('partials/sidebar_admin') %>

    <%
        const safeData = (typeof initialData !== 'undefined' && initialData) ? initialData : null;
        const mem = safeData ? safeData.memoryMetrics : null;
        const specs = safeData ? safeData.serverSpecs : null;
        const db = safeData ? safeData.databaseDiagnostics : null;
        const calc = safeData ? safeData.capacityCalculator : null;
        const opt = safeData ? safeData.optimizationStatus : null;
    %>

    <!-- Main Content -->
    <main class="flex-1 min-h-screen bg-slate-950 p-4 md:p-8 transition-all duration-300">
        <!-- Topbar / Title -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-800">
            <div>
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-amber-500 to-yellow-300 flex items-center justify-center text-slate-950 shadow-lg shadow-amber-500/20">
                        <i class="fa-solid fa-server text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-white tracking-tight flex items-center gap-2">
                            Diagnostik Kapasitas Server CBT
                            <span id="liveBadge" class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Real Data (Live DB)
                            </span>
                        </h1>
                        <p class="text-slate-400 text-sm mt-0.5">Monitoring spesifikasi hardware asli, buffer SQLite WAL, kalkulasi daya tampung peserta ujian, dan toolkit akselerasi.</p>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="fetchDiagnostics()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-medium rounded-xl border border-slate-700 transition-all flex items-center gap-2 shadow-sm cursor-pointer">
                    <i class="fa-solid fa-rotate-right" id="refreshIcon"></i> Perbarui Data
                </button>
                <div class="flex items-center gap-2 bg-slate-900 border border-slate-800 px-3 py-2 rounded-xl text-xs text-slate-400">
                    <label class="flex items-center cursor-pointer gap-2">
                        <input type="checkbox" id="autoRefreshToggle" checked class="w-4 h-4 rounded bg-slate-800 text-amber-500 focus:ring-amber-500 border-slate-700">
                        <span>Auto-Refresh (5d)</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Real CBT & Database Assets Banner -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mt-6 p-4 bg-slate-900/60 border border-slate-800/80 rounded-2xl backdrop-blur-sm">
            <div class="border-r border-slate-800/60 pr-2 last:border-r-0">
                <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider block">📁 Ukuran Database</span>
                <span class="text-sm font-bold text-blue-400 font-mono" id="valDbSize"><%= db ? db.dbSizeMb : '19.4' %> MB</span>
                <span class="text-[10px] text-slate-500 block">dev.db (SQLite)</span>
            </div>
            <div class="border-r border-slate-800/60 pr-2 last:border-r-0">
                <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider block">⚡ WAL Cache Buffer</span>
                <span class="text-sm font-bold text-amber-400 font-mono" id="valWalSize"><%= db ? db.walSizeMb : '3.9' %> MB</span>
                <span class="text-[10px] text-slate-500 block">dev.db-wal</span>
            </div>
            <div class="border-r border-slate-800/60 pr-2 last:border-r-0">
                <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider block">👥 Siswa Terdaftar</span>
                <span class="text-sm font-bold text-emerald-400 font-mono" id="valTotalStudents"><%= db ? db.totalStudents : '330' %> Siswa</span>
                <span class="text-[10px] text-slate-500 block">Aktif di Sistem</span>
            </div>
            <div class="border-r border-slate-800/60 pr-2 last:border-r-0">
                <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider block">🏫 Kelas / Rombel</span>
                <span class="text-sm font-bold text-indigo-400 font-mono" id="valTotalClasses"><%= db ? db.totalClasses : '33' %> Kelas</span>
                <span class="text-[10px] text-slate-500 block">VII, VIII, IX</span>
            </div>
            <div class="border-r border-slate-800/60 pr-2 last:border-r-0">
                <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider block">📚 Bank Soal CBT</span>
                <span class="text-sm font-bold text-purple-400 font-mono" id="valTotalQuestions"><%= db ? db.totalQuestions : '208' %> Soal</span>
                <span class="text-[10px] text-slate-500 block"><%= db ? db.totalExams : '5' %> Bank Ujian</span>
            </div>
            <div>
                <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider block">📝 Ujian Selesai</span>
                <span class="text-sm font-bold text-rose-400 font-mono" id="valSubmittedExams"><%= db ? db.submittedExams : '4' %> Berkas</span>
                <span class="text-[10px] text-slate-500 block">Tersimpan di DB</span>
            </div>
        </div>

        <!-- Metric Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mt-5">
            <!-- RAM Metric -->
            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm relative overflow-hidden group hover:border-slate-700 transition-all">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider">Penggunaan RAM Server</p>
                        <h3 class="text-2xl font-black text-white mt-1.5" id="valRamUsed"><%= mem ? `${mem.usedRamMb} / ${mem.totalRamMb} MB` : '-- / -- MB' %></h3>
                        <p class="text-xs text-slate-400 mt-1" id="valRamPercent"><%= mem ? `${mem.ramUsagePercent}% RAM Terpakai` : 'Memuat statistik memori...' %></p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center">
                        <i class="fa-solid fa-memory"></i>
                    </div>
                </div>
                <!-- RAM Progress Bar -->
                <div class="w-full bg-slate-800 rounded-full h-2 mt-4 overflow-hidden">
                    <div id="barRamUsage" class="h-2 rounded-full bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-500" style="width: <%= mem ? mem.ramUsagePercent : 0 %>%"></div>
                </div>
                <div class="flex justify-between text-[11px] text-slate-500 mt-2">
                    <span id="valRamFree">Bebas: <%= mem ? mem.freeRamMb : '--' %> MB</span>
                    <span id="valNodeHeap">Heap: <%= mem ? mem.heapUsedMb : '--' %> MB</span>
                </div>
            </div>

            <!-- CPU & Load -->
            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm relative overflow-hidden group hover:border-slate-700 transition-all">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider">CPU Cores & Utilisasi</p>
                        <h3 class="text-2xl font-black text-white mt-1.5" id="valCpuCores"><%= specs ? `${specs.cpuCores} Core CPU` : '-- Cores' %></h3>
                        <p class="text-xs text-slate-400 mt-1 truncate max-w-[200px]" id="valCpuModel"><%= specs ? specs.cpuModel : 'Processor...' %></p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center">
                        <i class="fa-solid fa-microchip"></i>
                    </div>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
                    <span>Beban CPU Nyata:</span>
                    <span class="font-mono text-emerald-400 font-bold" id="valLoadAvg"><%= specs ? `${specs.cpuUsagePercent}% Aktif` : '--%' %></span>
                </div>
                <div class="text-[11px] text-slate-500 mt-1">
                    Uptime Node: <span class="text-slate-300" id="valUptime"><%= specs ? specs.uptimeFormatted : '--' %></span>
                </div>
            </div>

            <!-- Database Latency Ping -->
            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm relative overflow-hidden group hover:border-slate-700 transition-all">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider">Database Query Latency</p>
                        <h3 class="text-2xl font-black text-emerald-400 mt-1.5" id="valLatency"><%= db ? `${db.averageLatencyMs} ms` : '-- ms' %></h3>
                        <p class="text-xs text-slate-400 mt-1" id="valLatencyStatus"><%= db ? db.latencyMessage : 'Menguji koneksi database...' %></p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
                    <span>Mode SQLite:</span>
                    <span class="text-slate-200 font-medium truncate max-w-[170px]" id="valDbEngine">WAL Mode • Sync <%= db ? db.pragmaSynchronous : 'NORMAL' %></span>
                </div>
                <div class="text-[11px] text-slate-500 mt-1">
                    Connection Pool: <span class="text-emerald-400 font-semibold" id="valPoolStatus">ONLINE (100% Sehat)</span>
                </div>
            </div>

            <!-- Safe Concurrent Users Counter -->
            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm relative overflow-hidden group hover:border-slate-700 transition-all">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider">Batas Aman Siswa Simultan</p>
                        <h3 class="text-2xl font-black text-amber-400 mt-1.5" id="valSafeUsers"><%= calc ? `${calc.safeConcurrentUsers} Siswa` : '-- Siswa' %></h3>
                        <p class="text-xs text-slate-400 mt-1" id="valSessionRecommend">Saran: <%= calc ? `${calc.recommendedSessions} Sesi (${calc.baselineTotalStudents} Siswa)` : '--' %></p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
                    <span>Peserta Aktif Sekarang:</span>
                    <span class="text-white font-bold" id="valOngoingNow"><%= calc ? `${calc.ongoingStudentsNow} Siswa` : '0 Siswa' %></span>
                </div>
                <div class="text-[11px] text-slate-500 mt-1">
                    Batas Peringatan (85%): <span class="text-amber-300 font-medium" id="valWarningThreshold"><%= calc ? `${calc.warningThreshold} Siswa` : '--' %></span>
                </div>
            </div>
        </div>

        <!-- Section 2: Simulator & 1-Click Toolkit -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-6">
            <!-- Left: Interactive Simulator -->
            <div class="lg:col-span-7 bg-slate-900/90 border border-slate-800 rounded-2xl p-6">
                <div class="flex items-center justify-between pb-4 border-b border-slate-800">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center">
                            <i class="fa-solid fa-calculator"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-white">Kalkulator Beban Ujian CBT Bersamaan</h2>
                            <p class="text-slate-400 text-xs">Simulasi daya tampung server berdasarkan jumlah peserta ujian serentak.</p>
                        </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-lg text-xs font-mono font-medium bg-slate-800 text-indigo-300 border border-slate-700">Real-Time Estimator</span>
                </div>

                <!-- Interactive Slider -->
                <div class="mt-6 space-y-5">
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label class="text-sm font-semibold text-slate-200">Simulasi Jumlah Siswa Mengerjakan Ujian Serentak:</label>
                            <span class="text-lg font-black font-mono text-amber-400 px-3 py-0.5 rounded-lg bg-slate-800 border border-slate-700" id="sliderDisplayVal">330 Siswa</span>
                        </div>
                        <input type="range" id="studentSlider" min="10" max="500" step="10" value="<%= calc ? Math.min(500, calc.baselineTotalStudents) : 330 %>" oninput="updateSimulation(this.value)" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-500">
                        <div class="flex justify-between text-[11px] text-slate-500 mt-2">
                            <button type="button" onclick="setSliderVal(32)" class="hover:text-amber-400 transition-colors cursor-pointer underline">32 Siswa (1 Kelas)</button>
                            <button type="button" onclick="setSliderVal(110)" class="hover:text-amber-400 transition-colors cursor-pointer underline">110 Siswa (1 Angkatan)</button>
                            <button type="button" onclick="setSliderVal(220)" class="hover:text-amber-400 transition-colors cursor-pointer underline">220 Siswa (2 Angkatan)</button>
                            <button type="button" onclick="setSliderVal(<%= calc ? calc.baselineTotalStudents : 330 %>)" class="hover:text-amber-400 transition-colors cursor-pointer underline font-bold text-amber-300">Semua <%= calc ? calc.baselineTotalStudents : 330 %> Siswa</button>
                        </div>
                    </div>

                    <!-- Simulation Result Box -->
                    <div id="simResultBox" class="p-4 rounded-xl border transition-all bg-emerald-950/30 border-emerald-500/30 text-emerald-200">
                        <div class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-xl text-emerald-400 mt-0.5" id="simResultIcon"></i>
                            <div class="flex-1">
                                <h4 class="text-sm font-bold text-white" id="simResultTitle">Kapasitas Server Sangat Aman</h4>
                                <p class="text-xs text-slate-300 mt-0.5" id="simResultDesc">Server memiliki cukup RAM dan core CPU untuk melayani ujian bersamaan tanpa perlambatan.</p>
                                <div class="grid grid-cols-3 gap-2 mt-3 pt-3 border-t border-slate-800/80 text-xs">
                                    <div>
                                        <span class="text-slate-400 block text-[11px]">Est. Konsumsi RAM:</span>
                                        <span class="font-mono font-bold text-white" id="simRamEst">~3.9 GB</span>
                                    </div>
                                    <div>
                                        <span class="text-slate-400 block text-[11px]">Est. Beban CPU:</span>
                                        <span class="font-mono font-bold text-white" id="simCpuEst">~35%</span>
                                    </div>
                                    <div>
                                        <span class="text-slate-400 block text-[11px]">Rekomendasi Sesi:</span>
                                        <span class="font-mono font-bold text-white" id="simRecSessions">1 Sesi Penuh</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Technical Specs Table -->
                    <div class="bg-slate-950/60 rounded-xl p-4 border border-slate-800/80 text-xs space-y-2">
                        <div class="flex justify-between py-1 border-b border-slate-800/60 text-slate-400">
                            <span>Platform & Engine Server:</span>
                            <span class="text-slate-200 font-medium" id="specPlatform"><%= specs ? specs.platform : 'Node.js Express / SQLite3' %></span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-800/60 text-slate-400">
                            <span>Alokasi Memori Limit Node.js:</span>
                            <span class="text-slate-200 font-medium" id="specMemLimit"><%= specs ? specs.phpMemoryLimitEquivalent : 'Heap Node.js' %></span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-800/60 text-slate-400">
                            <span>Batas Waktu Eksekusi (Max Execution Time):</span>
                            <span class="text-slate-200 font-medium" id="specMaxTime"><%= specs ? specs.maxExecutionTime : '30 detik' %></span>
                        </div>
                        <div class="flex justify-between py-1 text-slate-400">
                            <span>Uptime Sistem Operasi Host:</span>
                            <span class="text-slate-200 font-medium" id="specOsUptime"><%= specs ? specs.osUptimeFormatted : '--' %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: 1-Click Optimization Toolkit -->
            <div class="lg:col-span-5 bg-slate-900/90 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between pb-4 border-b border-slate-800">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </div>
                            <div>
                                <h2 class="text-base font-bold text-white">Toolkit Optimasi Satu-Klik</h2>
                                <p class="text-slate-400 text-xs">Tingkatkan throughput & minimalkan latensi CBT.</p>
                            </div>
                        </div>
                        <span class="text-[11px] text-slate-400 font-mono" id="valLastOptimizedLabel">Terakhir: <span id="valLastOptTime" class="text-amber-300"><%= opt && opt.lastOptimizedAt ? opt.lastOptimizedAt : 'Hari ini' %></span></span>
                    </div>

                    <!-- MASTER BUTTON: JALANKAN SEMUA OPTIMASI -->
                    <div class="mt-4">
                        <button onclick="runOptimize('optimize-all', this)" class="w-full py-3 px-4 bg-gradient-to-r from-amber-500 via-yellow-500 to-amber-600 hover:from-amber-600 hover:to-yellow-600 text-slate-950 font-black text-sm rounded-xl shadow-lg shadow-amber-500/20 flex items-center justify-center gap-2 transition-all cursor-pointer transform active:scale-98">
                            <i class="fa-solid fa-bolt-lightning text-base"></i>
                            <span>🚀 JALANKAN SEMUA OPTIMASI 1-KLIK (OPTIMIZE ALL)</span>
                        </button>
                    </div>

                    <div class="mt-4 space-y-3">
                        <!-- Tool 1: Config Cache -->
                        <div class="p-3 bg-slate-950/50 rounded-xl border border-slate-800 flex items-center justify-between gap-3 hover:border-slate-700 transition-colors">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-xs font-bold text-white flex items-center gap-1.5">
                                        <i class="fa-solid fa-database text-blue-400"></i> Cache Konfigurasi & PRAGMA
                                    </h4>
                                    <span id="badge-config" class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">🟢 AKTIF (64MB)</span>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-0.5">SQLite sync NORMAL, 64MB cache RAM, mmap 256MB.</p>
                            </div>
                            <button id="btn-config-cache" onclick="runOptimize('config-cache', this)" class="px-3 py-1.5 bg-blue-600/80 hover:bg-blue-600 text-white text-xs font-semibold rounded-lg transition-all flex items-center gap-1 shadow-sm shrink-0 cursor-pointer">
                                <span>Segarkan</span>
                            </button>
                        </div>

                        <!-- Tool 2: Routes Cache -->
                        <div class="p-3 bg-slate-950/50 rounded-xl border border-slate-800 flex items-center justify-between gap-3 hover:border-slate-700 transition-colors">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-xs font-bold text-white flex items-center gap-1.5">
                                        <i class="fa-solid fa-route text-indigo-400"></i> Cache Rute & Engine Request
                                    </h4>
                                    <span id="badge-routes" class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">🟢 AKTIF</span>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-0.5">Pre-warm query model siswa, soal, dan kelas.</p>
                            </div>
                            <button id="btn-routes-cache" onclick="runOptimize('routes-cache', this)" class="px-3 py-1.5 bg-indigo-600/80 hover:bg-indigo-600 text-white text-xs font-semibold rounded-lg transition-all flex items-center gap-1 shadow-sm shrink-0 cursor-pointer">
                                <span>Segarkan</span>
                            </button>
                        </div>

                        <!-- Tool 3: Views Cache -->
                        <div class="p-3 bg-slate-950/50 rounded-xl border border-slate-800 flex items-center justify-between gap-3 hover:border-slate-700 transition-colors">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-xs font-bold text-white flex items-center gap-1.5">
                                        <i class="fa-solid fa-file-code text-purple-400"></i> Cache Tampilan (EJS Views)
                                    </h4>
                                    <span id="badge-views" class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= opt && opt.viewsCache ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-slate-800 text-slate-400 border border-slate-700' %>">
                                        <%= opt && opt.viewsCache ? '🟢 AKTIF' : '⚪ SIAP DIAKTIFKAN' %>
                                    </span>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-0.5">Kompilasi template EJS sekali di RAM tanpa baca disk.</p>
                            </div>
                            <button id="btn-views-cache" onclick="runOptimize('views-cache', this)" class="px-3 py-1.5 bg-purple-600/80 hover:bg-purple-600 text-white text-xs font-semibold rounded-lg transition-all flex items-center gap-1 shadow-sm shrink-0 cursor-pointer">
                                <span><%= opt && opt.viewsCache ? 'Segarkan' : 'Aktifkan' %></span>
                            </button>
                        </div>

                        <!-- Tool 4: Production Mode -->
                        <div class="p-3 bg-slate-950/50 rounded-xl border border-slate-800 flex items-center justify-between gap-3 hover:border-slate-700 transition-colors">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-xs font-bold text-white flex items-center gap-1.5">
                                        <i class="fa-solid fa-shield-halved text-emerald-400"></i> Mode Produksi (CBT High-Load)
                                    </h4>
                                    <span id="badge-prod" class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= opt && opt.productionMode ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-slate-800 text-slate-400 border border-slate-700' %>">
                                        <%= opt && opt.productionMode ? '🟢 PRODUKSI' : '⚪ DEVELOPMENT' %>
                                    </span>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-0.5">Matikan verbose debug logs untuk efisiensi CPU maksimal.</p>
                            </div>
                            <button id="btn-production-mode" onclick="runOptimize('production-mode', this)" class="px-3 py-1.5 bg-emerald-600/80 hover:bg-emerald-600 text-white text-xs font-semibold rounded-lg transition-all flex items-center gap-1 shadow-sm shrink-0 cursor-pointer">
                                <span><%= opt && opt.productionMode ? 'Re-Apply' : 'Set Mode' %></span>
                            </button>
                        </div>

                        <!-- Tool 5: Purge Temp Cache -->
                        <div class="p-3 bg-slate-950/50 rounded-xl border border-slate-800 flex items-center justify-between gap-3 hover:border-slate-700 transition-colors">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-xs font-bold text-white flex items-center gap-1.5">
                                        <i class="fa-solid fa-broom text-amber-400"></i> Bersihkan Memory Pool (Shrink)
                                    </h4>
                                    <span id="badge-purge" class="px-2 py-0.5 rounded-full text-[9px] font-semibold bg-amber-500/20 text-amber-400 border border-amber-500/30">🧹 READY</span>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-0.5">PRAGMA shrink_memory & optimasi SQLite query planner.</p>
                            </div>
                            <button id="btn-purge-cache" onclick="runOptimize('purge-cache', this)" class="px-3 py-1.5 bg-amber-600/80 hover:bg-amber-600 text-white text-xs font-semibold rounded-lg transition-all flex items-center gap-1 shadow-sm shrink-0 cursor-pointer">
                                <span>Bersihkan</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Toast / Status Notification -->
                <div id="optToast" class="mt-4 p-3.5 bg-emerald-500/15 border border-emerald-500/40 rounded-xl text-xs text-emerald-300 hidden flex items-start gap-2.5 shadow-lg">
                    <i class="fa-solid fa-circle-check text-base text-emerald-400 mt-0.5 shrink-0"></i>
                    <div>
                        <strong class="font-bold block text-white" id="optToastTitle">Optimasi Berhasil Dijalankan!</strong>
                        <span id="optToastText">Seluruh parameter cache telah dioptimasi.</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Client Script -->
    <script>
        let currentDiagnostics = <%- JSON.stringify(safeData || null) %>;
        let autoRefreshInterval = null;

        function setSliderVal(val) {
            const slider = document.getElementById('studentSlider');
            if (slider) {
                slider.value = val;
                updateSimulation(val);
            }
        }

        async function fetchDiagnostics() {
            const icon = document.getElementById('refreshIcon');
            if (icon) icon.classList.add('fa-spin');

            try {
                const res = await fetch('/api/system/capacity-diagnostics');
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                currentDiagnostics = data;
                renderDiagnostics(data);
            } catch (err) {
                console.error('Error fetching diagnostics:', err);
            } finally {
                if (icon) icon.classList.remove('fa-spin');
            }
        }

        function renderDiagnostics(data) {
            if (!data) return;
            const mem = data.memoryMetrics;
            const specs = data.serverSpecs;
            const db = data.databaseDiagnostics;
            const calc = data.capacityCalculator;
            const opt = data.optimizationStatus;

            // CBT & Database Real Asset Banner
            if (db) {
                document.getElementById('valDbSize').innerText = `${db.dbSizeMb} MB`;
                document.getElementById('valWalSize').innerText = `${db.walSizeMb} MB`;
                document.getElementById('valTotalStudents').innerText = `${db.totalStudents} Siswa`;
                document.getElementById('valTotalClasses').innerText = `${db.totalClasses} Kelas`;
                document.getElementById('valTotalQuestions').innerText = `${db.totalQuestions} Soal`;
                document.getElementById('valSubmittedExams').innerText = `${db.submittedExams} Berkas`;
            }

            // RAM
            if (mem) {
                document.getElementById('valRamUsed').innerText = `${mem.usedRamMb} / ${mem.totalRamMb} MB`;
                document.getElementById('valRamPercent').innerText = `${mem.ramUsagePercent}% RAM Terpakai`;
                document.getElementById('barRamUsage').style.width = `${mem.ramUsagePercent}%`;
                document.getElementById('valRamFree').innerText = `Bebas: ${mem.freeRamMb} MB`;
                document.getElementById('valNodeHeap').innerText = `Heap: ${mem.heapUsedMb} MB`;

                const bar = document.getElementById('barRamUsage');
                if (mem.ramUsagePercent > 85) {
                    bar.className = 'h-2 rounded-full bg-gradient-to-r from-red-500 to-rose-600 transition-all duration-500';
                } else if (mem.ramUsagePercent > 70) {
                    bar.className = 'h-2 rounded-full bg-gradient-to-r from-amber-500 to-yellow-500 transition-all duration-500';
                } else {
                    bar.className = 'h-2 rounded-full bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-500';
                }
            }

            // CPU
            if (specs) {
                document.getElementById('valCpuCores').innerText = `${specs.cpuCores} Core CPU`;
                document.getElementById('valCpuModel').innerText = specs.cpuModel;
                document.getElementById('valLoadAvg').innerText = `${specs.cpuUsagePercent}% Aktif`;
                document.getElementById('valUptime').innerText = specs.uptimeFormatted;

                document.getElementById('specPlatform').innerText = specs.platform;
                document.getElementById('specMemLimit').innerText = specs.phpMemoryLimitEquivalent;
                document.getElementById('specMaxTime').innerText = specs.maxExecutionTime;
                document.getElementById('specOsUptime').innerText = specs.osUptimeFormatted;
            }

            // Database Latency
            if (db) {
                const latEl = document.getElementById('valLatency');
                latEl.innerText = `${db.averageLatencyMs} ms`;
                document.getElementById('valLatencyStatus').innerText = db.latencyMessage;
                document.getElementById('valDbEngine').innerText = `WAL Mode • Sync ${db.pragmaSynchronous}`;
                document.getElementById('valPoolStatus').innerText = `${db.connectionStatus} (${db.poolHealth})`;

                if (db.averageLatencyMs > 20) {
                    latEl.className = 'text-2xl font-black text-rose-400 mt-1.5';
                } else if (db.averageLatencyMs > 5) {
                    latEl.className = 'text-2xl font-black text-amber-400 mt-1.5';
                } else {
                    latEl.className = 'text-2xl font-black text-emerald-400 mt-1.5';
                }
            }

            // Safe Concurrent Users
            if (calc) {
                document.getElementById('valSafeUsers').innerText = `${calc.safeConcurrentUsers} Siswa`;
                document.getElementById('valSessionRecommend').innerText = `Saran: ${calc.recommendedSessions} Sesi (${calc.baselineTotalStudents} Siswa)`;
                document.getElementById('valOngoingNow').innerText = `${calc.ongoingStudentsNow} Siswa`;
                document.getElementById('valWarningThreshold').innerText = `${calc.warningThreshold} Siswa`;
            }

            // Toolkit Badges & Buttons State
            if (opt) {
                if (opt.lastOptimizedAt) {
                    const timeEl = document.getElementById('valLastOptTime');
                    if (timeEl) timeEl.innerText = opt.lastOptimizedAt;
                }

                // Tool 1: Config
                const bConfig = document.getElementById('badge-config');
                const btnConfig = document.getElementById('btn-config-cache');
                if (bConfig) {
                    bConfig.className = opt.configCache ? 'px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'px-2 py-0.5 rounded-full text-[9px] font-semibold bg-slate-800 text-slate-400 border border-slate-700';
                    bConfig.innerText = opt.configCache ? '🟢 AKTIF (64MB)' : '⚪ BELUM AKTIF';
                }
                if (btnConfig) btnConfig.innerHTML = opt.configCache ? '<span>Segarkan</span>' : '<span>Aktifkan</span>';

                // Tool 2: Routes
                const bRoutes = document.getElementById('badge-routes');
                if (bRoutes) {
                    bRoutes.className = opt.routesCache ? 'px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'px-2 py-0.5 rounded-full text-[9px] font-semibold bg-slate-800 text-slate-400 border border-slate-700';
                    bRoutes.innerText = opt.routesCache ? '🟢 AKTIF' : '⚪ BELUM AKTIF';
                }

                // Tool 3: Views
                const bViews = document.getElementById('badge-views');
                const btnViews = document.getElementById('btn-views-cache');
                if (bViews) {
                    bViews.className = opt.viewsCache ? 'px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'px-2 py-0.5 rounded-full text-[9px] font-semibold bg-slate-800 text-slate-400 border border-slate-700';
                    bViews.innerText = opt.viewsCache ? '🟢 AKTIF' : '⚪ SIAP DIAKTIFKAN';
                }
                if (btnViews) btnViews.innerHTML = opt.viewsCache ? '<span>Segarkan</span>' : '<span>Aktifkan</span>';

                // Tool 4: Prod
                const bProd = document.getElementById('badge-prod');
                const btnProd = document.getElementById('btn-production-mode');
                if (bProd) {
                    bProd.className = opt.productionMode ? 'px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'px-2 py-0.5 rounded-full text-[9px] font-semibold bg-slate-800 text-slate-400 border border-slate-700';
                    bProd.innerText = opt.productionMode ? '🟢 PRODUKSI' : '⚪ DEVELOPMENT';
                }
                if (btnProd) btnProd.innerHTML = opt.productionMode ? '<span>Re-Apply</span>' : '<span>Set Mode</span>';
            }

            // Update simulation
            const slider = document.getElementById('studentSlider');
            if (slider) updateSimulation(slider.value);
        }

        function updateSimulation(count) {
            document.getElementById('sliderDisplayVal').innerText = `${count} Siswa`;
            if (!currentDiagnostics) return;

            const safeLimit = currentDiagnostics.capacityCalculator.safeConcurrentUsers;
            const ramEstMb = Math.round(count * 12);
            const cpuEstPercent = Math.min(100, Math.round((count / (currentDiagnostics.serverSpecs.cpuCores * 90)) * 100));

            document.getElementById('simRamEst').innerText = `~${(ramEstMb / 1024).toFixed(1)} GB`;
            document.getElementById('simCpuEst').innerText = `~${cpuEstPercent}%`;

            const box = document.getElementById('simResultBox');
            const icon = document.getElementById('simResultIcon');
            const title = document.getElementById('simResultTitle');
            const desc = document.getElementById('simResultDesc');
            const rec = document.getElementById('simRecSessions');

            if (count <= safeLimit * 0.8) {
                box.className = 'p-4 rounded-xl border transition-all bg-emerald-950/30 border-emerald-500/30 text-emerald-200';
                icon.className = 'fa-solid fa-circle-check text-xl text-emerald-400 mt-0.5';
                title.innerText = 'Kapasitas Server Sangat Aman';
                desc.innerText = `Server memiliki ruang memori & CPU sangat memadai untuk melayani ${count} siswa tanpa perlambatan.`;
                rec.innerText = '1 Sesi Bebas';
            } else if (count <= safeLimit) {
                box.className = 'p-4 rounded-xl border transition-all bg-amber-950/30 border-amber-500/30 text-amber-200';
                icon.className = 'fa-solid fa-triangle-exclamation text-xl text-amber-400 mt-0.5';
                title.innerText = 'Kapasitas Mendekati Batas Aman';
                desc.innerText = `Disarankan mengaktifkan fitur Cache Konfigurasi & View sebelum ujian ${count} siswa dimulai.`;
                rec.innerText = '1 Sesi Waspada';
            } else {
                box.className = 'p-4 rounded-xl border transition-all bg-rose-950/30 border-rose-500/30 text-rose-200';
                icon.className = 'fa-solid fa-circle-xmark text-xl text-rose-400 mt-0.5';
                title.innerText = 'Beban Melebihi Batas Aman! Risiko Crash';
                const neededSessions = Math.ceil(count / safeLimit);
                desc.innerText = `Jumlah ${count} siswa melebihi batas aman (${safeLimit} siswa). Sangat disarankan membagi ujian menjadi ${neededSessions} sesi.`;
                rec.innerText = `Wajib ${neededSessions} Sesi`;
            }
        }

        async function runOptimize(type, btn) {
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Memproses...</span>';

            try {
                const res = await fetch(`/api/system/optimize/${type}`, { method: 'POST' });
                const result = await res.json();

                const toast = document.getElementById('optToast');
                const toastTitle = document.getElementById('optToastTitle');
                const toastText = document.getElementById('optToastText');
                
                toast.classList.remove('hidden');
                toastTitle.innerText = type === 'optimize-all' ? '🚀 Semua Optimasi Berhasil Diaktifkan!' : 'Optimasi Berhasil Dijalankan!';
                toastText.innerText = result.message || 'Optimasi selesai!';

                if (result.updatedDiagnostics) {
                    currentDiagnostics = result.updatedDiagnostics;
                    renderDiagnostics(result.updatedDiagnostics);
                }

                setTimeout(() => {
                    toast.classList.add('hidden');
                }, 5000);
            } catch (e) {
                alert('Gagal menjalankan optimasi: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        // Setup auto refresh
        document.addEventListener('DOMContentLoaded', () => {
            if (currentDiagnostics) {
                renderDiagnostics(currentDiagnostics);
            }
            fetchDiagnostics();

            const toggle = document.getElementById('autoRefreshToggle');
            if (toggle) {
                toggle.addEventListener('change', (e) => {
                    if (e.target.checked) {
                        autoRefreshInterval = setInterval(fetchDiagnostics, 5000);
                    } else {
                        clearInterval(autoRefreshInterval);
                    }
                });
                autoRefreshInterval = setInterval(fetchDiagnostics, 5000);
            }
        });
    </script>
</body>
</html>
