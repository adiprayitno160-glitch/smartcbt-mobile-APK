<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Server Monitoring &amp; Diagnostik Real-Time - SmartSchool</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/design-system.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1120; color: #f8fafc; }
        .glass-card { background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(51, 65, 85, 0.7); backdrop-filter: blur(12px); border-radius: 18px; }
        .pulse-online { box-shadow: 0 0 12px rgba(16, 185, 129, 0.6); }
    </style>
</head>
<body class="flex min-h-screen">
    <%- include('partials/sidebar_admin') %>

    <main class="flex-1 p-4 md:p-8 ml-0 md:ml-64 transition-all">
        <!-- Top Navigation / Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-slate-800 gap-4">
            <div>
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">🖥️</span>
                    <h1 class="text-xl md:text-2xl font-black tracking-tight text-white">Live Server Monitoring &amp; Kontrol</h1>
                </div>
                <p class="text-xs md:text-sm text-slate-400 mt-1">Pemantauan metrik CPU, RAM, Disk, status service, dan audit backup jarak jauh tanpa SSH.</p>
            </div>
            <div class="flex items-center gap-3">
                <span id="liveStatusPill" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-950/80 text-emerald-400 border border-emerald-500/40 pulse-online">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                    <span>SERVER ONLINE</span>
                </span>
                <button onclick="fetchMetrics()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold shadow-lg transition-all flex items-center gap-2">
                    <span>🔄 Refresh</span>
                </button>
            </div>
        </div>

        <!-- Metric Gauges Overview -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-6">
            <!-- CPU Card -->
            <div class="glass-card p-5 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between text-slate-400 text-xs font-bold mb-2">
                        <span>CPU USAGE</span>
                        <span id="metricCpuBadge" class="text-amber-400 font-extrabold px-2 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-[10px]">⚡ Core Load</span>
                    </div>
                    <div class="flex items-baseline justify-between">
                        <div class="flex items-baseline gap-2">
                            <span id="metricCpu" class="text-3xl font-black text-amber-300 font-mono">0%</span>
                            <span id="metricCpuCores" class="text-xs text-indigo-300 font-bold">4 Cores</span>
                        </div>
                        <span id="metricCpuSpeed" class="text-[11px] font-mono text-slate-400">3.60 GHz</span>
                    </div>
                    <p id="metricCpuModel" class="text-[11px] text-slate-300 font-medium truncate mt-1" title="Intel(R) Core(TM) i3-4160 CPU @ 3.60GHz">Intel(R) Core(TM) i3-4160 CPU @ 3.60GHz</p>
                    <div class="w-full bg-slate-800 h-2.5 rounded-full mt-3 overflow-hidden">
                        <div id="barCpu" class="bg-gradient-to-r from-amber-500 to-yellow-400 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
                <!-- Per Core Mini Gauges -->
                <div id="perCoreGauges" class="grid grid-cols-4 gap-1.5 mt-3 pt-2.5 border-t border-slate-800/80 text-[10px] text-slate-400">
                    <div class="bg-slate-900/80 rounded px-1.5 py-1 text-center border border-slate-800"><div class="text-[9px] text-slate-400">C0</div><div class="font-mono font-bold text-amber-300">--%</div></div>
                    <div class="bg-slate-900/80 rounded px-1.5 py-1 text-center border border-slate-800"><div class="text-[9px] text-slate-400">C1</div><div class="font-mono font-bold text-amber-300">--%</div></div>
                    <div class="bg-slate-900/80 rounded px-1.5 py-1 text-center border border-slate-800"><div class="text-[9px] text-slate-400">C2</div><div class="font-mono font-bold text-amber-300">--%</div></div>
                    <div class="bg-slate-900/80 rounded px-1.5 py-1 text-center border border-slate-800"><div class="text-[9px] text-slate-400">C3</div><div class="font-mono font-bold text-amber-300">--%</div></div>
                </div>
            </div>

            <!-- RAM Card -->
            <div class="glass-card p-5">
                <div class="flex items-center justify-between text-slate-400 text-xs font-bold mb-2">
                    <span>RAM USAGE</span>
                    <span class="text-sky-400">🧠 Memory</span>
                </div>
                <div class="flex items-baseline gap-2">
                    <span id="metricRam" class="text-3xl font-black text-white">0%</span>
                    <span id="metricRamDetails" class="text-[11px] text-slate-400">0 / 0 MB</span>
                </div>
                <div class="w-full bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                    <div id="barRam" class="bg-sky-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
            </div>

            <!-- Disk Card -->
            <div class="glass-card p-5">
                <div class="flex items-center justify-between text-slate-400 text-xs font-bold mb-2">
                    <span>STORAGE USAGE</span>
                    <span class="text-emerald-400">💾 SQLite DB</span>
                </div>
                <div class="flex items-baseline gap-2">
                    <span id="metricDisk" class="text-3xl font-black text-white">0%</span>
                    <span class="text-[11px] text-slate-400">Storage Drive</span>
                </div>
                <div class="w-full bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                    <div id="barDisk" class="bg-emerald-500 h-full rounded-full transition-all duration-500" style="width: 45%"></div>
                </div>
            </div>

            <!-- Uptime Card -->
            <div class="glass-card p-5">
                <div class="flex items-center justify-between text-slate-400 text-xs font-bold mb-2">
                    <span>SYSTEM UPTIME</span>
                    <span class="text-amber-400">⏱️ Aktif</span>
                </div>
                <div class="flex items-baseline gap-2">
                    <span id="metricUptime" class="text-2xl font-black text-amber-300">Loading...</span>
                </div>
                <p id="metricActiveUsers" class="text-[11px] text-slate-400 mt-2">Active Users: 0 online</p>
            </div>
        </div>

        <!-- Services Health & Admin Controls -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
            <!-- Services Health -->
            <div class="glass-card p-6 lg:col-span-2">
                <h3 class="text-sm font-extrabold text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                    <span>🛡️ Status Layanan Utama (Services Health)</span>
                </h3>
                <div id="servicesContainer" class="space-y-3">
                    <div class="p-3 bg-slate-800/60 rounded-xl flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
                            <span class="font-bold text-sm">DATABASE (SQLite dev.db)</span>
                        </div>
                        <span class="text-xs bg-emerald-950 text-emerald-300 px-2.5 py-1 rounded-full font-bold">ONLINE (2ms)</span>
                    </div>
                </div>
            </div>

            <!-- Admin Sensitive Controls (RBAC Protected) -->
            <div class="glass-card p-6 border-indigo-500/30">
                <h3 class="text-sm font-extrabold text-indigo-300 uppercase tracking-wider mb-4 flex items-center gap-2">
                    <span>⚙️ Kontrol Sensitif Server (Admin Only)</span>
                </h3>
                <p class="text-xs text-slate-400 mb-4 leading-relaxed">
                    Aksi di bawah dilindungi role security. Hanya Administrator dengan kredensial penuh yang dapat mengeksekusi kontrol fisik server.
                </p>
                <div class="space-y-3">
                    <button onclick="triggerManualBackup()" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs transition-all shadow flex items-center justify-center gap-2">
                        <span>💾</span> <span>Trigger Backup Database Sekarang</span>
                    </button>
                    <button onclick="confirmRestartService()" class="w-full py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl text-xs transition-all shadow flex items-center justify-center gap-2">
                        <span>🔄</span> <span>Jadwalkan Restart API Service</span>
                    </button>
                    <button onclick="toggleMaintenanceMode()" class="w-full py-2.5 bg-rose-600/80 hover:bg-rose-700 text-white font-bold rounded-xl text-xs transition-all shadow flex items-center justify-center gap-2">
                        <span>🚧</span> <span>Toggle Mode Maintenance</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Database Backups Table -->
        <div class="glass-card p-6 mt-6">
            <h3 class="text-sm font-extrabold text-white uppercase tracking-wider mb-4 flex items-center justify-between">
                <span>📦 Riwayat Cadangan Database (SQLite Backups)</span>
                <button onclick="fetchBackups()" class="text-xs text-indigo-400 hover:underline">Perbarui List</button>
            </h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="py-2.5 px-3">Nama Berkas</th>
                            <th class="py-2.5 px-3">Ukuran</th>
                            <th class="py-2.5 px-3">Jenis</th>
                            <th class="py-2.5 px-3">Status</th>
                            <th class="py-2.5 px-3">Waktu Pembuatan</th>
                        </tr>
                    </thead>
                    <tbody id="backupTableBody" class="divide-y divide-slate-800/60 text-slate-300">
                        <tr>
                            <td colspan="5" class="py-4 text-center text-slate-500">Memuat riwayat backup...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        function getAuthHeader() {
            const token = localStorage.getItem('token') || '';
            return token ? { 'Authorization': 'Bearer ' + token } : {};
        }

        async function fetchMetrics() {
            try {
                const res = await fetch('/api/server-monitoring/metrics', {
                    headers: { ...getAuthHeader() }
                });
                if (!res.ok) return;
                const data = await res.json();
                if (data.success && data.server) {
                    const s = data.server;
                    document.getElementById('metricCpu').innerText = s.cpu.usagePercent + '%';
                    document.getElementById('metricCpuModel').innerText = s.cpu.model;
                    document.getElementById('metricCpuModel').title = s.cpu.model;
                    if (document.getElementById('metricCpuCores')) {
                        document.getElementById('metricCpuCores').innerText = `${s.cpu.cores} Cores`;
                    }
                    if (document.getElementById('metricCpuSpeed') && s.cpu.speedGhz) {
                        document.getElementById('metricCpuSpeed').innerText = s.cpu.speedGhz;
                    }
                    const barCpu = document.getElementById('barCpu');
                    if (barCpu) {
                        barCpu.style.width = Math.min(100, Math.max(3, s.cpu.usagePercent)) + '%';
                        if (s.cpu.usagePercent >= 85) {
                            barCpu.className = 'bg-gradient-to-r from-rose-500 to-red-600 h-full rounded-full transition-all duration-500';
                        } else if (s.cpu.usagePercent >= 70) {
                            barCpu.className = 'bg-gradient-to-r from-amber-500 to-yellow-400 h-full rounded-full transition-all duration-500';
                        } else {
                            barCpu.className = 'bg-gradient-to-r from-amber-500 to-yellow-400 h-full rounded-full transition-all duration-500';
                        }
                    }

                    // Render per-core breakdown
                    const perCoreContainer = document.getElementById('perCoreGauges');
                    if (perCoreContainer && Array.isArray(s.cpu.perCore) && s.cpu.perCore.length > 0) {
                        perCoreContainer.innerHTML = s.cpu.perCore.map((cLoad, idx) => `
                            <div class="bg-slate-900/80 rounded px-1.5 py-1 text-center border border-slate-800">
                                <div class="text-[9px] text-slate-400">C${idx}</div>
                                <div class="font-mono font-bold ${cLoad > 80 ? 'text-rose-400' : cLoad > 60 ? 'text-amber-300' : 'text-emerald-400'}">${cLoad}%</div>
                            </div>
                        `).join('');
                    }

                    document.getElementById('metricRam').innerText = s.ram.usagePercent + '%';
                    document.getElementById('metricRamDetails').innerText = `${s.ram.usedMb} / ${s.ram.totalMb} MB`;
                    document.getElementById('barRam').style.width = Math.min(100, s.ram.usagePercent) + '%';

                    document.getElementById('metricDisk').innerText = s.disk.usagePercent + '%';
                    document.getElementById('barDisk').style.width = s.disk.usagePercent + '%';

                    document.getElementById('metricUptime').innerText = s.uptimeFormatted;
                    document.getElementById('metricActiveUsers').innerText = `Active Users: ${s.activeUsers} online (15m)`;

                    // Render services
                    if (s.services) {
                        const container = document.getElementById('servicesContainer');
                        container.innerHTML = s.services.map(svc => `
                            <div class="p-3 bg-slate-800/60 rounded-xl flex items-center justify-between border border-slate-700/40">
                                <div class="flex items-center gap-3">
                                    <span class="w-2.5 h-2.5 rounded-full ${svc.status === 'ONLINE' ? 'bg-emerald-400' : 'bg-rose-400'}"></span>
                                    <span class="font-bold text-xs text-white">${svc.name}</span>
                                </div>
                                <span class="text-[11px] ${svc.status === 'ONLINE' ? 'bg-emerald-950/80 text-emerald-300' : 'bg-rose-950/80 text-rose-300'} px-2.5 py-0.5 rounded-full font-bold">
                                    ${svc.status} (${svc.latencyMs}ms)
                                </span>
                            </div>
                        `).join('');
                    }
                }
            } catch (e) {
                console.error('Failed fetching metrics', e);
            }
        }

        async function fetchBackups() {
            try {
                const res = await fetch('/api/server-monitoring/backups', {
                    headers: { ...getAuthHeader() }
                });
                if (!res.ok) return;
                const data = await res.json();
                const tbody = document.getElementById('backupTableBody');
                if (data.data && data.data.length > 0) {
                    tbody.innerHTML = data.data.map(b => `
                        <tr class="hover:bg-slate-800/30">
                            <td class="py-2.5 px-3 font-mono font-bold text-sky-300">${b.filename}</td>
                            <td class="py-2.5 px-3">${b.sizeKb} KB</td>
                            <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded text-[10px] bg-indigo-950 text-indigo-300 font-bold">${b.jenis}</span></td>
                            <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded text-[10px] bg-emerald-950 text-emerald-300 font-bold">${b.status}</span></td>
                            <td class="py-2.5 px-3 text-slate-400">${new Date(b.waktu).toLocaleString('id-ID')}</td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-slate-500">Belum ada riwayat backup cadangan.</td></tr>';
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function triggerManualBackup() {
            if (!confirm('Apakah Anda yakin ingin membuat salinan (backup) dev.db sekarang?')) return;
            try {
                const res = await fetch('/api/server-monitoring/control', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
                    body: JSON.stringify({ action: 'TRIGGER_BACKUP', reason: 'Manual backup from portal' })
                });
                const d = await res.json();
                alert(d.message || 'Proses backup selesai');
                fetchBackups();
            } catch (e) {
                alert('Gagal mengeksekusi backup: ' + e.message);
            }
        }

        async function confirmRestartService() {
            if (!confirm('PERINGATAN: Merestart service API akan memutuskan koneksi aktif sesaat. Lanjutkan?')) return;
            try {
                const res = await fetch('/api/server-monitoring/control', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
                    body: JSON.stringify({ action: 'RESTART_SERVICE', serviceName: 'API_SERVER', reason: 'Admin scheduled restart' })
                });
                const d = await res.json();
                alert(d.message);
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }

        async function toggleMaintenanceMode() {
            const pwd = prompt('Masukkan konfirmasi mode maintenance (Ketik "MAINTENANCE"):');
            if (pwd !== 'MAINTENANCE') return;
            try {
                const res = await fetch('/api/server-monitoring/control', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...getAuthHeader() },
                    body: JSON.stringify({ action: 'TOGGLE_MAINTENANCE', reason: 'Maintenance mode activated' })
                });
                const d = await res.json();
                alert(d.message);
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }

        // Auto fetch metrics every 8 seconds
        fetchMetrics();
        fetchBackups();
        setInterval(fetchMetrics, 8000);
    </script>
</body>
</html>
