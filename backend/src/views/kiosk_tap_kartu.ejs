<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kiosk Absensi Tap Kartu RFID & Barcode - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <style>
        @keyframes pulse-border {
            0%, 100% { border-color: rgba(59, 130, 246, 0.4); box-shadow: 0 0 25px rgba(59, 130, 246, 0.2); }
            50% { border-color: rgba(59, 130, 246, 0.9); box-shadow: 0 0 45px rgba(59, 130, 246, 0.5); }
        }
        .scanner-card {
            animation: pulse-border 2.5s infinite;
        }
    </style>
</head>
<body class="bg-slate-950 text-white min-h-screen flex flex-col font-sans select-none overflow-hidden" onclick="focusCardInput()">
    
    <!-- Top Header -->
    <header class="p-6 bg-slate-900/80 border-b border-slate-800 flex justify-between items-center backdrop-blur-md">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-blue-600 flex items-center justify-center text-2xl shadow-lg shadow-blue-500/30">
                💳
            </div>
            <div>
                <h1 class="text-xl font-black tracking-wide text-blue-400">KIOSK ABSENSI TAP KARTU SEKOLAH</h1>
                <p class="text-xs text-slate-400">SMP NEGERI 1 SMART SCHOOL &bull; Mendukung RFID Reader 13.56 MHz, 125 KHz &amp; Barcode NISN</p>
            </div>
        </div>

        <!-- Mode Toggle & Clock -->
        <div class="flex items-center gap-6">
            <!-- Mode Switcher -->
            <div class="bg-slate-950 p-1.5 rounded-2xl border border-slate-800 flex gap-1 text-xs font-bold">
                <button onclick="setGateMode('GATE_IN')" id="btnModeIn" class="px-4 py-2 rounded-xl bg-emerald-600 text-white shadow transition-all">
                    🟢 GATE-IN (Masuk)
                </button>
                <button onclick="setGateMode('GATE_OUT')" id="btnModeOut" class="px-4 py-2 rounded-xl text-slate-400 hover:text-white transition-all">
                    🔵 GATE-OUT (Pulang)
                </button>
            </div>

            <!-- Digital Clock -->
            <div class="text-right">
                <div class="text-2xl font-black font-mono tracking-wider text-emerald-400" id="liveClock">07:00:00 WIB</div>
                <div class="text-[11px] text-slate-400" id="liveDate">Senin, 28 Agustus 2026</div>
            </div>
        </div>
    </header>

    <!-- Main Dual Panel -->
    <main class="flex-1 grid grid-cols-1 lg:grid-cols-12 p-8 gap-8 items-center max-w-7xl mx-auto w-full">
        
        <!-- LEFT: Tap Target Display (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col items-center justify-center space-y-6">
            
            <!-- Hidden input that constantly captures USB RFID Reader & Barcode Scanner -->
            <input type="text" id="cardInput" class="opacity-0 absolute -top-96" autofocus autocomplete="off">

            <!-- Center Scanner Box -->
            <div class="w-full max-w-lg bg-slate-900/90 border-2 border-blue-500/50 rounded-3xl p-8 scanner-card text-center flex flex-col items-center justify-center relative overflow-hidden backdrop-blur-xl">
                
                <!-- Status Badge -->
                <div id="gateStatusBanner" class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs px-4 py-1.5 rounded-full font-bold uppercase tracking-widest mb-6">
                    🟢 SIAP SCAN: TEMPELKAN KARTU PELAJAR
                </div>

                <!-- Interactive Card Image / Animation -->
                <div id="cardAnimationBox" class="w-36 h-36 rounded-3xl bg-blue-600/10 border-2 border-dashed border-blue-400/40 flex items-center justify-center text-6xl text-blue-400 mb-6 shadow-inner transition-transform duration-300">
                    💳
                </div>

                <!-- Student Result Details (Populated on Tap) -->
                <div id="studentDetailArea" class="w-full space-y-3 hidden animate-fade-in">
                    <div class="w-20 h-20 rounded-2xl bg-blue-700 text-white font-black text-3xl flex items-center justify-center mx-auto shadow-lg" id="resStudentAvatar">
                        M
                    </div>
                    <div>
                        <h2 class="text-2xl font-black text-white" id="resStudentName">MERRI ROSA AMELIA</h2>
                        <p class="text-sm text-blue-300 font-semibold" id="resStudentMeta">Kelas VII-A &bull; NISN: 131412082</p>
                    </div>
                    <div class="pt-2">
                        <span id="resStatusBadge" class="bg-emerald-600 text-white text-sm font-black px-6 py-2 rounded-2xl shadow-lg inline-block">
                            HADIR TEPAT WAKTU (07:05 WIB)
                        </span>
                    </div>
                </div>

                <!-- Default Idle Instructions -->
                <div id="idleInstructionArea" class="space-y-2">
                    <h3 class="text-lg font-bold text-slate-200">Tempelkan Kartu RFID atau Arahkan Barcode</h3>
                    <p class="text-xs text-slate-400 max-w-xs mx-auto">Reader USB otomatis mendeteksi chip kartu siswa tanpa perlu menekan tombol keyboard.</p>
                </div>
            </div>

            <!-- Hint Status Connection -->
            <div class="flex items-center gap-3 text-xs text-slate-400 bg-slate-900/60 px-5 py-2.5 rounded-2xl border border-slate-800">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span>USB Reader Standby &bull; Auto-Focus Input Aktif</span>
            </div>
        </div>

        <!-- RIGHT: Live Activity Feed (5 Cols) -->
        <div class="lg:col-span-5 bg-slate-900/70 border border-slate-800 rounded-3xl p-6 h-[75vh] flex flex-col backdrop-blur-md">
            <div class="flex justify-between items-center pb-4 border-b border-slate-800 mb-4">
                <h3 class="font-black text-sm text-slate-200 flex items-center gap-2">
                    <span>📋</span> RIWAYAT TAP HARI INI
                </h3>
                <span id="tapCountBadge" class="bg-blue-600/30 text-blue-300 text-xs font-bold px-2.5 py-1 rounded-xl border border-blue-500/30">0 Siswa</span>
            </div>

            <!-- Feed List -->
            <div class="flex-1 overflow-y-auto space-y-3 pr-1" id="tapFeedList">
                <div class="text-center py-12 text-slate-500 text-xs">
                    Belum ada siswa yang tap kartu pada sesi ini.
                </div>
            </div>
        </div>
    </main>

    <script>
        let currentMode = 'GATE_IN';
        let recentTaps = [];
        const cardInput = document.getElementById('cardInput');

        // Clock & Date Live
        setInterval(() => {
            const now = new Date();
            document.getElementById('liveClock').innerText = now.toLocaleTimeString('id-ID', { hour12: false }) + ' WIB';
            document.getElementById('liveDate').innerText = now.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        }, 1000);

        function focusCardInput() {
            cardInput.focus();
        }

        // Keep input focused automatically for USB RFID Reader
        setInterval(() => {
            if (document.activeElement !== cardInput) {
                cardInput.focus();
            }
        }, 1000);

        function setGateMode(mode) {
            currentMode = mode;
            const btnIn = document.getElementById('btnModeIn');
            const btnOut = document.getElementById('btnModeOut');
            const banner = document.getElementById('gateStatusBanner');

            if (mode === 'GATE_IN') {
                btnIn.className = 'px-4 py-2 rounded-xl bg-emerald-600 text-white shadow transition-all';
                btnOut.className = 'px-4 py-2 rounded-xl text-slate-400 hover:text-white transition-all';
                banner.className = 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs px-4 py-1.5 rounded-full font-bold uppercase tracking-widest mb-6';
                banner.innerText = '🟢 SIAP SCAN: GATE-IN (MASUK SEKOLAH)';
            } else {
                btnOut.className = 'px-4 py-2 rounded-xl bg-blue-600 text-white shadow transition-all';
                btnIn.className = 'px-4 py-2 rounded-xl text-slate-400 hover:text-white transition-all';
                banner.className = 'bg-blue-500/20 text-blue-400 border border-blue-500/30 text-xs px-4 py-1.5 rounded-full font-bold uppercase tracking-widest mb-6';
                banner.innerText = '🔵 SIAP SCAN: GATE-OUT (KEPULANGAN)';
            }
            focusCardInput();
        }

        // Listen for USB Reader Enter Key
        cardInput.addEventListener('keypress', async (e) => {
            if (e.key === 'Enter') {
                const cardIdentifier = cardInput.value.trim();
                cardInput.value = '';
                if (cardIdentifier.length > 0) {
                    await processCardTap(cardIdentifier);
                }
            }
        });

        async function processCardTap(cardIdentifier) {
            try {
                const res = await fetch('/api/attendance/tap-card', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        cardIdentifier,
                        type: currentMode,
                        method: 'RFID'
                    })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    showStudentSuccess(data);
                    speakAttendance(data.student.name, data.status);
                    addToFeed(data);
                } else {
                    showErrorTap(data.message || 'Kartu Tidak Terdaftar');
                    speakText('Kartu tidak terdaftar');
                }
            } catch (err) {
                console.error(err);
                showErrorTap('Gagal terhubung ke server');
            }
        }

        function showStudentSuccess(data) {
            const s = data.student;
            document.getElementById('idleInstructionArea').classList.add('hidden');
            const detailArea = document.getElementById('studentDetailArea');
            detailArea.classList.remove('hidden');

            document.getElementById('resStudentAvatar').innerText = (s.name || 'S')[0];
            document.getElementById('resStudentName').innerText = s.name;
            document.getElementById('resStudentMeta').innerText = (s.className ? 'Kelas ' + s.className : 'Staff') + ' • NISN: ' + (s.nisn || '-');

            const badge = document.getElementById('resStatusBadge');
            if (data.isLate) {
                badge.className = 'bg-amber-600 text-white text-sm font-black px-6 py-2 rounded-2xl shadow-lg inline-block animate-bounce';
                badge.innerText = '⚠️ TERLAMBAT (' + data.scanTime + ' WIB)';
            } else {
                badge.className = currentMode === 'GATE_IN'
                    ? 'bg-emerald-600 text-white text-sm font-black px-6 py-2 rounded-2xl shadow-lg inline-block'
                    : 'bg-blue-600 text-white text-sm font-black px-6 py-2 rounded-2xl shadow-lg inline-block';
                badge.innerText = '✅ ' + data.status + ' (' + data.scanTime + ' WIB)';
            }

            // Auto-revert to idle after 4 seconds
            setTimeout(() => {
                detailArea.classList.add('hidden');
                document.getElementById('idleInstructionArea').classList.remove('hidden');
            }, 4000);
        }

        function showErrorTap(msg) {
            const banner = document.getElementById('gateStatusBanner');
            const origClass = banner.className;
            const origText = banner.innerText;

            banner.className = 'bg-red-500/30 text-red-300 border border-red-500/50 text-xs px-4 py-1.5 rounded-full font-bold uppercase tracking-widest mb-6 animate-pulse';
            banner.innerText = '❌ ' + msg;

            setTimeout(() => {
                banner.className = origClass;
                banner.innerText = origText;
            }, 3500);
        }

        function addToFeed(data) {
            recentTaps.unshift(data);
            if (recentTaps.length > 25) recentTaps.pop();
            renderFeed();
        }

        function renderFeed() {
            const container = document.getElementById('tapFeedList');
            document.getElementById('tapCountBadge').innerText = recentTaps.length + ' Siswa';

            container.innerHTML = recentTaps.map(item => {
                const s = item.student;
                const statusColor = item.isLate 
                    ? 'text-amber-400 bg-amber-500/20 border-amber-500/30' 
                    : (item.status.includes('PULANG') ? 'text-blue-400 bg-blue-500/20 border-blue-500/30' : 'text-emerald-400 bg-emerald-500/20 border-emerald-500/30');

                return `
                    <div class="bg-slate-950/70 p-3.5 rounded-2xl border border-slate-800 flex items-center justify-between shadow-sm">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-blue-600/30 text-blue-300 font-bold flex items-center justify-center text-sm border border-blue-500/30">
                                ${(s.name || 'S')[0]}
                            </div>
                            <div>
                                <p class="font-bold text-xs text-white">${s.name}</p>
                                <p class="text-[10px] text-slate-400">Kelas ${s.className || '-'} &bull; ${item.scanTime} WIB</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-extrabold px-2.5 py-1 rounded-xl border ${statusColor}">
                            ${item.status}
                        </span>
                    </div>
                `;
            }).join('');
        }

        function speakAttendance(name, status) {
            if ('speechSynthesis' in window) {
                const text = name + ', ' + status;
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'id-ID';
                utterance.rate = 1.05;
                window.speechSynthesis.speak(utterance);
            }
        }

        function speakText(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'id-ID';
                window.speechSynthesis.speak(utterance);
            }
        }
    </script>
</body>
</html>