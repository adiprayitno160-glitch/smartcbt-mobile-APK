{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "SmartSchool E-Commerce-Inspired Unified Design System",
  "version": "1.0.0",
  "description": "Centralized design tokens shared across all user roles (Siswa, Guru, Orang Tua, Operator, BK) and Web Portal",
  "colors": {
    "brand": {
      "primary": "#0D47A1",
      "primaryVariant": "#0A2E5C",
      "primaryLight": "#1E40AF",
      "primarySurface": "#EFF6FF",
      "secondary": "#0284C7",
      "secondaryLight": "#E0F2FE",
      "accent": "#2563EB"
    },
    "status": {
      "success": "#10B981",
      "successBg": "#ECFDF5",
      "warning": "#F59E0B",
      "warningBg": "#FFFBEB",
      "danger": "#EF4444",
      "dangerBg": "#FEF2F2",
      "info": "#3B82F6",
      "infoBg": "#EFF6FF",
      "neutral": "#64748B",
      "neutralBg": "#F1F5F9"
    },
    "surface": {
      "background": "#F8FAFC",
      "card": "#FFFFFF",
      "cardElevated": "#FFFFFF",
      "border": "#E2E8F0",
      "borderLight": "#F1F5F9",
      "divider": "#E2E8F0"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "muted": "#94A3B8",
      "inverse": "#FFFFFF",
      "link": "#0284C7"
    },
    "roles": {
      "student": "#0284C7",
      "teacher": "#0D47A1",
      "operator": "#4F46E5",
      "counselor": "#0D9488",
      "parent": "#059669",
      "medical": "#DC2626"
    }
  },
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "scale": {
      "display": { "size": "24px", "lineHeight": "32px", "weight": "700" },
      "h1": { "size": "20px", "lineHeight": "28px", "weight": "700" },
      "h2": { "size": "18px", "lineHeight": "24px", "weight": "600" },
      "h3": { "size": "16px", "lineHeight": "22px", "weight": "600" },
      "bodyLarge": { "size": "15px", "lineHeight": "22px", "weight": "400" },
      "body": { "size": "14px", "lineHeight": "20px", "weight": "400" },
      "bodySmall": { "size": "12px", "lineHeight": "16px", "weight": "400" },
      "caption": { "size": "11px", "lineHeight": "14px", "weight": "500" },
      "badge": { "size": "10px", "lineHeight": "12px", "weight": "600" }
    }
  },
  "spacing": {
    "none": "0px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "32px"
  },
  "radius": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04)",
    "card": "0 2px 8px rgba(15, 23, 42, 0.06)"
  },
  "navigation": {
    "bottomNavItems": {
      "STUDENT": ["Beranda", "Tugas", "Absensi", "Pesan", "Profil"],
      "TEACHER": ["Beranda", "Kelas Saya", "Tugas/CBT", "Pesan", "Profil"],
      "PARENT": ["Beranda", "Akademik", "Kesehatan/BK", "Pesan", "Profil"],
      "OPERATOR": ["Beranda", "Modul", "Pengumuman", "Server", "Profil"],
      "COUNSELOR": ["Beranda", "Kasus", "Kalender", "Pesan", "Profil"]
    }
  }
}
