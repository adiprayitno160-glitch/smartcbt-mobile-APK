generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique // NISN for students, NIP/Username for staff
  password         String
  name             String
  role             String       // ADMIN, OPERATOR, TEACHER, COUNSELOR, MEDICAL, LIBRARIAN, STUDENT, PARENT
  deviceBindingId  String?      // Android ID for device locking
  rfidChipUid      String?      @unique
  profilePicUrl    String?
  isActive         Boolean      @default(true)
  lastLogin        DateTime?
  
  // Student Specific
  nis              String?
  nisn             String?
  gender           String?
  religion         String?
  pob              String?
  dob              String?
  address          String?
  fatherName       String?
  motherName       String?
  className        String?
  classId          String?
  class            Class?       @relation(fields: [classId], references: [id])
  parentPhone      String?
  bloodType        String?
  allergies        String?
  points           Int          @default(0)
  homeroomTeacher  String?
  counselorTeacher String?
  classRole        String?      // Ketua Kelas, Wakil, Sekretaris, Bendahara

  // Teacher Specific (Classes & Subject Taught)
  teachingClasses  String?      // e.g. "VII-A,VII-B" (Only classes taught by this teacher)
  teachingSubject  String?      // e.g. "Matematika"

  // Anthropometry / Health Snapshot
  latestHeightCm   Float?
  latestWeightKg   Float?
  latestBmi        Float?
  nutritionalStatus String? // UNDERWEIGHT, NORMAL, OVERWEIGHT, OBESE

  // Relationships
  attendances          Attendance[]
  examsTaken           StudentExam[]
  submissions          HomeworkSubmission[]
  medicalVisits        UksVisit[]
  healthMeasurements   StudentHealthMeasurement[]
  piketSchedules       PiketSchedule[]
  borrowedBooks        LibraryBorrowing[]
  consultationsAsStudent BkConsultation[] @relation("StudentConsultations")
  consultationsAsCounselor BkConsultation[] @relation("CounselorConsultations")
  disciplineRecords    DisciplineRecord[]
  warningLetters       DisciplineWarningLetter[]
  counselingSessions   CounselingSession[] @relation("StudentCounselingSessions")
  careerAssessments    CareerAssessment[]  @relation("StudentCareerAssessments")
  eFiles               EFile[]
  devices              DeviceSession[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Class {
  id              String   @id @default(uuid())
  name            String   @unique // e.g., "VII-A"
  barcodeCode     String?  @unique // Static barcode for gate in/out
  gateInBarcode   String?  // e.g., "GATE_IN_VII-A"
  gateOutBarcode  String?  // e.g., "GATE_OUT_VII-A"
  lat             Float?   @default(-8.125506) // Titik koordinat GPS ruang kelas resmi SMPN 1 Boyolangu
  lng             Float?   @default(111.893526)
  radiusMeters    Int      @default(10)      // Toleransi maksimal geofence (10 meter)
  isGpsLocked     Boolean  @default(false)   // Status kunci titik koordinat GPS kelas (Lock/Unlock)
  counselorId     String?  // ID Guru BK pengampu kelas ini
  counselorName   String?  // Nama Guru BK pengampu kelas ini
  officers        String?  // JSON string storing class officer assignments
  users           User[]
  homeworks       Homework[]
}

model SchoolHoliday {
  id                String   @id @default(uuid())
  date              String   @unique // Format "YYYY-MM-DD"
  name              String   // Cth: "Cuti Bersama Hari Raya", "Libur Situasi Banjir"
  description       String?  // Keterangan situasi / surat edaran
  isNationalHoliday Boolean  @default(false)
  createdBy         String?  // Username operator/admin
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GateSetting {
  id                  String   @id @default("default")
  gateInStartTime     String   @default("06:00") // Jam mulai buka gerbang masuk
  gateInEndTime       String   @default("07:00") // Batas waktu masuk tepat waktu (07:00)
  gateInMaxTime       String   @default("07:15") // Batas toleransi terlambat (07:15) -> lewat ini LOCK
  gateOutStartTime    String   @default("14:00") // Jam kepulangan normal dibuka
  gateOutEndTime      String   @default("17:00") // Batas akhir kepulangan normal
  isEmergencyGateOut  Boolean  @default(false)   // Mode Darurat (Buka semua gateout)
  isEarlyDismissal    Boolean  @default(false)   // Pulang Lebih Awal (Buka semua gateout)
  emergencyReason     String?
  dailySchedule       String?  // JSON string konfigurasi jadwal jam masuk & pulang per hari (Senin - Minggu)
  updatedBy           String?
  updatedAt           DateTime @updatedAt
}

model Attendance {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String   // GATE_IN, GATE_OUT
  method          String   // RFID, BARCODE, GPS
  status          String   // PRESENT, LATE, ABSENT, SICK, PERMISSION
  scanTime        DateTime @default(now())
  lat             Float?
  lng             Float?
  isFakeGps       Boolean  @default(false)
  photoUrl        String?
  note            String?
}

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  exams       Exam[]
  homeworks   Homework[]
}

model Exam {
  id                  String   @id @default(uuid())
  title               String
  subjectId           String
  subject             Subject  @relation(fields: [subjectId], references: [id])
  token               String   @unique
  isTokenActive       Boolean  @default(false)
  durationMinutes     Int
  minDurationMinutes  Int      @default(30)
  startTime           DateTime?
  endTime             DateTime?
  assignedClasses     String?  // JSON string or comma-separated e.g. "VII-A,VII-B" or "ALL"
  sessionName         String?  // e.g. "Sesi 1 (Pagi)"
  executionDate       String?  // e.g. "2026-08-30"
  startTimeStr        String?  // e.g. "07:30"
  endTimeStr          String?  // e.g. "09:30"
  randomizeQuestions  Boolean  @default(true)
  randomizeOptions    Boolean  @default(true)
  showScoreToStudent  Boolean  @default(false)
  maxStrikes          Int      @default(3)
  examType            String?  @default("SAS") // SAS, STS, SAT, FORMATIF, TRYOUT, US
  roomName            String?  @default("Lab Komputer 1")
  proctorName         String?  @default("Proktor Utama")
  passingGrade        Int?     @default(75)
  level               String?  @default("ALL") // VII, VIII, IX, ALL
  teacherId           String?  // Guru pembuat ujian
  questions           Question[]
  studentExams        StudentExam[]
  createdAt           DateTime @default(now())
}

model Question {
  id              String   @id @default(uuid())
  examId          String
  exam            Exam     @relation(fields: [examId], references: [id])
  type            String   // MULTIPLE_CHOICE, ESSAY
  content         String
  imageUrl        String?  // Media gambar (Diagram/Foto)
  audioUrl        String?  // Media suara (Listening/Audio Quran/Dikte)
  mediaType       String?  // IMAGE, AUDIO, BOTH, NONE
  correctOption   String?  // A, B, C, D
  options         String?  // JSON string
  orderNum        Int
  cognitiveLevel  String?  @default("C3") // C1, C2, C3, C4, C5, C6
  kdTag           String?  // e.g. "KD 3.1"
}

model StudentExam {
  id               String   @id @default(uuid())
  examId           String
  exam             Exam     @relation(fields: [examId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  startTime        DateTime @default(now())
  endTime          DateTime?
  status           String   // ONGOING, SUBMITTED, LOCKED
  strikeCount      Int      @default(0) // Fraud detection
  score            Float?
  answers          String?  // JSON string of StudentAnswers
}

model Homework {
  id           String   @id @default(uuid())
  title        String
  description  String
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  classId      String
  class        Class    @relation(fields: [classId], references: [id])
  startTime    DateTime? // Waktu mulai pengerjaan tugas dibuka
  endTime      DateTime? // Batas akhir pengerjaan tugas
  deadline     DateTime
  type         String?  @default("ESSAY") // ESSAY, MULTIPLE_CHOICE, MIXED
  questions    String?  // JSON string butir soal CBT sederhana: [{ id, question, options: ["A", "B", "C", "D"], correctOption: "A", type: "PG" | "ESSAY" }]
  fileUrl      String?  // Dokumen / Gambar lampiran tugas
  audioUrl     String?  // Instruksi audio / Listening tugas
  weight       Int?     @default(100) // Bobot nilai
  category     String?  @default("PR") // PR, TUGAS_HARIAN, PROYEK, ULANGAN_HARIAN
  isTemplate   Boolean  @default(false)
  teacherId    String?  // Guru pemberi tugas
  submissions  HomeworkSubmission[]
  createdAt    DateTime @default(now())
}

model HomeworkSubmission {
  id           String   @id @default(uuid())
  homeworkId   String
  homework     Homework @relation(fields: [homeworkId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  answers      String?  // JSON string jawaban siswa: { "1": "A", "2": "B", "essay": "..." }
  autoScore    Float?   // Nilai otomatis untuk pilihan ganda
  fileUrl      String?
  submittedAt  DateTime @default(now())
  isLate       Boolean  @default(false)
  score        Float?
  teacherNote  String?
}

model BkConsultation {
  id           String    @id @default(uuid())
  studentId    String
  student      User      @relation("StudentConsultations", fields: [studentId], references: [id])
  counselorId  String?
  counselor    User?     @relation("CounselorConsultations", fields: [counselorId], references: [id])
  category     String    @default("LAINNYA") // BULLYING, PRIBADI, TEMAN, KELUARGA, LAINNYA
  subject      String
  message      String
  replyMessage String?   // Tanggapan / Balasan dari Guru BK
  replyDate    DateTime?
  status       String    @default("PENDING") // PENDING, REPLIED, SCHEDULED, RESOLVED
  isAnonymous  Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model DisciplineRecord {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String   // PRESTASI, PELANGGARAN
  category      String   @default("RINGAN") // RINGAN, SEDANG, BERAT, SANGAT_BERAT
  description   String
  chronology    String?  // Kronologi detail kejadian
  sanction      String?  // Sanksi yang dijatuhkan
  sanctionLevel String   @default("PENDING") // PENDING, DIPROSES_BK, SP1, SP2, SP3_SKORSING, RESOLVED
  bapNumber     String?  // Nomor Berita Acara Pelanggaran
  evidenceUrl   String?  // Foto bukti
  reportedBy    String?  // Pihak pelapor
  points        Int
  createdAt     DateTime @default(now())
}

model CounselingSession {
  id                 String   @id @default(uuid())
  studentId          String
  student            User     @relation("StudentCounselingSessions", fields: [studentId], references: [id])
  counselorId        String?
  counselorName      String?
  type               String   // INDIVIDU, KELOMPOK, KARIR, AKADEMIK, PERILAKU
  topic              String
  problemDescription String
  solutionPlan       String?
  followUpAction     String?
  status             String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  sessionDate        DateTime @default(now())
  createdAt          DateTime @default(now())
}

model CareerAssessment {
  id                 String   @id @default(uuid())
  studentId          String
  student            User     @relation("StudentCareerAssessments", fields: [studentId], references: [id])
  academicYear       String
  interestFields     String   // JSON string: STEM, Sosial, Bahasa, Seni, Vokasi
  recommendedMajors  String   // JSON string: SMA IPA/IPS, SMK Rekayasa/Bisnis, dll.
  psychologicalNotes String?
  createdAt          DateTime @default(now())
}



model UksVisit {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  category           String   @default("LAINNYA") // PINGSAN, DEMAM, CEDERA_LUKA, MAAG_PERUT, PUSING, SESAK_NAFAS, LAINNYA
  isFainting         Boolean  @default(false)
  faintCountSnapshot Int      @default(1)
  incidentLocation   String?  @default("Ruang Kelas") // Lapangan Upacara, Ruang Kelas, Lab IPA, Kantin, dll.
  temperature        Float?
  bloodPressure      String?
  bedNumber          String?  // Bed 01, Bed 02, Bed 03, Bed 04
  disposition        String   @default("REST_AT_UKS") // REST_AT_UKS, BACK_TO_CLASS, SENT_HOME, REFERRED_HOSPITAL
  complaint          String
  diagnosis          String?  // Diagnosa medis petugas / dokter
  treatment          String?
  medicine           String?
  officerName        String?  @default("Petugas UKS")
  restNotes          String?  // Catatan istirahat / anjuran istirahat di UKS
  parentNotified     Boolean  @default(false)
  counselorAlerted   Boolean  @default(false)
  checkInTime        DateTime @default(now())
  checkOutTime       DateTime?
}

model StudentHealthMeasurement {
  id                 String   @id @default(uuid())
  studentId          String
  student            User     @relation(fields: [studentId], references: [id])
  heightCm           Float    // Tinggi badan (cm)
  weightKg           Float    // Berat badan (kg)
  bmiValue           Float    // IMT
  nutritionalStatus  String   // UNDERWEIGHT, NORMAL, OVERWEIGHT, OBESE
  academicPeriod     String?  // e.g. "Semester Ganjil 2025/2026"
  notes              String?  // Saran gizi
  measuredBy         String?  // Petugas UKS
  createdAt          DateTime @default(now())
}

model PiketSchedule {
  id          String   @id @default(uuid())
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  dayOfWeek   Int      // 1 = Senin, 2 = Selasa, 3 = Rabu, 4 = Kamis, 5 = Jumat, 6 = Sabtu
  dayName     String   // "SENIN", "SELASA", "RABU", dst.
  startTime   String?  @default("06:30")
  endTime     String?  @default("15:00")
  notes       String?  // Contoh: "Koordinator Piket", "Lantai 1"
  isActive    Boolean  @default(true)
  createdBy   String?  // Username operator
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model LibraryBook {
  id            String   @id @default(uuid())
  title         String
  author        String
  publisher     String?  @default("Kemendikbudristek")
  yearPublished String?
  isbn          String?
  barcodeCode   String   @unique
  stock         Int      @default(1)
  subject       String?  // Matematika, IPA, IPS, Bahasa Indonesia, dll.
  gradeClass    String?  // VII, VIII, IX, UMUM
  category      String   @default("BUKU_PAKET") // BUKU_PAKET, REFERENSI, DIGITAL_EBOOK
  curriculum    String?  @default("Kurikulum Merdeka") // Kurikulum Merdeka, Kurikulum 2013, dll.
  semester      String?  @default("1 Tahun") // Semester 1, Semester 2, 1 Tahun
  coverUrl      String?
  ebookUrl      String?
  copies        BookCopy[]
  borrowings    LibraryBorrowing[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model BookCopy {
  id                  String   @id @default(uuid())
  bookId              String
  book                LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  barcodeCode         String   @unique // Misal: BKP-MAT7-001 (Barcode fisik di cover)
  copyNumber          Int      // 1, 2, 3...
  condition           String   @default("BAIK") // BAIK, RUSAK_RINGAN, RUSAK_BERAT, HILANG
  status              String   @default("AVAILABLE") // AVAILABLE, BORROWED, LOST
  
  // Tracking Peminjam Aktif Saat Ini
  currentBorrowerId   String?
  currentBorrowerName String?
  currentBorrowerClass String?
  currentBorrowerNisn String?
  borrowedAt          DateTime?
  dueDate             DateTime?
  
  borrowHistory       LibraryBorrowing[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

model LibraryBorrowing {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  bookId       String
  book         LibraryBook @relation(fields: [bookId], references: [id])
  bookCopyId   String?
  bookCopy     BookCopy?   @relation(fields: [bookCopyId], references: [id])
  barcodeCode  String?
  borrowDate   DateTime @default(now())
  dueDate      DateTime
  returnDate   DateTime?
  status       String   // BORROWED, RETURNED, TRANSFERRED, LATE
  notes        String?  // Catatan mutasi peminjam
  createdAt    DateTime @default(now())
}

model Settings {
  id           String   @id @default(uuid())
  key          String   @unique
  value        String
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("UMUM") // UMUM, PENTING, UJIAN, KEGIATAN
  author    String   @default("Admin")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EFile {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String   // e.g. "Rapor Semester Ganjil 2025/2026"
  category    String   // KEPENDUDUKAN, PRESTASI, AKADEMIK, SURAT, LAINNYA
  fileUrl     String
  fileSize    String?  // e.g. "1.2 MB"
  fileType    String?  @default("PDF") // PDF, IMAGE
  description String?
  isFromAdmin Boolean? @default(false)
  senderName  String?
  source      String?
  period      String?
  isRead      Boolean? @default(false)
  readAt      DateTime?
  uploadedAt  DateTime @default(now())
}

model DeviceSession {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  deviceAndroidId  String       @unique // Android ID unik per device
  deviceName       String       // Nama device user
  deviceModel      String       // Model HP (e.g. "Samsung Galaxy A54")
  deviceBrand      String       // Brand HP (e.g. "Samsung")
  deviceOsVersion  String?      // Android version
  appVersion       String       // Versi APK
  lastKnownIp      String?      // IP address terakhir
  storagePath      String?      // External storage path
  batteryLevel     Int?         // Persentase baterai 0-100
  isCharging       Boolean?     // Status charging
  totalStorage     BigInt?      // Total storage internal (bytes)
  freeStorage      BigInt?      // Free storage internal (bytes)
  totalSdCard      BigInt?      // Total SD card (bytes)
  freeSdCard       BigInt?      // Free SD card (bytes)
  wifiSsid         String?      // Nama WiFi yang terhubung
  status           String       @default("ONLINE") // ONLINE, OFFLINE, BLOCKED
  lastSeen         DateTime     @default(now())
  registeredAt     DateTime     @default(now())
  files            DeviceFile[]
  copyRequests     CopyRequest[]

  @@index([status, lastSeen])
  @@index([userId])
}

model DeviceFile {
  id              String   @id @default(uuid())
  deviceId        String
  device          DeviceSession @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  fileName        String
  filePath        String   // Full path di device
  fileExtension   String?  // e.g. "pdf", "jpg", "mp4"
  fileSize        Int      // Size in bytes
  fileSizeHuman   String   // e.g. "1.5 MB"
  mimeType        String?  // e.g. "application/pdf"
  category        String   // IMAGE, VIDEO, AUDIO, DOCUMENT, APK, ARCHIVE, OTHER
  lastModified    DateTime
  syncedAt        DateTime @default(now())
  thumbnailBase64 String?  // Base64 mini thumbnail untuk instant visual preview

  @@unique([deviceId, filePath])
  @@index([deviceId])
  @@index([deviceId, category])
  @@index([lastModified])
}

model CopyRequest {
  id              String   @id @default(uuid())
  deviceId        String
  device          DeviceSession @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  filePath        String   // Path file yang ingin di-copy
  fileName        String
  status          String   @default("PENDING") // PENDING, UPLOADING, COMPLETED, FAILED
  uploadPath      String?  // Path file setelah di-upload ke server
  fileSize        Int?
  requestedBy     String   // Admin userId
  requestedAt     DateTime @default(now())
  completedAt     DateTime?
  errorMessage    String?

  @@index([deviceId, status])
  @@index([status])
}


model TeacherJournal {
  id              String   @id @default(uuid())
  teacherId       String
  teacherName     String
  className       String
  subjectName     String
  topic           String
  competencyCode  String?  // e.g. "KD 3.4"
  description     String
  photoUrl        String?  // Foto papan tulis / suasana kelas
  teachingDate    DateTime @default(now())
  presentCount    Int      @default(0)
  absentCount     Int      @default(0)
  lateCount       Int      @default(0)
  createdAt       DateTime @default(now())
}

model DynamicQrSession {
  id              String   @id @default(uuid())
  teacherId       String
  className       String
  subjectName     String
  qrToken         String   @unique
  expiresAt       DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userName    String?
  role        String?
  action      String   // e.g. "AI_EXTRACT_EXAM", "CONFIRM_AI_EXAM", "FORCE_SUBMIT", "SCHEDULE_EXAM", "RESET_SESSION", "DELETE_EXAM"
  target      String?  // e.g. "Exam: Matematika", "Student: 0098231234"
  details     String?  // JSON metadata or human readable description
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model StudentLeaveRequest {
  id            String   @id @default(uuid())
  studentId     String
  studentName   String
  className     String
  parentName    String
  parentPhone   String?
  category      String   // SICK (Sakit), PERMISSION (Izin Keluarga), DISPENSATION (Dispensasi)
  startDate     DateTime
  endDate       DateTime
  reason        String
  attachmentUrl String?  // Foto surat dokter / surat izin orang tua
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedBy    String?  // Nama Wali Kelas / Guru BK
  verifiedAt    DateTime?
  rejectionNote String?
  createdAt     DateTime @default(now())
}
model EmptyClassReport {
  id                String   @id @default(uuid())
  className         String   // e.g. "VII-A"
  periodLesson      String   // e.g. "Jam ke 3-4 (08:40 - 10:00)"
  subjectName       String   // e.g. "Matematika"
  scheduledTeacher  String   // e.g. "Bpk. Budi Santoso, S.Pd"
  teacherStatus     String   @default("BELUM_HADIR") // BELUM_HADIR, SAKIT, DINAS_LUAR, IZIN
  hasAssignment     Boolean  @default(false)
  assignmentDetails String?  // e.g. "Mengerjakan LKS Halaman 45 Nomor 1-10"
  status            String   @default("PENDING") // PENDING, GURU_INVAL_ASSIGNED, TUGAS_MANDIRI, RESOLVED
  substituteTeacher String?  // Nama Guru Inval yang menggantikan
  substituteNotes   String?
  handledBy         String?
  handledAt         DateTime?
  journalId         String?  // Relasi sinkronisasi ke Jurnal Mengajar Harian
  reporterName      String?  // e.g. "Ketua Kelas a.n. Ahmad Fauzi (VII-A)"
  createdAt         DateTime @default(now())
}

model AppVersionConfig {
  id            String   @id @default("latest")
  versionCode   Int      @default(13)
  versionName   String   @default("2.8.5")
  downloadUrl   String   @default("/uploads/SmartSchool_CBT_Release.apk")
  fileSizeMb    Float    @default(8.5)
  releaseNotes  String   @default("Fitur Lengkap: Perpustakaan Barcode/QR, SMARTUKS, Portal BK Poin/SP, Modul Tugas & PR")
  isForceUpdate Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model Medicine {
  id            String    @id @default(uuid())
  name          String    @unique // e.g. "Paracetamol 500mg"
  type          String    @default("TABLET") // TABLET, SIRUP, KRIM, INJEKSI, PERBAN, OBAT_LUAR
  dose          String?   // e.g. "500 mg", "10 ml"
  stock         Int       @default(0)
  unit          String    @default("tablet") // tablet, botol, strip, pcs, sachet
  expiryDate    DateTime?
  minStockAlert Int       @default(10)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DisciplineCategory {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "Terlambat masuk kelas (>= 15 menit)"
  points      Int      // e.g. 5, 10, 30, 40, 50
  category    String   @default("RINGAN") // RINGAN, SEDANG, BERAT
  createdAt   DateTime @default(now())
}

model DisciplineWarningLetter {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  spLevel     String   // SP1, SP2, SP3
  totalPoints Int
  letterNo    String   @unique // e.g. "421.3/SP-01/SMP1/IX/2026"
  pdfUrl      String?
  issuedAt    DateTime @default(now())
}

model OfficialLetter {
  id          String   @id @default(uuid())
  letterNo    String   // Nomor surat resmi (cth: 421.3/128/SMPN1/2026)
  title       String   // Perihal / Judul Surat
  content     String   // Ringkasan / Isi Surat
  targetType  String   // ALL, GRADE, CLASS, STUDENT
  targetValue String?  // ALL (null/kosong), GRADE ("7","8","9"), CLASS ("VII-A"), STUDENT (userId / NISN)
  fileUrl     String   // URL file PDF surat resmi
  fileSize    String?  // e.g. "1.2 MB"
  senderRole    String   @default("ADMIN") // ADMIN, OPERATOR
  senderName    String   @default("Tata Usaha & Kepala Sekolah")
  confirmations LetterConfirmation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LetterConfirmation {
  id          String   @id @default(uuid())
  letterId    String
  letter      OfficialLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  parentId    String
  studentId   String
  parentName  String
  studentName String
  status      String   @default("CONFIRMED") // CONFIRMED, REJECTED
  notes       String?
  confirmedAt DateTime @default(now())
}

model NotificationMessage {
  id             String   @id @default(uuid())
  recipientId    String?  // userId if exists
  recipientPhone String?
  recipientRole  String   @default("PARENT") // PARENT, STUDENT, TEACHER
  studentId      String?
  studentName    String?
  className      String?
  title          String
  message        String
  category       String   @default("ATTENDANCE") // ATTENDANCE, DISCIPLINE, EXAM, ACADEMIC, ANNOUNCEMENT
  isRead         Boolean  @default(false)
  sentAt         DateTime @default(now())
}

model BapReport {
  id              String   @id @default(uuid())
  examId          String
  examTitle       String
  subject         String
  className       String
  level           String?
  proctorId       String?
  proctorName     String
  roomName        String?
  totalRegistered Int      @default(0)
  totalPresent    Int      @default(0)
  totalAbsent     Int      @default(0)
  absentList      String?
  incidentNotes   String?
  signedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
}

model ClassPeriodSchedule {
  id              String   @id @default(uuid())
  day             String   // Senin, Selasa, Rabu, Kamis, Jumat, Sabtu
  periodIndex     Int      // 1, 2, 3, 4, 5, 6, 7, 8 (Jam ke-...)
  startTime       String   // e.g. "07:00"
  endTime         String   // e.g. "07:45"
  className       String   // e.g. "VII-A"
  subjectName     String   // e.g. "Matematika"
  teacherId       String?
  teacherName     String   // e.g. "Bpk. Budi Santoso, S.Pd"
  roomName        String?  // e.g. "Ruang Kelas 7A"
  isBreak         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClassPeriodSession {
  id              String   @id @default(uuid())
  scheduleId      String?
  teacherId       String
  teacherName     String
  className       String   // e.g. "VII-A"
  subjectName     String   // e.g. "Matematika"
  periodIndex     Int      @default(1)
  timeRange       String?  // e.g. "07:00 - 07:45"
  startTimeStr    String?  // e.g. "07:00"
  endTimeStr      String?  // e.g. "07:45"
  roomName        String?  // e.g. "Ruang Kelas 7A"
  inTime          DateTime @default(now())
  outWindowStart  DateTime?
  endTime         DateTime?
  status          String   @default("ACTIVE") // ACTIVE, CLOSED, AUTO_CLOSED
  totalStudents   Int      @default(0)
  studentOutCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  attendances     ClassPeriodAttendance[]
}

model ClassPeriodAttendance {
  id              String             @id @default(uuid())
  sessionId       String
  session         ClassPeriodSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId       String
  studentName     String
  className       String
  outTime         DateTime?
  status          String             @default("PRESENT") // PRESENT, TRUANT, AUTO_PRESENT
  method          String             @default("1_TAP_OUT") // 1_TAP_OUT, AUTO_OUT
  lat             Float?
  lng             Float?
  isFakeGps       Boolean            @default(false)
  deviceId        String?
  createdAt       DateTime           @default(now())
  @@unique([sessionId, studentId])
}