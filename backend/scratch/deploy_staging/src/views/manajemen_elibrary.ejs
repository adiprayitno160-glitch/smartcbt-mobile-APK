<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📖 Perpustakaan Digital & Audit Barcode Buku Paket</title>
    <script src="/js/tailwind.js"></script>
    <style>
        .active-tab {
            border-bottom: 3px solid #2563eb;
            color: #1d4ed8;
            font-weight: 700;
        }
        @media print {
            body * { visibility: hidden; }
            #printableBarcodeSection, #printableBarcodeSection * { visibility: visible; }
            #printableBarcodeSection { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-slate-50 text-slate-800 flex h-screen overflow-hidden">
    <!-- Unified Sidebar -->
    <% if (typeof isOperator !== 'undefined' && isOperator) { %>
        <%- include('partials/sidebar_operator') %>
    <% } else { %>
        <%- include('partials/sidebar_admin') %>
    <% } %>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-6 md:p-8 overflow-y-auto h-screen bg-slate-50/70 transition-all duration-300 ease-in-out">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>📖</span> Perpustakaan Digital &amp; Audit Barcode Buku
                    </h1>
                    <p class="text-slate-500 text-xs mt-0.5">Manajemen E-Book PDF, Pelacakan Barcode Eksemplar Buku Paket &amp; Peminjaman Siswa</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="openAddBookModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow flex items-center gap-2">
                    <span>➕</span> Tambah Judul / Buku Paket
                </button>
                <button onclick="refreshCurrentTab()" class="bg-white border hover:bg-gray-50 text-gray-700 px-3.5 py-2 rounded-lg text-sm font-semibold shadow-sm">
                    🔄 Refresh
                </button>
            </div>
        </div>

        <!-- Summary Stats Cards -->
        <div class="grid grid-cols-4 gap-4 mb-6">
            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Total Judul Buku</p>
                    <p class="text-2xl font-bold text-gray-800" id="statTotalTitles">0 Judul</p>
                    <p class="text-xs text-green-600 font-semibold mt-1">🟢 Katalog Terdaftar</p>
                </div>
                <div class="p-3 bg-blue-50 text-blue-700 rounded-xl text-2xl">📘</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Total Fisik & Copy</p>
                    <p class="text-2xl font-bold text-indigo-900" id="statTotalStock">0 Eks</p>
                    <p class="text-xs text-gray-400 mt-1">Eksemplar Tercetak</p>
                </div>
                <div class="p-3 bg-indigo-50 text-indigo-700 rounded-xl text-2xl">📦</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">Sedang Dipinjam</p>
                    <p class="text-2xl font-bold text-amber-800" id="statActiveLoans">0 Siswa</p>
                    <p class="text-xs text-amber-600 font-semibold mt-1">⏳ Sirkulasi Siswa</p>
                </div>
                <div class="p-3 bg-amber-50 text-amber-700 rounded-xl text-2xl">🔖</div>
            </div>

            <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase">E-Book PDF Resmi</p>
                    <p class="text-2xl font-bold text-teal-800" id="statEbooks">0 File</p>
                    <p class="text-xs text-teal-600 font-semibold mt-1">📱 Pembacaan di APK Siswa</p>
                </div>
                <div class="p-3 bg-teal-50 text-teal-700 rounded-xl text-2xl">📲</div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex border-b border-gray-200 mb-6 bg-white px-4 rounded-t-xl shadow-sm">
            <button onclick="switchTab('catalog')" id="tabBtnCatalog" class="px-6 py-3.5 text-sm active-tab flex items-center gap-2">
                <span>📚</span> Katalog Buku & E-Book PDF
            </button>
            <button onclick="switchTab('copies')" id="tabBtnCopies" class="px-6 py-3.5 text-sm text-gray-500 hover:text-blue-600 flex items-center gap-2">
                <span>🏷️</span> Audit Barcode Eksemplar & Buku Tertukar
            </button>
            <button onclick="switchTab('circulation')" id="tabBtnCirculation" class="px-6 py-3.5 text-sm text-gray-500 hover:text-blue-600 flex items-center gap-2">
                <span>⚡</span> Sirkulasi Cepat (Scan Barcode & QR)
            </button>
            <button onclick="switchTab('members')" id="tabBtnMembers" class="px-6 py-3.5 text-sm text-gray-500 hover:text-blue-600 flex items-center gap-2">
                <span>🪪</span> Kartu Anggota Digital Siswa
            </button>
        </div>

        <!-- TAB 1: Katalog Buku & PDF -->
        <div id="sectionCatalog" class="bg-white rounded-2xl shadow-sm border overflow-hidden">
            <div class="p-5 border-b flex flex-wrap justify-between items-center gap-4 bg-gray-50">
                <div class="flex items-center gap-3">
                    <span class="text-sm font-bold text-gray-700">📖 Katalog Buku &amp; E-Book Terdaftar</span>
                </div>
                <div class="flex items-center gap-2">
                    <select id="filterBookCategory" onchange="filterBooks()" class="border text-xs rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-blue-500 font-semibold text-slate-700">
                        <option value="ALL">Semua Kategori</option>
                        <option value="BUKU_PAKET">Buku Paket Pelajaran</option>
                        <option value="REFERENSI">Referensi &amp; Ensiklopedia</option>
                        <option value="FIKSI">Fiksi &amp; Novel</option>
                        <option value="KOMIK">Komik &amp; Bergambar</option>
                        <option value="SAINS">Sains &amp; Matematika</option>
                        <option value="BAHASA">Bahasa &amp; Sastra</option>
                        <option value="AGAMA">Pendidikan Agama</option>
                        <option value="LAINNYA">Koleksi Umum Lainnya</option>
                    </select>
                    <input type="text" id="searchBookInput" onkeyup="filterBooks()" placeholder="Cari judul / pengarang / ISBN..." class="border text-xs rounded-lg px-3.5 py-2 w-72 focus:ring-2 focus:ring-blue-500 bg-white">
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100 text-gray-600 uppercase text-[11px] font-bold border-b">
                            <th class="py-3.5 px-4">Judul Buku / E-Book</th>
                            <th class="py-3.5 px-4">Penulis & Penerbit</th>
                            <th class="py-3.5 px-4">Kategori & Kelas</th>
                            <th class="py-3.5 px-4">Stok / Eksemplar</th>
                            <th class="py-3.5 px-4">E-Book PDF</th>
                            <th class="py-3.5 px-4 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="booksTableBody" class="text-xs divide-y">
                        <tr><td colspan="6" class="text-center py-8 text-gray-400">Memuat katalog buku...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 2: Audit Barcode Eksemplar & Mutasi Buku Tertukar -->
        <div id="sectionCopies" class="hidden bg-white rounded-2xl shadow-sm border overflow-hidden">
            <div class="p-5 border-b flex flex-wrap justify-between items-center gap-4 bg-gray-50">
                <div>
                    <h3 class="text-sm font-bold text-gray-800 flex items-center gap-2">
                        <span>🏷️</span> Audit Barcode Eksemplar Fisik Buku Paket
                    </h3>
                    <p class="text-xs text-gray-500 mt-0.5">Lacak pemilik buku berdasarkan stiker barcode statis yang tertempel di buku siswa.</p>
                </div>
                <div class="flex gap-2">
                    <input type="text" id="searchCopyInput" onkeyup="filterCopies()" placeholder="Cari Barcode (Cth: BKP-MAT7-001) / Siswa..." class="border text-xs rounded-lg px-3.5 py-2 w-80 bg-white focus:ring-2 focus:ring-blue-500">
                    <button onclick="printSelectedStickers()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-3.5 py-2 rounded-lg font-bold shadow flex items-center gap-1.5">
                        <span>🖨️</span> Cetak Stiker Barcode
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100 text-gray-600 uppercase text-[11px] font-bold border-b">
                            <th class="py-3.5 px-4">Kode Barcode Eksemplar</th>
                            <th class="py-3.5 px-4">Judul Buku Paket</th>
                            <th class="py-3.5 px-4">Status Buku</th>
                            <th class="py-3.5 px-4">Peminjam Resmi Saat Ini</th>
                            <th class="py-3.5 px-4">Tanggal Pinjam</th>
                            <th class="py-3.5 px-4 text-center">Aksi Audit & Mutasi</th>
                        </tr>
                    </thead>
                    <tbody id="copiesTableBody" class="text-xs divide-y">
                        <tr><td colspan="6" class="text-center py-8 text-gray-400">Memuat data eksemplar...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 3: Sirkulasi Cepat Barcode & QR (Deteksi Buku Tertukar) -->
        <div id="sectionCirculation" class="hidden space-y-6">
            <div class="grid grid-cols-2 gap-6">
                <!-- Peminjaman Cepat -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border">
                    <div class="flex items-center gap-3 border-b pb-4 mb-4">
                        <span class="p-3 bg-blue-50 text-blue-700 rounded-xl text-xl">📤</span>
                        <div>
                            <h3 class="font-bold text-gray-800 text-base">Peminjaman Cepat Buku</h3>
                            <p class="text-xs text-gray-500">Scan Barcode Kartu Siswa + Barcode Buku</p>
                        </div>
                    </div>
                    <form onsubmit="handleQuickCirculation(event, 'BORROW')" class="space-y-4 text-xs">
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Scan QR Kartu Anggota / Masukkan NISN Siswa</label>
                            <input type="text" id="circBorrowStudentInput" required placeholder="Arahkan scanner ke QR Card atau ketik NISN..." class="w-full border rounded-lg p-2.5 bg-gray-50 focus:bg-white text-sm font-mono focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Scan Barcode Eksemplar Buku Fisik</label>
                            <input type="text" id="circBorrowBarcode" required placeholder="Cth: BKP-MAT7-001" class="w-full border rounded-lg p-2.5 bg-gray-50 focus:bg-white text-sm font-mono focus:ring-2 focus:ring-blue-500 uppercase">
                        </div>
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Durasi Peminjaman (Hari)</label>
                            <input type="number" id="circBorrowDays" value="14" min="1" max="365" class="w-32 border rounded-lg p-2 bg-gray-50 text-sm">
                        </div>
                        <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold shadow text-sm flex items-center justify-center gap-2">
                            <span>📤</span> Proses Peminjaman Cepat
                        </button>
                    </form>
                </div>

                <!-- Pengembalian Cepat & Deteksi Buku Tertukar -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border">
                    <div class="flex items-center gap-3 border-b pb-4 mb-4">
                        <span class="p-3 bg-emerald-50 text-emerald-700 rounded-xl text-xl">📥</span>
                        <div>
                            <h3 class="font-bold text-gray-800 text-base">Pengembalian Cepat (Deteksi Tertukar)</h3>
                            <p class="text-xs text-gray-500">Scan Barcode Buku untuk verifikasi pemilik sah</p>
                        </div>
                    </div>
                    <form onsubmit="handleQuickCirculation(event, 'RETURN')" class="space-y-4 text-xs">
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Scan Barcode Eksemplar Buku Fisik</label>
                            <input type="text" id="circReturnBarcode" required placeholder="Arahkan scanner ke stiker buku (Cth: BKP-MAT7-001)..." class="w-full border rounded-lg p-2.5 bg-gray-50 focus:bg-white text-sm font-mono focus:ring-2 focus:ring-emerald-500 uppercase">
                        </div>
                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Scan QR Kartu Siswa yang Mengembalikan (Opsional Verifikasi)</label>
                            <input type="text" id="circReturnStudentInput" placeholder="Ketik/scan jika ingin cek apakah buku ini benar milik siswa tersebut" class="w-full border rounded-lg p-2.5 bg-gray-50 focus:bg-white text-sm font-mono">
                        </div>
                        <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 text-amber-900 text-[11px] flex items-center gap-2">
                            <span>⚠️</span>
                            <span>Sistem otomatis mendeteksi jika buku tertukar dengan milik siswa lain dan memberi peringatan.</span>
                        </div>
                        <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold shadow text-sm flex items-center justify-center gap-2">
                            <span>📥</span> Proses Pengembalian Buku
                        </button>
                    </form>
                </div>
            </div>

            <!-- Alert Hasil Scan Sirkulasi -->
            <div id="circResultAlert" class="hidden p-4 rounded-xl border"></div>
        </div>

        <!-- TAB 4: Kartu Anggota Digital Siswa (Batch Print Grid A4) -->
        <div id="sectionMembers" class="hidden bg-white rounded-2xl shadow-sm border p-6">
            <div class="flex justify-between items-center mb-6 pb-4 border-b">
                <div>
                    <h3 class="font-bold text-gray-800 text-base flex items-center gap-2">
                        <span>🪪</span> Kartu Anggota Digital Siswa Terintegrasi QR Code
                    </h3>
                    <p class="text-xs text-gray-500 mt-1">Kartu Anggota Digital dapat dilihat langsung oleh siswa di Aplikasi APK Android atau dicetak fisik.</p>
                </div>
                <div class="flex gap-3">
                    <input type="text" id="searchMemberInput" onkeyup="filterMembers()" placeholder="Cari Nama / NISN / Kelas..." class="border text-xs rounded-lg px-3.5 py-2 w-64 bg-white">
                    <button onclick="printAllMemberCards()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-4 py-2 rounded-lg font-bold shadow flex items-center gap-1.5">
                        <span>🖨️</span> Cetak Kartu Anggota Siswa (A4 Grid)
                    </button>
                </div>
            </div>

            <div id="membersCardsGrid" class="grid grid-cols-3 gap-4">
                <p class="text-gray-400 text-xs col-span-3 text-center py-8">Memuat daftar anggota perpustakaan...</p>
            </div>
        </div>
    </main>

    <!-- Modal Tambah Buku Baru -->
    <div id="addBookModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl overflow-y-auto max-h-[90vh]">
            <div class="flex justify-between items-center mb-4 border-b pb-3">
                <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <span>➕</span> Tambah Buku & E-Book PDF Baru
                </h3>
                <button onclick="closeAddBookModal()" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
            </div>
            
            <form onsubmit="handleAddBook(event)" class="space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Judul Buku / E-Book</label>
                    <input type="text" id="bookTitle" required placeholder="Cth: Matematika SMP Kelas VII (Kurikulum Merdeka)" class="w-full border rounded-lg p-2.5 text-sm bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Penulis / Pengarang</label>
                        <input type="text" id="bookAuthor" required placeholder="Cth: Kemdikbudristek" class="w-full border rounded-lg p-2.5 text-sm bg-gray-50">
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Penerbit</label>
                        <input type="text" id="bookPublisher" placeholder="Cth: Pusat Kurikulum dan Perbukuan" class="w-full border rounded-lg p-2.5 text-sm bg-gray-50">
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Kode Barcode / Prefix</label>
                        <input type="text" id="bookBarcode" required placeholder="Cth: BKP-MAT7" class="w-full border rounded-lg p-2.5 text-sm bg-gray-50 font-mono">
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Jenis Buku</label>
                        <select id="bookIsTextbook" class="w-full border rounded-lg p-2.5 text-sm bg-gray-50">
                            <option value="true">Buku Paket Pelajaran</option>
                            <option value="false">Buku Referensi / Umum</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Target Kelas</label>
                        <input type="text" id="bookTargetClass" placeholder="Cth: 7, 8, 9, Semua" class="w-full border rounded-lg p-2.5 text-sm bg-gray-50">
                    </div>
                </div>

                <div class="bg-blue-50 p-3.5 rounded-xl border border-blue-200">
                    <label class="block font-bold text-blue-900 mb-1">🏷️ Buat Barcode Eksemplar Fisik Otomatis (Book Copies)</label>
                    <p class="text-[11px] text-blue-700 mb-2">Sistem akan men-generate barcode unik statis untuk setiap buku fisik (misal: BKP-MAT7-001 s/d BKP-MAT7-030).</p>
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-semibold text-blue-900">Jumlah Buku Fisik:</span>
                        <input type="number" id="bookGenerateCount" value="30" min="1" max="500" class="w-24 border rounded-lg p-2 text-sm text-center font-bold bg-white">
                        <span class="text-xs text-gray-500">Eksemplar</span>
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-gray-700 mb-1">📄 Unggah Berkas PDF E-Book (Digital Reader)</label>
                    <input type="file" id="bookPdfFile" accept="application/pdf" class="w-full border rounded-lg p-2 bg-gray-50 text-xs">
                    <p class="text-[10px] text-gray-500 mt-1">E-Book PDF akan dapat dibaca langsung oleh siswa di Aplikasi HP (APK) dan Web Portal.</p>
                </div>

                <div class="flex justify-end gap-2 pt-3 border-t">
                    <button type="button" onclick="closeAddBookModal()" class="px-4 py-2 border rounded-lg font-semibold text-gray-600 hover:bg-gray-100">Batal</button>
                    <button type="submit" id="btnSaveBook" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold shadow flex items-center gap-2">
                        <span>💾</span> Simpan & Generate Barcode
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Reassign / Mutasi Peminjam Buku Tertukar -->
    <div id="reassignModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4 border-b pb-3">
                <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <span>🔄</span> Mutasi / Koreksi Peminjam Buku
                </h3>
                <button onclick="closeReassignModal()" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
            </div>
            <form onsubmit="submitReassign(event)" class="space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Kode Barcode Buku Fisik</label>
                    <input type="text" id="reassignBarcode" readonly class="w-full border rounded-lg p-2.5 font-mono font-bold bg-gray-100 text-blue-800">
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Judul Buku</label>
                    <p id="reassignBookTitle" class="font-semibold text-gray-800 text-sm">-</p>
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Peminjam Lama Tercatat</label>
                    <p id="reassignCurrentBorrower" class="text-gray-600 bg-amber-50 p-2 rounded border border-amber-200">-</p>
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Pindahkan ke Siswa Asli (Peminjam Baru):</label>
                    <select id="reassignSelectStudent" required class="w-full border rounded-lg p-2.5 text-sm bg-white focus:ring-2 focus:ring-blue-500">
                        <option value="">-- Pilih Siswa Penerima Buku --</option>
                    </select>
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Catatan Mutasi</label>
                    <input type="text" id="reassignNotes" placeholder="Cth: Tertukar saat jam pelajaran matematika" class="w-full border rounded-lg p-2.5 bg-gray-50">
                </div>
                <div class="flex justify-end gap-2 pt-3 border-t">
                    <button type="button" onclick="closeReassignModal()" class="px-4 py-2 border rounded-lg font-semibold text-gray-600 hover:bg-gray-100">Batal</button>
                    <button type="submit" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-bold shadow">
                        🔄 Simpan Mutasi Peminjam
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Web PDF Reader -->
    <div id="pdfReaderModal" class="fixed inset-0 bg-black/70 z-50 hidden flex flex-col p-4">
        <div class="bg-white rounded-t-2xl p-4 flex justify-between items-center shadow-lg">
            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2" id="pdfReaderTitle">
                <span>📄</span> Pembaca E-Book PDF
            </h3>
            <button onclick="closePdfReader()" class="text-gray-500 hover:text-gray-800 text-2xl font-bold">&times;</button>
        </div>
        <div class="flex-1 bg-gray-200 rounded-b-2xl overflow-hidden">
            <iframe id="pdfFrame" class="w-full h-full border-0" src=""></iframe>
        </div>
    </div>

    <!-- Printable Barcode Section (Hidden on screen, shown in print) -->
    <div id="printableBarcodeSection" class="hidden p-8">
        <h2 class="text-xl font-bold text-center mb-6">🏷️ LABEL BARCODE BUKU PAKET SEKOLAH</h2>
        <div id="barcodeCardsContainer" class="grid grid-cols-3 gap-4"></div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if(!token) { window.location.href = '/'; }

        // ==================== SIDEBAR TOGGLE & PERSISTENCE ====================
        function togglePortalSidebar() {
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            if (!sidebar) return;

            const isCurrentlyHidden = sidebar.classList.contains('-translate-x-full');

            if (isCurrentlyHidden) {
                sidebar.classList.remove('-translate-x-full');
                if (expandBtn) expandBtn.classList.add('hidden');
                mainEls.forEach(m => {
                    m.classList.add('ml-64');
                    m.classList.remove('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'false');
            } else {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'true');
            }
        }

        // Shortcut Ctrl+B
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                togglePortalSidebar();
            }
        });

        // Apply saved state
        (function applySavedSidebarState() {
            const isCollapsed = localStorage.getItem('portal_sidebar_collapsed') === 'true';
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            
            if (isCollapsed && sidebar) {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
            }
        })();

        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            document.getElementById('profileName').innerText = payload.name || 'Petugas Pustaka';
            document.getElementById('profileRole').innerText = payload.role || 'Operator';
        } catch(e) {}

        let currentTab = 'catalog';
        let allBooks = [];
        let allCopies = [];
        let allStudents = [];

        async function init() {
            await Promise.all([
                loadLibraryData(),
                loadStudentsList()
            ]);
        }

        async function loadStudentsList() {
            try {
                const res = await fetch('/api/students', { headers: { 'Authorization': 'Bearer ' + token }});
                if(res.ok) {
                    allStudents = await res.json();
                    const sel = document.getElementById('reassignSelectStudent');
                    sel.innerHTML = '<option value="">-- Pilih Siswa Penerima Buku --</option>';
                    allStudents.forEach(s => {
                        sel.innerHTML += `<option value="${s.id}">${s.name} (${s.className || 'Tanpa Kelas'} - NIS: ${s.nis || '-'})</option>`;
                    });
                }
            } catch(e) { console.error('Error load students', e); }
        }

        let allLibraryMembers = [];

        function switchTab(tab) {
            currentTab = tab;
            ['catalog', 'copies', 'circulation', 'members'].forEach(t => {
                const sec = document.getElementById('section' + t.charAt(0).toUpperCase() + t.slice(1));
                const btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
                if (sec) sec.classList.add('hidden');
                if (btn) btn.className = 'px-6 py-3.5 text-sm text-gray-500 hover:text-blue-600 flex items-center gap-2';
            });

            const activeSec = document.getElementById('section' + tab.charAt(0).toUpperCase() + tab.slice(1));
            const activeBtn = document.getElementById('tabBtn' + tab.charAt(0).toUpperCase() + tab.slice(1));
            if (activeSec) activeSec.classList.remove('hidden');
            if (activeBtn) activeBtn.className = 'px-6 py-3.5 text-sm active-tab flex items-center gap-2';

            if (tab === 'catalog') loadLibraryData();
            else if (tab === 'copies') loadAllCopies();
            else if (tab === 'members') loadAllMembersData();
        }

        function refreshCurrentTab() {
            if(currentTab === 'catalog') loadLibraryData();
            else if(currentTab === 'copies') loadAllCopies();
            else if(currentTab === 'members') loadAllMembersData();
        }

        async function loadLibraryData() {
            try {
                const res = await fetch('/api/elibrary/books', { headers: { 'Authorization': 'Bearer ' + token }});
                const data = await res.json();
                if(data.success) {
                    allBooks = data.books || [];
                    document.getElementById('statTotalTitles').innerText = (data.summary.totalTitles || 0) + ' Judul';
                    document.getElementById('statTotalStock').innerText = (data.summary.totalStock || 0) + ' Eks';
                    document.getElementById('statActiveLoans').innerText = (data.summary.activeBorrowings || 0) + ' Siswa';
                    document.getElementById('statEbooks').innerText = (data.summary.availableEbooks || 0) + ' File';
                    renderBooksTable(allBooks);
                }
            } catch(e) { console.error('Error load books', e); }
        }

        function renderBooksTable(books) {
            const tbody = document.getElementById('booksTableBody');
            if(books.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">Belum ada judul buku terdaftar.</td></tr>';
                return;
            }

            tbody.innerHTML = books.map(b => {
                const pdfBadge = b.ebookUrl 
                    ? `<button onclick="openPdfReader('${b.title}', '${b.ebookUrl}')" class="bg-teal-100 hover:bg-teal-200 text-teal-800 font-bold px-2.5 py-1 rounded text-xs flex items-center gap-1">
                         <span>📖</span> Baca PDF
                       </button>`
                    : '<span class="text-gray-400 font-medium">Hanya Fisik</span>';

                const textbookBadge = b.isTextbook 
                    ? `<span class="bg-purple-100 text-purple-700 px-2 py-0.5 rounded font-bold text-[10px]">Buku Paket (Kls ${b.targetClass || 'Semua'})</span>`
                    : '<span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded text-[10px]">Buku Umum</span>';

                return `
                    <tr class="hover:bg-blue-50/40 transition-colors">
                        <td class="py-3 px-4">
                            <p class="font-bold text-gray-800 text-sm">${b.title}</p>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="font-mono text-[11px] bg-gray-100 px-1.5 py-0.5 rounded text-gray-600">${b.barcodeCode}</span>
                                ${b.isbn ? `<span class="text-[10px] text-gray-400">ISBN: ${b.isbn}</span>` : ''}
                            </div>
                        </td>
                        <td class="py-3 px-4">
                            <p class="text-gray-700 font-medium">${b.author}</p>
                            <p class="text-[10px] text-gray-400">${b.publisher || '-'}</p>
                        </td>
                        <td class="py-3 px-4">${textbookBadge}</td>
                        <td class="py-3 px-4 font-bold text-indigo-900">${b.stock} Eksemplar</td>
                        <td class="py-3 px-4">${pdfBadge}</td>
                        <td class="py-3 px-4 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="viewCopiesOfBook('${b.barcodeCode}')" title="Lihat Barcode Eksemplar" class="bg-blue-50 hover:bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs font-semibold">
                                    🏷️ Eksemplar
                                </button>
                                <button onclick="deleteBook('${b.id}')" title="Hapus Buku" class="bg-red-50 hover:bg-red-100 text-red-600 px-2 py-1 rounded text-xs font-bold">
                                    🗑️
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function loadAllCopies() {
            try {
                const res = await fetch('/api/elibrary/all-copies', { credentials: 'include', headers: { 'Authorization': 'Bearer ' + token }});
                if(res.ok) {
                    allCopies = await res.json();
                    renderCopiesTable(allCopies);
                }
            } catch(e) { console.error('Error load copies', e); }
        }

        function renderCopiesTable(copies) {
            const tbody = document.getElementById('copiesTableBody');
            if(copies.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400">Belum ada eksemplar buku paket tercatat. Tambahkan buku baru untuk membuat eksemplar.</td></tr>';
                return;
            }

            tbody.innerHTML = copies.map(c => {
                const isBorrowed = c.status === 'BORROWED';
                const statusBadge = isBorrowed 
                    ? '<span class="bg-amber-100 text-amber-800 px-2.5 py-0.5 rounded-full font-bold border border-amber-300">DIPINJAM</span>'
                    : '<span class="bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded-full font-bold border border-emerald-300">TERSEDIA</span>';

                const borrowerName = c.borrower 
                    ? `<span class="font-bold text-gray-800">${c.borrower.name}</span> <span class="text-gray-500 font-mono text-[10px]">(${c.borrower.className || '-'})</span>`
                    : '<span class="text-gray-400 font-italic">Di Rak Perpustakaan</span>';

                const borrowDate = c.borrowedAt ? new Date(c.borrowedAt).toLocaleDateString('id-ID') : '-';

                return `
                    <tr class="hover:bg-amber-50/40 transition-colors">
                        <td class="py-3 px-4 font-mono font-bold text-blue-700 text-sm">
                            ${c.copyBarcode}
                        </td>
                        <td class="py-3 px-4 font-semibold text-gray-800">${c.book?.title || '-'}</td>
                        <td class="py-3 px-4">${statusBadge}</td>
                        <td class="py-3 px-4">${borrowerName}</td>
                        <td class="py-3 px-4 text-gray-500 text-xs">${borrowDate}</td>
                        <td class="py-3 px-4 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="openReassignModal('${c.copyBarcode}', '${encodeURIComponent(c.book?.title || '')}', '${encodeURIComponent(c.borrower ? c.borrower.name + ' (' + (c.borrower.className || '') + ')' : 'Tidak ada peminjam')}')" class="bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1 rounded text-xs font-bold shadow-sm flex items-center gap-1">
                                    <span>🔄</span> Mutasi Peminjam
                                </button>
                                ${isBorrowed ? `
                                    <button onclick="returnBook('${c.copyBarcode}')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1 rounded text-xs font-bold shadow-sm">
                                        Kembalikan
                                    </button>
                                ` : ''}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function filterBooks() {
            const query = (document.getElementById('searchBookInput')?.value || '').toLowerCase().trim();
            const cat = document.getElementById('filterBookCategory')?.value || 'ALL';
            const filtered = allBooks.filter(b => {
                const matchQuery = !query || 
                    (b.title && b.title.toLowerCase().includes(query)) || 
                    (b.author && b.author.toLowerCase().includes(query)) || 
                    (b.isbn && b.isbn.toLowerCase().includes(query)) ||
                    (b.barcodeCode && b.barcodeCode.toLowerCase().includes(query)) ||
                    (b.subject && b.subject.toLowerCase().includes(query));

                const bCat = ((b.category || '') + ' ' + (b.subject || '') + ' ' + (b.title || '')).toUpperCase();
                let matchCat = true;
                if (cat === 'BUKU_PAKET') matchCat = b.isTextbook === true || bCat.includes('PAKET') || bCat.includes('PELAJARAN');
                else if (cat === 'REFERENSI') matchCat = bCat.includes('REFERENSI') || bCat.includes('ENSIKLOPEDIA') || bCat.includes('KAMUS');
                else if (cat === 'FIKSI') matchCat = bCat.includes('NOVEL') || bCat.includes('FIKSI') || bCat.includes('CERPEN');
                else if (cat === 'KOMIK') matchCat = bCat.includes('KOMIK') || bCat.includes('BERGAMBAR') || bCat.includes('MANGA');
                else if (cat === 'SAINS') matchCat = bCat.includes('IPA') || bCat.includes('SAINS') || bCat.includes('MATEMATIKA') || bCat.includes('FISIKA') || bCat.includes('BIOLOGI');
                else if (cat === 'BAHASA') matchCat = bCat.includes('BAHASA') || bCat.includes('INDONESIA') || bCat.includes('INGGRIS') || bCat.includes('JAWA');
                else if (cat === 'AGAMA') matchCat = bCat.includes('AGAMA') || bCat.includes('ISLAM') || bCat.includes('PAI');
                else if (cat === 'LAINNYA') matchCat = !b.isTextbook;

                return matchQuery && matchCat;
            });
            renderBooksTable(filtered);
        }

        function filterCopies() {
            const query = document.getElementById('searchCopyInput').value.toLowerCase();
            const filtered = allCopies.filter(c => 
                c.copyBarcode.toLowerCase().includes(query) || 
                (c.book?.title && c.book.title.toLowerCase().includes(query)) ||
                (c.borrower?.name && c.borrower.name.toLowerCase().includes(query)) ||
                (c.borrower?.className && c.borrower.className.toLowerCase().includes(query))
            );
            renderCopiesTable(filtered);
        }

        function viewCopiesOfBook(bookBarcode) {
            switchTab('copies');
            document.getElementById('searchCopyInput').value = bookBarcode;
            filterCopies();
        }

        function openAddBookModal() {
            document.getElementById('addBookModal').classList.remove('hidden');
        }

        function closeAddBookModal() {
            document.getElementById('addBookModal').classList.add('hidden');
        }

        async function handleAddBook(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSaveBook');
            btn.disabled = true;
            btn.innerText = 'Menyimpan & Mengunggah...';

            const title = document.getElementById('bookTitle').value;
            const author = document.getElementById('bookAuthor').value;
            const publisher = document.getElementById('bookPublisher').value;
            const barcodeCode = document.getElementById('bookBarcode').value;
            const isTextbook = document.getElementById('bookIsTextbook').value === 'true';
            const targetClass = document.getElementById('bookTargetClass').value;
            const generateCopiesCount = parseInt(document.getElementById('bookGenerateCount').value) || 0;

            const fileInput = document.getElementById('bookPdfFile');
            let fileBase64 = null;
            let fileName = null;

            if(fileInput.files && fileInput.files[0]) {
                const file = fileInput.files[0];
                fileName = file.name;
                fileBase64 = await new Promise((resolve) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result.split(',')[1]);
                    reader.readAsDataURL(file);
                });
            }

            try {
                const res = await fetch('/api/elibrary/books', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({
                        title, author, publisher, barcodeCode,
                        stock: generateCopiesCount || 10,
                        isTextbook, targetClass,
                        generateCopiesCount,
                        fileBase64, fileName
                    })
                });

                const data = await res.json();
                if(res.ok && data.success) {
                    alert('✅ ' + data.message);
                    closeAddBookModal();
                    loadLibraryData();
                } else {
                    alert(data.message || 'Gagal menambahkan buku');
                }
            } catch(err) {
                alert('Terjadi kesalahan jaringan');
            } finally {
                btn.disabled = false;
                btn.innerText = '💾 Simpan & Generate Barcode';
            }
        }

        function openReassignModal(copyBarcode, bookTitle, currentBorrower) {
            document.getElementById('reassignBarcode').value = copyBarcode;
            document.getElementById('reassignBookTitle').innerText = decodeURIComponent(bookTitle);
            document.getElementById('reassignCurrentBorrower').innerText = decodeURIComponent(currentBorrower);
            document.getElementById('reassignModal').classList.remove('hidden');
        }

        function closeReassignModal() {
            document.getElementById('reassignModal').classList.add('hidden');
        }

        async function submitReassign(e) {
            e.preventDefault();
            const copyBarcode = document.getElementById('reassignBarcode').value;
            const targetStudentId = document.getElementById('reassignSelectStudent').value;
            const notes = document.getElementById('reassignNotes').value;

            if(!targetStudentId) {
                alert('Pilih siswa penerima buku');
                return;
            }

            try {
                const res = await fetch('/api/elibrary/reassign-borrower', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ copyBarcode, targetStudentId, notes })
                });

                const data = await res.json();
                if(res.ok && data.success) {
                    alert('✅ ' + data.message);
                    closeReassignModal();
                    loadAllCopies();
                } else {
                    alert(data.message || 'Gagal memutasi peminjam');
                }
            } catch(err) {
                alert('Terjadi kesalahan');
            }
        }

        async function returnBook(copyBarcode) {
            if(!confirm(`Kembalikan buku dengan barcode ${copyBarcode} ke perpustakaan?`)) return;
            try {
                const res = await fetch('/api/elibrary/return-copy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ copyBarcode })
                });
                const data = await res.json();
                if(res.ok && data.success) {
                    alert('✅ ' + data.message);
                    loadAllCopies();
                } else {
                    alert(data.message || 'Gagal memproses pengembalian');
                }
            } catch(err) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        async function deleteBook(id) {
            if(!confirm('Hapus judul buku ini beserta seluruh eksemplarnya?')) return;
            try {
                const res = await fetch('/api/elibrary/books/' + id, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                alert(data.message);
                loadLibraryData();
            } catch(err) {
                alert('Gagal menghapus');
            }
        }

        async function handleQuickCirculation(e, action) {
            e.preventDefault();
            const alertBox = document.getElementById('circResultAlert');
            alertBox.className = 'p-4 rounded-xl border';

            let body = { action };
            if(action === 'BORROW') {
                body.barcode = document.getElementById('circBorrowBarcode').value.trim();
                body.studentIdOrNisn = document.getElementById('circBorrowStudentInput').value.trim();
                body.loanDays = parseInt(document.getElementById('circBorrowDays').value) || 14;
            } else {
                body.barcode = document.getElementById('circReturnBarcode').value.trim();
                body.studentIdOrNisn = document.getElementById('circReturnStudentInput').value.trim();
            }

            try {
                const res = await fetch('/api/elibrary/quick-circulation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(body)
                });
                const data = await res.json();

                alertBox.classList.remove('hidden');
                if(res.ok && data.success) {
                    if(data.isSwapped) {
                        alertBox.className = 'p-4 rounded-xl border bg-red-50 border-red-300 text-red-900';
                        alertBox.innerHTML = `
                            <div class="flex items-start gap-3">
                                <span class="text-2xl">🚨</span>
                                <div>
                                    <h4 class="font-bold text-sm">PERINGATAN: BUKU TERTUKAR TERDETEKSI!</h4>
                                    <p class="text-xs mt-1">${data.warning}</p>
                                    <p class="text-xs font-semibold mt-1">Buku ini telah berhasil dikembalikan ke sistem perpustakaan.</p>
                                </div>
                            </div>
                        `;
                    } else {
                        alertBox.className = 'p-4 rounded-xl border bg-emerald-50 border-emerald-300 text-emerald-900';
                        alertBox.innerHTML = `
                            <div class="flex items-start gap-3">
                                <span class="text-2xl">✅</span>
                                <div>
                                    <h4 class="font-bold text-sm">Transaksi Berhasil!</h4>
                                    <p class="text-xs mt-1">${data.message}</p>
                                </div>
                            </div>
                        `;
                    }

                    if(action === 'BORROW') {
                        document.getElementById('circBorrowBarcode').value = '';
                    } else {
                        document.getElementById('circReturnBarcode').value = '';
                        document.getElementById('circReturnStudentInput').value = '';
                    }
                    loadLibraryData();
                } else {
                    alertBox.className = 'p-4 rounded-xl border bg-red-50 border-red-300 text-red-900';
                    alertBox.innerHTML = `<p class="text-xs font-bold">❌ ${data.message || 'Gagal memproses sirkulasi'}</p>`;
                }
            } catch(err) {
                alertBox.classList.remove('hidden');
                alertBox.className = 'p-4 rounded-xl border bg-red-50 border-red-300 text-red-900';
                alertBox.innerHTML = `<p class="text-xs font-bold">❌ Gagal terhubung ke server: ${err.message}</p>`;
            }
        }

        async function loadAllMembersData() {
            try {
                const res = await fetch('/api/elibrary/all-members', { headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                if(data.success) {
                    allLibraryMembers = data.members || [];
                    renderMembersCards(allLibraryMembers);
                }
            } catch(e) { console.error('Error load library members', e); }
        }

        function filterMembers() {
            const q = (document.getElementById('searchMemberInput').value || '').toLowerCase();
            const filtered = allLibraryMembers.filter(m => 
                (m.name && m.name.toLowerCase().includes(q)) ||
                (m.nisn && m.nisn.toLowerCase().includes(q)) ||
                (m.className && m.className.toLowerCase().includes(q))
            );
            renderMembersCards(filtered);
        }

        function renderMembersCards(members) {
            const grid = document.getElementById('membersCardsGrid');
            if(members.length === 0) {
                grid.innerHTML = '<p class="text-gray-400 text-xs col-span-3 text-center py-8">Tidak ada anggota siswa ditemukan.</p>';
                return;
            }

            grid.innerHTML = members.map(m => `
                <div class="border-2 border-slate-700 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-4 shadow-md flex flex-col justify-between relative overflow-hidden">
                    <div class="flex justify-between items-start mb-3 border-b border-slate-700 pb-2">
                        <div>
                            <p class="text-[10px] uppercase font-bold tracking-wider text-blue-300">KARTU ANGGOTA PERPUSTAKAAN</p>
                            <h4 class="font-bold text-sm text-white">${m.name}</h4>
                            <p class="text-[11px] text-gray-300">Kelas: ${m.className || '-'} | NISN: ${m.nisn || m.username}</p>
                        </div>
                        <span class="text-xl">📚</span>
                    </div>

                    <div class="flex items-center justify-between mt-2">
                        <div class="bg-white p-2 rounded-xl text-black inline-block shadow">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=90x90&data=${encodeURIComponent(m.qrPayload)}" alt="QR Code" class="w-20 h-20">
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] text-gray-400">ID ANGGOTA</p>
                            <p class="font-mono font-bold text-xs text-amber-300">${m.memberId}</p>
                            <span class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/20 text-blue-300 border border-blue-400/30">
                                Anggota Aktif
                            </span>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function printAllMemberCards() {
            const container = document.getElementById('barcodeCardsContainer');
            container.innerHTML = '';
            
            const list = allLibraryMembers.slice(0, 30);
            if(list.length === 0) {
                alert('Tidak ada kartu anggota untuk dicetak');
                return;
            }

            list.forEach(m => {
                container.innerHTML += `
                    <div class="border-2 border-black p-4 rounded-xl text-center bg-white">
                        <p class="font-bold text-xs uppercase tracking-wider">KARTU ANGGOTA PERPUSTAKAAN</p>
                        <h4 class="font-bold text-sm mt-1">${m.name}</h4>
                        <p class="text-xs text-gray-600">Kelas: ${m.className || '-'} | NISN: ${m.nisn || m.username}</p>
                        <div class="my-3 flex justify-center">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(m.qrPayload)}" alt="QR Code" style="width:100px;height:100px;">
                        </div>
                        <p class="font-mono font-bold text-xs">${m.memberId}</p>
                    </div>
                `;
            });

            window.print();
        }

        function openPdfReader(title, url) {
            document.getElementById('pdfReaderTitle').innerText = '📄 Pembaca E-Book: ' + title;
            document.getElementById('pdfFrame').src = url;
            document.getElementById('pdfReaderModal').classList.remove('hidden');
        }

        function closePdfReader() {
            document.getElementById('pdfReaderModal').classList.add('hidden');
            document.getElementById('pdfFrame').src = '';
        }

        function printSelectedStickers() {
            const container = document.getElementById('barcodeCardsContainer');
            container.innerHTML = '';
            
            const list = allCopies.slice(0, 60); // print up to 60 visible copies
            if(list.length === 0) {
                alert('Tidak ada eksemplar untuk dicetak');
                return;
            }

            list.forEach(c => {
                container.innerHTML += `
                    <div class="border-2 border-black p-3 rounded text-center">
                        <p class="font-bold text-xs uppercase tracking-wider">PERPUSTAKAAN SEKOLAH</p>
                        <p class="font-semibold text-[11px] truncate mt-1">${c.book?.title || 'BUKU PAKET'}</p>
                        <div class="my-2 bg-gray-100 p-2 font-mono font-bold text-base border border-dashed border-gray-400">
                            *${c.copyBarcode}*
                        </div>
                        <p class="text-[10px] text-gray-600">Scan Barcode untuk Audit Peminjaman</p>
                    </div>
                `;
            });

            window.print();
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
