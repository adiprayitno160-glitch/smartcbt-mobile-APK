<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⚙️ Pengaturan Sistem & API Gemini AI - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-slate-100 flex min-h-screen">
    <!-- Sidebar -->
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <!-- Header -->
        <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-slate-200/80">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2.5">
                        <span class="p-2 bg-purple-100 text-purple-700 rounded-xl text-xl">⚙️</span>
                        <span>Pengaturan Sistem &amp; Identitas Sekolah</span>
                    </h1>
                    <p class="text-slate-500 text-xs mt-1">Konfigurasi Kepala Sekolah, NIP, Google Gemini AI API Key, dan pengujian koneksi server</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span id="systemStatusBadge" class="bg-emerald-100 text-emerald-800 border border-emerald-200 px-3.5 py-1.5 rounded-xl text-xs font-bold flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>SISTEM AKTIF</span>
                </span>
            </div>
        </header>

        <!-- Container Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-6xl">
            <!-- Left Column: Form Pengaturan Gemini API & Identitas Sekolah -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Card Pengaturan Kepala Sekolah & Identitas Sekolah -->
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
                    <div class="flex items-center justify-between border-b pb-4 mb-5">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 p-1 flex items-center justify-center shadow-sm flex-shrink-0">
                                <img src="/logo-smpn1boyolangu.png" alt="Logo SMPN 1 Boyolangu" class="w-full h-full object-contain">
                            </div>
                            <div>
                                <h2 class="text-base font-bold text-gray-800">Identitas Sekolah &amp; Kepala Sekolah</h2>
                                <p class="text-xs text-gray-500">Nama kepala sekolah dan NIP untuk tanda tangan BAP CBT, kop surat, dan dokumen resmi</p>
                            </div>
                        </div>
                        <span class="text-xs font-bold px-3 py-1 rounded-full bg-blue-50 text-blue-800 border border-blue-200">
                            🏫 SMPN 1 Boyolangu
                        </span>
                    </div>

                    <form id="formSchoolConfig" onsubmit="handleSaveSchoolConfig(event)" class="space-y-4 text-xs">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block font-bold text-gray-700 mb-1">Nama Kepala Sekolah *</label>
                                <input type="text" id="headmasterNameInput" placeholder="Contoh: Drs. H. SUKIRNO, M.Pd." class="w-full border rounded-2xl p-3 font-semibold text-xs focus:ring-2 focus:ring-blue-500 outline-none bg-slate-50 focus:bg-white" required>
                                <p class="text-[11px] text-gray-400 mt-1">Nama lengkap beserta gelar akademik kepala sekolah.</p>
                            </div>
                            <div>
                                <label class="block font-bold text-gray-700 mb-1">NIP Kepala Sekolah</label>
                                <input type="text" id="headmasterNipInput" placeholder="Contoh: 19660814 199802 1 002" class="w-full border rounded-2xl p-3 font-mono text-xs focus:ring-2 focus:ring-blue-500 outline-none bg-slate-50 focus:bg-white">
                                <p class="text-[11px] text-gray-400 mt-1">Nomor Induk Pegawai (NIP) Kepala Sekolah.</p>
                            </div>
                        </div>

                        <div>
                            <label class="block font-bold text-gray-700 mb-1">Nama Lembaga / Sekolah</label>
                            <input type="text" id="schoolNameInput" value="SMPN 1 Boyolangu" class="w-full border rounded-2xl p-3 font-semibold text-xs focus:ring-2 focus:ring-blue-500 outline-none bg-slate-50 focus:bg-white" required>
                        </div>

                        <div class="pt-3 border-t flex justify-end">
                            <button type="submit" id="btnSaveSchool" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-6 py-2.5 rounded-xl font-bold text-xs shadow-md flex items-center gap-2">
                                <span>💾</span> <span>Simpan Data Kepala Sekolah</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Card Konfigurasi API Key -->
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
                    <div class="flex items-center justify-between border-b pb-4 mb-5">
                        <div class="flex items-center gap-3">
                            <span class="text-3xl p-2.5 bg-gradient-to-br from-purple-500 to-indigo-600 text-white rounded-2xl shadow-sm">✨</span>
                            <div>
                                <h2 class="text-base font-bold text-gray-800">Google Gemini AI Engine</h2>
                                <p class="text-xs text-gray-500">Kunci API untuk ekstraksi naskah soal Word/PDF dan generate soal otomatis</p>
                            </div>
                        </div>
                        <span id="apiKeyStatusBadge" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-600">
                            Memeriksa...
                        </span>
                    </div>

                    <form id="formGeminiConfig" onsubmit="handleSaveGeminiConfig(event)" class="space-y-5 text-xs">
                        <!-- API Key Input -->
                        <div>
                            <div class="flex justify-between items-center mb-1.5">
                                <label class="block font-bold text-gray-700">Google Gemini API Key *</label>
                                <a href="https://aistudio.google.com/app/apikey" target="_blank" class="text-[11px] text-blue-600 hover:underline font-semibold flex items-center gap-1">
                                    <span>🔑</span> Dapatkan API Key Gratis di Google AI Studio &nearr;
                                </a>
                            </div>
                            <div class="relative">
                                <input type="password" id="geminiApiKeyInput" placeholder="Masukkan AIzaSy..." class="w-full border rounded-2xl p-3 pr-24 font-mono text-xs focus:ring-2 focus:ring-purple-500 outline-none bg-slate-50 focus:bg-white" required>
                                <button type="button" onclick="toggleApiKeyVisibility()" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 font-semibold text-[11px] px-2 py-1 bg-gray-100 rounded-lg">
                                    <span id="btnToggleEye">👁️ Tampilkan</span>
                                </button>
                            </div>
                            <p class="text-[11px] text-gray-400 mt-1.5">API Key tersimpan aman di database lokal sekolah (`Settings.GEMINI_API_KEY`).</p>
                        </div>

                        <!-- Pilihan Model AI -->
                        <div>
                            <label class="block font-bold text-gray-700 mb-1.5">Pilihan Model Gemini AI</label>
                            <select id="geminiModelSelect" class="w-full border rounded-2xl p-3 text-xs font-semibold bg-slate-50 focus:bg-white outline-none">
                                <option value="gemini-2.5-flash" selected>Gemini 2.5 Flash (Sangat Cepat &amp; Rekomendasi Utama Bank Soal)</option>
                                <option value="gemini-2.5-pro">Gemini 2.5 Pro (Kemampuan Penalaran &amp; Soal Rumit)</option>
                                <option value="gemini-2.0-flash">Gemini 2.0 Flash (Kecepatan Tinggi)</option>
                                <option value="gemini-1.5-flash">Gemini 1.5 Flash (Model Stabil)</option>
                            </select>
                        </div>

                        <!-- Action Buttons -->
                        <div class="pt-3 border-t flex flex-wrap justify-between items-center gap-3">
                            <button type="button" onclick="handleTestGeminiApi()" id="btnTestApi" class="bg-slate-800 hover:bg-black text-white px-5 py-2.5 rounded-xl font-bold text-xs shadow flex items-center gap-2">
                                <span>⚡</span> <span>Uji Koneksi (Ping Test)</span>
                            </button>
                            <button type="submit" id="btnSaveConfig" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white px-6 py-2.5 rounded-xl font-bold text-xs shadow-md flex items-center gap-2">
                                <span>💾</span> <span>Simpan Pengaturan API</span>
                            </button>
                        </div>
                    </form>

                    <!-- Alert Output Box -->
                    <div id="testResultBox" class="hidden mt-4 p-4 rounded-2xl text-xs border">
                        <p id="testResultText" class="font-semibold"></p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Panduan & Info Status -->
            <div class="space-y-6">
                <!-- Card Sakelar PPDB Online (Tahun Ajaran Baru) -->
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-xl">🎒</span>
                            <div>
                                <h3 class="font-bold text-gray-800 text-sm">Formulir Siswa Baru (PPDB)</h3>
                                <p class="text-[11px] text-gray-500">Buka / tutup pendaftaran siswa baru di aplikasi orang tua</p>
                            </div>
                        </div>
                        <span id="ppdbStatusBadge" class="text-xs font-bold px-3 py-1 rounded-full bg-gray-100 text-gray-600">Memeriksa...</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Aktifkan fitur ini hanya pada periode pendaftaran tahun ajaran baru. Jika dinonaktifkan, menu formulir pendaftaran di APK Orang Tua otomatis ditutup.
                    </p>
                    <div class="pt-2 flex items-center justify-between border-t">
                        <span class="text-xs font-semibold text-gray-700">Status Pendaftaran:</span>
                        <button type="button" id="btnTogglePpdb" onclick="handleTogglePpdb()" class="px-5 py-2 rounded-xl font-bold text-xs shadow transition-all bg-emerald-600 hover:bg-emerald-700 text-white flex items-center gap-1.5">
                            <span>⚡</span> <span id="btnTogglePpdbText">Buka PPDB</span>
                        </button>
                    </div>
                </div>

                <!-- Info Kegunaan AI di Sekolah -->
                <div class="bg-gradient-to-br from-indigo-900 to-purple-950 text-white rounded-3xl p-6 shadow-md space-y-4">
                    <h3 class="text-sm font-bold flex items-center gap-2 text-purple-200">
                        <span>🤖</span> Fitur yang Didukung AI Gemini
                    </h3>
                    <ul class="space-y-2.5 text-xs text-slate-200">
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-400 font-bold">✓</span>
                            <span><b>Ekstraksi Soal Naskah:</b> Otomatis membaca teks soal dari dokumen Word/PDF menjadi butir soal terstruktur CBT.</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-400 font-bold">✓</span>
                            <span><b>Deteksi Formula Matematika:</b> Mengubah persamaan matematika menjadi kode LaTeX KaTeX secara otomatis.</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-400 font-bold">✓</span>
                            <span><b>Penataan Kunci &amp; Opsi:</b> Memisahkan opsi A, B, C, D dan kunci jawaban secara pintar tanpa input manual satu per satu.</span>
                        </li>
                    </ul>
                </div>

                <!-- Petunjuk Mendapatkan API Key -->
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 space-y-3 text-xs">
                    <h3 class="font-bold text-gray-800 text-sm flex items-center gap-2">
                        <span>📖</span> Panduan Singkat API Key
                    </h3>
                    <ol class="list-decimal pl-4 space-y-2 text-gray-600 text-[11px] leading-relaxed">
                        <li>Buka portal resmi <a href="https://aistudio.google.com/app/apikey" target="_blank" class="text-blue-600 font-bold hover:underline">Google AI Studio</a>.</li>
                        <li>Login menggunakan akun Google sekolah atau akun pribadi Anda.</li>
                        <li>Klik tombol <b>"Create API Key"</b>.</li>
                        <li>Salin kunci yang diawali dengan <code>AIzaSy...</code> dan tempelkan pada kolom formulir di samping.</li>
                        <li>Klik <b>"Uji Koneksi"</b> untuk memvalidasi API Key, lalu klik <b>"Simpan Pengaturan API"</b>.</li>
                    </ol>
                </div>
            </div>
        </div>
    </main>

    <script>
        const token = localStorage.getItem('token');
        if (!token) window.location.href = '/';

        let isKeyVisible = false;
        let originalMaskedKey = '';

        loadSystemSettings();

        async function loadSystemSettings() {
            try {
                const res = await fetch('/api/admin/settings', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();

                if (res.ok) {
                    originalMaskedKey = data.geminiApiKey || '';
                    document.getElementById('geminiApiKeyInput').value = originalMaskedKey;
                    if (data.geminiModel) {
                        document.getElementById('geminiModelSelect').value = data.geminiModel;
                    }

                    const badge = document.getElementById('apiKeyStatusBadge');
                    if (data.hasCustomApiKey) {
                        badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200';
                        badge.innerText = '🟢 API Key Terpasang';
                    } else {
                        badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-amber-100 text-amber-800 border border-amber-200';
                        badge.innerText = '⚪ Belum Dikonfigurasi';
                    }

                    if (data.headmasterName) {
                        document.getElementById('headmasterNameInput').value = data.headmasterName;
                    } else {
                        document.getElementById('headmasterNameInput').value = 'Drs. H. SUKIRNO, M.Pd.';
                    }
                    if (data.headmasterNip) {
                        document.getElementById('headmasterNipInput').value = data.headmasterNip;
                    }
                    if (data.schoolName) {
                        document.getElementById('schoolNameInput').value = data.schoolName;
                    }

                    updatePpdbUi(data.ppdbEnabled);
                }
            } catch (e) {
                console.error('Failed to load settings:', e);
            }
        }

        async function handleSaveSchoolConfig(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSaveSchool');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span>⏳</span> <span>Menyimpan...</span>';
            btn.disabled = true;

            try {
                const payload = {
                    headmasterName: document.getElementById('headmasterNameInput').value.trim(),
                    headmasterNip: document.getElementById('headmasterNipInput').value.trim(),
                    schoolName: document.getElementById('schoolNameInput').value.trim()
                };

                const res = await fetch('/api/admin/settings/school', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (res.ok) {
                    alert(data.message || 'Data Kepala Sekolah berhasil disimpan!');
                } else {
                    alert('Gagal: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Gagal menyimpan: ' + err.message);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        let isPpdbActive = false;

        function updatePpdbUi(active) {
            isPpdbActive = Boolean(active);
            const badge = document.getElementById('ppdbStatusBadge');
            const btn = document.getElementById('btnTogglePpdb');
            const btnText = document.getElementById('btnTogglePpdbText');
            if (isPpdbActive) {
                badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200';
                badge.innerText = '🟢 DIBUKA (Aktif)';
                btn.className = 'px-5 py-2 rounded-xl font-bold text-xs shadow transition-all bg-rose-600 hover:bg-rose-700 text-white flex items-center gap-1.5';
                btnText.innerText = 'Tutup Pendaftaran';
            } else {
                badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-gray-100 text-gray-700 border border-gray-200';
                badge.innerText = '🔒 DITUTUP (Nonaktif)';
                btn.className = 'px-5 py-2 rounded-xl font-bold text-xs shadow transition-all bg-emerald-600 hover:bg-emerald-700 text-white flex items-center gap-1.5';
                btnText.innerText = 'Buka Pendaftaran (Aktifkan)';
            }
        }

        async function handleTogglePpdb() {
            const nextState = !isPpdbActive;
            const confirmMsg = nextState 
                ? 'Buka pendaftaran siswa baru (PPDB) di aplikasi orang tua sekarang?' 
                : 'Tutup pendaftaran siswa baru (PPDB)? Formulir tidak akan bisa diakses orang tua.';
            if (!confirm(confirmMsg)) return;

            try {
                const res = await fetch('/api/admin/settings/ppdb-toggle', {
                    method: 'PUT',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ enabled: nextState })
                });
                const data = await res.json();
                if (res.ok) {
                    updatePpdbUi(data.isEnabled);
                    alert(data.message);
                } else {
                    alert('Gagal: ' + data.message);
                }
            } catch (err) {
                alert('Gagal memperbarui status PPDB: ' + err.message);
            }
        }

        function toggleApiKeyVisibility() {
            const input = document.getElementById('geminiApiKeyInput');
            const btn = document.getElementById('btnToggleEye');
            if (isKeyVisible) {
                input.type = 'password';
                btn.innerText = '👁️ Tampilkan';
                isKeyVisible = false;
            } else {
                input.type = 'text';
                btn.innerText = '🙈 Sembunyikan';
                isKeyVisible = true;
            }
        }

        async function handleSaveGeminiConfig(e) {
            e.preventDefault();
            const apiKey = document.getElementById('geminiApiKeyInput').value.trim();
            const modelName = document.getElementById('geminiModelSelect').value;

            const btn = document.getElementById('btnSaveConfig');
            btn.disabled = true;
            btn.innerText = 'Menyimpan...';

            try {
                const res = await fetch('/api/admin/settings/gemini', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ apiKey, modelName })
                });

                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + data.message);
                    loadSystemSettings();
                } else {
                    alert('❌ ' + (data.message || 'Gagal menyimpan konfigurasi'));
                }
            } catch (err) {
                alert('❌ Terjadi kesalahan jaringan saat menyimpan konfigurasi');
            } finally {
                btn.disabled = false;
                btn.innerText = '💾 Simpan Pengaturan API';
            }
        }

        async function handleTestGeminiApi() {
            const apiKey = document.getElementById('geminiApiKeyInput').value.trim();
            const box = document.getElementById('testResultBox');
            const txt = document.getElementById('testResultText');
            const btn = document.getElementById('btnTestApi');

            box.classList.remove('hidden');
            box.className = 'mt-4 p-4 rounded-2xl text-xs border bg-blue-50 border-blue-200 text-blue-800';
            txt.innerText = '⏳ Sedang menguji koneksi ke Google Gemini AI API...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/admin/settings/gemini/test', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ apiKey })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    box.className = 'mt-4 p-4 rounded-2xl text-xs border bg-emerald-50 border-emerald-200 text-emerald-900';
                    txt.innerText = '🎉 ' + data.message;
                } else {
                    box.className = 'mt-4 p-4 rounded-2xl text-xs border bg-red-50 border-red-200 text-red-900';
                    txt.innerText = '❌ ' + (data.message || 'Uji koneksi gagal');
                }
            } catch (err) {
                box.className = 'mt-4 p-4 rounded-2xl text-xs border bg-red-50 border-red-200 text-red-900';
                txt.innerText = '❌ Terjadi kegagalan jaringan saat menghubungi server';
            } finally {
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>