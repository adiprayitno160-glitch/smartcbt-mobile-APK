<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rekap Absensi Siswa - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <script src="/js/chart.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex">
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>📋</span> Rekapitulasi Presensi Kehadiran Siswa
                    </h1>
                    <p class="text-slate-500 text-xs">Dashboard &amp; Visualisasi Terpadu: 10 Status Kehadiran Detail &amp; Grafik Tren</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <a href="/bk" class="bg-teal-700 hover:bg-teal-800 text-white px-3.5 py-2 rounded-lg shadow font-semibold flex items-center gap-1.5 text-xs">
                    <span>🚪</span> Kontrol Gate &amp; Barcode
                </a>
                <a href="/bk?tab=izin" class="bg-amber-600 hover:bg-amber-700 text-white px-3.5 py-2 rounded-lg shadow font-bold flex items-center gap-1.5 text-xs">
                    <span>📩</span> Verifikasi Izin &amp; Sakit BK
                </a>
                <button onclick="openHolidayModal()" class="bg-teal-600 hover:bg-teal-700 text-white px-3.5 py-2 rounded-lg shadow font-bold flex items-center gap-1.5 text-xs" title="Kelola Hari Libur Sekolah / Situasi Khusus">
                    <span>🌴</span> Kelola Hari Libur
                </button>
                <button onclick="openManualModal()" class="bg-green-600 hover:bg-green-700 text-white px-3.5 py-2 rounded-lg shadow font-semibold flex items-center gap-1.5 text-xs">
                    <span>+</span> Input Manual
                </button>
            </div>
        </div>

        <!-- BANNER HARI LIBUR JIKA TANGGAL TERPILIH ADALAH HARI LIBUR / MINGGU -->
        <div id="holidayBanner" class="hidden mb-6 p-4 bg-gradient-to-r from-teal-700 via-emerald-700 to-teal-900 text-white rounded-2xl shadow-md flex flex-wrap items-center justify-between gap-3 border border-teal-500/40">
            <div class="flex items-center gap-3">
                <span class="text-3xl">🌴</span>
                <div>
                    <h4 class="font-extrabold text-sm uppercase tracking-wider flex items-center gap-2">
                        <span id="holidayBannerTitle">Hari Libur Sekolah</span>
                        <span class="bg-white/20 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">Libur Resmi</span>
                    </h4>
                    <p class="text-xs text-teal-100 mt-0.5" id="holidayBannerDesc">Siswa yang tidak scan barcode tercatat sebagai [LBR] Libur (bukan Alfa/Bolos).</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="openHolidayModal()" class="bg-white text-teal-900 hover:bg-teal-50 text-xs font-bold px-3 py-1.5 rounded-lg shadow">
                    ⚙️ Atur Hari Libur
                </button>
            </div>
        </div>

        <!-- 11 STATUS RINGKASAN KARTU PRESENSI LENGKAP -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 lg:grid-cols-12 gap-2.5 mb-6">
            <div class="bg-white p-3 rounded-xl shadow-sm border border-gray-200 text-center">
                <p class="text-[10px] text-gray-400 font-bold uppercase">Total</p>
                <p class="text-xl font-black text-gray-800" id="statTotal">0</p>
            </div>
            <!-- H: Hadir (#10B981) -->
            <div class="bg-emerald-50 p-3 rounded-xl shadow-sm border border-emerald-200 text-center">
                <p class="text-[10px] text-emerald-700 font-black uppercase">[H] Hadir</p>
                <p class="text-xl font-black text-emerald-700" id="statH">0</p>
            </div>
            <!-- T: Terlambat (#F59E0B) -->
            <div class="bg-amber-50 p-3 rounded-xl shadow-sm border border-amber-200 text-center">
                <p class="text-[10px] text-amber-700 font-black uppercase">[T] Terlambat</p>
                <p class="text-xl font-black text-amber-700" id="statT">0</p>
            </div>
            <!-- S: Sakit (#8B5CF6) -->
            <div class="bg-purple-50 p-3 rounded-xl shadow-sm border border-purple-200 text-center">
                <p class="text-[10px] text-purple-700 font-black uppercase">[S] Sakit</p>
                <p class="text-xl font-black text-purple-700" id="statS">0</p>
            </div>
            <!-- I: Izin (#3B82F6) -->
            <div class="bg-blue-50 p-3 rounded-xl shadow-sm border border-blue-200 text-center">
                <p class="text-[10px] text-blue-700 font-black uppercase">[I] Izin</p>
                <p class="text-xl font-black text-blue-700" id="statI">0</p>
            </div>
            <!-- A: Alfa (#EF4444) -->
            <div class="bg-red-50 p-3 rounded-xl shadow-sm border border-red-200 text-center">
                <p class="text-[10px] text-red-700 font-black uppercase">[A] Alfa</p>
                <p class="text-xl font-black text-red-700" id="statA">0</p>
            </div>
            <!-- D: Dispensasi (#F97316) -->
            <div class="bg-orange-50 p-3 rounded-xl shadow-sm border border-orange-200 text-center">
                <p class="text-[10px] text-orange-700 font-black uppercase">[D] Dispen</p>
                <p class="text-xl font-black text-orange-700" id="statD">0</p>
            </div>
            <!-- U: UKS (#06B6D4) -->
            <div class="bg-cyan-50 p-3 rounded-xl shadow-sm border border-cyan-200 text-center">
                <p class="text-[10px] text-cyan-700 font-black uppercase">[U] UKS</p>
                <p class="text-xl font-black text-cyan-700" id="statU">0</p>
            </div>
            <!-- P: Pulang (#64748B) -->
            <div class="bg-slate-100 p-3 rounded-xl shadow-sm border border-slate-300 text-center">
                <p class="text-[10px] text-slate-700 font-black uppercase">[P] Pulang</p>
                <p class="text-xl font-black text-slate-700" id="statP">0</p>
            </div>
            <!-- L: Tugas Luar (#D97706) -->
            <div class="bg-yellow-50 p-3 rounded-xl shadow-sm border border-yellow-300 text-center">
                <p class="text-[10px] text-yellow-800 font-black uppercase">[L] Luar</p>
                <p class="text-xl font-black text-yellow-800" id="statL">0</p>
            </div>
            <!-- B: Bolos (#991B1B) -->
            <div class="bg-rose-100 p-3 rounded-xl shadow-sm border border-rose-300 text-center">
                <p class="text-[10px] text-rose-800 font-black uppercase">[B] Bolos</p>
                <p class="text-xl font-black text-rose-800" id="statB">0</p>
            </div>
            <!-- LBR: Libur (#0D9488) -->
            <div class="bg-teal-50 p-3 rounded-xl shadow-sm border border-teal-300 text-center">
                <p class="text-[10px] text-teal-800 font-black uppercase">[LBR] Libur</p>
                <p class="text-xl font-black text-teal-700" id="statLBR">0</p>
            </div>
        </div>

        <!-- 2 GRAFIK VISUALISASI: GRAFIK BATANG BULANAN & GRAFIK LINGKARAN KOMPOSISI -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <!-- Grafik Batang per Bulan (Col-span 2) -->
            <div class="lg:col-span-2 bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-xs font-bold text-gray-700 uppercase flex items-center gap-1.5">
                        <span>📊</span> Grafik Batang Tren Tingkat Kehadiran Siswa per Bulan (%)
                    </h3>
                    <span class="text-[10px] text-gray-400 font-semibold">Tahun Ajaran 2025/2026</span>
                </div>
                <div class="h-56 relative">
                    <canvas id="chartMonthlyAttendance"></canvas>
                </div>
            </div>

            <!-- Grafik Lingkaran / Donut Komposisi Status -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-xs font-bold text-gray-700 uppercase flex items-center gap-1.5">
                        <span>🍩</span> Grafik Lingkaran Komposisi Status
                    </h3>
                    <span class="text-[10px] text-emerald-600 font-bold" id="todayDateLabel">Hari Ini</span>
                </div>
                <div class="h-56 relative flex items-center justify-center">
                    <canvas id="chartStatusComposition"></canvas>
                </div>
            </div>
        </div>

        <!-- Filter Controls & Export Toolbar -->
        <div class="bg-white rounded-xl shadow-sm p-4 mb-6 border flex flex-wrap justify-between items-center gap-4">
            <div class="flex flex-wrap items-center gap-3">
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">📅 Tanggal Presensi</label>
                    <input type="date" id="filterDate" class="border p-2 rounded-lg text-xs font-semibold" onchange="loadRekap()">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">🎯 Lingkup Rekapitulasi</label>
                    <select id="filterScope" class="border p-2 rounded-lg text-xs font-bold bg-blue-50 text-blue-900" onchange="onScopeChange()">
                        <option value="ALL">Semua Kelas (Seluruh Siswa)</option>
                        <option value="GRADE">Per Tingkat / Jenjang</option>
                        <option value="CLASS" selected>Per Kelas</option>
                    </select>
                </div>
                <div id="containerGradeSelect" class="hidden">
                    <label class="block text-xs font-bold text-gray-600 mb-1">Tingkat</label>
                    <select id="filterGrade" class="border p-2 rounded-lg text-xs font-semibold" onchange="loadRekap()">
                        <option value="VII">Tingkat VII (Kelas 7)</option>
                        <option value="VIII">Tingkat VIII (Kelas 8)</option>
                        <option value="IX">Tingkat IX (Kelas 9)</option>
                    </select>
                </div>
                <div id="containerClassSelect">
                    <label class="block text-xs font-bold text-gray-600 mb-1">Pilih Kelas</label>
                    <select id="filterClass" class="border p-2 rounded-lg text-xs font-semibold" onchange="loadRekap()">
                        <option value="ALL">Semua Kelas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">🔍 Cari Nama / NISN</label>
                    <input type="text" id="searchInput" placeholder="Ketik nama atau NISN..." class="border p-2 rounded-lg text-xs" oninput="filterLocal()">
                </div>
            </div>

            <!-- Export Buttons -->
            <div class="flex flex-wrap items-center gap-2">
                <button onclick="downloadExcelRekap('xls')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-1.5 transition-all" title="Unduh File Excel Format Asli .xls">
                    <span>📊</span> Unduh Excel (.xls)
                </button>
                <button onclick="downloadExcelRekap('csv')" class="bg-teal-700 hover:bg-teal-800 text-white px-3 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-1.5 transition-all" title="Unduh CSV UTF-8">
                    <span>📑</span> Unduh CSV
                </button>
                <button onclick="downloadPdfRekap()" class="bg-slate-800 hover:bg-black text-white px-3.5 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-1.5 transition-all">
                    <span>📄</span> Cetak PDF Resmi (KOP)
                </button>
                <button onclick="triggerNotifyUnscannedAdmin()" class="bg-amber-600 hover:bg-amber-700 text-white px-3.5 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-1.5 transition-all" title="Kirim peringatan ke orang tua dan tetapkan ALPA bagi siswa yang belum scan">
                    <span>🔔</span> Tetapkan Alpa &amp; Kirim Notif
                </button>
                <button onclick="loadRekap()" class="bg-blue-50 text-blue-700 hover:bg-blue-100 px-3 py-2 rounded-lg text-xs font-bold border border-blue-200">
                    ⟳ Refresh
                </button>
            </div>
        </div>

        <!-- Attendance Table -->
        <div class="bg-white rounded-xl shadow overflow-hidden border flex flex-col">
            <div class="overflow-x-auto flex-1">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="bg-gray-100 text-gray-700 text-xs uppercase tracking-wider">
                            <th class="p-4 border-b">No</th>
                            <th class="p-4 border-b">Nama Siswa</th>
                            <th class="p-4 border-b">NISN / NIS</th>
                            <th class="p-4 border-b">Kelas</th>
                            <th class="p-4 border-b">Jam Masuk</th>
                            <th class="p-4 border-b">Jam Pulang</th>
                            <th class="p-4 border-b">Metode</th>
                            <th class="p-4 border-b">Status</th>
                            <th class="p-4 border-b">📍 Koordinat GPS</th>
                            <th class="p-4 border-b">Keterangan</th>
                            <th class="p-4 border-b text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="rekapTableBody">
                        <tr><td colspan="11" class="p-4 text-center text-gray-500">Memuat data absensi...</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="p-4 bg-gray-50 border-t flex flex-wrap justify-between items-center gap-3 text-sm text-gray-600">
                <span id="pageInfo" class="font-medium text-xs">Menampilkan 0-0 dari 0 siswa</span>
                <div class="flex items-center gap-1">
                    <button onclick="prevPage()" class="px-2.5 py-1.5 bg-gray-200 rounded-lg hover:bg-gray-300 disabled:opacity-40 font-medium text-xs transition" id="btnPrev">◀ Sebelumnya</button>
                    <div id="pageNumberButtons" class="flex items-center gap-1"></div>
                    <button onclick="nextPage()" class="px-2.5 py-1.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-40 font-medium text-xs transition shadow-sm" id="btnNext">Selanjutnya ▶</button>
                </div>
            </div>
        </div>
    </main>

    <!-- Modal Input Manual -->
    <div id="modalManual" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-2xl">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <h2 class="text-lg font-bold text-gray-800">Input Presensi Manual</h2>
                <button onclick="document.getElementById('modalManual').classList.add('hidden')" class="text-gray-400 text-2xl font-bold">&times;</button>
            </div>
            <form id="manualAttendanceForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Cari & Pilih Siswa *</label>
                    <div class="grid grid-cols-2 gap-2 mb-2">
                        <select id="filterManualRekapClass" class="w-full border p-1.5 rounded text-xs font-semibold bg-gray-50" onchange="filterManualRekapUsers()">
                            <option value="ALL">Semua Kelas</option>
                        </select>
                        <input type="text" id="searchManualRekapUser" placeholder="🔍 Cari nama/NISN..." class="w-full border p-1.5 rounded text-xs bg-gray-50" oninput="filterManualRekapUsers()">
                    </div>
                    <select id="manualUserId" class="w-full border p-2.5 rounded text-sm font-semibold" required size="4">
                        <option value="">Pilih Siswa</option>
                    </select>
                    <span id="manualRekapCount" class="text-[10px] text-gray-400 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Status Kehadiran *</label>
                    <select id="manualStatus" class="w-full border p-2.5 rounded text-sm" required>
                        <option value="PRESENT">Hadir Tepat Waktu</option>
                        <option value="LATE">Terlambat</option>
                        <option value="PERMISSION">Izin</option>
                        <option value="SICK">Sakit</option>
                        <option value="ABSENT">Alpa (Tanpa Keterangan)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Catatan / Keterangan</label>
                    <input type="text" id="manualNote" placeholder="Cth: Surat dokter / ada urusan keluarga" class="w-full border p-2.5 rounded text-sm">
                </div>
                <div class="flex justify-end gap-2 pt-4 border-t">
                    <button type="button" onclick="document.getElementById('modalManual').classList.add('hidden')" class="bg-gray-300 text-gray-700 px-4 py-2 rounded text-sm font-semibold">Batal</button>
                    <button type="submit" class="bg-blue-600 text-white px-5 py-2 rounded text-sm font-semibold shadow">Simpan Presensi</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Kelola Hari Libur Sekolah -->
    <div id="modalHoliday" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl max-h-[90vh] flex flex-col">
            <div class="flex justify-between items-center pb-3 border-b mb-4">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">🌴</span>
                    <h3 class="font-black text-slate-800 text-base">Kelola Hari Libur &amp; Situasi Khusus Sekolah</h3>
                </div>
                <button onclick="closeHolidayModal()" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
            </div>
            
            <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                Pada tanggal libur yang didaftarkan di sini, siswa yang tidak melakukan scan presensi akan otomatis berstatus <strong>[LBR] Libur</strong> (bukan Alfa/Bolos), serta terintegrasi langsung ke APK Mobile dan seluruh rekapitulasi.
            </p>

            <!-- Form Tambah Hari Libur -->
            <form id="formAddHoliday" onsubmit="saveHoliday(event)" class="bg-slate-50 p-4 rounded-xl border border-slate-200 mb-4 space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Tanggal Libur *</label>
                        <input type="date" id="holidayDate" required class="w-full border p-2 rounded-lg text-xs font-semibold bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Nama / Agenda Libur *</label>
                        <input type="text" id="holidayName" required placeholder="Cth: Cuti Bersama Idul Fitri" class="w-full border p-2 rounded-lg text-xs font-semibold bg-white">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Keterangan / Situasi Khusus (Opsional)</label>
                    <input type="text" id="holidayDesc" placeholder="Cth: Libur bencana alam / KBM tatap muka ditiadakan" class="w-full border p-2 rounded-lg text-xs bg-white">
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-1.5 transition">
                        <span>➕</span> Tambahkan Tanggal Libur
                    </button>
                </div>
            </form>

            <!-- List Hari Libur Aktif -->
            <div class="flex-1 overflow-y-auto">
                <h4 class="text-xs font-bold text-slate-700 uppercase mb-2">Daftar Hari Libur Khusus Sekolah Terdaftar</h4>
                <div id="holidayListContainer" class="space-y-2">
                    <p class="text-xs text-slate-400 py-4 text-center">Memuat daftar libur...</p>
                </div>
            </div>

            <div class="pt-4 border-t mt-4 flex justify-end">
                <button onclick="closeHolidayModal()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-lg text-xs font-bold">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token') || '';
        if(!token) window.location.href = '/';

        let rekapRecords = [];
        let filteredRecords = [];
        let currentPage = 1;
        const rowsPerPage = 50;

        // Set default date to today
        document.getElementById('filterDate').value = new Date().toISOString().split('T')[0];

        function onScopeChange() {
            const scope = document.getElementById('filterScope').value;
            const containerGrade = document.getElementById('containerGradeSelect');
            const containerClass = document.getElementById('containerClassSelect');

            if (scope === 'ALL') {
                containerGrade.classList.add('hidden');
                containerClass.classList.add('hidden');
            } else if (scope === 'GRADE') {
                containerGrade.classList.remove('hidden');
                containerClass.classList.add('hidden');
            } else {
                containerGrade.classList.add('hidden');
                containerClass.classList.remove('hidden');
            }
            loadRekap();
        }

        async function loadClasses() {
            try {
                const res = await fetch('/api/kelas', { headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                if(Array.isArray(data)) {
                    const sel = document.getElementById('filterClass');
                    sel.innerHTML = '<option value="ALL">Semua Kelas</option>';
                    data.forEach(k => {
                        sel.innerHTML += '<option value="' + k.nama + '">Kelas ' + k.nama + '</option>';
                    });
                    // Set default to VII-A
                    const viia = data.find(k => k.nama === 'VII-A' || k.nama === 'VII A' || k.nama.replace(/\s+/g, '').toUpperCase() === 'VIIA');
                    if (viia) {
                        sel.value = viia.nama;
                    } else {
                        const anyVII = data.find(k => k.nama.startsWith('VII'));
                        if (anyVII) sel.value = anyVII.nama;
                    }
                }
            } catch(e) {}
        }

        async function loadRekap() {
            const date = document.getElementById('filterDate').value;
            const scope = document.getElementById('filterScope').value;
            let className = '';
            let grade = '';

            let queryUrl = '/api/attendance/rekap?date=' + encodeURIComponent(date);

            if (scope === 'ALL') {
                queryUrl += '&scope=ALL';
            } else if (scope === 'GRADE') {
                grade = document.getElementById('filterGrade').value;
                queryUrl += '&scope=GRADE&grade=' + encodeURIComponent(grade);
            } else {
                className = document.getElementById('filterClass').value;
                queryUrl += '&scope=CLASS&className=' + encodeURIComponent(className);
            }

            try {
                const res = await fetch(queryUrl, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();

                if(data && data.records) {
                    rekapRecords = data.records;
                    filteredRecords = [...rekapRecords];

                    // Check Holiday Banner
                    const holidayBanner = document.getElementById('holidayBanner');
                    if (holidayBanner) {
                        if (data.isHoliday && data.holiday) {
                            holidayBanner.classList.remove('hidden');
                            document.getElementById('holidayBannerTitle').innerText = data.holiday.name || 'Hari Libur Sekolah';
                            document.getElementById('holidayBannerDesc').innerText = (data.holiday.description || 'Hari libur resmi sekolah') + '. Seluruh siswa yang tidak scan barcode tercatat sebagai [LBR] Libur (bukan Alfa/Bolos).';
                        } else {
                            holidayBanner.classList.add('hidden');
                        }
                    }

                    // Update 11 status cards + total
                    const c = data.counts || {};
                    if(document.getElementById('statTotal')) document.getElementById('statTotal').innerText = c.total || 0;
                    if(document.getElementById('statH')) document.getElementById('statH').innerText = c.H ?? (c.present || 0);
                    if(document.getElementById('statT')) document.getElementById('statT').innerText = c.T ?? (c.late || 0);
                    if(document.getElementById('statS')) document.getElementById('statS').innerText = c.S ?? (c.sick || 0);
                    if(document.getElementById('statI')) document.getElementById('statI').innerText = c.I ?? (c.permission || 0);
                    if(document.getElementById('statA')) document.getElementById('statA').innerText = c.A ?? (c.absent || 0);
                    if(document.getElementById('statD')) document.getElementById('statD').innerText = c.D || 0;
                    if(document.getElementById('statU')) document.getElementById('statU').innerText = c.U || 0;
                    if(document.getElementById('statP')) document.getElementById('statP').innerText = c.P || 0;
                    if(document.getElementById('statL')) document.getElementById('statL').innerText = c.L || 0;
                    if(document.getElementById('statB')) document.getElementById('statB').innerText = c.B || 0;
                    if(document.getElementById('statLBR')) document.getElementById('statLBR').innerText = c.LBR || 0;

                    // Render Visualizations
                    renderCharts(c, data.monthlyStats);

                    // Populate manual user dropdown & filter classes
                    const classSelect = document.getElementById('filterManualRekapClass');
                    const classSet = new Set();

                    rekapRecords.forEach(s => {
                        if(s.className) classSet.add(s.className);
                    });

                    if(classSelect && classSelect.children.length <= 1) {
                        classSelect.innerHTML = '<option value="ALL">Semua Kelas</option>';
                        Array.from(classSet).sort().forEach(c => {
                            classSelect.innerHTML += '<option value="' + c + '">Kelas ' + c + '</option>';
                        });
                    }

                    filterManualRekapUsers();
                    currentPage = 1;
                    renderTable();
                }
            } catch(e) {
                console.error(e);
            }
        }

        let chartMonthly = null;
        let chartDonut = null;

        function renderCharts(counts, monthlyStats) {
            if (typeof Chart === 'undefined') return;

            // 1. Monthly Attendance Bar Chart
            const canvasMonthly = document.getElementById('chartMonthlyAttendance');
            if (canvasMonthly) {
                const ctxMonthly = canvasMonthly.getContext('2d');
                if (chartMonthly) chartMonthly.destroy();

                const labels = Array.isArray(monthlyStats) && monthlyStats.length > 0 
                    ? monthlyStats.map(m => m.month) 
                    : ['Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des', 'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun'];
                const dataValues = Array.isArray(monthlyStats) && monthlyStats.length > 0 
                    ? monthlyStats.map(m => m.rate) 
                    : [94, 96, 95, 93, 97, 92, 95, 96, 94, 95, 97, 96];

                chartMonthly = new Chart(ctxMonthly, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Tingkat Kehadiran (%)',
                            data: dataValues,
                            backgroundColor: '#10B981',
                            borderRadius: 6,
                            maxBarThickness: 32
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                ticks: {
                                    callback: function(value) { return value + '%'; }
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            // 2. Status Composition Donut Chart
            const canvasDonut = document.getElementById('chartStatusComposition');
            if (canvasDonut) {
                const ctxDonut = canvasDonut.getContext('2d');
                if (chartDonut) chartDonut.destroy();

                const statusLabels = [
                    'Hadir [H]', 'Terlambat [T]', 'Sakit [S]', 'Izin [I]', 'Alfa [A]',
                    'Dispensasi [D]', 'UKS [U]', 'Pulang [P]', 'Tugas Luar [L]', 'Bolos [B]', 'Libur [LBR]'
                ];
                const statusData = [
                    counts?.H || 0,
                    counts?.T || 0,
                    counts?.S || 0,
                    counts?.I || 0,
                    counts?.A || 0,
                    counts?.D || 0,
                    counts?.U || 0,
                    counts?.P || 0,
                    counts?.L || 0,
                    counts?.B || 0,
                    counts?.LBR || 0
                ];
                const statusColors = [
                    '#10B981', // H Hadir
                    '#F59E0B', // T Terlambat
                    '#8B5CF6', // S Sakit
                    '#3B82F6', // I Izin
                    '#EF4444', // A Alfa
                    '#F97316', // D Dispensasi
                    '#06B6D4', // U UKS
                    '#64748B', // P Pulang
                    '#D97706', // L Luar
                    '#991B1B', // B Bolos
                    '#0D9488'  // LBR Libur
                ];

                chartDonut = new Chart(ctxDonut, {
                    type: 'doughnut',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: statusData,
                            backgroundColor: statusColors,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '62%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 9,
                                    font: { size: 9 }
                                }
                            }
                        }
                    }
                });
            }
        }

        function filterManualRekapUsers() {
            const classFilter = document.getElementById('filterManualRekapClass')?.value || 'ALL';
            const searchQuery = (document.getElementById('searchManualRekapUser')?.value || '').toLowerCase().trim();
            const selUser = document.getElementById('manualUserId');
            if(!selUser || !Array.isArray(rekapRecords)) return;

            const filtered = rekapRecords.filter(s => {
                const matchesClass = (classFilter === 'ALL' || (s.className && s.className.toUpperCase() === classFilter.toUpperCase()));
                const nameStr = (s.name || '').toLowerCase();
                const nisnStr = (s.nisn || '').toLowerCase();
                return matchesClass && (!searchQuery || nameStr.includes(searchQuery) || nisnStr.includes(searchQuery));
            });

            selUser.innerHTML = '<option value="">Pilih Siswa (' + filtered.length + ' Ditemukan)</option>';
            filtered.forEach(s => {
                selUser.innerHTML += '<option value="' + s.userId + '">' + s.name + ' (' + s.className + ') - ' + s.nisn + '</option>';
            });

            const countEl = document.getElementById('manualRekapCount');
            if(countEl) {
                countEl.innerText = filtered.length + ' siswa ditemukan';
            }
        }

        function filterLocal() {
            const q = (document.getElementById('searchInput').value || '').toLowerCase();
            filteredRecords = rekapRecords.filter(r => 
                (r.name && r.name.toLowerCase().includes(q)) || 
                (r.nisn && r.nisn.toLowerCase().includes(q)) ||
                (r.className && r.className.toLowerCase().includes(q))
            );
            currentPage = 1;
            renderTable();
        }

        function renderTable() {
            const tbody = document.getElementById('rekapTableBody');
            tbody.innerHTML = '';

            if(filteredRecords.length === 0) {
                tbody.innerHTML = '<tr><td colspan="11" class="p-4 text-center text-gray-500">Tidak ada data absensi ditemukan</td></tr>';
                document.getElementById('pageInfo').innerText = '0 siswa';
                document.getElementById('btnPrev').disabled = true;
                document.getElementById('btnNext').disabled = true;
                return;
            }

            const totalPages = Math.max(1, Math.ceil(filteredRecords.length / rowsPerPage));
            if(currentPage > totalPages) currentPage = totalPages;

            const start = (currentPage - 1) * rowsPerPage;
            const end = start + rowsPerPage;
            const paginatedData = filteredRecords.slice(start, end);

            paginatedData.forEach((r, idx) => {
                let badge = '<span class="bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full text-xs font-semibold">Belum Presensi</span>';
                const code = r.statusCode || '';
                if(code === 'H' || r.status === 'PRESENT') {
                    badge = '<span class="bg-emerald-100 text-emerald-800 border border-emerald-300 px-2.5 py-1 rounded-full text-xs font-bold">[H] Hadir</span>';
                } else if(code === 'T' || r.status === 'LATE') {
                    badge = '<span class="bg-amber-100 text-amber-800 border border-amber-300 px-2.5 py-1 rounded-full text-xs font-bold">[T] Terlambat</span>';
                } else if(code === 'S' || r.status === 'SICK') {
                    badge = '<span class="bg-purple-100 text-purple-800 border border-purple-300 px-2.5 py-1 rounded-full text-xs font-bold">[S] Sakit</span>';
                } else if(code === 'I' || r.status === 'PERMISSION') {
                    badge = '<span class="bg-blue-100 text-blue-800 border border-blue-300 px-2.5 py-1 rounded-full text-xs font-bold">[I] Izin</span>';
                } else if(code === 'A' || r.status === 'ABSENT') {
                    badge = '<span class="bg-red-100 text-red-800 border border-red-300 px-2.5 py-1 rounded-full text-xs font-bold">[A] Alfa</span>';
                } else if(code === 'D' || r.status === 'DISPENSATION') {
                    badge = '<span class="bg-orange-100 text-orange-800 border border-orange-300 px-2.5 py-1 rounded-full text-xs font-bold">[D] Dispensasi</span>';
                } else if(code === 'U' || r.status === 'UKS') {
                    badge = '<span class="bg-cyan-100 text-cyan-800 border border-cyan-300 px-2.5 py-1 rounded-full text-xs font-bold">[U] UKS</span>';
                } else if(code === 'P' || r.status === 'EARLY_LEAVE') {
                    badge = '<span class="bg-slate-200 text-slate-800 border border-slate-300 px-2.5 py-1 rounded-full text-xs font-bold">[P] Pulang</span>';
                } else if(code === 'L' || r.status === 'OUTDOOR_ASSIGNMENT') {
                    badge = '<span class="bg-yellow-100 text-yellow-900 border border-yellow-300 px-2.5 py-1 rounded-full text-xs font-bold">[L] Tugas Luar</span>';
                } else if(code === 'B' || r.status === 'TRUANT') {
                    badge = '<span class="bg-rose-200 text-rose-950 border border-rose-400 px-2.5 py-1 rounded-full text-xs font-bold">[B] Bolos</span>';
                } else if(code === 'LBR' || r.status === 'HOLIDAY') {
                    badge = '<span class="bg-teal-100 text-teal-900 border border-teal-400 px-2.5 py-1 rounded-full text-xs font-bold">🌴 [LBR] Libur</span>';
                }

                const scanTimeFormatted = r.gateInTime || (r.scanTime ? new Date(r.scanTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WIB' : '-');
                const gateOutFormatted = r.gateOutTime || '-';

                let geoCell = '<span class="text-gray-400 text-xs">-</span>';
                if (r.lat && r.lng) {
                    const mockBadge = r.isFakeGps 
                        ? '<span class="bg-red-100 text-red-700 text-[10px] font-extrabold px-1.5 py-0.5 rounded ml-1 border border-red-300">🚨 MOCK</span>' 
                        : '<span class="bg-emerald-100 text-emerald-700 text-[10px] font-bold px-1.5 py-0.5 rounded ml-1 border border-emerald-300">✓ VALID</span>';
                    geoCell = '<div class="flex flex-col gap-1">' +
                                '<span class="font-mono text-xs text-blue-800 font-semibold">' + Number(r.lat).toFixed(5) + ', ' + Number(r.lng).toFixed(5) + '</span>' +
                                '<div class="flex items-center gap-1">' +
                                    '<a href="https://www.google.com/maps?q=' + r.lat + ',' + r.lng + '" target="_blank" class="inline-flex items-center gap-1 text-[11px] font-bold text-blue-600 hover:text-blue-800 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">📍 Maps ↗</a>' +
                                    mockBadge +
                                '</div>' +
                              '</div>';
                }

                tbody.innerHTML += '<tr class="hover:bg-blue-50 border-b text-sm">' +
                    '<td class="p-4 text-gray-500">' + (start + idx + 1) + '</td>' +
                    '<td class="p-4 font-bold text-gray-800">' + (r.name || '-') + '</td>' +
                    '<td class="p-4 font-mono text-xs text-gray-600">' + (r.nisn || '-') + '</td>' +
                    '<td class="p-4"><span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded text-xs font-semibold border border-blue-200">' + (r.className || '-') + '</span></td>' +
                    '<td class="p-4 font-mono text-xs font-semibold text-emerald-700">' + scanTimeFormatted + '</td>' +
                    '<td class="p-4 font-mono text-xs font-semibold text-blue-700">' + gateOutFormatted + '</td>' +
                    '<td class="p-4 text-xs font-medium text-gray-600">' + (r.method || '-') + '</td>' +
                    '<td class="p-4">' + badge + '</td>' +
                    '<td class="p-4">' + geoCell + '</td>' +
                    '<td class="p-4 text-xs text-gray-500 max-w-[200px] truncate">' + (r.note || '-') + '</td>' +
                    '<td class="p-4 text-center">' +
                        '<button onclick="quickEdit(\'' + r.userId + '\', \'' + r.status + '\')" class="text-blue-600 hover:underline font-bold text-xs bg-blue-50 px-2.5 py-1 rounded border border-blue-200">Ubah</button>' +
                    '</td>' +
                '</tr>';
            });

            document.getElementById('pageInfo').innerText = 'Menampilkan ' + (start + 1) + '-' + Math.min(end, filteredRecords.length) + ' dari ' + filteredRecords.length + ' siswa';
            document.getElementById('btnPrev').disabled = currentPage === 1;
            document.getElementById('btnNext').disabled = currentPage === totalPages;
            renderPageNumbers(totalPages);
        }

        function renderPageNumbers(totalPages) {
            const container = document.getElementById('pageNumberButtons');
            if (!container) return;
            container.innerHTML = '';
            if (totalPages <= 1) return;

            const maxVisible = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            if (endPage - startPage + 1 < maxVisible) {
                startPage = Math.max(1, endPage - maxVisible + 1);
            }

            if (startPage > 1) {
                const btn1 = document.createElement('button');
                btn1.className = 'px-2.5 py-1 text-xs rounded border border-gray-300 hover:bg-gray-100 font-semibold text-gray-700';
                btn1.innerText = '1';
                btn1.onclick = () => goToPage(1);
                container.appendChild(btn1);

                if (startPage > 2) {
                    const dots = document.createElement('span');
                    dots.className = 'px-1 text-gray-400 text-xs font-bold';
                    dots.innerText = '...';
                    container.appendChild(dots);
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                const btn = document.createElement('button');
                btn.className = `px-2.5 py-1 text-xs rounded font-bold transition ${i === currentPage ? 'bg-blue-600 text-white shadow-sm' : 'border border-gray-300 hover:bg-gray-100 text-gray-700'}`;
                btn.innerText = i;
                btn.onclick = () => goToPage(i);
                container.appendChild(btn);
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    const dots = document.createElement('span');
                    dots.className = 'px-1 text-gray-400 text-xs font-bold';
                    dots.innerText = '...';
                    container.appendChild(dots);
                }
                const btnLast = document.createElement('button');
                btnLast.className = 'px-2.5 py-1 text-xs rounded border border-gray-300 hover:bg-gray-100 font-semibold text-gray-700';
                btnLast.innerText = totalPages;
                btnLast.onclick = () => goToPage(totalPages);
                container.appendChild(btnLast);
            }
        }

        function goToPage(p) {
            currentPage = p;
            renderTable();
        }

        function prevPage() { if(currentPage > 1) { currentPage--; renderTable(); } }
        function nextPage() { if(currentPage * rowsPerPage < filteredRecords.length) { currentPage++; renderTable(); } }

        function filterManualRekapUsers() {
            const classFilter = document.getElementById('filterManualRekapClass')?.value || 'ALL';
            const searchQuery = (document.getElementById('searchManualRekapUser')?.value || '').toLowerCase().trim();
            const select = document.getElementById('manualUserId');
            if (!select) return;

            select.innerHTML = '<option value="">-- Pilih Siswa --</option>';
            let count = 0;

            const list = Array.isArray(rekapRecords) ? rekapRecords : [];
            list.forEach(s => {
                const matchesClass = (classFilter === 'ALL' || s.className === classFilter);
                const nameMatches = (s.name || '').toLowerCase().includes(searchQuery);
                const nisnMatches = (s.nisn || '').toLowerCase().includes(searchQuery);
                const matchesSearch = searchQuery === '' || nameMatches || nisnMatches;

                if (matchesClass && matchesSearch) {
                    const opt = document.createElement('option');
                    opt.value = s.userId;
                    opt.textContent = `${s.name} (${s.className || '-'} - NISN: ${s.nisn || '-'})`;
                    select.appendChild(opt);
                    count++;
                }
            });

            const countEl = document.getElementById('manualRekapCount');
            if (countEl) {
                countEl.innerText = (searchQuery || classFilter !== 'ALL') 
                    ? `Ditemukan ${count} siswa (dari total ${list.length})` 
                    : `Menampilkan seluruh ${count} siswa`;
            }
        }

        function openManualModal() {
            document.getElementById('modalManual').classList.remove('hidden');
            const searchInput = document.getElementById('searchManualRekapUser');
            if(searchInput) searchInput.value = '';
            filterManualRekapUsers();
        }

        function quickEdit(userId, currentStatus) {
            document.getElementById('manualUserId').value = userId;
            document.getElementById('manualStatus').value = currentStatus !== 'NOT_YET' ? currentStatus : 'PRESENT';
            document.getElementById('modalManual').classList.remove('hidden');
        }

        document.getElementById('manualAttendanceForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
                userId: document.getElementById('manualUserId').value,
                status: document.getElementById('manualStatus').value,
                note: document.getElementById('manualNote').value,
                scanDate: document.getElementById('filterDate').value
            };

            const res = await fetch('/api/attendance/manual', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify(payload)
            });

            if(res.ok) {
                alert('Presensi berhasil diperbarui');
                document.getElementById('modalManual').classList.add('hidden');
                document.getElementById('manualNote').value = '';
                loadRekap();
            } else {
                alert('Gagal memperbarui presensi');
            }
        });

        function getExportParams() {
            const date = document.getElementById('filterDate').value;
            const scope = document.getElementById('filterScope').value;
            let query = 'date=' + encodeURIComponent(date) + '&scope=' + encodeURIComponent(scope) + '&token=' + encodeURIComponent(token);

            if (scope === 'GRADE') {
                const grade = document.getElementById('filterGrade').value;
                query += '&grade=' + encodeURIComponent(grade);
            } else if (scope === 'CLASS') {
                const className = document.getElementById('filterClass').value;
                query += '&className=' + encodeURIComponent(className);
            }
            return query;
        }

        function downloadExcelRekap(format = 'xls') {
            const params = getExportParams();
            window.open('/api/attendance/export-excel?' + params + '&format=' + encodeURIComponent(format), '_blank');
        }

        function downloadPdfRekap() {
            const params = getExportParams();
            window.open('/api/attendance/export-pdf?' + params, '_blank');
        }

        async function triggerNotifyUnscannedAdmin() {
            if (!confirm('Kirim notifikasi peringatan ke orang tua dan tetapkan status ALPA otomatis (+10 poin disiplin) bagi siswa yang belum scan barcode masuk hari ini?')) {
                return;
            }
            try {
                const res = await fetch('/api/attendance/check-unscanned', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                alert(data.message || 'Pemeriksaan presensi selesai.');
                loadRekap();
            } catch (e) {
                alert('Gagal: ' + e.message);
            }
        }

        async function openHolidayModal() {
            document.getElementById('modalHoliday').classList.remove('hidden');
            document.getElementById('holidayDate').value = document.getElementById('filterDate').value || new Date().toISOString().split('T')[0];
            await loadSchoolHolidaysList();
        }

        function closeHolidayModal() {
            document.getElementById('modalHoliday').classList.add('hidden');
        }

        async function loadSchoolHolidaysList() {
            const container = document.getElementById('holidayListContainer');
            try {
                const res = await fetch('/api/calendar/school-holidays', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                const list = data.holidays || [];
                if (list.length === 0) {
                    container.innerHTML = '<p class="text-xs text-slate-400 py-4 text-center">Belum ada hari libur sekolah khusus yang didaftarkan.</p>';
                    return;
                }
                container.innerHTML = list.map(h => `
                    <div class="flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl shadow-sm hover:border-teal-300">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="bg-teal-100 text-teal-800 text-[10px] font-bold px-2 py-0.5 rounded font-mono">${h.date}</span>
                                <strong class="text-xs text-slate-800 font-bold">${h.name}</strong>
                            </div>
                            ${h.description ? `<p class="text-[11px] text-slate-500 mt-0.5">${h.description}</p>` : ''}
                        </div>
                        <button onclick="deleteSchoolHoliday('${h.date}')" class="text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100 px-2.5 py-1 rounded-lg text-xs font-bold transition">
                            Hapus 🗑️
                        </button>
                    </div>
                `).join('');
            } catch (err) {
                container.innerHTML = '<p class="text-xs text-red-500 py-2">Gagal memuat data libur.</p>';
            }
        }

        async function saveHoliday(e) {
            e.preventDefault();
            const date = document.getElementById('holidayDate').value;
            const name = document.getElementById('holidayName').value;
            const description = document.getElementById('holidayDesc').value;

            try {
                const res = await fetch('/api/calendar/school-holidays', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ date, name, description })
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message || 'Hari libur berhasil disimpan!');
                    document.getElementById('holidayName').value = '';
                    document.getElementById('holidayDesc').value = '';
                    await loadSchoolHolidaysList();
                    loadRekap();
                } else {
                    alert(data.message || 'Gagal menyimpan hari libur');
                }
            } catch (err) {
                alert('Terjadi kesalahan: ' + err.message);
            }
        }

        async function deleteSchoolHoliday(date) {
            if (!confirm(`Hapus status libur untuk tanggal ${date}? Siswa pada tanggal tersebut akan kembali dihitung presensi normal.`)) return;
            try {
                const res = await fetch('/api/calendar/school-holidays/' + date, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                alert(data.message || 'Hari libur berhasil dihapus');
                await loadSchoolHolidaysList();
                loadRekap();
            } catch (err) {
                alert('Gagal menghapus: ' + err.message);
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        // Jalankan saat load berurutan agar filter VII-A aktif
        (async () => {
            await loadClasses();
            await loadRekap();
        })();
    </script>
</body>
</html>
