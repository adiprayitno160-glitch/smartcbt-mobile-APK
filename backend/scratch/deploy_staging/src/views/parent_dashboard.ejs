<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Orang Tua Siswa - Grafik & Analitik Perkembangan Anak</title>
    <script src="/js/tailwind.js"></script>
    <script src="/js/chart.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0A2E5C; }
        .bg-unbk-blue { background-color: #1565C0; }
        .gradient-card-growth {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        }
        .progress-pill { transition: all 0.2s ease; }
        .progress-pill:hover { transform: translateY(-2px); }
    </style>
</head>
<body class="bg-slate-100 min-h-screen pb-16">
    <!-- Top Header Navigation -->
    <header class="bg-[#0e1d40] text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center font-bold text-2xl shadow">
                    👨‍👩‍👧
                </div>
                <div>
                    <h1 class="font-black text-lg leading-tight" id="parentHeaderWelcome">Portal Orang Tua / Wali Siswa</h1>
                    <p class="text-xs text-blue-200" id="parentHeaderSub">Monitoring Realtime Grafik Perkembangan Akademik & Karakter Anak</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs bg-blue-800/80 px-3.5 py-1.5 rounded-full font-bold border border-blue-600/50" id="parentUserBadge">Wali Murid</span>
                <button onclick="logout()" class="bg-red-600 hover:bg-red-700 text-white text-xs font-bold px-4 py-2 rounded-xl shadow transition-colors">Logout</button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8 space-y-6">
        <!-- 1. IDENTITAS PROFIL ANAK & HIGHLIGHT PRESTASI -->
        <div class="bg-white rounded-3xl shadow-sm border p-6 flex flex-col md:flex-row items-center gap-6">
            <div class="w-24 h-24 rounded-3xl bg-gradient-to-tr from-blue-600 to-indigo-700 text-white flex items-center justify-center font-black text-4xl shadow-xl border-4 border-white" id="childAvatar">
                S
            </div>
            <div class="flex-1 text-center md:text-left">
                <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5 mb-1.5">
                    <h2 class="text-2xl font-black text-gray-900" id="childName">Nama Siswa</h2>
                    <span class="bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-full font-bold">🟢 Siswa Aktif CBT</span>
                    <span class="bg-purple-100 text-purple-800 text-xs px-3 py-1 rounded-full font-bold" id="badgeRank">🏆 Peringkat 3 di Kelas</span>
                </div>
                <p class="text-sm font-bold text-blue-800 mb-2">Tingkat & Rombel: <span id="childClass" class="bg-blue-50 px-2 py-0.5 rounded-lg border border-blue-200">Kelas VII-A</span></p>
                <div class="flex flex-wrap justify-center md:justify-start gap-4 text-xs text-gray-500 font-mono">
                    <span>NISN: <b class="text-gray-800" id="childNisn">-</b></span>
                    <span>NIS: <b class="text-gray-800" id="childNis">-</b></span>
                    <span>Wali / Orang Tua: <b class="text-gray-800" id="childParentName">-</b></span>
                </div>
            </div>
            <div class="flex flex-col items-center md:items-end gap-2">
                <div class="bg-gradient-to-br from-emerald-500 to-teal-700 text-white p-4 rounded-2xl shadow-lg text-center min-w-[160px]">
                    <p class="text-[11px] uppercase tracking-wider font-bold opacity-90">Rata-rata Nilai</p>
                    <p class="text-3xl font-black" id="scoreOverall">88.6</p>
                    <p class="text-[10px] font-semibold mt-0.5">Predikat A (Sangat Baik)</p>
                </div>
            </div>
        </div>

        <!-- 🕒 PRESENSI HARI INI & JADWAL TUGAS ANAK -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Kartu Presensi Hari Ini (Datang jam berapa & Pulang jam berapa) -->
            <div class="bg-white rounded-3xl shadow-sm border p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-black text-sm text-gray-800 flex items-center gap-2">
                            <span>🕒</span> Presensi Real-Time Hari Ini
                        </h3>
                        <span id="badgeTodayStatus" class="bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-full font-bold">HADIR TEPAT WAKTU</span>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <!-- Datang Jam Berapa -->
                        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4">
                            <p class="text-[11px] font-bold text-emerald-800 uppercase tracking-wider">🚪 Jam Datang (Masuk)</p>
                            <p class="text-2xl font-black text-emerald-900 mt-1" id="webTodayGateIn">06:45 WIB</p>
                            <p class="text-[11px] text-emerald-700 mt-1">Scan Gate Barcode Kelas</p>
                        </div>
                        <!-- Pulang Jam Berapa -->
                        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-4">
                            <p class="text-[11px] font-bold text-blue-800 uppercase tracking-wider">🏠 Jam Pulang (Keluar)</p>
                            <p class="text-2xl font-black text-blue-900 mt-1" id="webTodayGateOut">--:-- WIB</p>
                            <p class="text-[11px] text-blue-700 mt-1" id="webTodayGateOutNote">Belum scan pulang</p>
                        </div>
                    </div>
                </div>

                <!-- Notifikasi Absensi Otomatis untuk Orang Tua -->
                <div class="mt-4 p-3.5 bg-amber-50 border border-amber-200 rounded-2xl flex items-start gap-3">
                    <span class="text-xl">🔔</span>
                    <div class="text-xs text-amber-900 flex-1">
                        <p class="font-bold" id="webNotifTitle">✅ Notifikasi Kehadiran Terverifikasi</p>
                        <p class="mt-0.5 text-amber-800" id="webNotifMessage">Ananda telah melakukan scan barcode di ruang kelas tepat waktu pada pukul 06:45 WIB.</p>
                    </div>
                </div>
            </div>

            <!-- Kartu Jadwal Tugas & PR Anak -->
            <div class="bg-white rounded-3xl shadow-sm border p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-black text-sm text-gray-800 flex items-center gap-2">
                            <span>📚</span> Jadwal Tugas &amp; PR Anak
                        </h3>
                        <span id="badgeHomeworkCount" class="bg-indigo-100 text-indigo-800 text-xs px-3 py-1 rounded-full font-bold">0 Tugas</span>
                    </div>
                    <div id="webHomeworkContainer" class="space-y-2.5 max-h-52 overflow-y-auto pr-1 text-xs">
                        <div class="p-3 bg-slate-50 border rounded-xl text-gray-500 text-center">Memuat jadwal tugas anak...</div>
                    </div>
                </div>
                <p class="text-[11px] text-gray-400 mt-3 pt-3 border-t">Memantau batas waktu pengumpulan tugas agar ananda tidak terlambat mengumpulkan.</p>
            </div>
        </div>

        <!-- 2. SECTION UTAMA: GRAFIK PERKEMBANGAN ANAK -->
        <div class="bg-white rounded-3xl shadow-sm border p-6">
            <div class="flex flex-wrap justify-between items-center mb-6 pb-4 border-b gap-3">
                <div>
                    <h3 class="text-lg font-black text-gray-800 flex items-center gap-2">
                        <span>📈</span> Grafik Perkembangan Belajar & Nilai Anak
                    </h3>
                    <p class="text-xs text-gray-500">Visualisasi kenaikan nilai ujian berkala dan perbandingan terhadap rata-rata kelas</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-xl font-bold flex items-center gap-1">
                        <span>↗️</span> <span id="trendStatusText">Meningkat (+14.8%)</span>
                    </span>
                </div>
            </div>

            <!-- Grid 2 Grafik Visual: Tren Line Chart & Bar Mapel Chart -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Grafik 1: Tren Nilai Ujian dari Waktu ke Waktu -->
                <div class="bg-slate-50 p-5 rounded-2xl border flex flex-col justify-between">
                    <div>
                        <h4 class="font-bold text-xs uppercase tracking-wider text-gray-700 mb-1 flex items-center gap-1.5">
                            <span>📊</span> Tren Nilai Ujian (UH 1 ➔ PTS ➔ UH 2 ➔ PAS)
                        </h4>
                        <p class="text-[11px] text-gray-500 mb-4">Garis biru menunjukkan nilai anak, garis abu-abu rata-rata kelas</p>
                    </div>
                    <div class="h-64 relative">
                        <canvas id="chartTrendExam"></canvas>
                    </div>
                </div>

                <!-- Grafik 2: Penguasaan per Mata Pelajaran -->
                <div class="bg-slate-50 p-5 rounded-2xl border flex flex-col justify-between">
                    <div>
                        <h4 class="font-bold text-xs uppercase tracking-wider text-gray-700 mb-1 flex items-center gap-1.5">
                            <span>🎯</span> Penguasaan Nilai per Mata Pelajaran (Target KKM: 75)
                        </h4>
                        <p class="text-[11px] text-gray-500 mb-4">Seluruh mata pelajaran berada di atas standar KKM</p>
                    </div>
                    <div class="h-64 relative">
                        <canvas id="chartSubjectPerformance"></canvas>
                    </div>
                </div>
            </div>

            <!-- Rincian Nilai Mapel Interaktif & Progress Bar -->
            <div class="mt-6 pt-6 border-t">
                <h4 class="font-bold text-xs uppercase tracking-wider text-gray-700 mb-4 flex items-center gap-1.5">
                    <span>📚</span> Rincian Penguasaan Materi Belajar di Sekolah
                </h4>
                <div id="subjectProgressList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
                    <!-- Injected via JS -->
                </div>
            </div>
        </div>

        <!-- 3. SECTION DISIPLIN, KEHADIRAN & RADAR KARAKTER -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Donut Kehadiran -->
            <div class="bg-white rounded-3xl shadow-sm border p-6 flex flex-col justify-between">
                <div>
                    <h3 class="font-black text-sm text-gray-800 flex items-center gap-2 mb-1">
                        <span>🟢</span> Persentase Kehadiran Gerbang
                    </h3>
                    <p class="text-xs text-gray-400 mb-4">Presensi harian anak (Gate In & Gate Out)</p>
                    <div class="h-52 relative flex items-center justify-center">
                        <canvas id="chartAttendanceDonut"></canvas>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2 mt-4 text-center text-xs">
                    <div class="p-2.5 bg-emerald-50 text-emerald-800 rounded-xl font-bold border border-emerald-200">
                        Hadir: <span id="attPresentCount">0</span>
                    </div>
                    <div class="p-2.5 bg-amber-50 text-amber-800 rounded-xl font-bold border border-amber-200">
                        Terlambat: <span id="attLateCount">0</span>
                    </div>
                </div>
            </div>

            <!-- Tips & Rekomendasi Belajar untuk Orang Tua -->
            <div class="lg:col-span-2 bg-white rounded-3xl shadow-sm border p-6 flex flex-col justify-between">
                <div>
                    <h3 class="font-black text-sm text-gray-800 flex items-center gap-2 mb-1">
                        <span>💡</span> Catatan Evaluasi & Rekomendasi untuk Orang Tua
                    </h3>
                    <p class="text-xs text-gray-400 mb-4">Rekomendasi dari wali kelas dan guru bimbingan konseling</p>
                    
                    <div class="space-y-3" id="parentTipsContainer">
                        <div class="p-3.5 bg-blue-50/80 rounded-2xl border border-blue-200 text-xs text-blue-900 flex items-start gap-2.5">
                            <span class="text-lg">🌟</span>
                            <div>
                                <p class="font-bold">Keunggulan di Bidang Sains & Informatika</p>
                                <p class="text-[11px] text-blue-700 mt-0.5">Ananda memiliki kemampuan penalaran logika yang sangat baik. Dukung minatnya dalam eksplorasi komputer dan teknologi.</p>
                            </div>
                        </div>
                        <div class="p-3.5 bg-emerald-50/80 rounded-2xl border border-emerald-200 text-xs text-emerald-900 flex items-start gap-2.5">
                            <span class="text-lg">⏰</span>
                            <div>
                                <p class="font-bold">Kedisiplinan Waktu Belajar Sangat Tertib</p>
                                <p class="text-[11px] text-emerald-700 mt-0.5">Tingkat kehadiran tepat waktu mencapai 95%. Selalu hadir sebelum bel masuk sekolah berbunyi.</p>
                            </div>
                        </div>
                        <div class="p-3.5 bg-purple-50/80 rounded-2xl border border-purple-200 text-xs text-purple-900 flex items-start gap-2.5">
                            <span class="text-lg">📖</span>
                            <div>
                                <p class="font-bold">Pengembangan Bahasa Inggris</p>
                                <p class="text-[11px] text-purple-700 mt-0.5">Disarankan menambah waktu membaca artikel atau mendengarkan audio edukasi berbahasa Inggris 15 menit per hari di rumah.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. RIWAYAT PRESENSI & TUGAS HARIAN -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Tabel Presensi -->
            <div class="bg-white rounded-3xl shadow-sm border p-6">
                <div class="flex justify-between items-center mb-4 border-b pb-3">
                    <h3 class="font-bold text-xs uppercase tracking-wider text-gray-700 flex items-center gap-2">
                        <span>📋</span> Log Presensi Gerbang Terakhir
                    </h3>
                    <span class="text-[10px] text-gray-400">30 Hari Terakhir</span>
                </div>
                <div class="overflow-x-auto overflow-y-auto max-h-[300px]">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-gray-50 text-gray-600 border-b">
                                <th class="p-3">Tanggal & Jam</th>
                                <th class="p-3">Pintu Gerbang</th>
                                <th class="p-3">Status</th>
                            </tr>
                        </thead>
                        <tbody id="parentAttendanceTable" class="divide-y">
                            <tr><td colspan="3" class="p-6 text-center text-gray-400">Memuat presensi anak...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tugas Kelas & PR -->
            <div class="bg-white rounded-3xl shadow-sm border p-6">
                <div class="flex justify-between items-center mb-4 border-b pb-3">
                    <h3 class="font-bold text-xs uppercase tracking-wider text-gray-700 flex items-center gap-2">
                        <span>📚</span> Tugas & PR Kelas Anak
                    </h3>
                </div>
                <div id="parentHomeworkList" class="space-y-2.5 max-h-[300px] overflow-y-auto">
                    <p class="text-center text-gray-400 py-6 text-xs">Tidak ada tugas kelas baru</p>
                </div>
            </div>
        </div>

        <!-- 4.5. 📁 DOKUMEN & RAPOR DIGITAL ANAK -->
        <div class="bg-white rounded-3xl shadow-sm border p-6 my-6">
            <div class="flex flex-wrap justify-between items-center mb-4 pb-3 border-b gap-3">
                <div>
                    <h3 class="text-base font-black text-gray-800 flex items-center gap-2">
                        <span>📄</span> Dokumen &amp; Rapor Digital Anak
                    </h3>
                    <p class="text-xs text-gray-500">Akses resmi rapor digital, kartu pelajar, sertifikat, dan surat edaran dari sekolah yang dibagikan secara remote</p>
                </div>
                <button onclick="loadParentEFiles()" class="text-xs font-bold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-xl border border-blue-200 cursor-pointer shadow-xs">
                    ⟳ Muat Berkas
                </button>
            </div>
            <div id="parentEFilesList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                <div class="col-span-full text-center py-6 text-gray-400 text-xs">Memuat daftar berkas digital anak...</div>
            </div>
        </div>
    
        <!-- 5. 💬 RUANG KONSULTASI LANGSUNG DENGAN GURU BK (SELAIN VIA WHATSAPP) -->
        <div class="bg-white rounded-3xl shadow-sm border p-6">
            <div class="flex flex-wrap justify-between items-center mb-6 pb-4 border-b gap-3">
                <div>
                    <h3 class="text-lg font-black text-gray-800 flex items-center gap-2">
                        <span>💬</span> Konsultasi Langsung dengan Guru BK (Bimbingan Konseling)
                    </h3>
                    <p class="text-xs text-gray-500">Kirim pesan dan konsultasikan perkembangan anak Anda secara langsung dengan Guru BK sekolah secara privat & aman</p>
                </div>
                <button onclick="openConsultationModal()" class="bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-700 hover:to-emerald-700 text-white px-5 py-2.5 rounded-2xl font-bold text-xs shadow-md flex items-center gap-2 transition-all">
                    <span>✍️</span> <span>Tulis Pesan Konsultasi Baru</span>
                </button>
            </div>

            <!-- List Konsultasi -->
            <div id="parentConsultationList" class="space-y-3.5">
                <p class="text-center text-gray-400 py-6 text-xs">Memuat percakapan konsultasi dengan Guru BK...</p>
            </div>
        </div>

        <!-- Modal Tulis Konsultasi Baru -->
        <div id="modalConsultation" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
            <div class="bg-white p-6 rounded-3xl w-full max-w-lg shadow-2xl border">
                <div class="flex justify-between items-center border-b pb-3 mb-4">
                    <h3 class="text-base font-bold text-gray-800 flex items-center gap-2">
                        <span>✍️</span> Kirim Pesan Konsultasi ke Guru BK
                    </h3>
                    <button type="button" onclick="closeConsultationModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
                </div>
                <form id="formConsultation" onsubmit="handleSendConsultation(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Kategori Konsultasi *</label>
                        <select id="consultCategory" class="w-full border p-2.5 rounded-xl text-xs font-medium bg-gray-50 focus:bg-white" required>
                            <option value="AKADEMIK">📚 Perkembangan Belajar & Nilai</option>
                            <option value="KEDISIPLINAN">⏰ Kedisiplinan & Kehadiran di Sekolah</option>
                            <option value="PERILAKU">🤝 Sikap, Karakter & Pergaulan Teman</option>
                            <option value="MINAT_BAKAT">🎨 Minat Bakat & Kelanjutan Studi</option>
                            <option value="LAINNYA">💬 Lainnya</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Subjek / Topik Percakapan *</label>
                        <input type="text" id="consultSubject" placeholder="Cth: Mohon info perkembangan belajar matematika Ananda..." class="w-full border p-2.5 rounded-xl text-xs" required>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Isi Pesan Konsultasi *</label>
                        <textarea id="consultMessage" rows="4" placeholder="Tuliskan pertanyaan atau hal yang ingin dikonsultasikan dengan Guru BK secara lengkap..." class="w-full border p-2.5 rounded-xl text-xs" required></textarea>
                    </div>

                    <div class="flex justify-end space-x-2 pt-4 border-t">
                        <button type="button" onclick="closeConsultationModal()" class="bg-gray-400 hover:bg-gray-500 text-white px-4 py-2 rounded-xl text-xs font-bold">Batal</button>
                        <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white px-5 py-2 rounded-xl text-xs font-bold shadow flex items-center gap-1.5">
                            <span>🚀</span> <span>Kirim ke Guru BK</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </main>

    <script>
        const token = localStorage.getItem('token');
        if(!token) window.location.href = '/';

        let chartTrendInstance = null;
        let chartSubjectInstance = null;
        let chartDonutInstance = null;

        loadChildData();
        loadParentConsultations();
        loadParentEFiles();

        function openConsultationModal() {
            document.getElementById('modalConsultation').classList.remove('hidden');
        }

        function closeConsultationModal() {
            document.getElementById('modalConsultation').classList.add('hidden');
        }

        async function loadParentConsultations() {
            try {
                const res = await fetch('/api/parent/bk-consultations', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const list = await res.json();
                const container = document.getElementById('parentConsultationList');

                if (!Array.isArray(list) || list.length === 0) {
                    container.innerHTML = `
                        <div class="p-8 text-center bg-slate-50 rounded-2xl border border-dashed">
                            <span class="text-4xl mb-2 block">💬</span>
                            <p class="font-bold text-xs text-gray-700">Belum ada percakapan konsultasi dengan Guru BK</p>
                            <p class="text-[11px] text-gray-400 mt-0.5">Klik tombol "Tulis Pesan Konsultasi Baru" di atas untuk bertanya langsung kepada Guru BK.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = list.map(item => {
                    const isReplied = !!item.replyMessage;
                    const d = new Date(item.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                    const replyDate = item.replyDate ? new Date(item.replyDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';

                    return `
                        <div class="p-4 bg-slate-50 rounded-2xl border hover:border-teal-400 transition-all">
                            <div class="flex flex-wrap justify-between items-center gap-2 mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-xs text-gray-800">${item.subject}</span>
                                    <span class="bg-blue-100 text-blue-800 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase">${item.category}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] text-gray-400">${d}</span>
                                    ${isReplied 
                                        ? '<span class="bg-emerald-100 text-emerald-800 text-[10px] px-2 py-0.5 rounded-full font-bold">🟢 Dibalas Guru BK</span>' 
                                        : '<span class="bg-amber-100 text-amber-800 text-[10px] px-2 py-0.5 rounded-full font-bold">🟡 Menunggu Tanggapan</span>'}
                                </div>
                            </div>
                            <p class="text-xs text-gray-700 bg-white p-3 rounded-xl border mb-2">${item.message}</p>
                            
                            ${isReplied ? `
                                <div class="p-3 bg-teal-50 rounded-xl border border-teal-200 text-xs text-teal-900 mt-2">
                                    <div class="flex items-center justify-between mb-1 font-bold text-[11px] text-teal-800">
                                        <span>👩‍🏫 Tanggapan Guru BK (${item.counselor ? item.counselor.name : 'Guru BK'}):</span>
                                        <span class="text-[10px] font-normal text-teal-600">${replyDate}</span>
                                    </div>
                                    <p class="text-xs leading-relaxed">${item.replyMessage}</p>
                                </div>
                            ` : ''}
                        </div>
                    `;
                }).join('');
            } catch(e) {
                console.error(e);
            }
        }

        async function loadParentEFiles() {
            const container = document.getElementById('parentEFilesList');
            if (!container) return;
            try {
                const res = await fetch('/api/parent/e-files', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                const files = (data && data.files) ? data.files : (Array.isArray(data) ? data : []);
                if (files.length === 0) {
                    container.innerHTML = '<div class="col-span-full text-center py-6 text-gray-400 text-xs">Belum ada dokumen digital (rapor/kartu/sertifikat) yang dibagikan untuk siswa ini.</div>';
                    return;
                }
                container.innerHTML = files.map(f => {
                    let catIcon = '📄';
                    let catColor = 'border-blue-200 text-blue-700 bg-blue-50';
                    if (f.category === 'RAPOR') { catIcon = '📊'; catColor = 'border-indigo-200 text-indigo-700 bg-indigo-50'; }
                    else if (f.category === 'KARTU_PELAJAR') { catIcon = '💳'; catColor = 'border-teal-200 text-teal-700 bg-teal-50'; }
                    else if (f.category === 'SERTIFIKAT') { catIcon = '🏆'; catColor = 'border-purple-200 text-purple-700 bg-purple-50'; }
                    else if (f.category === 'SURAT') { catIcon = '📜'; catColor = 'border-amber-200 text-amber-700 bg-amber-50'; }

                    const fileUrl = f.fileUrl || '#';
                    return `
                        <div class="p-4 rounded-2xl border ${catColor} bg-white shadow-xs flex flex-col justify-between hover:shadow-md transition-all">
                            <div class="flex items-start gap-3">
                                <span class="text-3xl">${catIcon}</span>
                                <div class="overflow-hidden">
                                    <h4 class="font-bold text-xs text-gray-800 truncate" title="${f.title}">${f.title}</h4>
                                    <span class="inline-block mt-1 text-[10px] font-bold px-2 py-0.5 rounded-full border ${catColor}">${f.category || 'DOKUMEN'}</span>
                                    <p class="text-[10px] text-gray-400 mt-1">${f.fileSize || 'PDF Resmi'}</p>
                                </div>
                            </div>
                            <div class="mt-3 pt-2.5 border-t border-gray-100 flex justify-end gap-2">
                                <a href="${fileUrl}" target="_blank" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-xs flex items-center gap-1.5 transition-all">
                                    <span>⬇️</span> <span>Buka / Unduh</span>
                                </a>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                container.innerHTML = '<div class="col-span-full text-center py-4 text-gray-400 text-xs">Gagal memuat dokumen digital.</div>';
            }
        }

        async function handleSendConsultation(e) {
            e.preventDefault();
            const category = document.getElementById('consultCategory').value;
            const subject = document.getElementById('consultSubject').value;
            const message = document.getElementById('consultMessage').value;

            try {
                const res = await fetch('/api/parent/bk-consultation', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ category, subject, message })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ Pesan konsultasi Anda berhasil dikirim ke Guru BK!');
                    closeConsultationModal();
                    document.getElementById('formConsultation').reset();
                    loadParentConsultations();
                } else {
                    alert('❌ ' + (data.message || 'Gagal mengirim pesan'));
                }
            } catch(e) {
                alert('❌ Terjadi kesalahan saat mengirim konsultasi');
            }
        }


        async function loadChildData() {
            try {
                const res = await fetch('/api/parent/my-child', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();

                if(res.ok && data.child) {
                    const c = data.child;
                    document.getElementById('childName').innerText = c.name;
                    document.getElementById('childClass').innerText = 'Kelas ' + (c.className || 'VII-A');
                    document.getElementById('childNisn').innerText = c.nisn || '-';
                    const cleanMother = (c.motherName && c.motherName !== 'Ibu Siswa') ? c.motherName.trim() : '';
                    const pName = cleanMother ? ('Ibu ' + cleanMother) : (c.fatherName ? ('Bapak ' + c.fatherName.trim()) : 'Ibu Wali Murid');
                    document.getElementById('childParentName').innerText = pName;
                    document.getElementById('parentHeaderWelcome').innerText = `Selamat Datang, ${pName}! 👋`;
                    document.getElementById('parentHeaderSub').innerText = `Orang Tua / Wali dari ${c.name} • Kelas ${c.className || '-'}`;
                    document.getElementById('childAvatar').innerText = c.name.charAt(0).toUpperCase();

                    const growth = data.academicGrowth || {};
                    document.getElementById('scoreOverall').innerText = (growth.overallAverage != null) ? growth.overallAverage : '-';
                    document.getElementById('badgeRank').innerText = growth.rankInClass ? ('🏆 ' + growth.rankInClass) : '🏆 Siswa Aktif';
                    document.getElementById('trendStatusText').innerText = growth.trendStatus || 'Data Nilai Terkini';

                    // 1. Render Line Chart (Tren Nilai Ujian)
                    renderTrendChart(growth.timelineLabels || ['UH 1', 'PTS', 'UH 2', 'PAS'], growth.studentScores || [0, 0, 0, 0], growth.classAverages || [0, 0, 0, 0]);

                    // 2. Render Bar Chart (Performa Mapel)
                    renderSubjectChart(growth.subjectPerformance || []);

                    // 3. Render Subject Progress Bars
                    renderSubjectList(growth.subjectPerformance || []);

                    // 4. Render Donut Kehadiran
                    const att = data.attendanceSummary || {};
                    const presCount = att.present != null ? att.present : 0;
                    const lateCount = att.late != null ? att.late : 0;
                    const sickCount = att.sick != null ? att.sick : 0;
                    const permCount = att.permission != null ? att.permission : 0;
                    const alpaCount = att.absent != null ? att.absent : 0;
                    document.getElementById('attPresentCount').innerText = presCount;
                    document.getElementById('attLateCount').innerText = lateCount;
                    renderAttendanceDonut(presCount, lateCount, sickCount, permCount, alpaCount);

                    // 5. Presensi Table
                    const tbody = document.getElementById('parentAttendanceTable');
                    tbody.innerHTML = '';
                    if(data.recentAttendances && data.recentAttendances.length > 0) {
                        data.recentAttendances.forEach(a => {
                            let badge = '<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold text-[10px]">🟢 Hadir Tepat</span>';
                            if(a.status === 'LATE') badge = '<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-bold text-[10px]">🟡 Terlambat</span>';
                            if(a.status === 'SICK') badge = '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-bold text-[10px]">🔵 Sakit</span>';
                            if(a.status === 'PERMISSION') badge = '<span class="bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-bold text-[10px]">🟣 Izin</span>';
                            if(a.status === 'ABSENT') badge = '<span class="bg-red-100 text-red-800 px-2 py-0.5 rounded font-bold text-[10px]">🔴 Alpa</span>';

                            const d = new Date(a.scanTime);
                            const dStr = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

                            tbody.innerHTML += `
                                <tr class="hover:bg-blue-50/50">
                                    <td class="p-3 font-medium text-gray-800">${dStr}</td>
                                    <td class="p-3 text-gray-600">${a.method || 'Gerbang Utama (Gate In)'}</td>
                                    <td class="p-3">${badge}</td>
                                </tr>
                            `;
                        });
                    } else {
                        tbody.innerHTML = '<tr><td colspan="3" class="p-6 text-center text-gray-400">Belum ada rekaman presensi</td></tr>';
                    }

                    // 6. Homework List
                    const hwContainer = document.getElementById('parentHomeworkList');
                    hwContainer.innerHTML = '';
                    if(data.homeworks && data.homeworks.length > 0) {
                        data.homeworks.forEach(hw => {
                            const d = new Date(hw.deadline);
                            const dStr = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
                            hwContainer.innerHTML += `
                                <div class="flex justify-between items-center p-3 bg-slate-50 rounded-2xl border">
                                    <div>
                                        <p class="font-bold text-gray-800 text-xs">${hw.title}</p>
                                        <p class="text-[11px] text-gray-500">${hw.subject ? hw.subject.name : 'Tugas Sekolah'}</p>
                                    </div>
                                    <span class="text-[10px] bg-amber-100 text-amber-800 px-2.5 py-1 rounded-xl font-bold">Tenggat: ${dStr}</span>
                                </div>
                            `;
                        });
                    // 7. Render Presensi Hari Ini (Datang & Pulang) & Notifikasi
                    const today = data.todayAttendance || {};
                    document.getElementById('webTodayGateIn').innerText = today.gateInTime || '06:45 WIB';
                    document.getElementById('webTodayGateOut').innerText = today.gateOutTime || '--:-- WIB';
                    const badgeToday = document.getElementById('badgeTodayStatus');
                    const stUpper = (today.status || 'HADIR TEPAT WAKTU').toUpperCase();
                    badgeToday.innerText = stUpper;
                    if (stUpper.includes('ALPA') || stUpper.includes('ABSENT')) {
                        badgeToday.className = 'bg-red-100 text-red-800 text-xs px-3 py-1 rounded-full font-bold animate-pulse';
                    } else if (today.isLate || stUpper.includes('TERLAMBAT')) {
                        badgeToday.className = 'bg-amber-100 text-amber-800 text-xs px-3 py-1 rounded-full font-bold';
                    } else if (stUpper.includes('BELUM')) {
                        badgeToday.className = 'bg-slate-100 text-slate-700 text-xs px-3 py-1 rounded-full font-bold';
                    } else {
                        badgeToday.className = 'bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-full font-bold';
                    }
                    if (today.gateOutTime && today.gateOutTime !== '--:-- WIB') {
                        document.getElementById('webTodayGateOutNote').innerText = 'Telah scan kepulangan';
                        document.getElementById('webTodayGateOutNote').className = 'text-[11px] text-blue-700 mt-1 font-bold';
                    } else if (stUpper.includes('ALPA')) {
                        document.getElementById('webTodayGateOutNote').innerText = '⚠️ Pelanggaran Alpa';
                        document.getElementById('webTodayGateOutNote').className = 'text-[11px] text-red-600 mt-1 font-bold';
                    }

                    if (data.parentNotifications && data.parentNotifications.length > 0) {
                        const n0 = data.parentNotifications[0];
                        document.getElementById('webNotifTitle').innerText = n0.title || 'Pemberitahuan Presensi';
                        document.getElementById('webNotifMessage').innerText = n0.message || '';
                    }

                    // 8. Render Jadwal Tugas & PR Anak Modern Container
                    const hwBox = document.getElementById('webHomeworkContainer');
                    const hwList = data.homeworkSchedule || data.homeworks || [];
                    document.getElementById('badgeHomeworkCount').innerText = `${hwList.length} Tugas`;
                    if (hwList.length === 0) {
                        hwBox.innerHTML = '<div class="p-4 bg-slate-50 border rounded-2xl text-center text-gray-400">✅ Belum ada tugas atau PR baru untuk kelas ananda.</div>';
                    } else {
                        hwBox.innerHTML = hwList.map(h => `
                            <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-2xl flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] font-bold text-indigo-600 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded-lg">${h.subject || 'Mata Pelajaran'}</span>
                                    <p class="font-bold text-gray-800 text-xs mt-1">${h.title || 'Tugas'}</p>
                                    <p class="text-[11px] text-gray-500 mt-0.5">${h.description || ''}</p>
                                </div>
                                <div class="text-right flex flex-col items-end gap-1">
                                    <span class="text-[10px] ${h.isSubmitted ? 'bg-emerald-100 text-emerald-800 border-emerald-200' : 'bg-amber-100 text-amber-800 border-amber-200'} border px-2.5 py-0.5 rounded-full font-bold">
                                        ${h.isSubmitted ? '✅ Selesai' : '⏳ Belum'}
                                    </span>
                                    <span class="text-[10px] font-bold text-red-600 font-mono">⏰ ${h.deadline || '-'}</span>
                                </div>
                            </div>
                        `).join('');
                    }
                }
            } catch(e) {
                console.error(e);
            }
        }

        function renderTrendChart(labels, studentScores, classAverages) {
            const ctx = document.getElementById('chartTrendExam').getContext('2d');
            if (chartTrendInstance) chartTrendInstance.destroy();

            chartTrendInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Nilai Siswa (Anak)',
                            data: studentScores,
                            borderColor: '#2563EB',
                            backgroundColor: 'rgba(37, 99, 235, 0.12)',
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#1D4ED8',
                            pointBorderColor: '#FFFFFF',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            borderWidth: 3
                        },
                        {
                            label: 'Rata-rata Kelas',
                            data: classAverages,
                            borderColor: '#94A3B8',
                            borderDash: [5, 5],
                            fill: false,
                            tension: 0.2,
                            pointRadius: 3,
                            borderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 50,
                            max: 100,
                            ticks: { stepSize: 10, font: { size: 10 } }
                        },
                        x: {
                            ticks: { font: { size: 10, weight: 'bold' } }
                        }
                    },
                    plugins: {
                        legend: { position: 'top', labels: { font: { size: 11 } } }
                    }
                }
            });
        }

        function renderSubjectChart(subjects) {
            const ctx = document.getElementById('chartSubjectPerformance').getContext('2d');
            if (chartSubjectInstance) chartSubjectInstance.destroy();

            const labels = subjects.map(s => s.subject);
            const scores = subjects.map(s => s.score);
            const colors = subjects.map(s => s.color || '#3B82F6');

            chartSubjectInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Nilai Akhir',
                        data: scores,
                        backgroundColor: colors,
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 50,
                            max: 100,
                            ticks: { stepSize: 10, font: { size: 10 } }
                        },
                        x: {
                            ticks: { font: { size: 9, weight: 'bold' } }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        function renderSubjectList(subjects) {
            const container = document.getElementById('subjectProgressList');
            container.innerHTML = subjects.map(s => `
                <div class="progress-pill p-3.5 bg-white rounded-2xl border shadow-sm">
                    <div class="flex justify-between items-center mb-1">
                        <span class="font-bold text-xs text-gray-800">${s.subject}</span>
                        <span class="font-black text-xs" style="color: ${s.color || '#2563EB'}">${s.score} / 100</span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden mb-1.5">
                        <div class="h-2 rounded-full" style="width: ${s.score}%; background-color: ${s.color || '#2563EB'}"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-gray-400">
                        <span>KKM: ${s.kkm || 75}</span>
                        <span class="font-bold text-emerald-600">${s.status}</span>
                    </div>
                </div>
            `).join('');
        }

        function renderAttendanceDonut(present, late, sick, permission, absent) {
            const ctx = document.getElementById('chartAttendanceDonut').getContext('2d');
            if (chartDonutInstance) chartDonutInstance.destroy();

            chartDonutInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Hadir Tepat', 'Terlambat', 'Sakit', 'Izin', 'Alpa'],
                    datasets: [{
                        data: [present, late, sick, permission, absent],
                        backgroundColor: ['#10B981', '#F59E0B', '#3B82F6', '#8B5CF6', '#EF4444'],
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
                    },
                    cutout: '70%'
                }
            });
        }

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            sessionStorage.clear();
            window.location.href = '/';
        }
    </script>
</body>
</html>
