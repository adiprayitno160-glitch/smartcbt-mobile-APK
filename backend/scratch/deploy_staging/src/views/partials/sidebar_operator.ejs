<!-- UNIFIED OPERATOR MODERN FRESH SLATE & SKY BLUE SIDEBAR -->
<!-- Floating Expand Button (Visible when Sidebar is Collapsed) -->
<button type="button" onclick="togglePortalSidebar()" id="sidebarExpandBtn" title="Tampilkan Sidebar (Shortcut: Ctrl+B)" class="fixed top-3 left-4 z-50 bg-slate-900/95 hover:bg-sky-600 text-white px-3.5 py-2 rounded-xl shadow-2xl border border-slate-700/80 backdrop-blur-md transition-all duration-300 hidden flex items-center gap-2.5 text-xs font-bold hover:scale-105 group cursor-pointer">
    <svg class="w-5 h-5 text-sky-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
    <span class="font-extrabold tracking-wide">Menu Operator</span>
    <span class="text-[10px] bg-white/15 px-1.5 py-0.5 rounded text-slate-300">Ctrl+B</span>
</button>

<aside id="portalSidebar" class="w-64 bg-slate-900 h-screen text-white flex flex-col fixed left-0 top-0 shadow-2xl z-40 select-none border-r border-slate-800 transition-all duration-300 ease-in-out">
    <!-- Brand Header -->
    <div class="px-4 py-3.5 border-b border-slate-800 bg-gradient-to-r from-slate-900 via-slate-900 to-sky-950/40 flex items-center justify-between gap-2.5">
        <div class="flex items-center gap-3 overflow-hidden">
            <div class="w-10 h-10 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-md border border-sky-400/30 flex-shrink-0">
                <img src="/logo-smpn1boyolangu.png" alt="Logo SMPN 1 Boyolangu" class="w-full h-full object-contain drop-shadow" onerror="this.src='/logo.png'">
            </div>
            <div class="truncate">
                <h1 class="font-black text-sm tracking-wide text-white leading-tight">SMART CBT</h1>
                <p class="text-[11px] text-sky-400 font-semibold truncate">Portal Operator • S1BOY</p>
            </div>
        </div>

        <!-- Toggle Button to Hide / Collapse Sidebar -->
        <button type="button" onclick="togglePortalSidebar()" id="sidebarCollapseBtn" title="Sembunyikan Sidebar (Ctrl+B)" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all flex items-center justify-center group flex-shrink-0 cursor-pointer" aria-label="Sembunyikan Sidebar">
            <svg class="w-5 h-5 transition-transform group-hover:-translate-x-0.5 text-slate-400 group-hover:text-sky-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
            </svg>
        </button>
    </div>

    <!-- Operator Profile Info -->
    <div class="p-3 bg-slate-950/50 border-b border-slate-800 flex items-center gap-3">
        <div class="w-9 h-9 bg-sky-600/30 text-sky-300 rounded-xl flex items-center justify-center font-black text-xs border border-sky-500/30 flex-shrink-0 shadow-inner">
            OP
        </div>
        <div class="overflow-hidden">
            <p class="text-xs font-bold text-slate-100 truncate" id="sidebarOperatorName">Operator Sekolah</p>
            <div class="flex items-center gap-1.5 mt-0.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-[10px] text-sky-400 font-semibold">Proktor &amp; Kurikulum</span>
            </div>
        </div>
    </div>

    <!-- Navigation Links (Enlarged, Clear & Modern Typography) -->
    <nav class="flex-1 p-3 space-y-1.5 overflow-y-auto text-sm font-semibold">
        <!-- CBT & ASESMEN -->
        <div class="pt-1 pb-1">
            <p class="px-3 text-xs font-extrabold text-sky-400/90 uppercase tracking-wider">CBT &amp; Ujian Proktor</p>
        </div>
        <a href="/operator/cbt" id="opnav-cbt" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-sky-600/20 text-[13.5px] transition-all">
            <span class="text-lg text-sky-400">📝</span> <span>Bank Soal &amp; Jadwal CBT</span>
        </a>
        <a href="/operator/monitoring" id="opnav-monitor" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-sky-600/20 text-[13.5px] transition-all">
            <span class="text-lg text-indigo-400">🖥️</span> <span>Live Monitoring Ujian</span>
        </a>
        <a href="/operator" id="opnav-token" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-sky-600/20 text-[13.5px] transition-all">
            <span class="text-lg text-amber-400">⏰</span> <span>Manajemen Token CBT</span>
        </a>

        <!-- AKADEMIK & KURIKULUM -->
        <div class="pt-3 pb-1 border-t border-slate-800/80">
            <p class="px-3 text-xs font-extrabold text-emerald-400/90 uppercase tracking-wider">Akademik &amp; Piket</p>
        </div>
        <a href="/operator/jam-pelajaran" id="opnav-jp" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-emerald-600/20 text-[13.5px] transition-all">
            <span class="text-lg text-emerald-400">📅</span> <span>Jadwal &amp; Jam Pelajaran (JP)</span>
        </a>
        <a href="/operator/piket" id="opnav-piket" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-emerald-600/20 text-[13.5px] transition-all">
            <span class="text-lg text-teal-400">📋</span> <span>Guru Piket &amp; Kelas Kosong</span>
        </a>

        <div class="pt-3 pb-1 border-t border-slate-800/80">
            <p class="px-3 text-xs font-extrabold text-slate-400 uppercase tracking-wider">Akses Terkait</p>
        </div>

        <a href="/display/kelas-kosong" target="_blank" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-amber-300 hover:bg-amber-950/40 text-[13.5px] transition-all">
            <span class="text-lg">📺</span> <span>Layar Display Piket ↗</span>
        </a>
        <a href="/admin/cbt" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800 text-[13.5px] transition-all">
            <span class="text-lg">🏢</span> <span>Portal Admin Utama</span>
        </a>
    </nav>

    <!-- Footer Logout -->
    <div class="p-3 border-t border-slate-800 bg-slate-950/70">
        <button onclick="logoutOperator()" class="w-full bg-rose-600/90 hover:bg-rose-700 text-white font-bold py-2.5 rounded-xl text-xs shadow-md transition-colors flex items-center justify-center gap-2 cursor-pointer">
            <span>🚪</span> <span>Logout Operator</span>
        </button>
    </div>
</aside>

<script>
    // ==================== OPERATOR SIDEBAR TOGGLE & PERSISTENCE ====================
    function togglePortalSidebar() {
        const sidebar = document.getElementById('portalSidebar');
        const expandBtn = document.getElementById('sidebarExpandBtn');
        const mainEls = document.querySelectorAll('main, .main-content-portal');
        if (!sidebar) return;

        const isCurrentlyHidden = sidebar.classList.contains('-translate-x-full');

        if (isCurrentlyHidden) {
            sidebar.classList.remove('-translate-x-full');
            if (expandBtn) expandBtn.classList.add('hidden');
            mainEls.forEach(m => {
                m.classList.add('ml-64');
                m.classList.remove('ml-0');
            });
            localStorage.setItem('portal_sidebar_collapsed', 'false');
        } else {
            sidebar.classList.add('-translate-x-full');
            if (expandBtn) expandBtn.classList.remove('hidden');
            mainEls.forEach(m => {
                m.classList.remove('ml-64');
                m.classList.add('ml-0');
            });
            localStorage.setItem('portal_sidebar_collapsed', 'true');
        }
    }

    // Shortcut Ctrl+B
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
            e.preventDefault();
            togglePortalSidebar();
        }
    });

    // Apply saved state
    (function applySavedSidebarState() {
        const isCollapsed = localStorage.getItem('portal_sidebar_collapsed') === 'true';
        const sidebar = document.getElementById('portalSidebar');
        const expandBtn = document.getElementById('sidebarExpandBtn');
        const mainEls = document.querySelectorAll('main, .main-content-portal');
        
        if (isCollapsed && sidebar) {
            sidebar.classList.add('-translate-x-full');
            if (expandBtn) expandBtn.classList.remove('hidden');
            mainEls.forEach(m => {
                m.classList.remove('ml-64');
                m.classList.add('ml-0');
            });
        }
    })();

    // Highlight active link in operator sidebar
    (function highlightOperatorSidebar() {
        const path = window.location.pathname;
        if (path === '/operator/cbt') {
            const el = document.getElementById('opnav-cbt');
            if (el) el.classList.add('bg-sky-600/30', 'text-sky-300', 'font-bold', 'border-l-4', 'border-sky-500');
        } else if (path === '/operator/monitoring') {
            const el = document.getElementById('opnav-monitor');
            if (el) el.classList.add('bg-sky-600/30', 'text-sky-300', 'font-bold', 'border-l-4', 'border-sky-500');
        } else if (path === '/operator') {
            const el = document.getElementById('opnav-token');
            if (el) el.classList.add('bg-sky-600/30', 'text-sky-300', 'font-bold', 'border-l-4', 'border-sky-500');
        } else if (path.includes('/jam-pelajaran')) {
            const el = document.getElementById('opnav-jp');
            if (el) el.classList.add('bg-emerald-600/30', 'text-emerald-300', 'font-bold', 'border-l-4', 'border-emerald-500');
        } else if (path.includes('/piket')) {
            const el = document.getElementById('opnav-piket');
            if (el) el.classList.add('bg-emerald-600/30', 'text-emerald-300', 'font-bold', 'border-l-4', 'border-emerald-500');
        }

        try {
            const userStr = localStorage.getItem('user');
            if (userStr) {
                const user = JSON.parse(userStr);
                const el = document.getElementById('sidebarOperatorName');
                if (el) el.innerText = user.name || 'Operator';
            }
        } catch(e) {}
    })();

    function logoutOperator() {
        localStorage.removeItem('token');
        sessionStorage.clear();
        window.location.href = '/';
    }
</script>
