<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/js/tailwind.js"></script>
    <!-- TinyMCE CDN -->
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.3/tinymce.min.js"></script>
    <!-- KaTeX CDN untuk rendering rumus matematika LaTeX -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    <!-- MathLive CDN untuk keyboard virtual rumus matematika -->
    <script defer src="https://cdn.jsdelivr.net/npm/mathlive"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
        .tab-btn.active {
            border-bottom: 2px solid #1565C0;
            color: #1565C0;
            font-weight: bold;
        }
        @media print {
            body * { visibility: hidden; }
            #printResultArea, #printResultArea *,
            #printableBankSoalArea, #printableBankSoalArea *,
            #printableLjsArea, #printableLjsArea * { visibility: visible; }
            #printResultArea, #printableBankSoalArea, #printableLjsArea {
                position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 16px; background: white !important;
            }
            .no-print { display: none !important; }
        }
        math-field {
            font-size: 1.15rem;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1.5px solid #CBD5E1;
            background: white;
            width: 100%;
        }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex">
    <!-- Sidebar -->
    <% if (typeof isOperator !== 'undefined' && isOperator) { %>
        <%- include('partials/sidebar_operator') %>
    <% } else { %>
        <%- include('partials/sidebar_admin') %>
    <% } %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <!-- Top Header Bar -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 pb-4 border-b border-slate-200/80">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <div class="flex items-center gap-3">
                        <div class="w-2.5 h-7 bg-blue-600 rounded-full"></div>
                        <h1 class="text-2xl font-black text-slate-800 tracking-tight flex items-center gap-2">
                            <span>📝</span> CBT &amp; Bank Soal Sekolah
                        </h1>
                        <span class="bg-blue-50 text-blue-700 text-xs font-bold px-2.5 py-1 rounded-full border border-blue-200/60">CBT Center</span>
                    </div>
                    <p class="text-slate-500 text-xs mt-1 ml-5">Bank Soal Multi-Format (Word, Excel, PDF), Ekstraksi Soal AI Gemini, Penjadwalan Ujian Komprehensif, dan Rekap Hasil</p>
                </div>
            </div>
            
            <div class="flex items-center gap-3 self-end md:self-auto">
                <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white border border-indigo-500/40 px-3.5 py-2 rounded-xl text-xs font-bold shadow-md flex items-center gap-2.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-slate-300 font-semibold">🕒 Jam Server:</span>
                    <span id="serverLiveClock" class="server-clock-display font-mono text-emerald-400 font-extrabold text-sm tracking-wider">--:--:-- WIB</span>
                </div>
            </div>
        </header>

        <!-- Action Toolbar -->
        <div class="flex flex-wrap justify-between items-center gap-3 mb-6 bg-white p-3.5 rounded-2xl border border-slate-200/80 shadow-sm">
            <div class="flex flex-wrap items-center gap-2">
                <a href="/api/cbt/template/excel" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-xl shadow-sm text-xs font-bold flex items-center gap-1.5 transition-all">
                    <span>📥</span> Template Excel
                </a>
                <a href="/api/cbt/template/word" target="_blank" class="bg-blue-600 hover:bg-blue-700 text-white px-3.5 py-2 rounded-xl shadow-sm text-xs font-bold flex items-center gap-1.5 transition-all">
                    <span>📄</span> Panduan Word
                </a>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <button onclick="openAiGeneratorModal()" class="bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700 text-white px-3.5 py-2 rounded-xl shadow-sm font-bold flex items-center gap-1.5 text-xs transition-all cursor-pointer">
                    <span>🤖</span> Buat Soal AI
                </button>
                <button onclick="openAiModal()" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white px-3.5 py-2 rounded-xl shadow-sm font-bold flex items-center gap-1.5 text-xs transition-all cursor-pointer">
                    <span>✨</span> Import Soal AI (Word/Excel/PDF)
                </button>
                <button onclick="openScheduleModal()" class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl shadow-sm font-bold flex items-center gap-1.5 text-xs transition-all cursor-pointer">
                    <span>📅</span> Jadwalkan Ujian
                </button>
                <button onclick="openAddExamModal()" class="bg-slate-800 hover:bg-black text-white px-3.5 py-2 rounded-xl shadow-sm font-bold flex items-center gap-1.5 text-xs transition-all cursor-pointer">
                    <span>➕</span> Buat Bank Soal
                </button>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="bg-white rounded-2xl shadow-sm border mb-6 px-4 pt-3 flex space-x-8 text-sm">
            <button onclick="switchTab('jadwal')" class="tab-btn active pb-3 px-2 text-gray-600 flex items-center gap-2 font-bold" id="tab-jadwal">
                <span>📅</span> Penjadwalan Ujian (<span id="countSchedule">0</span>)
            </button>
            <button onclick="switchTab('soal')" class="tab-btn pb-3 px-2 text-gray-600 flex items-center gap-2 font-bold" id="tab-soal">
                <span>📚</span> Bank Soal Sekolah (<span id="countExams">0</span>)
            </button>
            <button onclick="switchTab('hasil')" class="tab-btn pb-3 px-2 text-gray-600 flex items-center gap-2 font-bold" id="tab-hasil">
                <span>📊</span> Rekap Hasil Nilai Siswa
            </button>
            <button onclick="switchTab('analisis')" class="tab-btn pb-3 px-2 text-gray-600 flex items-center gap-2 font-bold" id="tab-analisis">
                <span>📈</span> Analisis Butir Soal &amp; Riset CBT
            </button>
        </div>

        <!-- TAB 1: PENJADWALAN UJIAN -->
        <div id="section-jadwal" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5" id="scheduleCardGrid">
                <p class="text-gray-400 py-6 text-sm col-span-3 text-center">Memuat jadwal ujian...</p>
            </div>
        </div>

        <!-- TAB 2: BANK SOAL & PAKET UJIAN -->
        <div id="section-soal" class="hidden space-y-6">
            <div class="bg-white rounded-xl shadow border overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100 text-gray-700 text-xs uppercase tracking-wider">
                            <th class="p-4 border-b">Judul Paket Ujian</th>
                            <th class="p-4 border-b">Mata Pelajaran</th>
                            <th class="p-4 border-b">Jumlah Soal</th>
                            <th class="p-4 border-b">Durasi</th>
                            <th class="p-4 border-b">Token Standby</th>
                            <th class="p-4 border-b">Aksi Soal</th>
                        </tr>
                    </thead>
                    <tbody id="examTableBody">
                        <tr><td colspan="6" class="p-4 text-center text-gray-500">Memuat data paket soal...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 3: REKAP HASIL NILAI SISWA -->
        <div id="section-hasil" class="hidden space-y-6">
            <!-- Filter Bar -->
            <div class="bg-white rounded-xl shadow-sm p-4 border flex flex-wrap justify-between items-center gap-4">
                <div class="flex flex-wrap items-center gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Pilih Ujian</label>
                        <select id="filterExamResult" class="border p-2 rounded-lg text-sm" onchange="loadResults()">
                            <option value="ALL">Semua Ujian</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Pilih Kelas</label>
                        <select id="filterClassResult" class="border p-2 rounded-lg text-sm" onchange="loadResults()">
                            <option value="ALL">Semua Kelas</option>
                        </select>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button onclick="exportResultsCsv()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-1.5 shadow transition-all">
                        <span>📊</span> Unduh Excel / CSV
                    </button>
                    <button onclick="window.print()" class="bg-gray-800 hover:bg-black text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-1.5 shadow">
                        <span>🖨️</span> Cetak Berita Acara &amp; Daftar Nilai
                    </button>
                </div>
            </div>

            <!-- Statistik & Analisis Ketuntasan KKM Beesmart CBT -->
            <div id="statKetuntasanCard" class="grid grid-cols-2 md:grid-cols-6 gap-3">
                <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
                    <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Total Peserta</p>
                    <p class="text-xl font-extrabold text-slate-800 mt-1" id="statTotalPeserta">0</p>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-blue-200 shadow-sm bg-blue-50/30">
                    <p class="text-[11px] font-bold text-blue-600 uppercase tracking-wider">Rata-Rata Nilai</p>
                    <p class="text-xl font-extrabold text-blue-700 mt-1" id="statRataRata">0.0</p>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-emerald-200 shadow-sm bg-emerald-50/30">
                    <p class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider">Nilai Tertinggi</p>
                    <p class="text-xl font-extrabold text-emerald-700 mt-1" id="statNilaiMax">0</p>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-amber-200 shadow-sm bg-amber-50/30">
                    <p class="text-[11px] font-bold text-amber-600 uppercase tracking-wider">Nilai Terendah</p>
                    <p class="text-xl font-extrabold text-amber-700 mt-1" id="statNilaiMin">0</p>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-teal-200 shadow-sm bg-teal-50/30">
                    <p class="text-[11px] font-bold text-teal-700 uppercase tracking-wider">Tuntas KKM (&ge;75)</p>
                    <div class="flex items-baseline gap-1 mt-1">
                        <p class="text-xl font-extrabold text-teal-700" id="statTuntasCount">0</p>
                        <span class="text-xs font-semibold text-teal-600" id="statTuntasPct">(0%)</span>
                    </div>
                </div>
                <div class="bg-white p-3.5 rounded-xl border border-rose-200 shadow-sm bg-rose-50/30">
                    <p class="text-[11px] font-bold text-rose-600 uppercase tracking-wider">Belum Tuntas</p>
                    <div class="flex items-baseline gap-1 mt-1">
                        <p class="text-xl font-extrabold text-rose-700" id="statBelumTuntasCount">0</p>
                        <span class="text-xs font-semibold text-rose-600" id="statBelumTuntasPct">(0%)</span>
                    </div>
                </div>
            </div>

            <!-- Result Table -->
            <div class="bg-white rounded-xl shadow border overflow-hidden" id="printResultArea">
                <div class="p-4 border-b bg-gray-50 flex justify-between items-center">
                    <div>
                        <h3 class="font-bold text-gray-800 text-base" id="printResultTitle">Rekapitulasi Nilai Ujian CBT</h3>
                        <p class="text-xs text-gray-500" id="printResultSub">Hasil pengerjaan siswa yang tersinkron dari aplikasi CBT APK</p>
                    </div>
                    <span class="text-xs bg-blue-100 text-blue-800 font-bold px-3 py-1 rounded-full" id="resultTotalStudentCount">0 Peserta</span>
                </div>
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="bg-gray-100 text-gray-700 text-xs uppercase tracking-wider">
                            <th class="p-4 border-b">Rank</th>
                            <th class="p-4 border-b">Nama Siswa</th>
                            <th class="p-4 border-b">NISN / NIS</th>
                            <th class="p-4 border-b">Kelas</th>
                            <th class="p-4 border-b">Mata Pelajaran</th>
                            <th class="p-4 border-b">Waktu Mulai - Selesai</th>
                            <th class="p-4 border-b">Pelanggaran (Strike)</th>
                            <th class="p-4 border-b">Skor Nilai</th>
                            <th class="p-4 border-b">Status</th>
                            <th class="p-4 border-b text-center no-print">LJS Digital</th>
                        </tr>
                    </thead>
                    <tbody id="resultTableBody">
                        <tr><td colspan="9" class="p-4 text-center text-gray-500">Memuat hasil nilai ujian...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 4: ANALISIS BUTIR SOAL & RISET CBT -->
        <div id="section-analisis" class="hidden space-y-6">
            <!-- Filter & Action Bar -->
            <div class="bg-white rounded-xl shadow-sm p-4 border flex flex-wrap justify-between items-center gap-4">
                <div class="flex flex-wrap items-center gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Pilih Paket Ujian untuk Dianalisis</label>
                        <select id="selectAnalysisExam" class="border p-2 rounded-lg text-sm min-w-[280px] font-semibold" onchange="loadItemAnalysisData()">
                            <option value="">-- Pilih Paket Ujian --</option>
                        </select>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button onclick="loadItemAnalysisData()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-1.5 shadow transition-all">
                        <span>🔄</span> Hitung Ulang Parameter
                    </button>
                    <button onclick="printItemAnalysisReport()" class="bg-gray-800 hover:bg-black text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-1.5 shadow">
                        <span>🖨️</span> Cetak Laporan Analisis
                    </button>
                </div>
            </div>

            <!-- Summary Cards Analisis Butir Soal -->
            <div id="analysisSummaryCards" class="hidden space-y-4">
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Total Peserta</p>
                        <p class="text-xl font-black text-slate-800 mt-1" id="statAnalysisParticipants">0 Siswa</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-blue-200 shadow-sm bg-blue-50/30">
                        <p class="text-[11px] font-bold text-blue-600 uppercase tracking-wider">Total Soal</p>
                        <p class="text-xl font-black text-blue-700 mt-1" id="statAnalysisQuestions">0 Butir</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-emerald-200 shadow-sm bg-emerald-50/30">
                        <p class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider">Tingkat Kesukaran</p>
                        <p class="text-xs font-bold text-emerald-800 mt-1">
                            <span id="statEasy">0 Mudah</span> • <span id="statMed">0 Sedang</span> • <span id="statHard">0 Sukar</span>
                        </p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-indigo-200 shadow-sm bg-indigo-50/30">
                        <p class="text-[11px] font-bold text-indigo-600 uppercase tracking-wider">Daya Beda Soal</p>
                        <p class="text-sm font-black text-indigo-700 mt-1" id="statDiscriminationSummary">0 Butir Baik</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-amber-200 shadow-sm bg-amber-50/30">
                        <p class="text-[11px] font-bold text-amber-600 uppercase tracking-wider">Rekomendasi Butir</p>
                        <p class="text-xs font-bold text-amber-800 mt-1">
                            <span id="statAccepted">0 Diterima</span> • <span id="statRevised">0 Revisi</span> • <span id="statRejected">0 Ditolak</span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Table Analisis Butir Soal -->
            <div class="bg-white rounded-xl shadow border overflow-hidden">
                <div class="p-4 border-b bg-gray-50 flex justify-between items-center">
                    <div>
                        <h3 class="font-bold text-gray-800 text-base">Analisis Psikometrik &amp; Parameter Butir Soal</h3>
                        <p class="text-xs text-gray-500">Tingkat Kesukaran (Facility Index), Daya Pembeda (Discrimination), &amp; Efektivitas Pilihan Pengecoh</p>
                    </div>
                    <span class="text-xs bg-indigo-100 text-indigo-800 font-bold px-3 py-1 rounded-full" id="analysisItemCount">0 Butir Soal</span>
                </div>
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-100 text-gray-700 text-xs uppercase tracking-wider">
                            <th class="p-3 border-b text-center w-12">No</th>
                            <th class="p-3 border-b">Pertanyaan &amp; Kunci</th>
                            <th class="p-3 border-b text-center">Tingkat Kesukaran (P)</th>
                            <th class="p-3 border-b text-center">Daya Pembeda (D)</th>
                            <th class="p-3 border-b text-center">Efektivitas Distraktor</th>
                            <th class="p-3 border-b text-center">Rekomendasi</th>
                        </tr>
                    </thead>
                    <tbody id="analysisTableBody">
                        <tr><td colspan="6" class="p-8 text-center text-slate-400">Silakan pilih paket ujian di atas untuk memuat analisis butir soal.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Modal Ekstraksi & Import Soal via AI Gemini Multi-Format (Word, Excel, PDF, Teks) -->
    <div id="modalAiExtract" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-3xl w-full max-w-4xl max-h-[90vh] overflow-y-auto shadow-2xl border border-purple-100">
            <div class="flex justify-between items-center border-b pb-4 mb-4">
                <div class="flex items-center gap-3">
                    <span class="text-3xl p-2 bg-purple-100 rounded-2xl text-purple-700">✨</span>
                    <div>
                        <h2 class="text-base font-black text-gray-800">Import &amp; Ekstraksi Naskah Soal via AI Gemini</h2>
                        <p class="text-xs text-gray-500">Mendukung berkas Microsoft Word (.docx), Excel (.xlsx/.xls), PDF (.pdf), serta Teks Bebas</p>
                    </div>
                </div>
                <button onclick="document.getElementById('modalAiExtract').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
            </div>

            <!-- STEP 1: Input Source (File or Text) -->
            <div id="aiStep1" class="space-y-4 text-xs">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Judul Paket Soal (Opsional / Otomatis dari nama file)</label>
                        <input type="text" id="aiTitle" placeholder="Cth: Penilaian Akhir Semester (PAS) IPA Kelas 8" class="w-full border p-2.5 rounded-xl text-xs font-semibold">
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Mata Pelajaran (Opsional / Otomatis dideteksi AI)</label>
                        <input type="text" id="aiSubject" placeholder="Cth: Ilmu Pengetahuan Alam (IPA)" class="w-full border p-2.5 rounded-xl text-xs font-semibold">
                    </div>
                </div>

                <!-- Tab Pemilihan Metode Input -->
                <div class="flex border-b border-gray-200 gap-4 pt-1">
                    <button type="button" onclick="switchAiImportTab('file')" id="tabBtnAiFile" class="pb-2 font-bold text-purple-700 border-b-2 border-purple-600 flex items-center gap-1.5 text-xs">
                        <span>📁</span> Unggah Berkas Dokumen (Word / Excel / PDF)
                    </button>
                    <button type="button" onclick="switchAiImportTab('text')" id="tabBtnAiText" class="pb-2 font-semibold text-gray-400 hover:text-gray-600 flex items-center gap-1.5 text-xs">
                        <span>📋</span> Salin &amp; Tempel Teks Manual
                    </button>
                </div>

                <!-- TAB A: File Upload (Word, Excel, PDF) -->
                <div id="aiTabFileContainer" class="space-y-3">
                    <div id="aiDropZone" onclick="document.getElementById('aiFileInput').click()" class="border-2 border-dashed border-purple-300 hover:border-purple-600 rounded-3xl p-8 text-center bg-purple-50/40 hover:bg-purple-50/80 transition-all cursor-pointer group">
                        <div class="w-16 h-16 mx-auto rounded-2xl bg-white shadow-md flex items-center justify-center text-3xl mb-3 group-hover:scale-110 transition-transform">
                            📄
                        </div>
                        <p class="font-bold text-sm text-gray-800">Klik atau Seret Berkas Dokumen ke Sini</p>
                        <p class="text-xs text-gray-500 mt-1">Mendukung: <b>Word (.docx)</b>, <b>Excel (.xlsx, .xls)</b>, <b>PDF (.pdf)</b>, atau <b>Teks (.txt)</b></p>
                        <div class="mt-4 flex flex-wrap justify-center gap-2">
                            <span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-2.5 py-1 rounded-full">Word .docx</span>
                            <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2.5 py-1 rounded-full">Excel .xlsx</span>
                            <span class="bg-red-100 text-red-800 text-[10px] font-bold px-2.5 py-1 rounded-full">PDF Naskah</span>
                        </div>
                        <input type="file" id="aiFileInput" accept=".docx,.xlsx,.xls,.pdf,.txt" class="hidden" onchange="handleAiFileSelected(event)">
                    </div>

                    <div id="aiFileSelectedBadge" class="hidden p-3 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <span class="text-xl">📎</span>
                            <div>
