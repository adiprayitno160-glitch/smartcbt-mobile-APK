    <script>
        function getCookie(name) {
            const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            return match ? match[2] : null;
        }
        const token = localStorage.getItem('token') || getCookie('token') || '';
        if(!token) window.location.href = '/';

        const schDateInput = document.getElementById('schDate');
        if (schDateInput) schDateInput.value = new Date().toISOString().split('T')[0];

        let allExams = [];
        let allClasses = [];
        let allResults = [];
        let allTeachersList = [];

        initServerClock();
        loadClasses();
        loadTeachersForProctors();
        loadExams();
        loadResults();

        // Real-Time Server Clock (WIB 24 Jam)
        let serverClockOffset = 0;
        async function initServerClock() {
            try {
                const res = await fetch('/api/server-time');
                if (res.ok) {
                    const data = await res.json();
                    serverClockOffset = data.timestamp - Date.now();
                }
            } catch (e) {
                console.warn('Gagal sinkronisasi waktu server:', e);
            }
            updateServerClock();
            setInterval(updateServerClock, 1000);
        }

        function updateServerClock() {
            const clockEls = document.querySelectorAll('.server-clock-display');
            if (!clockEls.length) return;
            const now = new Date(Date.now() + serverClockOffset);
            const timeStr = new Intl.DateTimeFormat('en-GB', {
                timeZone: 'Asia/Jakarta',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            }).format(now) + ' WIB';
            
            clockEls.forEach(el => {
                el.innerText = timeStr;
            });
        }

