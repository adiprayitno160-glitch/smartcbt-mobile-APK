            }

            const tbody = document.getElementById('analysisTableBody');
            tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-500">⏳ Sedang menghitung parameter statistik butir soal...</td></tr>';

            try {
                const res = await fetch('/api/cbt/exams/' + examId + '/item-analysis', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (!res.ok) {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-rose-500">' + (data.message || 'Gagal memuat analisis') + '</td></tr>';
                    return;
                }

                // Render summary cards
                document.getElementById('analysisSummaryCards')?.classList.remove('hidden');
                document.getElementById('statAnalysisParticipants').innerText = (data.totalParticipants || 0) + ' Siswa';
                document.getElementById('statAnalysisQuestions').innerText = (data.totalQuestions || 0) + ' Butir';
                document.getElementById('statEasy').innerText = (data.summary?.easyCount || 0) + ' Mudah';
                document.getElementById('statMed').innerText = (data.summary?.mediumCount || 0) + ' Sedang';
                document.getElementById('statHard').innerText = (data.summary?.hardCount || 0) + ' Sukar';
                document.getElementById('statAccepted').innerText = (data.summary?.acceptedCount || 0) + ' Diterima';
                document.getElementById('statRevised').innerText = (data.summary?.revisedCount || 0) + ' Revisi';
                document.getElementById('statRejected').innerText = (data.summary?.rejectedCount || 0) + ' Ditolak';

                const discGood = Array.isArray(data.items) ? data.items.filter(q => q.discriminationIndex >= 0.30).length : 0;
                document.getElementById('statDiscriminationSummary').innerText = discGood + ' Butir Baik';
                document.getElementById('analysisItemCount').innerText = (data.items ? data.items.length : 0) + ' Butir Soal';

                // Render table items
                tbody.innerHTML = '';
                if (!data.items || data.items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-400">Belum ada butir soal atau jawaban siswa pada paket ini.</td></tr>';
                    return;
                }

                data.items.forEach(item => {
                    let recBadge = '<span class="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-bold text-[10px]">✅ Diterima</span>';
                    if (item.recommendation === 'Perlu Revisi') {
                        recBadge = '<span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full font-bold text-[10px]">⚠️ Perlu Revisi</span>';
                    } else if (item.recommendation && item.recommendation.includes('Ditolak')) {
                        recBadge = '<span class="bg-rose-100 text-rose-800 px-2.5 py-1 rounded-full font-bold text-[10px]">❌ Ditolak</span>';
                    }

                    let pBadgeColor = item.facilityIndex > 0.7 ? 'text-emerald-700 bg-emerald-50' : (item.facilityIndex < 0.3 ? 'text-rose-700 bg-rose-50' : 'text-blue-700 bg-blue-50');
                    let dBadgeColor = item.discriminationIndex >= 0.3 ? 'text-indigo-700 bg-indigo-50' : 'text-amber-700 bg-amber-50';

                    let distractorStr = '';
                    ['A', 'B', 'C', 'D'].forEach(opt => {
                        const st = (item.distractorStats && item.distractorStats[opt]) ? item.distractorStats[opt] : { percentage: 0 };
                        const isKey = opt === item.correctOption;
                        const optClass = isKey ? 'font-black text-emerald-700' : (st.percentage < 5 ? 'text-rose-400' : 'text-slate-600');
                        distractorStr += '<span class="' + optClass + ' mr-1.5">' + opt + ':' + st.percentage + '%</span>';
                    });

                    tbody.innerHTML += `
                        <tr class="hover:bg-blue-50/50 border-b">
                            <td class="p-3 text-center font-bold text-slate-700 font-mono">${item.orderNum}</td>
                            <td class="p-3 max-w-md">
                                <p class="font-semibold text-slate-800 line-clamp-2">${item.content}</p>
                                <span class="inline-block mt-1 bg-slate-100 text-slate-600 text-[10px] px-2 py-0.5 rounded font-mono font-bold">Kunci: ${item.correctOption}</span>
                            </td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-1 rounded-lg font-bold font-mono ${pBadgeColor}">${item.facilityIndex}</span>
                                <p class="text-[10px] text-slate-500 mt-1 font-semibold">${item.difficultyLabel}</p>
                            </td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-1 rounded-lg font-bold font-mono ${dBadgeColor}">${item.discriminationIndex}</span>
                                <p class="text-[10px] text-slate-500 mt-1 font-semibold">${item.discriminationLabel}</p>
                            </td>
                            <td class="p-3 text-center font-mono text-[10px]">
                                ${distractorStr}
                            </td>
                            <td class="p-3 text-center whitespace-nowrap">
                                ${recBadge}
                            </td>
                        </tr>
                    `;
                });
            } catch(err) {
                console.error(err);
                tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-rose-500">Terjadi kesalahan teknis saat mengambil data analisis.</td></tr>';
            }
        }

        function printItemAnalysisReport() {
            window.print();
        }

        // ==========================================
        // EKSPOR & IMPOR LANGSUNG EXCEL BANK SOAL
        // ==========================================
        let targetExamIdForExcelImport = null;
        function triggerDirectExcelImport(examId) {
            if (!examId) return;
            targetExamIdForExcelImport = examId;
            document.getElementById('directExcelFileInput').click();
        }

        async function handleDirectExcelUpload(event) {
            const file = event.target.files[0];
            if (!file || !targetExamIdForExcelImport) return;

            const formData = new FormData();
            formData.append('file', file);

            try {
                const res = await fetch(`/api/cbt/exams/${targetExamIdForExcelImport}/import-excel`, {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token },
                    body: formData
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + (data.message || 'Berhasil mengimpor butir soal dari Excel!'));
                    loadExams();
                    if (activeExamIdForQuestions === targetExamIdForExcelImport) {
                        await loadExamQuestionsList(activeExamIdForQuestions);
                    }
                } else {
                    alert('❌ ' + (data.message || 'Gagal mengimpor soal dari Excel'));
                }
            } catch (err) {
                alert('❌ Terjadi kesalahan saat mengunggah berkas Excel');
            } finally {
                event.target.value = '';
                targetExamIdForExcelImport = null;
            }
        }

        function exportExamToExcelDirect(examId) {
            if (!examId) return;
            window.location.href = `/api/cbt/exams/${examId}/export-excel?token=${encodeURIComponent(token)}`;
        }
    </script>
    <input type="file" id="directExcelFileInput" accept=".xlsx,.xls" class="hidden" onchange="handleDirectExcelUpload(event)">
    <!-- Modal Generator Soal Berbasis AI Gemini -->
    <div id="modalAiGenerator" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl border border-teal-100">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <div class="flex items-center gap-2.5">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-teal-600 to-cyan-500 flex items-center justify-center text-xl text-white shadow-md">
                        🤖
                    </div>
                    <div>
                        <h2 class="text-base font-extrabold text-slate-800">Generator Soal Otomatis Berbasis AI Gemini</h2>
                        <p class="text-xs text-slate-500">Penyusunan naskah soal instan dengan standar kurikulum, penalaran HOTS &amp; pembahasan</p>
                    </div>
                </div>
                <button onclick="closeAiGeneratorModal()" class="text-slate-400 hover:text-slate-600 text-2xl font-bold">&times;</button>
            </div>

            <form id="formAiGenerate" onsubmit="handleGenerateQuestionsAi(event)" class="space-y-4 text-xs">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Mata Pelajaran *</label>
                        <input type="text" id="genSubject" required placeholder="Cth: Ilmu Pengetahuan Alam (IPA)" class="w-full border rounded-xl p-2.5 bg-slate-50 focus:bg-white text-xs font-semibold outline-none focus:ring-2 focus:ring-teal-500">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Jenjang / Kelas *</label>
                        <select id="genGrade" class="w-full border rounded-xl p-2.5 bg-slate-50 focus:bg-white text-xs font-semibold outline-none">
                            <option value="Kelas VII (Fase D)">Kelas VII (Fase D)</option>
                            <option value="Kelas VIII (Fase D)">Kelas VIII (Fase D)</option>
                            <option value="Kelas IX (Fase D)">Kelas IX (Fase D)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1">Topik / Kisi-Kisi Materi Pokok *</label>
                    <input type="text" id="genTopic" required placeholder="Cth: Sistem Peredaran Darah Manusia, Jantung & Pembuluh Darah" class="w-full border rounded-xl p-2.5 bg-slate-50 focus:bg-white text-xs font-semibold outline-none focus:ring-2 focus:ring-teal-500">
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Jumlah Butir Soal</label>
                        <select id="genCount" class="w-full border rounded-xl p-2.5 bg-slate-50 focus:bg-white text-xs font-semibold outline-none">
                            <option value="5">5 Butir Soal</option>
                            <option value="10" selected>10 Butir Soal</option>
                            <option value="15">15 Butir Soal</option>
                            <option value="20">20 Butir Soal</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Tingkat Kesulitan</label>
                        <select id="genDifficulty" class="w-full border rounded-xl p-2.5 bg-slate-50 focus:bg-white text-xs font-semibold outline-none">
                            <option value="Campuran (Mudah, Sedang, HOTS)" selected>Campuran Standar</option>
                            <option value="Dominan HOTS (C4-C6 Analisis)">HOTS (Penalaran Tinggi)</option>
                            <option value="Sedang (C3 Penerapan)">Sedang (C3)</option>
                            <option value="Dasar / Mudah (C1-C2)">Mudah / Pemahaman</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Bentuk Soal</label>
                        <select id="genType" class="w-full border rounded-xl p-2.5 bg-slate-50 focus:bg-white text-xs font-semibold outline-none">
                            <option value="MULTIPLE_CHOICE" selected>Pilihan Ganda (A-D)</option>
                            <option value="ESSAY">Uraian / Esai</option>
                        </select>
                    </div>
                </div>

                <div class="p-3 bg-teal-50/70 border border-teal-200 rounded-xl text-[11px] text-teal-800">
                    💡 <b>Tips AI:</b> Soal yang di-generate akan otomatis disiapkan dengan 4 opsi distraktor berkualitas tinggi, kunci jawaban, dan pembahasan ilmiah yang dapat ditinjau sebelum disimpan.
                </div>

                <div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
                    <button type="button" onclick="closeAiGeneratorModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs transition-colors">Batal</button>
                    <button type="submit" id="btnSubmitGenerateAi" class="px-5 py-2.5 bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700 text-white font-bold rounded-xl text-xs shadow-md shadow-teal-500/20 flex items-center gap-1.5 transition-all">
                        <span>✨</span> Generate Butir Soal AI
                    </button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>
