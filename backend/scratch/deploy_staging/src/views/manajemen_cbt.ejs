        async function saveSingleClassProctor(examId, className, proctorName) {
            try {
                const res = await fetch('/api/cbt/assign-class-proctors', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({
                        examId,
                        assignments: { [className]: proctorName.trim() }
                    })
                });
                const data = await res.json();
                if (res.ok) {
                    const e = allExams.find(x => x.id === examId);
                    if (e) {
                        if (!e.classProctors) e.classProctors = {};
                        e.classProctors[className] = proctorName.trim();
                    }
                    const inputEl = document.getElementById(`proctor_input_${className}`);
                    if (inputEl) {
                        inputEl.classList.add('border-emerald-500', 'bg-emerald-50/40');
                        setTimeout(() => {
                            inputEl.classList.remove('border-emerald-500', 'bg-emerald-50/40');
                        }, 1500);
                    }
                } else {
                    alert('Gagal menyimpan guru pengawas: ' + (data.message || 'Error'));
                }
            } catch(e) {
                alert('Terjadi kesalahan jaringan saat menyimpan pengawas.');
            }
        }

        async function resetClassRoomToken(examId, className) {
            if (!confirm(`Acak ulang token khusus untuk Kelas ${className}? Siswa dan pengawas kelas ini akan menerima token baru.`)) return;
            try {
                const res = await fetch('/api/cbt/reset-class-token', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ examId, className })
                });
                const data = await res.json();
                if (res.ok && data.token) {
                    alert(`✅ Token Kelas ${className} berhasil diacak ulang: ${data.token}`);
                    const e = allExams.find(x => x.id === examId);
                    if (e) {
                        if (!e.classTokens) e.classTokens = {};
                        e.classTokens[className] = data.token;
                    }
                    openClassTokensModal(examId);
                    renderScheduleCards();
                } else {
                    alert('Gagal mengacak token kelas: ' + (data.message || 'Error'));
                }
            } catch(e) {
                alert('Terjadi kesalahan jaringan saat mengacak token kelas.');
            }
        }

