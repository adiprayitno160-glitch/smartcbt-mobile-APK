        function renderResultTable() {
            const tbody = document.getElementById('resultTableBody');
            tbody.innerHTML = '';
            document.getElementById('resultTotalStudentCount').innerText = allResults.length + ' Peserta';

            // Hitung statistik & analisis ketuntasan KKM (Standar Beesmart CBT)
            const total = allResults.length;
            const validScores = allResults.map(r => r.score).filter(s => s !== null && !isNaN(s));
            const rataRata = validScores.length ? (validScores.reduce((a, b) => a + b, 0) / validScores.length).toFixed(1) : '0.0';
            const maxScore = validScores.length ? Math.max(...validScores) : 0;
            const minScore = validScores.length ? Math.min(...validScores) : 0;
            const kkm = 75;
            const tuntasCount = validScores.filter(s => s >= kkm).length;
            const belumTuntasCount = validScores.length - tuntasCount;
            const tuntasPct = validScores.length ? Math.round((tuntasCount / validScores.length) * 100) : 0;
            const belumTuntasPct = validScores.length ? (100 - tuntasPct) : 0;

            if (document.getElementById('statTotalPeserta')) document.getElementById('statTotalPeserta').innerText = total;
            if (document.getElementById('statRataRata')) document.getElementById('statRataRata').innerText = rataRata;
            if (document.getElementById('statNilaiMax')) document.getElementById('statNilaiMax').innerText = maxScore;
            if (document.getElementById('statNilaiMin')) document.getElementById('statNilaiMin').innerText = minScore;
            if (document.getElementById('statTuntasCount')) document.getElementById('statTuntasCount').innerText = tuntasCount;
            if (document.getElementById('statTuntasPct')) document.getElementById('statTuntasPct').innerText = `(${tuntasPct}%)`;
            if (document.getElementById('statBelumTuntasCount')) document.getElementById('statBelumTuntasCount').innerText = belumTuntasCount;
            if (document.getElementById('statBelumTuntasPct')) document.getElementById('statBelumTuntasPct').innerText = `(${belumTuntasPct}%)`;

            if(allResults.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" class="p-4 text-center text-gray-500">Belum ada siswa yang menyelesaikan ujian ini</td></tr>';
                return;
            }

            allResults.forEach((r, idx) => {
                const s = r.user || {};
                const ex = r.exam || {};
                const scoreDisplay = r.score !== null ? `<span class="font-extrabold text-blue-800 text-sm">${r.score}</span>` : '<span class="text-gray-400">-</span>';
                const strikeBadge = r.strikeCount > 0 
                    ? `<span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-bold">${r.strikeCount} Kali</span>`
                    : '<span class="text-green-600 text-xs font-semibold">Bersih</span>';

                const startStr = r.startTime ? new Date(r.startTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '-';
                const endStr = r.endTime ? new Date(r.endTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : 'Sedang Mengerjakan';

                tbody.innerHTML += `
                    <tr class="hover:bg-blue-50 border-b text-sm">
                        <td class="p-4 font-bold text-gray-500">${idx + 1}</td>
                        <td class="p-4 font-bold text-gray-800">${s.name || '-'}</td>
                        <td class="p-4 font-mono text-xs text-gray-600">${s.nisn || s.username || '-'}</td>
                        <td class="p-4"><span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded text-xs font-semibold">${s.className || '-'}</span></td>
                        <td class="p-4 text-xs font-semibold text-gray-700">${ex.subject ? ex.subject.name : '-'}</td>
                        <td class="p-4 font-mono text-xs">${startStr} - ${endStr}</td>
                        <td class="p-4">${strikeBadge}</td>
                        <td class="p-4">${scoreDisplay}</td>
                        <td class="p-4"><span class="bg-green-100 text-green-800 text-xs px-2 py-0.5 rounded font-bold">${r.status}</span></td>
                        <td class="p-4 text-center no-print">
                            <button onclick="openLjsModal('${r.id}')" class="px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-lg text-xs border border-indigo-200 inline-flex items-center gap-1 shadow-sm transition-all" title="Buka Lembar Jawaban Siswa (LJS Digital)">
                                <span>📄</span> LJS
                            </button>
                        </td>
                    </tr>
                `;
            });
        }

