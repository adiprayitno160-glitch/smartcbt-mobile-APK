        async function loadExamQuestionsList(examId) {
            const listEl = document.getElementById('qeQuestionList');
            listEl.innerHTML = '<p class="text-gray-400 py-6 text-center">Memuat butir soal...</p>';
            try {
                const res = await fetch('/api/guru/exams/' + examId + '/questions', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const questions = await res.json();
                currentEditingQuestionList = Array.isArray(questions) ? questions : [];
                document.getElementById('qeCount').innerText = currentEditingQuestionList.length;

                if (currentEditingQuestionList.length === 0) {
                    listEl.innerHTML = '<p class="text-gray-400 py-6 text-center">Belum ada butir soal. Klik "+ Tambah Soal".</p>';
                    return;
                }

                listEl.innerHTML = currentEditingQuestionList.map((q, idx) => {
                    const snippet = q.content.replace(/<[^>]*>?/gm, '').substring(0, 45) || 'Pertanyaan ' + (idx + 1);
                    return `
                        <div class="p-2.5 rounded-xl border bg-slate-50 hover:bg-blue-50 transition-all flex justify-between items-center group">
                            <div class="cursor-pointer flex-1" onclick="loadQuestionToForm('${q.id}')">
                                <div class="flex items-center gap-1.5 mb-1">
                                    <span class="font-extrabold text-blue-900 bg-blue-200/70 px-1.5 py-0.5 rounded text-[10px]">#${q.orderNum || (idx + 1)}</span>
                                    <span class="text-[10px] bg-purple-100 text-purple-800 font-bold px-1.5 py-0.5 rounded">${q.cognitiveLevel || 'C3'}</span>
                                    <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded">Kunci: ${q.correctOption || 'A'}</span>
                                </div>
                                <p class="text-gray-700 truncate font-medium text-[11px]">${snippet}...</p>
                            </div>
                            <button onclick="deleteQuestionItem('${q.id}')" class="text-red-500 hover:text-red-700 hover:bg-red-50 p-1.5 rounded-lg opacity-80 group-hover:opacity-100 transition-opacity" title="Hapus Soal">
                                🗑️
                            </button>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                listEl.innerHTML = '<p class="text-red-500 py-4 text-center">Gagal memuat soal.</p>';
            }
        }

        function onQuestionTypeChange() {
            const qType = document.getElementById('qeType').value;
            const optContainer = document.getElementById('qeOptionsContainer');
            const optEContainer = document.getElementById('qeOptEContainer');
            const essayContainer = document.getElementById('qeEssayContainer');
            const keyWrapper = document.getElementById('qeKeySelectWrapper');
            const optOptionE = document.getElementById('qeOptOptionE');

            if (qType === 'ESSAY') {
                optContainer.classList.add('hidden');
                essayContainer.classList.remove('hidden');
                keyWrapper.classList.add('hidden');
            } else if (qType === 'MULTIPLE_CHOICE_5') {
                optContainer.classList.remove('hidden');
                optEContainer.classList.remove('hidden');
                optEContainer.classList.add('flex');
                essayContainer.classList.add('hidden');
                keyWrapper.classList.remove('hidden');
                optOptionE.classList.remove('hidden');
            } else { // MULTIPLE_CHOICE or MATCHING
                optContainer.classList.remove('hidden');
                optEContainer.classList.add('hidden');
                optEContainer.classList.remove('flex');
                essayContainer.classList.add('hidden');
                keyWrapper.classList.remove('hidden');
                optOptionE.classList.add('hidden');
                if (document.getElementById('qeCorrectOption').value === 'E') {
                    document.getElementById('qeCorrectOption').value = 'A';
                }
            }
        }
