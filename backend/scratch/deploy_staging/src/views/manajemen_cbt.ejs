        function editSchedule(examId) {
            const e = allExams.find(x => x.id === examId);
            if(!e) return;

            document.getElementById('schExamId').value = e.id;
            document.getElementById('schSelectExam').value = e.id;
            if (document.getElementById('schExamType')) {
                document.getElementById('schExamType').value = e.examType || 'SAS';
            }
            document.getElementById('schClass').value = e.assignedClasses || 'ALL';
            document.getElementById('schSession').value = e.sessionName || 'Sesi 1 (Pagi)';
            if (document.getElementById('schRoom')) {
                document.getElementById('schRoom').value = e.roomName || 'Lab Komputer 1';
            }
            if (document.getElementById('schProctor')) {
                document.getElementById('schProctor').value = e.proctorName || 'Proktor Utama';
            }
            document.getElementById('schDate').value = e.executionDate || new Date().toISOString().split('T')[0];
            document.getElementById('schStartTime').value = e.startTimeStr || '07:30';
            document.getElementById('schEndTime').value = e.endTimeStr || '09:30';
            document.getElementById('schDuration').value = e.durationMinutes || 90;
            if (document.getElementById('schMinDuration')) {
                document.getElementById('schMinDuration').value = e.minDurationMinutes || 30;
            }
            if (document.getElementById('schPassingGrade')) {
                document.getElementById('schPassingGrade').value = e.passingGrade || 75;
            }
            document.getElementById('schTokenActive').value = e.isTokenActive ? 'true' : 'false';
            if (document.getElementById('schMaxStrikes')) {
                document.getElementById('schMaxStrikes').value = e.maxStrikes || 3;
            }
