        async function regenerateScheduleToken(examId) {
            if (!confirm('Acak ulang token ujian ini? Pengawas dan siswa akan melihat token baru.')) return;
            try {
                const res = await fetch('/api/cbt/regenerate-token', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ examId })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ Token baru berhasil diacak: ' + (data.token || ''));
                    loadExams();
                } else {
                    alert('Gagal mengacak token: ' + (data.message || 'Error'));
                }
            } catch(e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        async function toggleScheduleToken(examId, currentlyActive) {
            const promptMsg = currentlyActive 
                ? 'Matikan / Nonaktifkan token ujian ini? Siswa tidak bisa login ujian sampai token diaktifkan kembali.' 
                : 'Aktifkan token ujian ini? Token akan dirilis untuk siswa.';
            if (!confirm(promptMsg)) return;
            try {
                const res = await fetch('/api/cbt/toggle-token', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ 
                        examId, 
                        isActive: !currentlyActive,
                        isTokenActive: !currentlyActive,
                        clearToken: currentlyActive
                    })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + (data.message || 'Status token berhasil diperbarui.'));
                    loadExams();
                } else {
                    alert('Gagal memperbarui status token: ' + (data.message || 'Error'));
                }
            } catch(e) {
                alert('Terjadi kesalahan jaringan saat memperbarui status token');
            }
        }

