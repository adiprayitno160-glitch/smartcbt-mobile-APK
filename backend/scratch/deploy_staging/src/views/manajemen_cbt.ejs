        function handleAiFileSelected(event) {
            const file = event.target.files[0];
            if (!file) return;
            selectedAiFile = file;
            document.getElementById('aiFileSelectedBadge').classList.remove('hidden');
            document.getElementById('aiFileNameText').innerText = file.name;
            const sizeKb = Math.round(file.size / 1024);
            document.getElementById('aiFileSizeText').innerText = `Ukuran: ${sizeKb} KB • Siap diekstrak AI`;

            // Isi judul otomatis jika masih kosong
            const titleInput = document.getElementById('aiTitle');
            if (!titleInput.value) {
                titleInput.value = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ');
            }
        }

