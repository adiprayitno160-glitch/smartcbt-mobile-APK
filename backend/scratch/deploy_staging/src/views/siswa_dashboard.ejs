                        <span>Hadir: <b class="text-emerald-700">21</b></span>
                        <span>Terlambat: <b class="text-amber-700">1</b></span>
                        <span>Persentase: <b class="text-blue-700">98%</b></span>
                    </div>
                </div>

                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-gray-50 border-b text-gray-600">
