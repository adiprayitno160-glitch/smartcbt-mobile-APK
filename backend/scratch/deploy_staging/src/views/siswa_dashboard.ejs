                        <button onclick="alert('Mengunduh berkas Rapor Digital PDF...')" class="bg-sky-700 hover:bg-sky-800 text-white font-bold px-4 py-2 rounded-lg text-xs">Unduh</button>
                    </div>
                    <div class="p-4 border rounded-xl flex justify-between items-center bg-gray-50 hover:bg-gray-100 transition-colors">
                        <div>
                            <p class="font-bold text-gray-800 text-sm">💳 Kartu Pelajar Digital Resmi</p>
                            <p class="text-xs text-gray-500">Format PDF • 850 KB • Lengkap QR</p>
                        </div>
                        <button onclick="alert('Mengunduh Kartu Pelajar Digital PDF...')" class="bg-sky-700 hover:bg-sky-800 text-white font-bold px-4 py-2 rounded-lg text-xs">Unduh</button>
                    </div>
                    <div class="p-4 border rounded-xl flex justify-between items-center bg-gray-50 hover:bg-gray-100 transition-colors">
