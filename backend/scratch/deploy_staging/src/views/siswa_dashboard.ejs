                            <p class="text-xs text-gray-500">Format PDF • 540 KB • Resmi</p>
                        </div>
                        <button onclick="alert('Mengunduh Surat Keterangan Siswa Aktif PDF...')" class="bg-sky-700 hover:bg-sky-800 text-white font-bold px-4 py-2 rounded-lg text-xs">Unduh</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 5: RUANG BK -->
        <div id="section-bk" class="hidden space-y-6">
            <div class="bg-gradient-to-r from-teal-700 to-emerald-800 p-6 rounded-2xl text-white shadow-sm flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="space-y-1">
                    <h2 class="text-lg font-bold flex items-center gap-2"><span>🕊️</span> Ruang Pengaduan & Konseling BK (100% Anonim)</h2>
                    <p class="text-xs text-teal-100 max-w-2xl leading-relaxed">
                        Ceritakan masalah perundungan/bullying, teman, atau belajar kepada Guru BK. Nama kamu tidak akan ditampilkan di laporan pada BK demi keamanan dan perlindunganmu jika memilih opsi anonim.
                    </p>
                </div>
                <button onclick="openModalReport()" class="bg-white hover:bg-teal-50 text-teal-900 font-extrabold px-5 py-2.5 rounded-xl shadow text-xs whitespace-nowrap cursor-pointer">
                    ✍️ Tulis Pesan ke Guru BK
                </button>
            </div>

            <!-- Riwayat Konseling Siswa -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border space-y-4">
                <div class="flex justify-between items-center border-b pb-3">
                    <h3 class="font-bold text-gray-800 text-sm flex items-center gap-2">
                        <span>💬</span> Riwayat Konseling & Jawaban Guru BK
                    </h3>
                    <button onclick="fetchStudentBkConsultations()" class="text-xs text-teal-600 hover:text-teal-800 font-semibold flex items-center gap-1 cursor-pointer">
                        🔄 Segarkan
                    </button>
                </div>
                <div id="bkConsultationList" class="space-y-3">
                    <p class="text-center text-xs text-gray-400 py-6">Memuat riwayat konseling...</p>
                </div>
            </div>
        </div>

        <!-- SECTION 6: PROFIL & GANTI PASSWORD / FOTO -->
        <div id="section-profile" class="hidden space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Kartu Identitas Profil -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border space-y-4">
                    <h2 class="text-lg font-bold text-gray-800 border-b pb-3">👤 Data Lengkap Siswa</h2>
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 bg-sky-100 text-sky-800 rounded-full flex items-center justify-center font-bold text-2xl border-2 border-sky-500 overflow-hidden" id="profileBigContainer">
                            <span id="profileBigInitial">S</span>
                        </div>
                        <div>
                            <p class="font-bold text-gray-800" id="profDetailName">Nama Siswa</p>
                            <p class="text-xs text-gray-500">NISN: <span id="profDetailNisn">131412082</span></p>
                            <input type="file" id="portalAvatarInput" accept="image/*" class="hidden" onchange="uploadStudentAvatar(event)">
                            <button onclick="document.getElementById('portalAvatarInput').click()" class="mt-2 text-xs bg-sky-50 text-sky-700 border border-sky-300 font-semibold px-3 py-1 rounded-md hover:bg-sky-100 cursor-pointer">📸 Ganti Foto Profil</button>
                        </div>
                    </div>

                    <div class="space-y-2 text-xs text-gray-600 border-t pt-3">
                        <div class="flex justify-between py-1 border-b">
                            <span>Kelas:</span>
                            <span class="font-bold text-gray-800">Kelas VII-A</span>
                        </div>
                        <div class="flex justify-between py-1 border-b">
                            <span>Wali Kelas:</span>
                            <span class="font-bold text-gray-800">Bpk. Drs. Agus Santoso, M.Pd</span>
                        </div>
                        <div class="flex justify-between py-1 border-b">
                            <span>Guru BK Pembimbing:</span>
                            <span class="font-bold text-gray-700" id="profGuruBk">-</span>
                        </div>
                        <div class="flex justify-between py-1 border-b">
                            <span>Golongan Darah:</span>
                            <span class="font-bold text-gray-800">O (Rhesus +)</span>
                        </div>
                        <div class="flex justify-between py-1 border-b">
                            <span>Poin Kedisiplinan:</span>
                            <span class="font-bold text-emerald-700">100 Poin (Disiplin Baik)</span>
                        </div>
                    </div>
                </div>

                <!-- Form Ganti Password -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border space-y-4">
                    <h2 class="text-lg font-bold text-gray-800 border-b pb-3">🔒 Ganti Password Akun</h2>
                    <form onsubmit="handlePortalChangePassword(event)" class="space-y-3 text-xs">
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">Password Lama:</label>
                            <input type="password" id="inputOldPassword" required class="w-full p-2.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="Masukkan password saat ini">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">Password Baru:</label>
                            <input type="password" id="inputNewPassword" required class="w-full p-2.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="Minimal 6 karakter">
                        </div>
                        <div>
                            <label class="block font-semibold text-gray-700 mb-1">Konfirmasi Password Baru:</label>
                            <input type="password" id="inputConfirmPassword" required class="w-full p-2.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="Ketik ulang password baru">
                        </div>
                        <button type="submit" class="w-full bg-sky-800 hover:bg-sky-900 text-white font-bold py-2.5 rounded-lg shadow transition-colors">Simpan Password Baru</button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <!-- MODAL TULIS PESAN / PENGADUAN BK -->
    <div id="modalReportBk" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 space-y-4 shadow-xl">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-bold text-gray-800 text-base flex items-center gap-2">
                    <span>🕊️</span> Tulis Laporan / Konsultasi BK
                </h3>
                <button onclick="closeModalReport()" class="text-gray-400 hover:text-gray-600 font-bold text-lg cursor-pointer">&times;</button>
            </div>
            <form onsubmit="submitStudentBkReport(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Kategori Masalah</label>
                    <select id="bkInputCategory" class="w-full border rounded-lg p-2.5 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-teal-500">
                        <option value="Masalah Belajar & Akademik">Masalah Belajar & Akademik</option>
                        <option value="Pengaduan Perundungan (Bullying)">Pengaduan Perundungan (Bullying)</option>
                        <option value="Masalah Sosial & Pertemanan">Masalah Sosial & Pertemanan</option>
                        <option value="Kendala Pribadi & Emosional">Kendala Pribadi & Emosional</option>
                        <option value="Bimbingan Karir & Masa Depan">Bimbingan Karir & Masa Depan</option>
                        <option value="Lainnya">Lainnya</option>
                    </select>
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Judul / Perihal</label>
                    <input type="text" id="bkInputSubject" required placeholder="Contoh: Kendala Belajar Matematika / Laporan Bullying" class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-teal-500">
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Ceritakan Secara Detail</label>
                    <textarea id="bkInputMessage" rows="4" required placeholder="Jelaskan apa yang terjadi, apa yang ingin dikonsultasikan..." class="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-teal-500"></textarea>
                </div>
                <div class="flex items-center gap-2 bg-teal-50 p-3 rounded-lg border border-teal-200">
                    <input type="checkbox" id="bkInputAnonymous" class="rounded text-teal-600 focus:ring-teal-500 cursor-pointer">
                    <label for="bkInputAnonymous" class="font-bold text-teal-900 cursor-pointer text-xs">
                        🕵️ Kirim sebagai Anonim (Identitas Dirahasiakan dari Guru BK)
                    </label>
                </div>
                <div class="flex justify-end gap-2 pt-2 border-t">
                    <button type="button" onclick="closeModalReport()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 font-semibold cursor-pointer">Batal</button>
                    <button type="submit" id="btnSubmitBkReport" class="px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 font-bold shadow cursor-pointer">Kirim ke Guru BK</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if (!token) {
            window.location.href = '/';
        }

        function applyUserProfile(user) {
            if (!user) return;
            document.getElementById('profileName').textContent = user.name || 'Siswa';
            document.getElementById('welcomeName').textContent = user.name || 'Siswa';
            document.getElementById('profDetailName').textContent = user.name || 'Siswa';
            document.getElementById('profileNis').textContent = user.username || user.nisn || '-';
            document.getElementById('profDetailNisn').textContent = user.nisn || user.username || '-';
            if (user.className) {
                const badge = document.getElementById('studentClassBadge');
                if (badge) badge.textContent = user.className;
            }

            const initial = (user.name || 'S').charAt(0).toUpperCase();
            const smallCont = document.getElementById('profilePicContainer');
            const bigCont = document.getElementById('profileBigContainer');

            if (user.profilePicUrl) {
                if (smallCont) smallCont.innerHTML = `<img src="${user.profilePicUrl}" class="w-full h-full object-cover rounded-full" alt="Foto">`;
                if (bigCont) bigCont.innerHTML = `<img src="${user.profilePicUrl}" class="w-full h-full object-cover rounded-full" alt="Foto">`;
            } else {
                if (smallCont) smallCont.innerHTML = `<span id="profileInitial">${initial}</span>`;
                if (bigCont) bigCont.innerHTML = `<span id="profileBigInitial">${initial}</span>`;
            }
        }

        const userStr = localStorage.getItem('user');
        if (userStr) {
            try {
                applyUserProfile(JSON.parse(userStr));
            } catch (e) {}
        }

        // Ambil data profil terbaru dari server (termasuk foto profil)
        async function fetchFreshStudentProfile() {
            try {
                const res = await fetch('/api/student/profile', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    const json = await res.json();
                    const freshUser = json.user || json.data;
                    if (freshUser) {
                        const merged = { ...(userStr ? JSON.parse(userStr) : {}), ...freshUser };
                        localStorage.setItem('user', JSON.stringify(merged));
                        applyUserProfile(merged);
                    }
                }
            } catch (err) {
                console.warn('Gagal memuat profil server:', err);
            }
        }
        fetchFreshStudentProfile();

        async function uploadStudentAvatar(event) {
            const file = event.target.files?.[0];
            if (!file) return;

            if (file.size > 5 * 1024 * 1024) {
                alert('Ukuran foto maksimal 5 MB');
                return;
            }

            const reader = new FileReader();
            reader.onload = async function(e) {
                const base64Data = e.target.result;
                try {
                    const res = await fetch('/api/student/profile', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': 'Bearer ' + token
                        },
                        body: JSON.stringify({ profilePicBase64: base64Data })
                    });
                    const data = await res.json();
                    if (res.ok) {
                        alert('✅ Foto profil berhasil diperbarui!');
                        if (data.user || data.data) {
                            const updatedUser = data.user || data.data;
                            const current = userStr ? JSON.parse(userStr) : {};
                            const merged = { ...current, ...updatedUser };
                            localStorage.setItem('user', JSON.stringify(merged));
                            applyUserProfile(merged);
                        } else {
                            fetchFreshStudentProfile();
                        }
                    } else {
                        alert('❌ Gagal mengunggah foto: ' + (data.message || 'Error server'));
                    }
                } catch (err) {
                    alert('Error unggah foto: ' + err.message);
                }
            };
            reader.readAsDataURL(file);
        }

        function switchSiswaTab(tab) {
            const tabs = ['home', 'absensi', 'analytics', 'efiles', 'bk', 'profile'];
            tabs.forEach(t => {
                const section = document.getElementById('section-' + t);
                const btn = document.getElementById('tabBtn-' + t);
                if (section) section.classList.toggle('hidden', t !== tab);
                if (btn) {
                    if (t === tab) {
                        btn.className = 'w-full text-left px-4 py-2.5 bg-blue-600/30 text-blue-300 rounded-xl font-bold border-l-4 border-blue-500 flex items-center gap-2.5';
                    } else {
                        btn.className = 'w-full text-left px-4 py-2.5 hover:bg-blue-600/20 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all';
                    }
                }
            });
            if (tab === 'bk') {
                fetchStudentBkConsultations();
            }
        }

        function openModalReport() {
            const m = document.getElementById('modalReportBk');
            if (m) {
                m.classList.remove('hidden');
                m.classList.add('flex');
            }
        }

        function closeModalReport() {
            const m = document.getElementById('modalReportBk');
            if (m) {
                m.classList.add('hidden');
                m.classList.remove('flex');
            }
        }

        async function submitStudentBkReport(e) {
            e.preventDefault();
            const category = document.getElementById('bkInputCategory').value;
            const subject = document.getElementById('bkInputSubject').value.trim();
            const message = document.getElementById('bkInputMessage').value.trim();
            const isAnonymous = document.getElementById('bkInputAnonymous').checked;

            if (!subject || !message) {
                alert('Harap isi judul dan detail pesan pengaduan.');
                return;
            }

            const btn = document.getElementById('btnSubmitBkReport');
            btn.disabled = true;
            btn.innerText = 'Mengirim...';

            try {
                const res = await fetch('/api/student/bk-report', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ category, subject, message, isAnonymous })
                });
                const data = await res.json();
                if (res.ok && (data.success !== false)) {
                    alert('✅ ' + (data.message || 'Pesan berhasil dikirim ke Guru BK!'));
                    document.getElementById('bkInputSubject').value = '';
                    document.getElementById('bkInputMessage').value = '';
                    document.getElementById('bkInputAnonymous').checked = false;
                    closeModalReport();
                    fetchStudentBkConsultations();
                } else {
                    alert('❌ Gagal mengirim: ' + (data.message || 'Terjadi kesalahan server'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerText = 'Kirim ke Guru BK';
            }
        }

        async function fetchStudentBkConsultations() {
            const container = document.getElementById('bkConsultationList');
            if (!container) return;

            try {
                const res = await fetch('/api/student/bk-consultations', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (!res.ok) throw new Error('Gagal memuat riwayat konseling');
                const list = await res.json();

                if (!Array.isArray(list) || list.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-8 text-gray-400">
                            <p class="text-2xl mb-1">🕊️</p>
                            <p class="text-xs font-semibold">Belum ada riwayat konseling atau pengaduan.</p>
                            <p class="text-[11px] text-gray-400 mt-0.5">Klik tombol "Tulis Pesan ke Guru BK" di atas jika ada hal yang ingin diceritakan.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = list.map(c => {
                    const isReplied = c.replyMessage && c.replyMessage.trim().length > 0;
                    const dateStr = c.createdAt ? new Date(c.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';
                    const replyDateStr = c.replyDate ? new Date(c.replyDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
                    const counselorName = c.counselor?.name || 'Guru BK';

                    return `
                        <div class="border border-gray-100 rounded-xl p-4 space-y-2.5 bg-gray-50/50 hover:bg-gray-50 transition-all">
                            <div class="flex justify-between items-start gap-2">
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="bg-teal-100 text-teal-800 text-[10px] font-bold px-2 py-0.5 rounded-full">${c.category || 'Konseling BK'}</span>
                                        ${c.isAnonymous ? '<span class="bg-gray-200 text-gray-700 text-[10px] font-semibold px-2 py-0.5 rounded-full">🕵️ Anonim</span>' : ''}
                                        <span class="text-[11px] text-gray-400">${dateStr}</span>
                                    </div>
                                    <h4 class="font-bold text-gray-800 text-xs mt-1">${c.subject || 'Tanpa Judul'}</h4>
                                </div>
                                <span class="${isReplied ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'} text-[10px] font-bold px-2.5 py-1 rounded-lg whitespace-nowrap">
                                    ${isReplied ? '✅ Sudah Dibalas' : '⏳ Menunggu Jawaban'}
                                </span>
                            </div>
                            <p class="text-xs text-gray-600 bg-white p-3 rounded-lg border border-gray-100 leading-relaxed">${c.message}</p>
                            ${isReplied ? `
                                <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-lg space-y-1">
                                    <div class="flex justify-between items-center text-[10px] text-emerald-700 font-bold">
                                        <span>💡 Tanggapan ${counselorName}:</span>
                                        <span class="text-emerald-600 font-normal">${replyDateStr}</span>
                                    </div>
                                    <p class="text-xs text-emerald-900 leading-relaxed">${c.replyMessage}</p>
                                </div>
                            ` : ''}
                        </div>
                    `;
                }).join('');
            } catch (err) {
                container.innerHTML = `<p class="text-xs text-red-500 text-center py-4">Error memuat data BK: ${err.message}</p>`;
            }
        }

        async function handlePortalChangePassword(e) {
            e.preventDefault();
            const oldP = document.getElementById('inputOldPassword').value;
            const newP = document.getElementById('inputNewPassword').value;
            const confP = document.getElementById('inputConfirmPassword').value;

            if (newP !== confP) {
                alert('Konfirmasi password baru tidak cocok!');
                return;
            }

            try {
                const res = await fetch('/api/student/profile', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ oldPassword: oldP, newPassword: newP })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + (data.message || 'Password berhasil diperbarui!'));
                    document.getElementById('inputOldPassword').value = '';
                    document.getElementById('inputNewPassword').value = '';
                    document.getElementById('inputConfirmPassword').value = '';
                } else {
                    alert('❌ Gagal: ' + (data.message || 'Password lama salah'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            }
        }

        // ==================== SIDEBAR TOGGLE & PERSISTENCE ====================
        function togglePortalSidebar() {
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            if (!sidebar) return;

            const isCurrentlyHidden = sidebar.classList.contains('-translate-x-full');

            if (isCurrentlyHidden) {
                sidebar.classList.remove('-translate-x-full');
                if (expandBtn) expandBtn.classList.add('hidden');
                mainEls.forEach(m => {
                    m.classList.add('ml-64');
                    m.classList.remove('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'false');
            } else {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'true');
            }
        }

        // Shortcut Ctrl+B
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                togglePortalSidebar();
            }
        });

        // Apply saved state
        (function applySavedSidebarState() {
            const isCollapsed = localStorage.getItem('portal_sidebar_collapsed') === 'true';
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            
            if (isCollapsed && sidebar) {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
            }
        })();

        function logout() {
            localStorage.clear();
            window.location.href = '/';
        }
    </script>
</body>
</html>
