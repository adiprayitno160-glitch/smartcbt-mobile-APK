<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Siswa - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-slate-50 text-slate-800 flex h-screen overflow-hidden font-sans">
    
    <!-- Floating Expand Button (Visible when Sidebar is Collapsed) -->
    <button type="button" onclick="togglePortalSidebar()" id="sidebarExpandBtn" title="Tampilkan Sidebar (Shortcut: Ctrl+B)" class="fixed top-3 left-4 z-50 bg-slate-900/95 hover:bg-sky-600 text-white px-3.5 py-2 rounded-xl shadow-2xl border border-slate-700/80 backdrop-blur-md transition-all duration-300 hidden flex items-center gap-2.5 text-xs font-bold hover:scale-105 group cursor-pointer">
        <svg class="w-5 h-5 text-sky-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <span class="font-extrabold tracking-wide">Menu Siswa</span>
        <span class="text-[10px] bg-white/15 px-1.5 py-0.5 rounded text-slate-300">Ctrl+B</span>
    </button>

    <!-- Sidebar Siswa (Refreshed Slate & Sky Theme) -->
    <aside id="portalSidebar" class="w-64 bg-slate-900 h-screen text-white flex flex-col fixed left-0 top-0 shadow-2xl z-40 border-r border-slate-800 transition-all duration-300 ease-in-out select-none">
        <!-- Brand Header with Logo and Collapse Toggle Button -->
        <div class="px-4 py-3.5 border-b border-slate-800 bg-gradient-to-r from-slate-900 via-slate-900 to-sky-950/40 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2.5 overflow-hidden">
                <div class="w-10 h-10 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-md border border-sky-400/30 flex-shrink-0">
                    <img src="/logo-smpn1boyolangu.png" alt="Logo SMPN 1 Boyolangu" class="w-full h-full object-contain drop-shadow" onerror="this.src='/logo.png'">
                </div>
                <div class="truncate">
                    <h1 class="font-black text-sm tracking-wide text-white leading-tight">SMART SISWA</h1>
                    <p class="text-[11px] text-sky-400 font-semibold truncate">SMPN 1 Boyolangu</p>
                </div>
            </div>

            <!-- Toggle Button to Hide / Collapse Sidebar -->
            <button type="button" onclick="togglePortalSidebar()" id="sidebarCollapseBtn" title="Sembunyikan Sidebar (Ctrl+B)" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all flex items-center justify-center group flex-shrink-0 cursor-pointer" aria-label="Sembunyikan Sidebar">
                <svg class="w-5 h-5 transition-transform group-hover:-translate-x-0.5 text-slate-400 group-hover:text-sky-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
                </svg>
            </button>
        </div>

        <div class="p-3 bg-slate-950/50 border-b border-slate-800 flex items-center space-x-3">
            <div class="w-9 h-9 bg-sky-600/30 text-sky-300 rounded-xl flex items-center justify-center font-black text-sm border border-sky-500/30 flex-shrink-0 shadow-inner" id="profilePicContainer">
                <span id="profileInitial">S</span>
            </div>
            <div class="overflow-hidden">
                <p class="text-xs font-bold text-slate-100 truncate" id="profileName">Nama Siswa</p>
                <div class="flex items-center gap-1 mt-0.5">
                    <span class="text-[10px] text-sky-400 font-semibold truncate">NISN: <span id="profileNis">-</span></span>
                </div>
            </div>
        </div>

        <nav class="flex-1 p-3 space-y-1.5 overflow-y-auto text-sm font-semibold">
            <button onclick="switchSiswaTab('home')" id="tabBtn-home" class="w-full text-left px-3.5 py-2.5 bg-sky-600/30 text-sky-200 rounded-xl font-bold border-l-4 border-sky-500 flex items-center gap-2.5 text-[13.5px]">
                <span class="text-lg">🏠</span> <span>Beranda &amp; Ujian</span>
            </button>
            <button onclick="switchSiswaTab('absensi')" id="tabBtn-absensi" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">📊</span> <span>Rekap Absensi Detail</span>
            </button>
            <button onclick="switchSiswaTab('analytics')" id="tabBtn-analytics" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">📈</span> <span>Analisis Belajar</span>
            </button>
            <button onclick="switchSiswaTab('efiles')" id="tabBtn-efiles" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">📁</span> <span>E-File Dokumen</span>
            </button>
            <button onclick="switchSiswaTab('bk')" id="tabBtn-bk" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">🕊️</span> <span>Layanan BK &amp; Curhat</span>
            </button>
            <button onclick="switchSiswaTab('profile')" id="tabBtn-profile" class="w-full text-left px-3.5 py-2.5 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl font-medium flex items-center gap-2.5 transition-all text-[13.5px]">
                <span class="text-lg">👤</span> <span>Profil &amp; Password</span>
            </button>
        </nav>

        <div class="p-3 border-t border-slate-800 bg-slate-950/70">
            <button onclick="logout()" class="w-full bg-rose-600/90 hover:bg-rose-700 text-white font-bold py-2.5 rounded-xl shadow-md transition-colors text-xs flex items-center justify-center gap-2 cursor-pointer">
                <span>🚪</span> <span>Logout Siswa</span>
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-6 md:p-8 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <header class="mb-6 border-b border-slate-200/80 pb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">Halo, <span id="welcomeName">Siswa</span>! 👋</h1>
                    <p class="text-slate-500 text-xs">Portal Terpadu Siswa: Akademik, Presensi Masuk/Pulang, Nilai, E-File &amp; Layanan BK</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="/uploads/smartcbt-latest.apk" download="smartcbt-latest.apk" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs shadow transition-all" title="Unduh APK Mobile Smart School CBT Versi Terbaru">
                    <span>📲</span> <span>Unduh APK v2.8.59</span>
                </a>
                <span class="text-xs bg-sky-100 text-sky-800 font-bold px-3 py-1.5 rounded-full border border-sky-200" id="studentClassBadge">Kelas VII-A</span>
            </div>
        </header>

        <!-- SECTION 1: HOME & UJIAN AKTIF -->
        <div id="section-home" class="space-y-6">
            <!-- Banner Pembaruan APK Smart School CBT Siswa -->
            <div class="bg-gradient-to-r from-emerald-600 to-teal-700 text-white p-4 rounded-2xl shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-3">
                    <span class="text-3xl p-2 bg-white/20 rounded-xl">📲</span>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-extrabold text-sm">Aplikasi Smart School CBT Siswa v2.8.59 (Build 67)</h3>
                            <span class="bg-emerald-400/30 text-emerald-100 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-300/40">Versi Terbaru</span>
                        </div>
                        <p class="text-xs text-emerald-100 mt-0.5">Tampilan modern, dialog token ujian baru, header berwarna tugas &amp; arsip, dan koneksi VPS live otomatis.</p>
                    </div>
                </div>
                <a href="/uploads/smartcbt-latest.apk" download="smartcbt-latest.apk" class="bg-white hover:bg-emerald-50 text-emerald-800 font-bold px-4 py-2 rounded-xl text-xs shadow-md transition-all whitespace-nowrap flex items-center gap-2">
                    <span>⬇️</span> <span>Unduh APK Resmi</span>
                </a>
            </div>

            <!-- Hero Card Info -->
            <div class="bg-gradient-to-r from-sky-800 to-blue-900 text-white p-6 rounded-2xl shadow-sm">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <h2 class="text-lg font-bold">Informasi Pembimbing Akademik</h2>
                        <div class="mt-2 space-y-1 text-xs text-sky-200">
                            <p>👨‍🏫 <b>Wali Kelas:</b> <span id="homeWaliKelas">Bpk. Drs. Agus Santoso, M.Pd</span></p>
                            <p>🕊️ <b>Guru BK Pembimbing:</b> <span id="homeGuruBk">-</span></p>
                            <p>🩸 <b>Golongan Darah:</b> <span id="homeBlood">O (Rhesus +)</span> | ⭐ <b>Poin Kedisiplinan:</b> <span id="homePoints">100 (Disiplin)</span></p>
                        </div>
                    </div>
                    <div class="bg-white/10 p-3 rounded-xl border border-white/20 text-xs space-y-1">
                        <p class="font-bold text-white">Presensi Hari Ini:</p>
                        <p class="text-emerald-300 font-semibold">Siap Scan Barcode Pintu Kelas</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
                    <h2 class="text-lg font-bold text-sky-900 mb-4 border-b pb-2 flex items-center gap-2">
                        <span>📝</span> Ujian CBT Aktif Hari Ini
                    </h2>
                    <div id="activeExamsList" class="space-y-3">
                        <div class="p-4 bg-sky-50 rounded-xl border border-sky-200">
                            <p class="font-bold text-sky-900 text-sm">Penilaian Akhir Semester (PAS) 2025/2026</p>
                            <p class="text-xs text-gray-600 mt-1">Durasi: 90 Menit • Mode Ujian Nasional Kiosk Anti-Curang</p>
                            <p class="text-xs font-semibold text-emerald-700 mt-2">Token Ujian: Diberikan oleh Pengawas Ruang</p>
                        </div>
                    </div>
                </div>

                <div class="bg-gradient-to-br from-sky-600 to-blue-700 p-6 rounded-2xl shadow-sm text-white space-y-3">
                    <h2 class="text-lg font-bold flex items-center gap-2">
                        <span>📱</span> Panduan Penggunaan Mobile APK
                    </h2>
                    <ul class="list-disc pl-5 space-y-2 text-xs text-sky-50 leading-relaxed">
                        <li><b>Presensi Masuk/Pulang:</b> Buka aplikasi mobile APK lalu tekan tombol kamera di tengah bawah untuk scan barcode kelas.</li>
                        <li><b>Ujian CBT:</b> Masukkan Token Ujian yang diberikan oleh pengawas/proktor saat ujian dibuka.</li>
                        <li><b>E-File:</b> Unduh Rapor Digital, Kartu Pelajar, dan Sertifikat langsung di menu E-File.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- SECTION 2: REKAP ABSENSI DETAIL -->
