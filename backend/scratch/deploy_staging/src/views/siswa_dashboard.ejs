                        </div>
                        <button onclick="alert('Mengunduh Sertifikat Sains PDF...')" class="bg-sky-700 hover:bg-sky-800 text-white font-bold px-4 py-2 rounded-lg text-xs">Unduh</button>
                    </div>
                    <div class="p-4 border rounded-xl flex justify-between items-center bg-gray-50 hover:bg-gray-100 transition-colors">
