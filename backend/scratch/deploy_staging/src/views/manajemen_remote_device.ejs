<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📱 Remote (Galeri & Media Siswa) - Smart School Panel</title>
    <script src="/js/tailwind.js"></script>
    <script>
        let zipPollTimer = null;
        let currentZipFolder = 'ALL';

        async function downloadCurrentFolderZip() {
            if (!currentDeviceId) {
                alert('Pilih perangkat siswa terlebih dahulu dari daftar di sebelah kiri.');
                return;
            }
            const folder = currentFolderFilter || 'ALL';
            currentZipFolder = folder;
            const folderTitle = folder === 'ALL' ? 'Semua Berkas' : folder;

            document.getElementById('modalFolderZip').classList.remove('hidden');
            document.getElementById('zipModalFolder').innerText = 'Folder: ' + folderTitle;
            document.getElementById('zipStatusMessage').innerText = 'Menghubungi HP siswa untuk menyiapkan berkas...';
            document.getElementById('zipProgressBar').style.width = '10%';

            try {
                if (!token) token = await getFreshToken();
                const res = await fetch('/api/admin/remote-devices/' + currentDeviceId + '/folder-zip/prepare', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ folder, limit: 100 })
                });
                const data = await res.json();
                if (!data.success) {
                    alert('❌ ' + (data.message || 'Gagal menyiapkan folder'));
                    closeZipModal();
                    return;
                }

                updateZipModalUI(data.totalTarget, data.readyCount, data.queuedCount);

                if (data.readyCount >= data.totalTarget && data.totalTarget > 0) {
                    document.getElementById('zipStatusMessage').innerText = '✅ Semua berkas siap! Mengunduh arsip ZIP...';
                    document.getElementById('zipProgressBar').style.width = '100%';
                    setTimeout(() => {
                        triggerActualZipDownload();
                    }, 600);
                    return;
                }

                if (zipPollTimer) clearInterval(zipPollTimer);
                zipPollTimer = setInterval(pollZipStatus, 2000);
            } catch(e) {
                console.error('Error prepare folder zip:', e);
                alert('❌ Terjadi kesalahan jaringan saat menyiapkan unduhan folder.');
                closeZipModal();
            }
        }

        async function pollZipStatus() {
            if (!currentDeviceId) return;
            try {
                const res = await fetch('/api/admin/remote-devices/' + currentDeviceId + '/folder-zip/status?folder=' + encodeURIComponent(currentZipFolder) + '&limit=100', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (data.success) {
                    updateZipModalUI(data.totalTarget, data.readyCount, data.pendingCount, data.failedCount || 0);
                    if (data.isComplete || (data.readyCount + (data.failedCount || 0) >= data.totalTarget)) {
                        if (zipPollTimer) clearInterval(zipPollTimer);
                        zipPollTimer = null;
                        if (data.readyCount > 0) {
                            document.getElementById('zipStatusMessage').innerText = `✅ ${data.readyCount} berkas selesai disiapkan! Memulai unduhan ZIP...`;
                            document.getElementById('zipProgressBar').style.width = '100%';
                            setTimeout(() => {
                                triggerActualZipDownload();
                            }, 800);
                        } else {
                            document.getElementById('zipStatusMessage').innerText = `⚠️ Seluruh ${data.totalTarget} berkas di HP tidak dapat dibaca (dibatasi oleh Scoped Storage OS HP).`;
                            document.getElementById('zipProgressBar').style.width = '100%';
                            document.getElementById('zipProgressBar').className = 'bg-rose-500 h-2.5 rounded-full transition-all duration-300';
                        }
                    }
                }
            } catch(e) {
                console.error('Error polling zip status:', e);
                const msgEl = document.getElementById('zipStatusMessage');
                if (msgEl) msgEl.innerText = '⚠️ Koneksi lambat saat memeriksa status unduhan...';
            }
        }

        function updateZipModalUI(total, ready, pending, failed = 0) {
            document.getElementById('zipStatTotal').innerText = total;
            document.getElementById('zipStatReady').innerText = ready;
            document.getElementById('zipStatPending').innerText = pending;
            const elFailed = document.getElementById('zipStatFailed');
            if (elFailed) elFailed.innerText = failed;
            const pct = total > 0 ? Math.round(((ready + failed) / total) * 100) : 0;
            document.getElementById('zipProgressBar').style.width = pct + '%';
            if (pending > 0) {
                document.getElementById('zipStatusMessage').innerText = 'Sedang mentransfer: ' + ready + ' dari ' + total + ' berkas siap (' + pending + ' dalam antrean HP)';
            } else if (ready > 0) {
                document.getElementById('zipStatusMessage').innerText = '✅ ' + ready + ' berkas siap diunduh dalam arsip ZIP.';
            } else if (failed > 0) {
                document.getElementById('zipStatusMessage').innerText = '⚠️ ' + failed + ' berkas di HP tidak dapat diakses.';
            }

            const btnDownload = document.getElementById('btnTriggerZipDownload');
            if (btnDownload) {
                if (ready > 0) {
                    btnDownload.disabled = false;
                    btnDownload.className = 'flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 rounded-xl text-xs font-black shadow-md transition-all cursor-pointer';
                    btnDownload.innerText = ready >= total ? 'Unduh Semua (.ZIP)' : `⬇️ Unduh Yang Sudah Siap (${ready} Berkas)`;
                } else {
                    btnDownload.disabled = true;
                    btnDownload.className = 'flex-1 bg-gray-300 text-gray-500 py-2.5 rounded-xl text-xs font-bold transition-all cursor-not-allowed';
                    btnDownload.innerText = 'Menunggu berkas siap...';
                }
            }
        }

        function triggerActualZipDownload() {
            if (!currentDeviceId) return;
            const tok = token || localStorage.getItem('token') || '';
            window.location.href = '/api/admin/remote-devices/' + currentDeviceId + '/folder-zip/download?folder=' + encodeURIComponent(currentZipFolder) + '&token=' + encodeURIComponent(tok);
        }

        function closeZipModal() {
            if (zipPollTimer) clearInterval(zipPollTimer);
            zipPollTimer = null;
            document.getElementById('modalFolderZip').classList.add('hidden');
        }
    </script>
