        function openPreviewModal(fileId, fileName, filePath, fileSize) {
            const isVideo = /\.(mp4|mkv|avi|mov|webm|3gp)$/i.test(fileName);
            const isPdf = fileName.toLowerCase().endsWith('.pdf');

            document.getElementById('modalTitle').innerText = (isVideo ? 'Pratinjau Video: ' : (isPdf ? 'Pratinjau Dokumen: ' : 'Pratinjau Foto: ')) + fileName;
            document.getElementById('modalFileName').innerText = fileName;
            document.getElementById('modalFilePath').innerText = filePath;
            document.getElementById('modalFileSize').innerText = 'Ukuran: ' + fileSize;

            const imgEl = document.getElementById('modalPreviewImg');
            const pdfEl = document.getElementById('modalPdfPlaceholder');
            const videoEl = document.getElementById('modalVideoPlaceholder');

            imgEl.classList.add('hidden');
            pdfEl.classList.add('hidden');
            pdfEl.classList.remove('flex');
            if (videoEl) {
                videoEl.classList.add('hidden');
                videoEl.classList.remove('flex');
            }

            if (isPdf) {
                pdfEl.classList.remove('hidden');
                pdfEl.classList.add('flex');
            } else if (isVideo) {
                if (videoEl) {
                    videoEl.classList.remove('hidden');
                    videoEl.classList.add('flex');
                }
                const badge = document.getElementById('modalStatusBadge');
                if (badge) {
                    badge.className = 'bg-indigo-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                    badge.innerText = '🎬 Video';
                }
                const player = document.getElementById('modalVideoPlayer');
                const notice = document.getElementById('modalVideoNotice');
                if (player) {
                    const tok = token || localStorage.getItem('token') || '';
                    const streamUrl = '/api/admin/remote-devices/' + (currentDeviceId || '0') + '/stream/' + encodeURIComponent(fileId) + '?token=' + encodeURIComponent(tok);
                    player.src = streamUrl;
                    player.load();
                    player.onerror = function() {
                        if (notice) notice.innerText = '⚠️ Video belum disalin ke server PC. Klik tombol [Salin ke Server] di bawah untuk memproses unduhan.';
                        if (badge) {
                            badge.className = 'bg-amber-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                            badge.innerText = '🎬 Video (Perlu Salin ke PC)';
                        }
                    };
                    player.oncanplay = function() {
                        if (notice) notice.innerText = '✅ Siap diputar langsung dari server (HTTP 206 Streaming).';
                        if (badge) {
                            badge.className = 'bg-emerald-600/90 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                            badge.innerText = '🎬 Video (Siap Diputar)';
                        }
                    };
                }
            } else {
                imgEl.classList.remove('hidden');
                const badge = document.getElementById('modalStatusBadge');
                if (badge) {
                    badge.className = 'bg-blue-600/80 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                    badge.innerText = '⏳ Memuat...';
                }
                const previewSrc = '/api/admin/remote-devices/' + (currentDeviceId || '0') + '/preview-image?file=' + encodeURIComponent(fileName) + '&fileId=' + encodeURIComponent(fileId) + '&t=' + Date.now();
                imgEl.onload = function() {
                    if (badge) {
                        // Cek apakah output adalah SVG placeholder atau foto asli
                        const isSvg = imgEl.naturalWidth === 600 && imgEl.naturalHeight === 380;
                        if (isSvg) {
                            badge.className = 'bg-amber-500/80 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                            badge.innerText = '⏳ Mentransfer dari HP...';
                            // Polling refresh foto setelah 3 detik saat HP selesai kirim
                            setTimeout(() => {
                                if (!document.getElementById('previewModal').classList.contains('hidden')) {
                                    imgEl.src = '/api/admin/remote-devices/' + (currentDeviceId || '0') + '/preview-image?file=' + encodeURIComponent(fileName) + '&fileId=' + encodeURIComponent(fileId) + '&t=' + Date.now();
                                }
                            }, 3500);
                        } else {
                            badge.className = 'bg-emerald-600/80 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                            badge.innerText = '🟢 Foto Asli HP';
                        }
                    }
                };
                imgEl.onerror = function() {
                    if (badge) {
                        badge.className = 'bg-red-500/80 text-white font-bold text-[11px] px-2.5 py-0.5 rounded-full';
                        badge.innerText = '❌ Gagal Memuat';
                    }
                };
                imgEl.src = previewSrc;
            }

            document.getElementById('modalBtnCopy').onclick = function() {
                requestCopyFile(fileId, fileName, filePath);
                closePreviewModal();
            };

            const directBtn = document.getElementById('modalBtnDirectDownload');
            if (directBtn) {
                directBtn.onclick = function() {
                    downloadDirectFile(fileId, fileName, filePath);
                };
            }

            document.getElementById('previewModal').classList.remove('hidden');
        }

