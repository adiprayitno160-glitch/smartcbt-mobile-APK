            currentDeviceFiles.forEach(f => {
                if (selectedFileIds.has(f.id)) totalBytes += (f.fileSize || 0);
            });
            let humanSize = totalBytes > 1048576 ? (totalBytes / 1048576).toFixed(1) + ' MB' : (totalBytes / 1024).toFixed(0) + ' KB';

            // Top action bar badge & button
            const topBadge = document.getElementById('selectedCountBadge');
            if (topBadge) topBadge.innerText = count;

            const topBtn = document.getElementById('btnBulkCopyTop');
            if (topBtn) {
                if (count > 0) {
                    topBtn.disabled = false;
                    topBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    topBtn.innerHTML = `<span>📥</span> <span>Salin ${count} Berkas ke PC (${humanSize})</span>`;
                } else {
                    topBtn.disabled = true;
                    topBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    topBtn.innerHTML = `<span>📥</span> <span>Salin Berkas Terpilih ke PC</span>`;
                }
            }

            // Sync top checkbox state
            const chkAll = document.getElementById('chkSelectAllFolder');
            if (chkAll) {
                const currentFiles = getFilteredFiles();
                chkAll.checked = currentFiles.length > 0 && currentFiles.every(f => selectedFileIds.has(f.id));
            }

            // Floating drawer
            if (count > 0) {
                if (bar) bar.classList.remove('hidden');
                const cntEl = document.getElementById('floatingSelectedCount');
                if (cntEl) cntEl.innerText = count;
                const sizeEl = document.getElementById('floatingTotalSize');
