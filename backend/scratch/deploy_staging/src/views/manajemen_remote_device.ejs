        function updatePaginationUI() {
            const pageNumEl = document.getElementById('currentPageNum');
            const totalPageEl = document.getElementById('totalPageNum');
            const pageInfoEl = document.getElementById('pageInfoFiles');
            const totalInfoEl = document.getElementById('totalInfoFiles');
            const btnPrev = document.getElementById('btnPrevPage');
            const btnNext = document.getElementById('btnNextPage');

            if (pageNumEl) pageNumEl.innerText = currentPage;
            if (totalPageEl) totalPageEl.innerText = currentTotalPages;
            if (btnPrev) btnPrev.disabled = (currentPage <= 1);
            if (btnNext) btnNext.disabled = (currentPage >= currentTotalPages);

            const startIdx = (currentPage - 1) * 60 + 1;
            const endIdx = Math.min(currentPage * 60, currentTotalFilesForFolder);
            if (pageInfoEl) pageInfoEl.innerText = currentTotalFilesForFolder > 0 ? `${startIdx} - ${endIdx}` : '0';
            if (totalInfoEl) totalInfoEl.innerText = currentTotalFilesForFolder;
        }

