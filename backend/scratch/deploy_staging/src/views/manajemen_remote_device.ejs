        // ===== SCALABLE: Paginated Device Loading (handles 1200+ devices) =====
        async function loadDevices(showLoading = false) {
            try {
                if (!token) token = await getFreshToken();

                // Load stats (lightweight, cached on server)
                const statsRes = await fetch('/api/admin/remote-devices/stats', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (statsRes.ok) {
                    const stats = await statsRes.json();
                    if (stats.success) {
                        document.getElementById('statTotalDevices').innerText = stats.totalCount;
                        document.getElementById('statOnlineDevices').innerText = stats.onlineCount;
                        // Update class list from DB
                        if (stats.classList && stats.classList.length > 0) {
                            classListData = stats.classList;
                            refreshClassFilterDropdown(stats.classList);
                        }
                    }
                }

                // Load first page of devices
                devicePage = 1;
                allDevicesLoaded = false;
                allDevices = [];
                await loadDevicePage(1, true);
            } catch (e) {
                console.error('Failed to load devices:', e);
            }
