        function getFilteredFiles() {
            const catEl = document.getElementById('filterFileCategory');
            const cat = catEl ? catEl.value : 'ALL';
            const searchEl = document.getElementById('searchFile');
            const search = searchEl ? searchEl.value.toLowerCase().trim() : '';

            return currentDeviceFiles.filter(f => {
                let matchFolder = true;
                if (currentFolderFilter !== 'ALL') {
                    if (f._serverFolder) {
                        // Jika berkas sudah ditarik secara spesifik oleh server untuk folder ini, jangan dibuang
                        matchFolder = (f._serverFolder === currentFolderFilter);
                    } else {
                        const folderName = extractFolderFromPath(f.filePath);
                        matchFolder = (folderName === currentFolderFilter);
                    }
                }
                const matchCat = cat === 'ALL' || f.category === cat;
                const matchSearch = !search ||
                    (f.fileName || '').toLowerCase().includes(search) ||
                    (f.filePath || '').toLowerCase().includes(search);
                const matchOnlySelected = !isOnlySelectedFilter || selectedFileIds.has(f.id);

                return matchFolder && matchCat && matchSearch && matchOnlySelected;
            });
        }

