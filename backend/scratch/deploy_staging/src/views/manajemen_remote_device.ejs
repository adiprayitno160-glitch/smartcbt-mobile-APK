        function extractFolderFromPath(filePath) {
            if (!filePath) return '📁 Penyimpanan Umum';
            const cleanPath = (filePath || '').split('::')[0].trim();
            const norm = cleanPath.replace(/\\/g, '/');
            const lower = norm.toLowerCase();
            const fileName = norm.substring(norm.lastIndexOf('/') + 1).toLowerCase();

            const isWaName = fileName.includes('-wa') || fileName.includes('_wa') || fileName.startsWith('wa') || fileName.startsWith('stk-') || fileName.startsWith('aud-') || fileName.startsWith('doc-') || fileName.startsWith('ptt-');
            const isWa = lower.includes('whatsapp') || isWaName;
            const isSent = norm.includes('/sent/') || norm.includes('/sent') || lower.includes('sent') || fileName.includes('sent');
            const isImg = /\.(jpg|jpeg|png|webp|gif|bmp|heic|heif)$/i.test(norm) || lower.includes('image') || fileName.startsWith('img-') || fileName.startsWith('stk-');
            const isVid = /\.(mp4|mkv|3gp|avi|webm|mov)$/i.test(norm) || lower.includes('video') || fileName.startsWith('vid-');
            const isAudio = /\.(opus|m4a|mp3|ogg|wav|aac)$/i.test(norm) || lower.includes('voice') || lower.includes('audio') || fileName.startsWith('aud-') || fileName.startsWith('ptt-');
            const isDoc = /\.(pdf|doc|docx|xls|xlsx|ppt|pptx|txt|rtf)$/i.test(norm) || lower.includes('document') || fileName.startsWith('doc-');

            if (isWa && isImg && isSent) return '📤 WA Images (Sent)';
            if (isWa && isImg && !isSent) return '📥 WA Images (Receive)';
            if (isWa && isVid && isSent) return '📤 WA Video (Sent)';
            if (isWa && isVid && !isSent) return '🎬 WA Video (Receive)';
            if (isWa && isAudio) return '🎵 WA Voice/Audio';
            if (isWa && isDoc) return '📄 WA Docs';

            if (lower.includes('dcim') || lower.includes('camera')) return '📷 Kamera (DCIM)';
            if (lower.includes('screenshots') || lower.includes('screenshot')) return '📱 Screenshots Layar';
            if (lower.includes('movies') || lower.includes('screenrecorder') || lower.includes('screen recorder')) return '🎬 Video & Rekaman Layar';
            if (lower.includes('download')) return '📥 Unduhan (Download)';
            if (isDoc) return '📄 Dokumen (Documents)';
            if (isAudio) return '🎵 Audio & Musik';

            const parts = norm.split('/');
            if (parts.length >= 2) {
                const parent = parts[parts.length - 2];
                if (parent && parent !== '0' && parent !== 'emulated' && parent !== 'storage') {
                    return '📁 ' + parent;
                }
            }
            return '📁 Penyimpanan Umum';
        }

        function renderFolderPills() {
            const container = document.getElementById('folderPillsContainer');
            if (!container) return;
            const folderCounts = (currentFolderCounts && Object.keys(currentFolderCounts).length > 0) ? currentFolderCounts : { 'ALL': currentTotalFilesForFolder || currentDeviceFiles.length };

            const priorityOrder = [
                '📥 WA Images (Receive)',
                '📤 WA Images (Sent)',
                '🎬 WA Video (Receive)',
                '📤 WA Video (Sent)',
                '📄 WA Docs (Receive)',
                '📤 WA Docs (Sent)',
                '🎵 WA Voice/Audio',
                '📷 Kamera (DCIM)',
                '📱 Screenshots Layar',
                '📥 Unduhan (Download)',
                '🎬 Video & Rekaman Layar',
                '📄 Dokumen (Documents)'
            ];

            const pillEntries = Object.keys(folderCounts).filter(k => k !== 'ALL').sort((a, b) => {
                const idxA = priorityOrder.indexOf(a);
                const idxB = priorityOrder.indexOf(b);
                if (idxA !== -1 && idxB !== -1) return idxA - idxB;
                if (idxA !== -1) return -1;
                if (idxB !== -1) return 1;
                return a.localeCompare(b);
            });

            container.innerHTML = `
                <div class="folder-pill ${currentFolderFilter === 'ALL' ? 'active' : ''} px-3.5 py-2 rounded-xl border border-blue-500 bg-blue-600 text-white font-bold flex items-center gap-2 shadow-sm cursor-pointer"
                     onclick="selectFolderFilter('ALL')">
                    <span>📁 Semua Folder</span>
                    <span class="bg-blue-800 text-[10px] text-white px-2 py-0.5 rounded-full font-bold">${folderCounts['ALL'] || 0}</span>
                </div>
            ` + pillEntries.map(fName => {
                const isActive = currentFolderFilter === fName;
                const activeClass = isActive ? 'border-blue-500 bg-blue-600 text-white font-bold shadow-md' : 'border-slate-700 bg-slate-800 text-slate-200 hover:bg-slate-700';
                const badgeClass = isActive ? 'bg-blue-800 text-white' : 'bg-slate-700 text-blue-300';
                return `
                    <div class="folder-pill ${isActive ? 'active' : ''} px-3.5 py-2 rounded-xl border ${activeClass} flex items-center gap-2 transition-all cursor-pointer"
                         onclick="selectFolderFilter('${fName.replace(/'/g, "\\'")}')">
                        <span>${fName}</span>
                        <span class="${badgeClass} text-[10px] px-2 py-0.5 rounded-full font-bold">${folderCounts[fName] || 0}</span>
                    </div>
                `;
            }).join('');
        }

        function selectFolderFilter(folderName) {
            currentFolderFilter = folderName;
            currentPage = 1;
            renderFolderPills();
            loadDeviceFiles(currentDeviceId, folderName, 1);
            updateSelectedUI();
        }

        async function loadDeviceFiles(deviceId, folder = currentFolderFilter, page = currentPage) {
            if (!deviceId) return;
            if (isLoadingFiles) return;
            isLoadingFiles = true;
            currentFolderFilter = folder;
            currentPage = page;

            const galleryContainer = document.getElementById('galleryContainer');
            const tableBody = document.getElementById('tableBody');
            if (galleryContainer && currentViewMode === 'GALLERY') {
                galleryContainer.innerHTML = '<div class="col-span-full p-12 text-center text-blue-600 font-bold"><span class="animate-spin inline-block text-2xl mb-2">⏳</span><br>Memuat berkas...</div>';
            } else if (tableBody && currentViewMode === 'TABLE') {
                tableBody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-blue-600 font-bold">Memuat berkas...</td></tr>';
            }

            try {
                if (!token) token = await getFreshToken();
                const search = document.getElementById('searchFile') ? document.getElementById('searchFile').value.trim() : '';
                let url = `/api/admin/remote-devices/${deviceId}/files?folder=${encodeURIComponent(folder)}&page=${page}&limit=60`;
                if (search) url += `&search=${encodeURIComponent(search)}`;

                let res = await fetch(url, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (res.status === 401 || res.status === 403) {
                    token = await getFreshToken();
                    res = await fetch(url, {
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                }

                const data = await res.json();
                if (data.success) {
                    if (data.isOnline === false) {
                        currentDeviceFiles = [];
                        currentFolderCounts = {};
                        currentTotalFilesForFolder = 0;
                        currentTotalPages = 1;
                        renderFolderPills();
                        if (galleryContainer && currentViewMode === 'GALLERY') {
                            galleryContainer.innerHTML = '<div class="col-span-full p-12 text-center text-slate-500 font-bold bg-slate-50 border border-dashed rounded-2xl"><span class="text-4xl mb-3 block">📴</span>Perangkat Siswa Sedang Offline<br><span class="text-xs text-slate-400 font-normal mt-1 block">Hubungkan HP siswa ke Wi-Fi / buka aplikasi Smart School CBT untuk melihat dan mengunduh berkas secara langsung (Live Remote).</span></div>';
                        } else if (tableBody && currentViewMode === 'TABLE') {
                            tableBody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-slate-500 font-semibold">📴 Perangkat Siswa Sedang Offline (Menunggu HP terhubung)</td></tr>';
                        }
                        updatePaginationUI();
                        return;
                    }
                    currentDeviceFiles = (data.files || []).map(f => Object.assign({}, f, { _serverFolder: folder }));
                    if (data.folderCounts) {
                        currentFolderCounts = data.folderCounts;
                    }
                    if (data.pagination) {
                        currentTotalPages = Math.max(1, data.pagination.totalPages || 1);
                        currentTotalFilesForFolder = data.pagination.total || 0;
                    }
                    renderFolderPills();
                    filterDeviceFiles();
                    updatePaginationUI();
                }
            } catch (e) {
                console.error('Failed to load device files:', e);
                if (galleryContainer && currentViewMode === 'GALLERY') {
                    galleryContainer.innerHTML = '<div class="col-span-full p-12 text-center text-red-500 font-bold bg-red-50 border border-dashed rounded-2xl"><span class="text-3xl mb-2 block">⚠️</span>Gagal memuat berkas remote.<br><button onclick="loadDeviceFiles(currentDeviceId, currentFolderFilter, currentPage)" class="mt-3 px-4 py-1.5 bg-blue-600 text-white rounded-lg text-xs font-semibold shadow-sm hover:bg-blue-700 transition-colors">Coba Muat Ulang</button></div>';
                } else if (tableBody && currentViewMode === 'TABLE') {
                    tableBody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-red-500 font-semibold">⚠️ Gagal memuat berkas remote</td></tr>';
                }
            } finally {
                isLoadingFiles = false;
            }
        }

        function changePage(delta) {
            const targetPage = currentPage + delta;
            if (targetPage >= 1 && targetPage <= currentTotalPages) {
                loadDeviceFiles(currentDeviceId, currentFolderFilter, targetPage);
            }
