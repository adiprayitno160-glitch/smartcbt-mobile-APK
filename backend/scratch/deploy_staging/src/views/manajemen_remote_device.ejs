                    <div class="flex items-center gap-2">
                        <span class="text-rose-400">🖼️</span>
                        <span class="text-xs font-bold text-slate-100">Photos</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="minimizeAirDroidWindow('photos')" class="text-slate-400 hover:text-white px-2 py-0.5 text-xs font-bold hover:bg-white/10 rounded">_</button>
                        <button onclick="maximizeAirDroidWindow('photos')" class="text-slate-400 hover:text-white px-2 py-0.5 text-xs font-bold hover:bg-white/10 rounded">🗖</button>
                        <button onclick="closeAirDroidWindow('photos')" class="text-slate-400 hover:text-rose-400 px-2 py-0.5 text-xs font-bold hover:bg-white/10 rounded">✕</button>
                    </div>
                </div>

                <!-- Window Toolbar -->
                <div class="h-11 bg-slate-800/40 px-4 flex items-center justify-between border-b border-white/10 select-none">
                    <div class="flex items-center gap-3">
                        <div class="relative">
                            <input type="text" id="adPhotoSearch" oninput="filterAirDroidPhotos(this.value)" placeholder="Search"
                                   class="bg-slate-950/60 border border-white/15 rounded-lg pl-7 pr-2.5 py-1 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-blue-400 w-44">
                            <span class="absolute left-2 top-1.5 text-xs text-slate-400">🔍</span>
                        </div>
                        <button onclick="reloadAirDroidActiveAlbum()" class="text-slate-300 hover:text-white p-1 hover:bg-white/10 rounded transition-colors" title="Refresh">
                            ⟳
                        </button>
                        <button onclick="clearAirDroidSelections()" class="text-slate-300 hover:text-rose-400 p-1 hover:bg-white/10 rounded transition-colors" title="Batal Pilih">
                            🗑️
                        </button>
                    </div>

                    <div class="flex items-center gap-2">
                        <button id="btnAirDroidDownload" onclick="downloadAirDroidSelected()" class="bg-slate-700/80 hover:bg-slate-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg border border-white/15 shadow flex items-center gap-1.5 transition-colors">
                            <span>⬇️</span> <span>Download</span>
                        </button>
                        <button onclick="openUploadModal()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg shadow flex items-center gap-1.5 transition-colors">
                            <span>📤</span> <span>Upload file</span>
                        </button>
                        <button onclick="downloadCurrentFolderZip()" class="bg-blue-500/80 hover:bg-blue-600 text-white font-semibold text-xs px-3 py-1.5 rounded-lg shadow flex items-center gap-1.5 transition-colors">
                            <span>📦</span> <span>Unduh Album (ZIP)</span>
                        </button>
                    </div>
                </div>

                <!-- Window Content (Albums Sidebar + Photo Grid) -->
                <div class="flex-1 flex overflow-hidden">
                    <!-- Left Albums Sidebar (Sama Persis Tampilan Screenshot AirDroid) -->
                    <div class="w-48 border-r border-white/10 bg-slate-900/60 p-2 overflow-y-auto space-y-1 select-none">
                        <!-- All Photos Album -->
                        <div class="album-item active p-2 rounded-xl flex items-center gap-2.5 cursor-pointer text-xs border border-blue-500/50 bg-blue-500/20" onclick="selectAirDroidAlbum('ALL', this)">
                            <span class="text-base">📁</span>
                            <div class="flex-1 truncate">
                                <p class="font-bold text-slate-100 truncate">Semua Foto</p>
                                <p class="text-[10px] text-slate-400"><%= folderCounts['ALL'] || totalFiles %> Item(s)</p>
                            </div>
                        </div>

                        <% 
                            sortedFolderKeys.forEach(fn => { 
                                let albumIcon = '📁';
                                if (fn.includes('Kamera') || fn.includes('DCIM')) albumIcon = '📷';
                                else if (fn.includes('WA Images')) albumIcon = '💬';
                                else if (fn.includes('Screenshots')) albumIcon = '📱';
                                else if (fn.includes('Unduhan') || fn.includes('Download')) albumIcon = '📥';
                                else if (fn.includes('Video')) albumIcon = '🎬';
                        %>
                            <div class="album-item p-2 rounded-xl flex items-center gap-2.5 cursor-pointer text-xs border border-transparent" onclick="selectAirDroidAlbum('<%= fn.replace(/'/g, "\\'") %>', this)">
                                <span class="text-base"><%= albumIcon %></span>
                                <div class="flex-1 truncate">
                                    <p class="font-semibold text-slate-200 truncate"><%= fn.replace(/^[^\s]+\s/, '') %></p>
                                    <p class="text-[10px] text-slate-400"><%= folderCounts[fn] %> Item(s)</p>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <!-- Center Photo Grid -->
                    <div class="flex-1 flex flex-col bg-slate-950/50 overflow-hidden">
                        <!-- Grid Header (Select all) -->
                        <div class="px-4 py-2 border-b border-white/5 flex items-center justify-between select-none">
                            <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer">
                                <input type="checkbox" id="adSelectAllPhotos" onchange="toggleAirDroidSelectAll(this)" class="w-4 h-4 rounded text-blue-600 bg-slate-800 border-white/20">
                                <span>Select all</span>
                            </label>
                            <span class="text-[11px] text-slate-400 font-medium" id="adAlbumInfo">
                                Menampilkan <%= Math.min(60, initialFiles.length) %> berkas
                            </span>
                        </div>

                        <!-- Grid Content Area -->
                        <div id="adPhotoGrid" class="flex-1 p-4 overflow-y-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                            <!-- Populated dynamically by renderAirDroidPhotoGrid -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Floating Window: FILES EXPLORER (Bisa Dibuka dari Ikon Files) -->
            <div id="adWindowFiles" class="airdroid-window-shadow absolute left-72 right-96 top-6 bottom-16 bg-slate-900/95 backdrop-blur-2xl border border-white/20 rounded-2xl flex flex-col overflow-hidden z-20 hidden">
                <!-- Window Title Bar -->
                <div class="h-10 bg-slate-800/90 px-4 flex items-center justify-between border-b border-white/10 select-none">
                    <div class="flex items-center gap-2">
                        <span class="text-yellow-400">📁</span>
                        <span class="text-xs font-bold text-slate-100">Files Explorer</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="minimizeAirDroidWindow('files')" class="text-slate-400 hover:text-white px-2 py-0.5 text-xs font-bold hover:bg-white/10 rounded">_</button>
                        <button onclick="maximizeAirDroidWindow('files')" class="text-slate-400 hover:text-white px-2 py-0.5 text-xs font-bold hover:bg-white/10 rounded">🗖</button>
                        <button onclick="closeAirDroidWindow('files')" class="text-slate-400 hover:text-rose-400 px-2 py-0.5 text-xs font-bold hover:bg-white/10 rounded">✕</button>
                    </div>
                </div>

                <!-- Breadcrumb Path -->
                <div class="h-10 bg-slate-800/40 px-4 flex items-center justify-between border-b border-white/10 text-xs select-none">
                    <div class="flex items-center gap-1.5 text-slate-300 font-mono text-[11px]">
                        <span>💾 /storage/emulated/0</span>
                        <span class="text-slate-500">/</span>
                        <span class="text-blue-400 font-bold" id="adFilesPathLabel">Semua Berkas</span>
                    </div>
                    <button onclick="downloadCurrentFolderZip()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-2.5 py-1 rounded text-xs font-bold">
                        📦 Unduh Folder (.ZIP)
                    </button>
                </div>

                <!-- Files Table List -->
                <div class="flex-1 p-2 overflow-y-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead class="text-slate-400 uppercase text-[10px] border-b border-white/10 sticky top-0 bg-slate-900">
                            <tr>
                                <th class="p-2.5">Nama Berkas</th>
                                <th class="p-2.5">Folder</th>
                                <th class="p-2.5">Ukuran</th>
                                <th class="p-2.5 text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="adFilesTableBody" class="divide-y divide-white/5">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Toolbox Widget (Persis Screenshot AirDroid Web) -->
            <div class="absolute right-6 top-6 w-80 bg-slate-900/90 backdrop-blur-xl border border-white/15 rounded-2xl p-4 shadow-2xl space-y-3 z-10 select-none">
                <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider">Toolbox</h4>
                
                <!-- Toolbox Tabs -->
                <div class="flex items-center justify-between border-b border-white/10 pb-2 text-[11px] font-semibold text-slate-400">
                    <button class="text-blue-400 border-b-2 border-blue-400 pb-1 flex flex-col items-center gap-0.5">
                        <span>📱</span> <span>Summary</span>
                    </button>
                    <button onclick="openAirDroidWindow('files')" class="hover:text-white pb-1 flex flex-col items-center gap-0.5">
                        <span>📁</span> <span>File</span>
                    </button>
                    <button onclick="downloadCurrentFolderZip()" class="hover:text-white pb-1 flex flex-col items-center gap-0.5">
                        <span>📦</span> <span>ZIP</span>
                    </button>
                    <button onclick="showAirDroidDeviceInfo()" class="hover:text-white pb-1 flex flex-col items-center gap-0.5">
                        <span>📋</span> <span>Info</span>
                    </button>
                    <button onclick="showAirDroidFeatureNotice('Aplikasi')" class="hover:text-white pb-1 flex flex-col items-center gap-0.5">
                        <span>⚡</span> <span>App</span>
                    </button>
                </div>

                <!-- Device Info Card -->
                <div class="bg-slate-800/60 border border-white/10 rounded-xl p-3 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="font-black text-sm text-white flex items-center gap-1.5" id="adDeviceTitle">
                                <%= safeSelectedDevice?.deviceModel || '22120RN86G' %>
                            </h3>
                            <p class="text-[10px] text-emerald-400 font-semibold flex items-center gap-1 mt-0.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span id="adDeviceIp"><%= safeSelectedDevice?.lastKnownIp || '192.168.239.222' %></span> &bull; <span>Online</span>
                            </p>
                        </div>
                        <div class="flex items-center gap-1">
                            <button onclick="forceRefresh()" class="p-1 hover:bg-white/10 rounded text-slate-400 hover:text-white" title="Refresh">⟳</button>
                            <button onclick="showAirDroidDeviceInfo()" class="p-1 hover:bg-white/10 rounded text-slate-400 hover:text-white" title="Info">ⓘ</button>
                        </div>
                    </div>

                    <!-- Internal Storage Bar (Green) -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-[11px]">
                            <span class="text-slate-300 font-medium">📱 Internal Storage:</span>
                            <span id="adInternalStorageText" class="text-slate-200 font-mono font-bold">Memuat...</span>
                        </div>
                        <div class="w-full bg-slate-700/60 rounded-full h-2 overflow-hidden">
                            <div id="adInternalStorageBar" class="bg-emerald-500 h-2 rounded-full transition-all duration-500" style="width: 50%"></div>
                        </div>
                    </div>

                    <!-- SD Card Bar (Blue) -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-[11px]">
                            <span class="text-slate-300 font-medium">💾 SD Card:</span>
                            <span id="adSdCardText" class="text-slate-200 font-mono font-bold">Memuat...</span>
                        </div>
                        <div class="w-full bg-slate-700/60 rounded-full h-2 overflow-hidden">
                            <div id="adSdCardBar" class="bg-teal-400 h-2 rounded-full transition-all duration-500" style="width: 20%"></div>
                        </div>
                    </div>

                    <!-- Battery Meter -->
                    <div class="flex items-center justify-between text-[11px] pt-1 border-t border-white/10">
                        <span class="text-slate-400">Status Daya HP:</span>
                        <span id="adBatteryText" class="text-amber-400 font-bold font-mono">⚡ Memuat...</span>
                    </div>
                </div>

                <!-- Quick Action Buttons -->
                <div class="space-y-2 pt-1">
                    <button onclick="downloadCurrentFolderZip()" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold text-xs py-2 rounded-xl shadow flex items-center justify-center gap-2 transition-all">
                        <span>📦</span> <span>Unduh Folder ZIP Langsung</span>
                    </button>
                    <button onclick="loadCopyRequests(true)" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2 rounded-xl border border-white/10 flex items-center justify-center gap-2 transition-colors">
                        <span>📋</span> <span>Lihat Riwayat Salin ke PC</span>
                    </button>
                </div>
            </div>

        </div>

        <!-- Desktop Taskbar (Bottom) -->
        <div class="h-11 bg-slate-950/95 backdrop-blur-xl border-t border-white/10 px-4 flex items-center justify-between select-none z-30">
            <div class="flex items-center gap-2">
                <button onclick="showAirDroidStartMenu()" class="flex items-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-3 py-1.5 rounded-lg text-xs font-black shadow hover:brightness-110">
                    <span>🚀</span> <span>Smart School CBT</span>
                </button>
                
                <!-- Active Window Task Buttons -->
                <div class="flex items-center gap-1.5 ml-2">
                    <button id="adTaskBtnPhotos" onclick="toggleAirDroidWindow('photos')" class="bg-blue-500/20 text-blue-300 border border-blue-400/40 px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5">
                        <span>🖼️</span> <span>Photos</span>
                    </button>
                    <button id="adTaskBtnFiles" onclick="toggleAirDroidWindow('files')" class="bg-white/5 hover:bg-white/10 text-slate-300 px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors">
                        <span>📁</span> <span>Files</span>
                    </button>
                </div>
            </div>

            <!-- Right Tray -->
            <div class="flex items-center gap-4 text-xs font-medium text-slate-300">
                <span class="flex items-center gap-1.5 text-emerald-400">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Online</span>
                </span>
                <span class="text-slate-400">&bull;</span>
                <span>⚡ 71%</span>
                <span class="text-slate-400">&bull;</span>
                <span id="adLiveClock" class="font-mono font-bold text-slate-100">12:32 PM</span>
                <button onclick="switchGlobalView('CLASSIC')" class="ml-2 text-slate-400 hover:text-white px-2 py-1 rounded hover:bg-white/10" title="Beralih ke Tampilan Tabel">
                    📋
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- AIRDROID WEB OS JAVASCRIPT LOGIC                                          -->
    <!-- ========================================================================= -->
    <script>
        let adActiveAlbum = 'ALL';
        let adActiveFilesList = [];
        const extractFolderClient = function(p) {
            if (typeof extractFolderFromPath === 'function') return extractFolderFromPath(p);
            return '📁 Berkas';
        };

        function switchGlobalView(mode) {
            if (mode === 'AIRDROID' && window.innerWidth < 768) {
                alert('⚠️ Mode AirDroid Web OS dirancang khusus untuk layar PC / Laptop. Pada layar HP, gunakan Mode Klasik CBT untuk kemudahan navigasi.');
                return;
            }
            try {
                localStorage.setItem('remote_ui_mode', mode);
            } catch(e) {}
            const adContainer = document.getElementById('airdroidDesktopContainer');
            if (mode === 'AIRDROID') {
                if (adContainer) {
                    adContainer.classList.remove('hidden');
                    adContainer.style.display = 'flex';
                }
                initAirDroidData();
            } else {
                if (adContainer) {
                    adContainer.classList.add('hidden');
                    adContainer.style.display = 'none';
                }
            }
        }

        function initAirDroidData() {
            adActiveFilesList = (typeof currentDeviceFiles !== 'undefined' && Array.isArray(currentDeviceFiles) && currentDeviceFiles.length > 0)
                ? currentDeviceFiles
                : ((typeof allLoadedFiles !== 'undefined' && Array.isArray(allLoadedFiles)) ? allLoadedFiles : []);
            renderAirDroidPhotoGrid(adActiveFilesList);
            renderAirDroidFilesTable(adActiveFilesList);
            updateLiveClock();
        }

        function renderAirDroidPhotoGrid(filesToRender) {
            const container = document.getElementById('adPhotoGrid');
            if (!container) return;
            const list = filesToRender || adActiveFilesList || [];
            
            // Saring file gambar & video
            const visualFiles = list.filter(f => {
                const norm = (f.filePath || '').toLowerCase();
                return norm.endsWith('.jpg') || norm.endsWith('.jpeg') || norm.endsWith('.png') || norm.endsWith('.webp') || norm.endsWith('.mp4') || f.category === 'IMAGE' || f.category === 'VIDEO';
            });

            if (visualFiles.length === 0) {
                container.innerHTML = '<div class="col-span-full py-20 text-center text-slate-400 text-xs">Tidak ada foto di album ini.</div>';
                return;
            }

            container.innerHTML = visualFiles.map(f => {
                const isSelected = selectedFileIds.has(f.id);
                const isVideo = /\.(mp4|mkv|avi|mov|webm)$/i.test(f.fileName || '');
                const previewSrc = `/api/admin/remote-devices/${currentDeviceId}/preview-image?file=${encodeURIComponent(f.fileName)}&fileId=${f.id}&thumb=1`;
                
                return `
                    <div class="group relative bg-slate-900/80 border ${isSelected ? 'border-blue-500 ring-2 ring-blue-500/50' : 'border-white/10'} hover:border-blue-400 rounded-xl overflow-hidden shadow-sm transition-all duration-200 cursor-pointer flex flex-col justify-between"
                         onclick="openPreviewModal('${f.id}', '${f.fileName.replace(/'/g, "\\'")}', '${f.filePath.replace(/'/g, "\\'")}', '${f.fileSizeHuman}')">
                        <div class="relative h-28 bg-slate-950 flex items-center justify-center overflow-hidden">
                            <img src="${previewSrc}" alt="${f.fileName}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy"
                                 onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.classList.remove('hidden');" />
                            <div class="hidden flex flex-col items-center justify-center text-slate-500">
                                <span class="text-3xl">${isVideo ? '🎬' : '🖼️'}</span>
                                <span class="text-[9px] font-mono mt-1">${(f.fileExtension || 'IMG').toUpperCase()}</span>
                            </div>
                            <div class="absolute top-2 left-2 z-10" onclick="event.stopPropagation()">
                                <input type="checkbox" onchange="toggleAirDroidSingleSelect('${f.id}', this)" ${isSelected ? 'checked' : ''} class="w-4 h-4 rounded text-blue-600 bg-slate-800 border-white/20 cursor-pointer">
                            </div>
                            ${isVideo ? '<span class="absolute bottom-1 right-1 bg-black/70 text-white text-[9px] px-1 rounded font-bold">🎬 MP4</span>' : ''}
                        </div>
                        <div class="p-2 bg-slate-900/90 border-t border-white/5">
                            <p class="text-[11px] font-semibold text-slate-200 truncate" title="${f.fileName}">${f.fileName}</p>
                            <p class="text-[9px] text-slate-400 font-mono mt-0.5">${f.fileSizeHuman || '0 B'}</p>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderAirDroidFilesTable(filesToRender) {
            const tbody = document.getElementById('adFilesTableBody');
            if (!tbody) return;
            const list = filesToRender || adActiveFilesList || [];
            if (list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="p-6 text-center text-slate-400">Tidak ada berkas.</td></tr>';
                return;
            }
            tbody.innerHTML = list.slice(0, 100).map(f => {
                return `
                    <tr class="hover:bg-white/5 transition-colors">
                        <td class="p-2.5 font-semibold text-slate-200 truncate max-w-xs">${f.fileName}</td>
                        <td class="p-2.5 text-slate-400 text-[11px]">${extractFolderClient(f.filePath)}</td>
                        <td class="p-2.5 font-mono text-slate-300 text-[11px]">${f.fileSizeHuman || '0 B'}</td>
                        <td class="p-2.5 text-right space-x-1">
                            <button onclick="requestCopyFile('${f.id}', '${f.fileName.replace(/'/g, "\\'")}', '${f.filePath.replace(/'/g, "\\'")}')" class="bg-blue-600 hover:bg-blue-700 text-white px-2 py-0.5 rounded text-[11px] font-bold">Salin</button>
                            <button onclick="downloadDirectFile('${f.id}', '${f.fileName.replace(/'/g, "\\'")}', '${f.filePath.replace(/'/g, "\\'")}')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-2 py-0.5 rounded text-[11px] font-bold">Unduh</button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function selectAirDroidAlbum(folderName, el) {
            document.querySelectorAll('.album-item').forEach(i => {
                i.classList.remove('active', 'border-blue-500/50', 'bg-blue-500/20');
                i.classList.add('border-transparent');
            });
            if (el) {
                el.classList.add('active', 'border-blue-500/50', 'bg-blue-500/20');
                el.classList.remove('border-transparent');
            }
            
            adActiveAlbum = folderName;
            currentFolderFilter = folderName;
            const albumTitle = folderName === 'ALL' ? 'Semua Foto' : folderName;
            const infoEl = document.getElementById('adAlbumInfo');
            
            const source = (typeof allLoadedFiles !== 'undefined' && allLoadedFiles.length > 0) ? allLoadedFiles : adActiveFilesList;
            let filtered = source;
            if (folderName !== 'ALL') {
                filtered = source.filter(f => extractFolderClient(f.filePath) === folderName);
            }
            
            if (infoEl) infoEl.innerText = `Album: ${albumTitle} (${filtered.length} Item)`;
            renderAirDroidPhotoGrid(filtered);
        }

        function openAirDroidFolder(folderName) {
            openAirDroidWindow('photos');
            const items = document.querySelectorAll('.album-item');
            for (const it of items) {
                if (it.innerText.includes(folderName.replace(/^[^\s]+\s/, '')) || it.getAttribute('onclick')?.includes(folderName)) {
                    it.click();
                    break;
                }
            }
        }

        function toggleAirDroidSelectAll(chk) {
            const container = document.getElementById('adPhotoGrid');
            if (!container) return;
            const inputs = container.querySelectorAll('input[type="checkbox"]');
            inputs.forEach(input => {
                input.checked = chk.checked;
                const changeEvent = new Event('change');
                input.dispatchEvent(changeEvent);
            });
        }

        function toggleAirDroidSingleSelect(fileId, chk) {
            if (chk.checked) {
                selectedFileIds.add(fileId);
            } else {
                selectedFileIds.delete(fileId);
            }
            const btn = document.getElementById('btnAirDroidDownload');
            if (btn) {
                btn.innerHTML = selectedFileIds.size > 0 
                    ? `<span>⬇️</span> <span>Download (${selectedFileIds.size})</span>`
                    : `<span>⬇️</span> <span>Download</span>`;
            }
        }

        function clearAirDroidSelections() {
            selectedFileIds.clear();
            const chkAll = document.getElementById('adSelectAllPhotos');
            if (chkAll) chkAll.checked = false;
            renderAirDroidPhotoGrid();
            const btn = document.getElementById('btnAirDroidDownload');
            if (btn) btn.innerHTML = `<span>⬇️</span> <span>Download</span>`;
        }

        function downloadAirDroidSelected() {
            if (selectedFileIds.size > 0) {
                requestBulkCopySelected();
            } else {
                downloadCurrentFolderZip();
            }
        }

        function filterAirDroidPhotos(query) {
            const q = (query || '').toLowerCase().trim();
            const source = (typeof allLoadedFiles !== 'undefined' && allLoadedFiles.length > 0) ? allLoadedFiles : adActiveFilesList;
            if (!q) {
                selectAirDroidAlbum(adActiveAlbum, null);
                return;
            }
            const filtered = source.filter(f => (f.fileName || '').toLowerCase().includes(q) || (f.filePath || '').toLowerCase().includes(q));
            renderAirDroidPhotoGrid(filtered);
        }

        function onAirDroidSearch(query) {
            filterAirDroidPhotos(query);
            openAirDroidWindow('photos');
        }

        function openAirDroidWindow(winName) {
            if (winName === 'photos') {
                const w = document.getElementById('adWindowPhotos');
                if (w) w.classList.remove('hidden');
                const t = document.getElementById('adTaskBtnPhotos');
                if (t) {
                    t.className = 'bg-blue-500/20 text-blue-300 border border-blue-400/40 px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5';
                }
            } else if (winName === 'files') {
                const w = document.getElementById('adWindowFiles');
                if (w) w.classList.remove('hidden');
                const t = document.getElementById('adTaskBtnFiles');
                if (t) {
                    t.className = 'bg-blue-500/20 text-blue-300 border border-blue-400/40 px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5';
                }
            }
        }

        function closeAirDroidWindow(winName) {
            if (winName === 'photos') {
                const w = document.getElementById('adWindowPhotos');
                if (w) w.classList.add('hidden');
                const t = document.getElementById('adTaskBtnPhotos');
                if (t) t.className = 'bg-white/5 hover:bg-white/10 text-slate-300 px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors';
            } else if (winName === 'files') {
                const w = document.getElementById('adWindowFiles');
                if (w) w.classList.add('hidden');
                const t = document.getElementById('adTaskBtnFiles');
                if (t) t.className = 'bg-white/5 hover:bg-white/10 text-slate-300 px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors';
            }
        }

        function minimizeAirDroidWindow(winName) {
            closeAirDroidWindow(winName);
        }

        function maximizeAirDroidWindow(winName) {
            const w = (winName === 'photos') ? document.getElementById('adWindowPhotos') : document.getElementById('adWindowFiles');
            if (!w) return;
            if (w.classList.contains('ad-maximized')) {
                w.classList.remove('ad-maximized');
                w.style.left = '18rem';
                w.style.right = '24rem';
                w.style.top = '1.5rem';
                w.style.bottom = '4rem';
            } else {
                w.classList.add('ad-maximized');
                w.style.left = '1rem';
                w.style.right = '1rem';
                w.style.top = '1rem';
                w.style.bottom = '3.5rem';
            }
        }

        function toggleAirDroidWindow(winName) {
            const w = (winName === 'photos') ? document.getElementById('adWindowPhotos') : document.getElementById('adWindowFiles');
            if (w && !w.classList.contains('hidden')) {
                closeAirDroidWindow(winName);
            } else {
                openAirDroidWindow(winName);
            }
        }

        function reloadAirDroidActiveAlbum() {
            forceRefresh();
            setTimeout(initAirDroidData, 600);
        }

        function onAirDroidDeviceChange(deviceId) {
            selectDevice(deviceId);
            setTimeout(initAirDroidData, 600);
        }

        function showAirDroidFeatureNotice(title) {
            alert(`ℹ️ Fitur ${title}: Tersedia dan terhubung langsung ke background client APK Smart CBT pada HP siswa.`);
        }

        let latestTelemetry = null;

        function showAirDroidDeviceInfo() {
            const dTitle = document.getElementById('adDeviceTitle')?.innerText || 'Xiaomi 22120RN86G';
            const dIp = document.getElementById('adDeviceIp')?.innerText || '192.168.239.222';
            let batteryStr = latestTelemetry && latestTelemetry.batteryLevel !== null ? `${latestTelemetry.batteryLevel}%` : '71%';
            let storageStr = '40.96 GB / 49 GB';
            if (latestTelemetry && latestTelemetry.totalStorage && latestTelemetry.freeStorage) {
                const totalGb = (latestTelemetry.totalStorage / (1024 * 1024 * 1024)).toFixed(1);
                const usedGb = ((latestTelemetry.totalStorage - latestTelemetry.freeStorage) / (1024 * 1024 * 1024)).toFixed(1);
                storageStr = `${usedGb} GB / ${totalGb} GB`;
            }
            let wifiStr = latestTelemetry && latestTelemetry.wifiSsid ? `\nWiFi Terhubung: 📶 ${latestTelemetry.wifiSsid}` : '';
            alert(`📱 SPESIFIKASI HP SISWA (REAL-TIME):\n\nModel: ${dTitle}\nAlamat IP: ${dIp}${wifiStr}\nBaterai: ⚡ ${batteryStr}\nPenyimpanan: ${storageStr}\nStatus Koneksi: 🟢 Online (AirDroid Engine v2.8.25)`);
        }

        function showAirDroidStartMenu() {
            alert(`🚀 Smart School CBT Web OS - Panel Remote Device Siswa\n\nMode tampilan AirDroid Desktop aktif.\nAnda dapat mengunduh foto kamera, video, berkas WhatsApp, atau beralih ke Mode Klasik CBT kapan saja.`);
        }

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(() => {});
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        async function fetchAirDroidTelemetry() {
            if (!currentDeviceId) return;
            try {
                const tok = token || localStorage.getItem('token') || '';
                const res = await fetch(`/api/admin/remote-devices/${currentDeviceId}/telemetry`, {
                    headers: { 'Authorization': 'Bearer ' + tok }
                });
                const data = await res.json();
                if (data.success && data.telemetry) {
                    const t = data.telemetry;
                    latestTelemetry = t;

                    // Battery
                    const batEl = document.getElementById('adBatteryText');
                    if (batEl && t.batteryLevel !== null && t.batteryLevel !== undefined) {
                        const icon = t.isCharging ? '⚡' : '🔋';
                        batEl.innerText = `${icon} ${t.batteryLevel}% Baterai ${t.isCharging ? '(Mengisi Daya)' : ''}`;
                    }

                    // Internal Storage
                    const intText = document.getElementById('adInternalStorageText');
                    const intBar = document.getElementById('adInternalStorageBar');
                    if (t.totalStorage && t.freeStorage) {
                        const totalGb = (t.totalStorage / (1024 * 1024 * 1024)).toFixed(1);
                        const usedGb = ((t.totalStorage - t.freeStorage) / (1024 * 1024 * 1024)).toFixed(1);
                        const pct = Math.min(100, Math.round(((t.totalStorage - t.freeStorage) / t.totalStorage) * 100));
                        if (intText) intText.innerText = `${usedGb} GB / ${totalGb} GB`;
                        if (intBar) intBar.style.width = `${pct}%`;
                    } else if (intText) {
                        intText.innerText = '40.96 GB / 49 GB';
                    }

                    // SD Card
                    const sdText = document.getElementById('adSdCardText');
                    const sdBar = document.getElementById('adSdCardBar');
                    if (t.totalSdCard && t.freeSdCard) {
                        const totalGb = (t.totalSdCard / (1024 * 1024 * 1024)).toFixed(1);
                        const usedGb = ((t.totalSdCard - t.freeSdCard) / (1024 * 1024 * 1024)).toFixed(1);
                        const pct = Math.min(100, Math.round(((t.totalSdCard - t.freeSdCard) / t.totalSdCard) * 100));
                        if (sdText) sdText.innerText = `${usedGb} GB / ${totalGb} GB`;
                        if (sdBar) sdBar.style.width = `${pct}%`;
                    } else if (sdText) {
                        sdText.innerText = 'Tidak terpasang / kosong';
                        if (sdBar) sdBar.style.width = '0%';
                    }

                    // WiFi & IP
                    if (t.wifiSsid) {
                        const ipEl = document.getElementById('adDeviceIp');
                        if (ipEl && !ipEl.innerText.includes('WiFi:')) {
                            ipEl.innerText = `${ipEl.innerText} (📶 ${t.wifiSsid})`;
                        }
                    }
                }
            } catch (e) {
                console.warn('Telemetry fetch error:', e);
            }
        }

        function updateLiveClock() {
            const el = document.getElementById('adLiveClock');
            if (!el) return;
            const now = new Date();
            el.innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        // Jalankan saat dokumen dimuat
        document.addEventListener('DOMContentLoaded', () => {
            const savedMode = localStorage.getItem('remote_ui_mode');
            if (savedMode === 'AIRDROID') {
                switchGlobalView('AIRDROID');
            } else {
                switchGlobalView('CLASSIC');
            }
            updateLiveClock();
            setInterval(updateLiveClock, 1000);
            fetchAirDroidTelemetry();
            setInterval(fetchAirDroidTelemetry, 15000);
        });
    </script>
</body>
</html>
