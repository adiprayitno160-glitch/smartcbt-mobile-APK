        // Refresh class filter dropdown from DB data
        function refreshClassFilterDropdown(classes) {
            const select = document.getElementById('filterClassRombel');
            if (!select || !classes || classes.length === 0) return;
            const currentVal = select.value;

            const groups = {};
            classes.forEach(c => {
                const match = (c.name || '').match(/^([IVX]+)-/);
                const level = match ? match[1] : 'Lainnya';
                if (!groups[level]) groups[level] = [];
                groups[level].push(c);
            });
            const romanOrder = ['VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
            const sortedLevels = Object.keys(groups).sort((a, b) => {
                const ai = romanOrder.indexOf(a);
                const bi = romanOrder.indexOf(b);
                return (ai === -1 ? 100 : ai) - (bi === -1 ? 100 : bi);
            });

            let html = '<option value="ALL">ðŸ“‹ Semua Rombel (Semua Siswa Terdaftar)</option>';
            sortedLevels.forEach(level => {
                const classesInLevel = groups[level];
                html += '<optgroup label="Tingkat ' + level + ' (' + classesInLevel.length + ' Rombel)">';
                classesInLevel.forEach(c => {
                    html += '<option value="' + c.name + '" ' + (c.name === currentVal ? 'selected' : '') + '>' + c.name + '</option>';
                });
                html += '</optgroup>';
            });
            select.innerHTML = html;
        }

        function filterDevices() {
            const classFilter = document.getElementById('filterClassRombel') ? document.getElementById('filterClassRombel').value : 'ALL';
            const statusFilter = document.getElementById('filterDeviceStatus') ? document.getElementById('filterDeviceStatus').value : 'ONLINE_ONLY';
            const search = document.getElementById('searchDevice') ? document.getElementById('searchDevice').value.toLowerCase().trim() : '';

            const filtered = allDevices.filter(d => {
                const matchClass = classFilter === 'ALL' || (d.owner?.className === classFilter);
                
                let matchStatus = true;
                if (statusFilter === 'ONLINE_ONLY') {
                    matchStatus = d.status === 'ONLINE';
                } else if (statusFilter === 'LOW_BATTERY') {
                    matchStatus = d.isLowBattery || (d.batteryLevel !== null && d.batteryLevel <= 20);
                }

                const matchSearch = !search ||
                                    (d.deviceName || '').toLowerCase().includes(search) ||
                                    (d.deviceModel || '').toLowerCase().includes(search) ||
                                    (d.owner?.name || '').toLowerCase().includes(search) ||
                                    (d.owner?.nisn || '').includes(search) ||
                                    (d.lastKnownIp || '').includes(search);
                return matchClass && matchStatus && matchSearch;
            });

            const countEl = document.getElementById('visibleDeviceCount');
            if (countEl) countEl.innerText = deviceTotalCount || filtered.length;
            renderDeviceList(filtered);

            // Perbarui juga pilihan di menu AirDroid Web OS agar hanya menampilkan perangkat yang sesuai (Online)
            updateAirDroidDeviceDropdown(allDevices.filter(d => d.status === 'ONLINE'));
        }

