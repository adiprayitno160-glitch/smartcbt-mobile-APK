        async function loadDevicePage(page, replace = false) {
            if (isLoadingDevices || (allDevicesLoaded && !replace)) return;
            isLoadingDevices = true;

            const loader = document.getElementById('deviceListLoader');
            const endMsg = document.getElementById('deviceListEnd');
            if (loader) loader.classList.remove('hidden');
            if (endMsg) endMsg.classList.add('hidden');

            try {
                const classFilter = document.getElementById('filterClassRombel') ? document.getElementById('filterClassRombel').value : 'ALL';
                const statusFilter = document.getElementById('filterDeviceStatus') ? document.getElementById('filterDeviceStatus').value : 'ONLINE_ONLY';
                const search = document.getElementById('searchDevice') ? document.getElementById('searchDevice').value.trim() : '';

                const params = new URLSearchParams({
                    page: String(page),
                    limit: String(DEVICE_PAGE_SIZE)
                });
                if (classFilter !== 'ALL') params.set('class', classFilter);
                if (statusFilter === 'ONLINE_ONLY') params.set('status', 'ONLINE');
                else if (statusFilter === 'LOW_BATTERY') params.set('status', 'LOW_BATTERY');
                if (search) params.set('search', search);

                if (!token) token = await getFreshToken();
                let res = await fetch('/api/admin/remote-devices/list?' + params.toString(), {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (res.status === 401 || res.status === 403) {
                    token = await getFreshToken();
                    res = await fetch('/api/admin/remote-devices/list?' + params.toString(), {
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                }

                const data = await res.json();
                if (data.success) {
                    deviceTotalCount = data.totalCount;
                    deviceTotalPages = data.totalPages;

                    if (replace) {
                        allDevices = data.devices || [];
                    } else {
                        allDevices = allDevices.concat(data.devices || []);
                    }

                    if (page >= deviceTotalPages) {
                        allDevicesLoaded = true;
                    } else {
                        allDevicesLoaded = false;
                    }

                    devicePage = page;

                    // Update file count stats
                    let totalFilesAcrossAll = 0;
                    allDevices.forEach(d => {
                        totalFilesAcrossAll += (d.fileCount || 0);
                    });
                    document.getElementById('statTotalFiles').innerText = totalFilesAcrossAll;

                    // Re-render device list
                    filterDevices();

                    // Jika belum ada perangkat yang dipilih di panel utama, pilih otomatis
                    if (!currentDeviceId && allDevices.length > 0) {
                        const targetDev = allDevices.find(d => d.fileCount > 0) || allDevices[0];
                        selectDevice(targetDev.id);
                    }
                }
            } catch (e) {
                console.error('Failed to load device page:', e);
            } finally {
                isLoadingDevices = false;
                if (loader) loader.classList.add('hidden');
                if (allDevicesLoaded && endMsg) endMsg.classList.remove('hidden');
                else if (endMsg) endMsg.classList.add('hidden');
            }
        }

