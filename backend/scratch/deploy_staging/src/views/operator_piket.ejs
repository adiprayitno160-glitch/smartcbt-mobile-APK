<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Guru Piket - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex h-screen overflow-hidden">
    
    <!-- Unified Operator Sidebar -->
    <%- include('partials/sidebar_operator') %>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-6 md:p-8 overflow-y-auto bg-slate-50/60 transition-all duration-300 ease-in-out">
        <header class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-6 border-b border-slate-200/80 pb-4">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>📋</span> Jadwal Guru Piket &amp; Penanganan Kelas Kosong
                    </h1>
                    <p class="text-xs text-slate-500 mt-0.5">Kelola jadwal piket mingguan secara dinamis. Laporan kelas kosong otomatis terdistribusi.</p>
                </div>
            </div>
            <button onclick="openAddModal()" class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl text-xs font-bold shadow flex items-center gap-2">
                <span>➕</span> Tambah Guru Piket
            </button>
        </header>

        <!-- Top Overview Badges -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center text-2xl">👥</div>
                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Guru Piket Hari Ini (<span id="todayDayName">-</span>)</p>
                    <p class="text-2xl font-bold text-amber-700" id="todayPiketCount">0 Guru</p>
                    <div class="text-xs text-gray-600 mt-1" id="todayPiketNames">Memuat...</div>
                </div>
            </div>

            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 bg-red-100 text-red-600 rounded-xl flex items-center justify-center text-2xl">⚠️</div>
                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Laporan Kelas Kosong Menunggu</p>
                    <p class="text-2xl font-bold text-red-600" id="pendingReportCount">0 Kelas</p>
                    <p class="text-xs text-gray-400">Belum ada guru inval / tugas mandiri</p>
                </div>
            </div>

            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center text-2xl">✅</div>
                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Kelas Tertangani Hari Ini</p>
                    <p class="text-2xl font-bold text-emerald-600" id="resolvedReportCount">0 Kelas</p>
                    <p class="text-xs text-gray-400">Guru piket sigap mengisi jam kosong</p>
                </div>
            </div>
        </div>

        <!-- Section 1: Monitoring Kelas Kosong Hari Ini (Real-Time) -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-8 p-6">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                        <span>🚨 Live Monitoring Kelas Kosong</span>
                        <span class="inline-block w-2.5 h-2.5 bg-red-500 rounded-full animate-ping"></span>
                    </h2>
                    <p class="text-sm text-gray-500">Laporan langsung dari siswa di kelas. Tersinkronisasi dengan TV Display sekolah dan notifikasi APK Guru Piket.</p>
                </div>
                <button onclick="loadEmptyClassReports()" class="text-xs text-amber-700 bg-amber-50 hover:bg-amber-100 px-3 py-1.5 rounded-md border border-amber-200 font-semibold">
                    🔄 Refresh
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-gray-600 text-sm border-b">
                            <th class="p-3 font-semibold">Kelas</th>
                            <th class="p-3 font-semibold">Mata Pelajaran</th>
                            <th class="p-3 font-semibold">Pelapor (Siswa)</th>
                            <th class="p-3 font-semibold">Waktu Masuk</th>
                            <th class="p-3 font-semibold">Keterangan</th>
                            <th class="p-3 font-semibold">Status & Penanganan</th>
                            <th class="p-3 font-semibold text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="emptyClassTableBody">
                        <tr><td colspan="7" class="p-4 text-center text-gray-400">Memuat laporan kelas kosong...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 2: Jadwal Piket Mingguan Dinamis -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-xl font-bold text-gray-800">📅 Tabel Jadwal Piket Mingguan</h2>
                    <p class="text-sm text-gray-500">Atur siapa saja guru yang bertugas piket untuk setiap hari Senin s/d Sabtu.</p>
                </div>
                <!-- Day Filter Tabs -->
                <div class="flex gap-1 bg-gray-100 p-1 rounded-lg" id="dayFilterTabs">
                    <button onclick="filterDay('ALL')" class="day-tab active px-3 py-1.5 rounded-md text-xs font-bold transition-all bg-blue-600 text-white shadow-sm" data-day="ALL">Semua Hari</button>
                    <button onclick="filterDay('SENIN')" class="day-tab px-3 py-1.5 rounded-md text-xs font-semibold text-gray-600 hover:text-amber-700" data-day="SENIN">Senin</button>
                    <button onclick="filterDay('SELASA')" class="day-tab px-3 py-1.5 rounded-md text-xs font-semibold text-gray-600 hover:text-amber-700" data-day="SELASA">Selasa</button>
                    <button onclick="filterDay('RABU')" class="day-tab px-3 py-1.5 rounded-md text-xs font-semibold text-gray-600 hover:text-amber-700" data-day="RABU">Rabu</button>
                    <button onclick="filterDay('KAMIS')" class="day-tab px-3 py-1.5 rounded-md text-xs font-semibold text-gray-600 hover:text-amber-700" data-day="KAMIS">Kamis</button>
                    <button onclick="filterDay('JUMAT')" class="day-tab px-3 py-1.5 rounded-md text-xs font-semibold text-gray-600 hover:text-amber-700" data-day="JUMAT">Jumat</button>
                    <button onclick="filterDay('SABTU')" class="day-tab px-3 py-1.5 rounded-md text-xs font-semibold text-gray-600 hover:text-amber-700" data-day="SABTU">Sabtu</button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-gray-600 text-sm border-b">
                            <th class="p-3 font-semibold">Hari Piket</th>
                            <th class="p-3 font-semibold">Nama Guru Piket</th>
                            <th class="p-3 font-semibold">NIP / Identitas</th>
                            <th class="p-3 font-semibold">Area / Catatan Piket</th>
                            <th class="p-3 font-semibold">Status</th>
                            <th class="p-3 font-semibold text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="piketScheduleTableBody">
                        <tr><td colspan="6" class="p-4 text-center text-gray-400">Memuat data jadwal piket...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 3: Laporan Ketidakaktifan & Rekapitulasi Presensi Guru Bulanan -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 mt-8 p-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b pb-4">
                <div>
                    <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                        <span>📊 Laporan Ketidakaktifan &amp; Presensi Guru Bulanan</span>
                    </h2>
                    <p class="text-sm text-gray-500">Monitoring rekapitulasi kehadiran, persentase tidak hadir, keterlambatan, dan kelas kosong yang ditinggalkan guru.</p>
                </div>
                <div class="flex items-center gap-2.5 flex-wrap">
                    <select id="inactivityMonthSelect" onchange="loadTeacherInactivityReport()" class="border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold bg-slate-50">
                        <option value="1">Januari</option>
                        <option value="2">Februari</option>
                        <option value="3">Maret</option>
                        <option value="4">April</option>
                        <option value="5">Mei</option>
                        <option value="6">Juni</option>
                        <option value="7">Juli</option>
                        <option value="8">Agustus</option>
                        <option value="9">September</option>
                        <option value="10">Oktober</option>
                        <option value="11">November</option>
                        <option value="12">Desember</option>
                    </select>
                    <select id="inactivityYearSelect" onchange="loadTeacherInactivityReport()" class="border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold bg-slate-50">
                        <option value="2025">2025</option>
                        <option value="2026" selected>2026</option>
                        <option value="2027">2027</option>
                    </select>
                    <input type="text" id="inactivitySearchInput" oninput="filterInactivityTable()" placeholder="🔍 Cari guru/NIP..." class="border border-slate-300 rounded-xl px-3 py-2 text-xs bg-slate-50 focus:bg-white outline-none w-44">
                    <button onclick="loadTeacherInactivityReport()" class="bg-slate-800 hover:bg-slate-900 text-white px-3.5 py-2 rounded-xl text-xs font-bold shadow flex items-center gap-1.5">
                        <span>🔄</span> Segarkan
                    </button>
                </div>
            </div>

            <!-- Inactivity Summary Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-slate-50 border border-slate-200 p-4 rounded-xl">
                    <span class="text-[11px] font-bold text-slate-500 block uppercase">Hari Kerja Efektif</span>
                    <span class="text-xl font-extrabold text-slate-800" id="inactivityWorkingDays">0 Hari</span>
                </div>
                <div class="bg-rose-50 border border-rose-200 p-4 rounded-xl">
                    <span class="text-[11px] font-bold text-rose-600 block uppercase">Rata-rata Ketidakhadiran</span>
                    <span class="text-xl font-extrabold text-rose-700" id="inactivityAvgAbsence">0%</span>
                </div>
                <div class="bg-amber-50 border border-amber-200 p-4 rounded-xl">
                    <span class="text-[11px] font-bold text-amber-600 block uppercase">Rata-rata Keterlambatan</span>
                    <span class="text-xl font-extrabold text-amber-700" id="inactivityAvgLate">0%</span>
                </div>
                <div class="bg-purple-50 border border-purple-200 p-4 rounded-xl">
                    <span class="text-[11px] font-bold text-purple-600 block uppercase">Total Kelas Kosong Dilaporkan</span>
                    <span class="text-xl font-extrabold text-purple-800" id="inactivityTotalEmptyClasses">0 Insiden</span>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-50 text-slate-700 font-bold border-b">
                            <th class="p-3">No</th>
                            <th class="p-3">Nama Guru &amp; NIP</th>
                            <th class="p-3">Mata Pelajaran</th>
                            <th class="p-3 text-center">Tidak Hadir</th>
                            <th class="p-3 text-center">% Absen</th>
                            <th class="p-3 text-center">Terlambat</th>
                            <th class="p-3 text-center">% Terlambat</th>
                            <th class="p-3">Kelas Kosong / Ditinggalkan</th>
                            <th class="p-3 text-center">Status Disiplin</th>
                        </tr>
                    </thead>
                    <tbody id="teacherInactivityTableBody" class="divide-y divide-slate-100">
                        <tr><td colspan="9" class="p-6 text-center text-slate-400">Memuat laporan presensi guru...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Modal Tambah Guru Piket -->
    <div id="addModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4 border-b pb-3">
                <h3 class="text-lg font-bold text-gray-800">➕ Tambah Jadwal Guru Piket</h3>
                <button onclick="closeAddModal()" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
            </div>
            <form id="addPiketForm" onsubmit="submitAddPiket(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Pilih Guru Piket *</label>
                    <div class="mb-2">
                        <input type="text" id="searchTeacherInput" placeholder="🔍 Cari nama guru / NIP..." class="w-full p-2 border rounded-lg text-xs bg-gray-50 focus:bg-white focus:ring-2 focus:ring-amber-500 outline-none" oninput="filterTeacherSelect()">
                    </div>
                    <select id="selectTeacher" required size="5" class="w-full p-2 border rounded-lg text-xs font-semibold bg-gray-50 focus:bg-white focus:ring-2 focus:ring-amber-500 outline-none">
                        <option value="">-- Pilih Guru Pengajar --</option>
                    </select>
                    <div class="flex justify-between items-center text-[10px] text-gray-400 mt-1">
                        <span id="teacherCountInfo">Memuat daftar guru...</span>
                        <button type="button" onclick="clearTeacherSearch()" class="text-amber-600 hover:underline">Reset</button>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Hari Tugas Piket</label>
                    <select id="selectDay" required class="w-full p-2.5 border rounded-lg text-sm bg-gray-50 focus:bg-white focus:ring-2 focus:ring-amber-500">
                        <option value="SENIN">Senin</option>
                        <option value="SELASA">Selasa</option>
                        <option value="RABU">Rabu</option>
                        <option value="KAMIS">Kamis</option>
                        <option value="JUMAT">Jumat</option>
                        <option value="SABTU">Sabtu</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Lokasi / Catatan Penugasan</label>
                    <input type="text" id="inputNotes" placeholder="Contoh: Gedung Timur Lantai 2 / Gerbang & Kelas 7" class="w-full p-2.5 border rounded-lg text-sm bg-gray-50 focus:bg-white focus:ring-2 focus:ring-amber-500">
                </div>
                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeAddModal()" class="px-4 py-2 border rounded-lg text-gray-600 text-sm font-semibold hover:bg-gray-100">Batal</button>
                    <button type="submit" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-sm font-bold shadow">Simpan Jadwal</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if(!token) { window.location.href = '/'; }

        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            document.getElementById('profileName').innerText = payload.name || 'Operator Sekolah';
        } catch(e) {}

        let allSchedules = [];
        let allTeachers = [];
        let currentDayFilter = 'ALL';

        async function initPage() {
            try {
                const curM = new Date().getMonth() + 1;
                const curY = new Date().getFullYear();
                const mSel = document.getElementById('inactivityMonthSelect');
                const ySel = document.getElementById('inactivityYearSelect');
                if (mSel) mSel.value = curM;
                if (ySel) ySel.value = curY;
            } catch(e) {}

            await Promise.all([
                loadTeachers(),
                loadSchedules(),
                loadTodayPiket(),
                loadEmptyClassReports(),
                loadTeacherInactivityReport()
            ]);
            // Auto refresh empty class reports every 10 seconds
            setInterval(loadEmptyClassReports, 10000);
        }

        async function loadTeachers() {
            try {
                const res = await fetch('/api/teachers', { headers: { 'Authorization': 'Bearer ' + token }});
                if(res.ok) {
                    allTeachers = await res.json();
                    filterTeacherSelect();
                }
            } catch(e) { console.error('Error load teachers', e); }
        }

        function filterTeacherSelect() {
            const query = (document.getElementById('searchTeacherInput')?.value || '').toLowerCase().trim();
            const sel = document.getElementById('selectTeacher');
            if(!sel) return;

            sel.innerHTML = '<option value="">-- Pilih Guru Pengajar --</option>';
            let count = 0;
            const list = Array.isArray(allTeachers) ? allTeachers : [];
            list.forEach(t => {
                const teacherName = t.name || t.nama || 'Guru';
                const teacherNip = t.username || t.nip || '-';
                const teacherSubj = t.teachingSubject || t.mata_pelajaran || '-';
                const matches = !query || 
                    teacherName.toLowerCase().includes(query) || 
                    teacherNip.toLowerCase().includes(query) ||
                    teacherSubj.toLowerCase().includes(query);

                if(matches) {
                    const opt = document.createElement('option');
                    opt.value = t.id;
                    opt.textContent = `${teacherName} (${teacherNip}) - ${teacherSubj}`;
                    sel.appendChild(opt);
                    count++;
                }
            });

            const countEl = document.getElementById('teacherCountInfo');
            if(countEl) {
                countEl.innerText = query ? `Ditemukan ${count} guru (dari total ${list.length})` : `Menampilkan seluruh ${count} guru`;
            }
        }

        function clearTeacherSearch() {
            const input = document.getElementById('searchTeacherInput');
            if(input) input.value = '';
            filterTeacherSelect();
        }

        async function loadSchedules() {
            try {
                const res = await fetch('/api/operator/piket-schedule', { credentials: 'include', headers: { 'Authorization': 'Bearer ' + token }});
                if(res.ok) {
                    allSchedules = await res.json();
                    renderSchedules();
                }
            } catch(e) { console.error(e); }
        }

        function filterDay(day) {
            currentDayFilter = day;
            document.querySelectorAll('.day-tab').forEach(b => {
                if(b.getAttribute('data-day') === day) {
                    b.className = 'day-tab active px-3 py-1.5 rounded-md text-xs font-bold transition-all bg-blue-600 text-white shadow-sm';
                } else {
                    b.className = 'day-tab px-3 py-1.5 rounded-md text-xs font-semibold text-gray-600 hover:text-amber-700';
                }
            });
            renderSchedules();
        }

        function renderSchedules() {
            const tbody = document.getElementById('piketScheduleTableBody');
            tbody.innerHTML = '';

            const filtered = currentDayFilter === 'ALL' 
                ? allSchedules 
                : allSchedules.filter(s => s.dayOfWeek.toUpperCase() === currentDayFilter);

            if(filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-gray-400">Belum ada guru piket yang terdaftar untuk jadwal ini.</td></tr>';
                return;
            }

            const dayBadges = {
                'SENIN': 'bg-blue-100 text-blue-800 border-blue-200',
                'SELASA': 'bg-green-100 text-green-800 border-green-200',
                'RABU': 'bg-yellow-100 text-yellow-800 border-yellow-200',
                'KAMIS': 'bg-purple-100 text-purple-800 border-purple-200',
                'JUMAT': 'bg-emerald-100 text-emerald-800 border-emerald-200',
                'SABTU': 'bg-rose-100 text-rose-800 border-rose-200'
            };

            filtered.forEach(s => {
                const badge = dayBadges[s.dayOfWeek.toUpperCase()] || 'bg-gray-100 text-gray-800 border-gray-200';
                tbody.innerHTML += `
                    <tr class="hover:bg-amber-50/50 border-b transition-colors">
                        <td class="p-3">
                            <span class="px-2.5 py-1 rounded-full text-xs font-bold border ${badge}">
                                ${s.dayOfWeek}
                            </span>
                        </td>
                        <td class="p-3 font-bold text-gray-800">${s.teacher?.name || '-'}</td>
                        <td class="p-3 text-xs text-gray-500">${s.teacher?.username || s.teacher?.id || '-'}</td>
                        <td class="p-3 text-sm text-gray-600">${s.notes || '-'}</td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 rounded text-xs font-semibold ${s.isActive ? 'bg-green-100 text-green-700' : 'bg-gray-200 text-gray-600'}">
                                ${s.isActive ? 'Aktif' : 'Non-Aktif'}
                            </span>
                        </td>
                        <td class="p-3 text-center">
                            <button onclick="deleteSchedule('${s.id}')" class="text-red-600 hover:text-red-800 p-1 rounded hover:bg-red-50 text-xs font-bold">
                                🗑️ Hapus
                            </button>
                        </td>
                    </tr>
                `;
            });
        }

        async function loadTodayPiket() {
            try {
                const res = await fetch('/api/operator/piket-today', { headers: { 'Authorization': 'Bearer ' + token }});
                if(res.ok) {
                    const data = await res.json();
                    document.getElementById('todayDayName').innerText = data.dayOfWeek || '-';
                    document.getElementById('todayPiketCount').innerText = `${data.count || 0} Guru`;
                    
                    if(data.teachers && data.teachers.length > 0) {
                        const names = data.teachers.map(t => t.teacher?.name).filter(Boolean).join(', ');
                        document.getElementById('todayPiketNames').innerText = names;
                    } else {
                        document.getElementById('todayPiketNames').innerText = 'Tidak ada jadwal piket hari ini.';
                    }
                }
            } catch(e) { console.error('Error load today piket', e); }
        }

        async function loadEmptyClassReports() {
            try {
                const res = await fetch('/api/piket/empty-class-reports');
                if(res.ok) {
                    const reports = await res.json();
                    const tbody = document.getElementById('emptyClassTableBody');
                    tbody.innerHTML = '';

                    const pending = reports.filter(r => r.status === 'PENDING');
                    const resolved = reports.filter(r => r.status === 'RESOLVED');
                    document.getElementById('pendingReportCount').innerText = `${pending.length} Kelas`;
                    document.getElementById('resolvedReportCount').innerText = `${resolved.length} Kelas`;

                    if(reports.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-gray-400">Tidak ada laporan jam kelas kosong saat ini. Semua kelas kondusif! 🎉</td></tr>';
                        return;
                    }

                    reports.forEach(r => {
                        const isPending = r.status === 'PENDING';
                        const time = new Date(r.createdAt).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                        const statusBadge = isPending 
                            ? `<span class="bg-red-100 text-red-700 px-2.5 py-1 rounded-full text-xs font-bold border border-red-200 animate-pulse">MENUNGGU GURU PIKET</span>`
                            : `<span class="bg-green-100 text-green-700 px-2.5 py-1 rounded-full text-xs font-bold border border-green-200">TERTANGANI (${r.handledBy || 'Guru Inval'})</span>`;

                        let repBadge = '<span class="text-xs text-gray-400 italic">Pengurus Kelas</span>';
                        if(r.reporterName) {
                            const rep = r.reporterName;
                            if(rep.includes('Ketua Kelas') && !rep.includes('Wakil')) {
                                repBadge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black bg-amber-100 text-amber-900 border border-amber-300 shadow-sm">👑 ${rep}</span>`;
                            } else if(rep.includes('Wakil')) {
                                repBadge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black bg-sky-100 text-sky-900 border border-sky-300">🥈 ${rep}</span>`;
                            } else if(rep.includes('Sekretaris')) {
                                repBadge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black bg-purple-100 text-purple-900 border border-purple-300">📝 ${rep}</span>`;
                            } else if(rep.includes('Bendahara')) {
                                repBadge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black bg-emerald-100 text-emerald-900 border border-emerald-300">💰 ${rep}</span>`;
                            } else {
                                repBadge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-800 border border-slate-300">👤 ${rep}</span>`;
                            }
                        }

                        tbody.innerHTML += `
                            <tr class="hover:bg-amber-50/40 border-b">
                                <td class="p-3 font-bold text-amber-900">${r.className}</td>
                                <td class="p-3 text-sm font-semibold text-gray-700">${r.subject || '-'}</td>
                                <td class="p-3">${repBadge}</td>
                                <td class="p-3 text-xs font-mono text-gray-500">${time} WIB</td>
                                <td class="p-3 text-xs text-gray-600 max-w-xs truncate">${r.notes || '-'}</td>
                                <td class="p-3">${statusBadge}</td>
                                <td class="p-3 text-center">
                                    ${isPending ? `
                                        <button onclick="handleReportPrompt('${r.id}', '${r.className}')" class="bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold px-3 py-1.5 rounded-md shadow">
                                            Ambil Tindakan
                                        </button>
                                    ` : `
                                        <span class="text-xs text-gray-400 font-semibold">Tugas: ${r.assignmentNote || 'Selesai'}</span>
                                    `}
                                </td>
                            </tr>
                        `;
                    });
                }
            } catch(e) { console.error('Error load empty classes', e); }
        }

        async function handleReportPrompt(reportId, className) {
            const assignment = prompt(`Masukkan instruksi / tugas pengganti untuk kelas ${className} (atau nama Guru Inval):`, 'Diberikan tugas mandiri oleh Guru Piket');
            if(assignment === null) return;

            try {
                const res = await fetch(`/api/piket/empty-class-reports/${reportId}/handle`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ assignmentNote: assignment })
                });
                if(res.ok) {
                    alert('Laporan kelas kosong berhasil ditangani!');
                    loadEmptyClassReports();
                } else {
                    alert('Gagal menangani laporan.');
                }
            } catch(e) { alert('Terjadi kesalahan'); }
        }

        function openAddModal() {
            clearTeacherSearch();
            document.getElementById('addModal').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
            document.getElementById('addPiketForm').reset();
        }

        async function submitAddPiket(e) {
            e.preventDefault();
            const teacherId = document.getElementById('selectTeacher').value;
            const dayOfWeek = document.getElementById('selectDay').value;
            const notes = document.getElementById('inputNotes').value;

            if(!teacherId) {
                alert('Pilih guru terlebih dahulu');
                return;
            }

            try {
                const res = await fetch('/api/operator/piket-schedule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ teacherId, dayOfWeek, notes })
                });

                if(res.ok) {
                    closeAddModal();
                    await loadSchedules();
                    await loadTodayPiket();
                    alert('Jadwal guru piket berhasil disimpan!');
                } else {
                    const err = await res.json();
                    alert(err.message || 'Gagal menyimpan jadwal');
                }
            } catch(e) {
                alert('Terjadi kesalahan jaringan');
            }
        }

        async function deleteSchedule(id) {
            if(!confirm('Hapus guru ini dari jadwal piket?')) return;
            try {
                const res = await fetch(`/api/operator/piket-schedule/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if(res.ok) {
                    await loadSchedules();
                    await loadTodayPiket();
                } else {
                    alert('Gagal menghapus jadwal piket');
                }
            } catch(e) {
                alert('Terjadi kesalahan');
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        // ==================== LAPORAN KETIDAKAKTIFAN GURU BULANAN ====================
        let allInactivityData = [];

        async function loadTeacherInactivityReport() {
            const month = document.getElementById('inactivityMonthSelect')?.value || (new Date().getMonth() + 1);
            const year = document.getElementById('inactivityYearSelect')?.value || new Date().getFullYear();
            const tbody = document.getElementById('teacherInactivityTableBody');
            if (tbody) tbody.innerHTML = `<tr><td colspan="9" class="p-6 text-center text-slate-400"><div class="inline-block animate-spin w-5 h-5 border-2 border-amber-600 border-t-transparent rounded-full mr-2"></div> Memuat data ketidakhadiran guru...</td></tr>`;

            try {
                const res = await fetch(`/api/piket/teacher-inactivity?month=${month}&year=${year}`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (data.success) {
                    allInactivityData = data.teachers || [];
                    document.getElementById('inactivityWorkingDays').innerText = `${data.effectiveWorkingDays} Hari`;
                    document.getElementById('inactivityAvgAbsence').innerText = `${data.summary?.avgAbsencePercentage || 0}%`;
                    document.getElementById('inactivityAvgLate').innerText = `${data.summary?.avgLatePercentage || 0}%`;
                    document.getElementById('inactivityTotalEmptyClasses').innerText = `${data.summary?.totalSchoolEmptyClasses || 0} Insiden`;
                    renderInactivityTable(allInactivityData);
                } else {
                    if (tbody) tbody.innerHTML = `<tr><td colspan="9" class="p-6 text-center text-rose-500">${data.message || 'Gagal memuat rekap'}</td></tr>`;
                }
            } catch(err) {
                console.error('Error loading teacher inactivity:', err);
                if (tbody) tbody.innerHTML = `<tr><td colspan="9" class="p-6 text-center text-rose-500">Terjadi kesalahan jaringan saat memuat rekap.</td></tr>`;
            }
        }

        function filterInactivityTable() {
            const query = (document.getElementById('inactivitySearchInput')?.value || '').toLowerCase().trim();
            const filtered = allInactivityData.filter(t => 
                (t.name || '').toLowerCase().includes(query) ||
                (t.nip || '').toLowerCase().includes(query) ||
                (t.subject || '').toLowerCase().includes(query)
            );
            renderInactivityTable(filtered);
        }

        function renderInactivityTable(list) {
            const tbody = document.getElementById('teacherInactivityTableBody');
            if (!tbody) return;

            if (!list || list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="p-6 text-center text-slate-400">Tidak ada data guru yang cocok dengan pencarian.</td></tr>`;
                return;
            }

            tbody.innerHTML = list.map((t, idx) => {
                let statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Sangat Disiplin</span>';
                if (t.evaluationStatus === 'PERLU_PEMBINAAN_KHUSUS') {
                    statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-100 text-rose-800 border border-rose-300">⚠️ Perlu Pembinaan</span>';
                } else if (t.evaluationStatus === 'PERHATIAN_KURIKULUM') {
                    statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-300">Perhatian</span>';
                } else if (t.evaluationStatus === 'CUKUP_DISIPLIN') {
                    statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-sky-100 text-sky-800">Cukup Disiplin</span>';
                }

                let missedClassesDisplay = '<span class="text-slate-400 italic">Nihil (KBM Penuh)</span>';
                if (t.missedClasses && t.missedClasses.length > 0) {
                    missedClassesDisplay = `
                        <div class="flex flex-wrap gap-1 items-center">
                            ${t.missedClasses.map(cls => `<span class="px-1.5 py-0.5 bg-rose-50 text-rose-700 border border-rose-200 rounded font-bold text-[10px]">Kelas ${cls}</span>`).join('')}
                            <span class="text-[10px] font-bold text-rose-600">(${t.missedClassesCount}x Kosong)</span>
                        </div>
                    `;
                }

                const absenceColor = t.absencePercentage >= 15 ? 'text-rose-600 font-extrabold' : (t.absencePercentage > 0 ? 'text-amber-600 font-bold' : 'text-emerald-700 font-semibold');
                const lateColor = t.latePercentage >= 15 ? 'text-rose-600 font-extrabold' : (t.latePercentage > 0 ? 'text-amber-600 font-bold' : 'text-slate-600');

                return `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-3 text-slate-400 font-mono">${idx + 1}</td>
                        <td class="p-3">
                            <p class="font-bold text-slate-800">${t.name}</p>
                            <p class="text-[11px] text-slate-400 font-mono">NIP: ${t.nip || '-'}</p>
                        </td>
                        <td class="p-3 font-semibold text-slate-600">${t.subject}</td>
                        <td class="p-3 text-center font-bold text-slate-700">${t.totalAbsentDays} Hari</td>
                        <td class="p-3 text-center ${absenceColor}">${t.absencePercentage}%</td>
                        <td class="p-3 text-center font-bold text-slate-700">${t.lateCount}x</td>
                        <td class="p-3 text-center ${lateColor}">${t.latePercentage}%</td>
                        <td class="p-3">${missedClassesDisplay}</td>
                        <td class="p-3 text-center">${statusBadge}</td>
                    </tr>
                `;
            }).join('');
        }

        document.addEventListener('DOMContentLoaded', initPage);
    </script>
</body>
</html>
