<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Jam Pelajaran (JP) - Portal Operator</title>
    <script src="/js/tailwind.js"></script>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex h-screen overflow-hidden">

    <!-- Unified Operator Sidebar -->
    <%- include('partials/sidebar_operator') %>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-6 md:p-8 overflow-y-auto bg-slate-50/60 transition-all duration-300 ease-in-out">
        <header class="flex flex-wrap justify-between items-center mb-6 pb-4 border-b border-slate-200/80">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>⏰</span> Tabel Master Jam &amp; Jadwal Pelajaran (JP)
                    </h1>
                    <p class="text-xs text-slate-500 mt-0.5">Konfigurasi sesi jam pelajaran sekolah untuk presensi 1-tap otomatis Guru &amp; Siswa.</p>
                </div>
            </div>
            <div class="flex gap-2.5 mt-3 sm:mt-0">
                <button onclick="triggerGenerateDefaults()" class="bg-amber-600 hover:bg-amber-700 text-white font-bold px-4 py-2 rounded-lg text-sm shadow flex items-center gap-1.5 transition-all">
                    <span>⚡</span> Generate Jadwal Standar (JP 1-8)
                </button>
                <button onclick="openModalAdd()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-lg text-sm shadow flex items-center gap-1.5 transition-all">
                    <span>+</span> Tambah Jam Pelajaran
                </button>
            </div>
        </header>

        <!-- Filter Controls -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 mb-6 flex flex-wrap gap-4 items-center justify-between">
            <div class="flex flex-wrap items-center gap-3">
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">📅 Filter Hari</label>
                    <select id="filterDay" class="border p-2 rounded-lg text-xs font-semibold bg-gray-50" onchange="loadSchedules()">
                        <option value="ALL">Semua Hari</option>
                        <option value="Senin">Senin</option>
                        <option value="Selasa">Selasa</option>
                        <option value="Rabu">Rabu</option>
                        <option value="Kamis">Kamis</option>
                        <option value="Jumat">Jumat</option>
                        <option value="Sabtu">Sabtu</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">🏫 Filter Kelas</label>
                    <select id="filterClass" class="border p-2 rounded-lg text-xs font-semibold bg-gray-50" onchange="loadSchedules()">
                        <option value="ALL">Semua Kelas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">🔍 Cari Guru / Mapel</label>
                    <input type="text" id="searchKeyword" placeholder="Cari nama guru atau mata pelajaran..." class="border p-2 rounded-lg text-xs w-64 bg-gray-50" oninput="filterLocal()">
                </div>
            </div>
            <button onclick="loadSchedules()" class="text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-300 font-bold px-3 py-2 rounded-lg text-xs">
                ⟳ Refresh Data
            </button>
        </div>

        <!-- Table Master Schedules -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="bg-amber-50 text-amber-950 text-xs uppercase tracking-wider border-b border-amber-200">
                            <th class="p-3.5 font-bold">No</th>
                            <th class="p-3.5 font-bold">Hari</th>
                            <th class="p-3.5 font-bold">JP Ke</th>
                            <th class="p-3.5 font-bold">Waktu Belajar</th>
                            <th class="p-3.5 font-bold">Kelas</th>
                            <th class="p-3.5 font-bold">Mata Pelajaran</th>
                            <th class="p-3.5 font-bold">Guru Pengampu</th>
                            <th class="p-3.5 font-bold">Ruangan</th>
                            <th class="p-3.5 font-bold">Status</th>
                            <th class="p-3.5 font-bold text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="scheduleTableBody" class="text-sm divide-y divide-gray-100">
                        <tr><td colspan="10" class="p-6 text-center text-gray-500">Memuat data jam pelajaran...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Modal Form Tambah / Edit Jadwal -->
    <div id="modalSchedule" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-2xl w-full max-w-lg shadow-2xl">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <h3 class="text-lg font-bold text-gray-800" id="modalTitle">Tambah Jam Pelajaran</h3>
                <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
            </div>
            <form id="scheduleForm" onsubmit="saveSchedule(event)" class="space-y-3.5">
                <input type="hidden" id="editScheduleId">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1">Hari *</label>
                        <select id="formDay" class="w-full border p-2 rounded-lg text-xs font-semibold bg-gray-50" required>
                            <option value="Senin">Senin</option>
                            <option value="Selasa">Selasa</option>
                            <option value="Rabu">Rabu</option>
                            <option value="Kamis">Kamis</option>
                            <option value="Jumat">Jumat</option>
                            <option value="Sabtu">Sabtu</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1">Jam Ke- (JP) *</label>
                        <input type="number" id="formPeriodIndex" min="1" max="12" class="w-full border p-2 rounded-lg text-xs" required value="1">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1">Jam Mulai (HH:mm) *</label>
                        <input type="time" id="formStartTime" class="w-full border p-2 rounded-lg text-xs font-semibold" required value="07:00">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1">Jam Selesai (HH:mm) *</label>
                        <input type="time" id="formEndTime" class="w-full border p-2 rounded-lg text-xs font-semibold" required value="07:45">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1">Target Kelas *</label>
                        <input type="text" id="formClassName" class="w-full border p-2 rounded-lg text-xs font-semibold uppercase" required placeholder="Cth: VII-A">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1">Ruangan</label>
                        <input type="text" id="formRoomName" class="w-full border p-2 rounded-lg text-xs" placeholder="Cth: Ruang Kelas 7A">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">Mata Pelajaran *</label>
                    <input type="text" id="formSubjectName" class="w-full border p-2 rounded-lg text-xs font-semibold" required placeholder="Cth: Matematika / Bahasa Indonesia">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">Guru Pengampu *</label>
                    <input type="text" id="formTeacherName" class="w-full border p-2 rounded-lg text-xs font-semibold" required placeholder="Cth: Bpk. Budi Santoso, S.Pd">
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="formIsBreak" class="rounded text-amber-600">
                    <label for="formIsBreak" class="text-xs text-gray-700 font-semibold">Tandai sebagai Jam Istirahat / Sholat</label>
                </div>

                <div class="flex justify-end gap-2 pt-4 border-t">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg text-xs font-bold">Batal</button>
                    <button type="submit" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-xs font-bold shadow">Simpan Jadwal</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        if(!token) window.location.href = '/';

        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            document.getElementById('profileName').innerText = payload.name;
        } catch(e) {}

        let allSchedules = [];
        let filteredSchedules = [];

        async function loadClasses() {
            try {
                const res = await fetch('/api/kelas', { headers: { 'Authorization': 'Bearer ' + token } });
                const classes = await res.json();
                const sel = document.getElementById('filterClass');
                if(Array.isArray(classes)) {
                    sel.innerHTML = '<option value="ALL">Semua Kelas</option>';
                    classes.forEach(c => {
                        sel.innerHTML += `<option value="${c.nama}">Kelas ${c.nama}</option>`;
                    });
                }
            } catch(e) {}
        }

        async function loadSchedules() {
            const day = document.getElementById('filterDay').value;
            const className = document.getElementById('filterClass').value;
            let url = `/api/operator/schedules?day=${encodeURIComponent(day)}&className=${encodeURIComponent(className)}`;

            try {
                const res = await fetch(url, { headers: { 'Authorization': 'Bearer ' + token } });
                const data = await res.json();
                if(data.success && Array.isArray(data.schedules)) {
                    allSchedules = data.schedules;
                    filterLocal();
                }
            } catch(e) {
                console.error(e);
            }
        }

        function filterLocal() {
            const q = (document.getElementById('searchKeyword').value || '').toLowerCase().trim();
            filteredSchedules = allSchedules.filter(s => 
                (s.subjectName && s.subjectName.toLowerCase().includes(q)) ||
                (s.teacherName && s.teacherName.toLowerCase().includes(q)) ||
                (s.className && s.className.toLowerCase().includes(q))
            );
            renderTable();
        }

        function renderTable() {
            const tbody = document.getElementById('scheduleTableBody');
            tbody.innerHTML = '';

            if(filteredSchedules.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" class="p-8 text-center text-gray-500">Tidak ada data jadwal ditemukan. Klik tombol <b>"Generate Jadwal Standar"</b> untuk membuat template otomatis.</td></tr>';
                return;
            }

            filteredSchedules.forEach((s, idx) => {
                const isBreakBadge = s.isBreak 
                    ? '<span class="bg-rose-100 text-rose-800 text-[10px] font-extrabold px-2 py-0.5 rounded border border-rose-300">ISTIRAHAT</span>'
                    : '<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-300">PEMBELAJARAN</span>';

                tbody.innerHTML += `
                    <tr class="hover:bg-amber-50/50 transition-colors">
                        <td class="p-3.5 text-gray-400 font-mono text-xs">${idx + 1}</td>
                        <td class="p-3.5 font-bold text-gray-800">${s.day}</td>
                        <td class="p-3.5 font-bold text-amber-700">JP ${s.periodIndex}</td>
                        <td class="p-3.5 font-mono text-xs font-semibold text-blue-700">${s.startTime} - ${s.endTime} WIB</td>
                        <td class="p-3.5 font-bold text-gray-700">${s.className}</td>
                        <td class="p-3.5 font-bold text-gray-900">${s.subjectName}</td>
                        <td class="p-3.5 text-xs text-gray-700">${s.teacherName || '-'}</td>
                        <td class="p-3.5 text-xs text-gray-500">${s.roomName || '-'}</td>
                        <td class="p-3.5">${isBreakBadge}</td>
                        <td class="p-3.5 text-center space-x-1">
                            <button onclick='openModalEdit(${JSON.stringify(s)})' class="bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold px-2.5 py-1 rounded text-xs border border-blue-200">Edit</button>
                            <button onclick="deleteSchedule('${s.id}')" class="bg-rose-50 text-rose-700 hover:bg-rose-100 font-bold px-2.5 py-1 rounded text-xs border border-rose-200">Hapus</button>
                        </td>
                    </tr>
                `;
            });
        }

        function openModalAdd() {
            document.getElementById('editScheduleId').value = '';
            document.getElementById('modalTitle').innerText = 'Tambah Jam Pelajaran';
            document.getElementById('scheduleForm').reset();
            document.getElementById('modalSchedule').classList.remove('hidden');
        }

        function openModalEdit(s) {
            document.getElementById('editScheduleId').value = s.id;
            document.getElementById('modalTitle').innerText = 'Edit Jam Pelajaran';
            document.getElementById('formDay').value = s.day;
            document.getElementById('formPeriodIndex').value = s.periodIndex;
            document.getElementById('formStartTime').value = s.startTime;
            document.getElementById('formEndTime').value = s.endTime;
            document.getElementById('formClassName').value = s.className;
            document.getElementById('formRoomName').value = s.roomName || '';
            document.getElementById('formSubjectName').value = s.subjectName;
            document.getElementById('formTeacherName').value = s.teacherName || '';
            document.getElementById('formIsBreak').checked = Boolean(s.isBreak);
            document.getElementById('modalSchedule').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modalSchedule').classList.add('hidden');
        }

        async function saveSchedule(e) {
            e.preventDefault();
            const id = document.getElementById('editScheduleId').value;
            const payload = {
                day: document.getElementById('formDay').value,
                periodIndex: Number(document.getElementById('formPeriodIndex').value),
                startTime: document.getElementById('formStartTime').value,
                endTime: document.getElementById('formEndTime').value,
                className: document.getElementById('formClassName').value.toUpperCase(),
                roomName: document.getElementById('formRoomName').value,
                subjectName: document.getElementById('formSubjectName').value,
                teacherName: document.getElementById('formTeacherName').value,
                isBreak: document.getElementById('formIsBreak').checked
            };

            const url = id ? `/api/operator/schedules/${id}` : '/api/operator/schedules';
            const method = id ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(data.success) {
                    alert(data.message || 'Jadwal berhasil disimpan!');
                    closeModal();
                    loadSchedules();
                } else {
                    alert(data.message || 'Gagal menyimpan jadwal');
                }
            } catch(err) {
                alert('Terjadi kesalahan: ' + err.message);
            }
        }

        async function deleteSchedule(id) {
            if(!confirm('Yakin ingin menghapus jadwal ini?')) return;
            try {
                const res = await fetch(`/api/operator/schedules/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if(data.success) {
                    loadSchedules();
                } else {
                    alert(data.message || 'Gagal menghapus jadwal');
                }
            } catch(e) {
                alert('Gagal: ' + e.message);
            }
        }

        async function triggerGenerateDefaults() {
            if(!confirm('Generate jadwal standar otomatis untuk Kelas VII s/d IX (Senin - Jumat, JP 1-10)?')) return;
            try {
                const res = await fetch('/api/operator/schedules/generate-defaults', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                alert(data.message || 'Jadwal standar berhasil dibuat!');
                loadSchedules();
            } catch(e) {
                alert('Gagal generate: ' + e.message);
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }

        loadClasses();
        loadSchedules();
    </script>
</body>
</html>
