<%
    const initList = (typeof initialStudents !== 'undefined' && Array.isArray(initialStudents)) ? initialStudents : [];
    const totalCount = initList.length;
    const countVII = initList.filter(s => (s.className || '').startsWith('VII-')).length;
    const countVIII = initList.filter(s => (s.className || '').startsWith('VIII-')).length;
    const countIX = initList.filter(s => (s.className || '').startsWith('IX-')).length;
%>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Siswa & Profil (Tingkat VII, VIII, IX) - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <script src="/js/qrcode.min.js"></script>
    <style>
        .bg-unbk-navy { background-color: #0c234a; }
        .bg-unbk-blue { background-color: #1d4ed8; }
        .tab-btn.active {
            background-color: #1565C0;
            color: white;
            box-shadow: 0 4px 12px rgba(21, 101, 192, 0.25);
            font-weight: 800;
        }
        @media print {
            body * { visibility: hidden; }
            #printableStudentCard, #printableStudentCard * { visibility: visible; }
            #printableStudentCard { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex">
    <!-- Sidebar -->
    <%- include('partials/sidebar_admin') %>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-8 ml-0 md:ml-64 overflow-y-auto h-screen bg-slate-50/60 transition-all duration-300 ease-in-out">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <div class="flex items-center gap-3">
                <button onclick="togglePortalSidebar()" class="p-2 rounded-xl border border-slate-200/80 bg-white hover:bg-slate-100 text-slate-700 transition-colors shadow-sm cursor-pointer" title="Toggle Sidebar (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <h1 class="text-2xl font-black text-slate-800 flex items-center gap-2">
                        <span>👨‍🎓</span> Data Siswa &amp; Profil
                    </h1>
                    <p class="text-slate-500 text-xs">Pengelompokan Lengkap Tingkat Kelas VII, Kelas VIII, dan Kelas IX</p>
                </div>
            </div>
            <div class="flex gap-2">
                <button onclick="openPromoteModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl shadow-md font-bold flex items-center gap-2 transition-all text-xs">
                    <span>⬆️</span> <span>Kenaikan Kelas</span>
                </button>
                <button onclick="openAddModal()" class="bg-unbk-blue hover:bg-blue-800 text-white px-5 py-2.5 rounded-xl shadow-md font-bold flex items-center gap-2 transition-all text-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>Tambah Siswa</span>
                </button>
            </div>
        </div>

        <!-- 4 STATISTIK KARTU TINGKAT KELAS -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div onclick="selectTingkatTab('ALL')" class="bg-white p-4 rounded-2xl border shadow-sm cursor-pointer hover:border-blue-500 transition-all flex items-center justify-between">
                <div>
                    <p class="text-[11px] text-gray-500 font-bold uppercase">Total Siswa Terdaftar</p>
                    <p class="text-2xl font-black text-gray-800" id="statAllCount"><%= totalCount %></p>
                    <p class="text-[10px] text-blue-600 font-semibold mt-0.5"><%= countVII > 0 ? (countVII + ' Siswa Aktif di Database') : 'Belum Ada Data' %></p>
                </div>
                <div class="p-3 bg-blue-50 text-blue-600 rounded-2xl text-2xl">👨‍🎓</div>
            </div>
            <div onclick="selectTingkatTab('VII')" class="bg-white p-4 rounded-2xl border shadow-sm cursor-pointer hover:border-emerald-500 transition-all flex items-center justify-between">
                <div>
                    <p class="text-[11px] text-emerald-700 font-bold uppercase">Tingkat VII (Kelas 7)</p>
                    <p class="text-2xl font-black text-emerald-600" id="statVII"><%= countVII %></p>
                    <p class="text-[10px] text-emerald-600 font-semibold mt-0.5">11 Rombel (VII-A s.d VII-K)</p>
                </div>
                <div class="p-3 bg-emerald-50 text-emerald-600 rounded-2xl text-2xl">🟢</div>
            </div>
            <div onclick="selectTingkatTab('VIII')" class="bg-white p-4 rounded-2xl border shadow-sm cursor-pointer hover:border-sky-500 transition-all flex items-center justify-between">
                <div>
                    <p class="text-[11px] text-sky-700 font-bold uppercase">Tingkat VIII (Kelas 8)</p>
                    <p class="text-2xl font-black text-sky-600" id="statVIII"><%= countVIII %></p>
                    <p class="text-[10px] text-sky-600 font-semibold mt-0.5">11 Rombel (VIII-A s.d VIII-K)</p>
                </div>
                <div class="p-3 bg-sky-50 text-sky-600 rounded-2xl text-2xl">🔵</div>
            </div>
            <div onclick="selectTingkatTab('IX')" class="bg-white p-4 rounded-2xl border shadow-sm cursor-pointer hover:border-purple-500 transition-all flex items-center justify-between">
                <div>
                    <p class="text-[11px] text-purple-700 font-bold uppercase">Tingkat IX (Kelas 9)</p>
                    <p class="text-2xl font-black text-purple-600" id="statIX"><%= countIX %></p>
                    <p class="text-[10px] text-purple-600 font-semibold mt-0.5">11 Rombel (IX-A s.d IX-K)</p>
                </div>
                <div class="p-3 bg-purple-50 text-purple-600 rounded-2xl text-2xl">🟣</div>
            </div>
        </div>

        <!-- TINGKAT TAB SWITCHER & FILTER BAR -->
        <div class="bg-white p-4 rounded-2xl border shadow-sm mb-4">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <!-- Level Tabs -->
                <div class="flex items-center bg-gray-100 p-1.5 rounded-xl gap-1">
                    <button onclick="selectTingkatTab('ALL')" id="tabAll" class="tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5">
                        <span>📋</span> <span>Semua Tingkat</span> <span class="bg-white/20 text-[10px] px-1.5 py-0.5 rounded-full" id="tabBadgeAll"><%= totalCount %></span>
                    </button>
                    <button onclick="selectTingkatTab('VII')" id="tabVII" class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold text-gray-700 hover:text-gray-900 transition-all flex items-center gap-1.5">
                        <span>🟢</span> <span>Kelas VII</span> <span class="bg-emerald-100 text-emerald-800 text-[10px] px-1.5 py-0.5 rounded-full font-bold" id="tabBadgeVII"><%= countVII %></span>
                    </button>
                    <button onclick="selectTingkatTab('VIII')" id="tabVIII" class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold text-gray-700 hover:text-gray-900 transition-all flex items-center gap-1.5">
                        <span>🔵</span> <span>Kelas VIII</span> <span class="bg-sky-100 text-sky-800 text-[10px] px-1.5 py-0.5 rounded-full font-bold" id="tabBadgeVIII"><%= countVIII %></span>
                    </button>
                    <button onclick="selectTingkatTab('IX')" id="tabIX" class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold text-gray-700 hover:text-gray-900 transition-all flex items-center gap-1.5">
                        <span>🟣</span> <span>Kelas IX</span> <span class="bg-purple-100 text-purple-800 text-[10px] px-1.5 py-0.5 rounded-full font-bold" id="tabBadgeIX"><%= countIX %></span>
                    </button>
                </div>

                <!-- Sub-Filter Rombel & Live Search -->
                <div class="flex items-center gap-3 flex-1 max-w-xl justify-end">
                    <select id="filterRombelSelect" onchange="applyFilters()" class="text-xs font-bold border-2 border-blue-100 rounded-xl px-3 py-2 bg-blue-50/50 text-blue-900 focus:outline-none">
                        <option value="ALL">Semua Rombel</option>
                    </select>

                    <input type="text" id="searchInput" placeholder="🔍 Cari Nama / NISN / NIS / Kelas..."
                           class="border rounded-xl px-3.5 py-2 text-xs w-64 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none"
                           oninput="debounceSearch()">
                </div>
            </div>
        </div>

        <!-- Table Container -->
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden flex flex-col border">
            <div class="overflow-x-auto flex-1">
                <table class="w-full text-left border-collapse whitespace-nowrap text-xs" id="siswaTable">
                    <thead>
                        <tr class="bg-gray-100 text-gray-700 uppercase tracking-wider font-bold border-b">
                            <th class="p-3.5">Foto & Nama Siswa</th>
                            <th class="p-3.5">NISN / Username</th>
                            <th class="p-3.5">Tingkat & Rombel</th>
                            <th class="p-3.5">L/P</th>
                            <th class="p-3.5">📱 Binding HP Siswa</th>
                            <th class="p-3.5">Status CBT</th>
                            <th class="p-3.5 text-right">Aksi Terpadu</th>
                        </tr>
                    </thead>
                    <tbody id="studentTableBody" class="divide-y">
                        <tr><td colspan="7" class="p-8 text-center text-gray-400">Memuat data siswa dari database...</td></tr>
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination Controls -->
            <div class="p-4 bg-gray-50 border-t flex justify-between items-center text-xs text-gray-600">
                <span id="pageInfo">Menampilkan 0-0 dari 0 siswa</span>
                <div class="space-x-2">
                    <button onclick="prevPage()" class="px-3 py-1.5 bg-gray-200 rounded-lg hover:bg-gray-300 disabled:opacity-50 font-bold" id="btnPrev">Sebelumnya</button>
                    <button onclick="nextPage()" class="px-3 py-1.5 bg-unbk-blue text-white rounded-lg hover:bg-blue-800 disabled:opacity-50 font-bold shadow-sm" id="btnNext">Selanjutnya</button>
                </div>
            </div>
        </div>
    </main>

    <!-- Modal Profil Siswa (Kartu Pelajar & Biodata Lengkap) -->
    <div id="modalProfile" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-3xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl border">
            <div class="p-5 border-b flex justify-between items-center bg-gradient-to-r from-blue-900 to-indigo-900 text-white rounded-t-3xl">
                <div class="flex items-center gap-2">
                    <span class="text-xl">🪪</span>
                    <h2 class="text-base font-bold">Profil Lengkap Siswa & Kartu Pelajar</h2>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="window.print()" class="bg-blue-700 hover:bg-blue-600 px-3.5 py-1.5 rounded-xl text-xs font-bold shadow">🖨️ Cetak Kartu</button>
                    <button onclick="closeProfileModal()" class="text-white hover:text-gray-300 text-2xl font-bold ml-2">&times;</button>
                </div>
            </div>

            <div class="p-6 bg-slate-50" id="profileCardContent">
                <!-- Injected via JS -->
            </div>
        </div>
    </div>

    <!-- Modal Tambah / Edit Siswa -->
    <div id="modalAdd" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white p-6 rounded-3xl w-full max-w-xl max-h-[90vh] overflow-y-auto shadow-2xl">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <div class="flex items-center gap-2.5">
                    <span class="text-2xl">👨‍🎓</span>
                    <div>
                        <h2 class="text-base font-bold text-gray-800" id="modalTitle">Tambah Siswa Baru</h2>
                        <p class="text-[11px] text-gray-500">Kelola identitas pokok siswa, NISN, rombel kelas, dan kontak orang tua</p>
                    </div>
                </div>
                <button type="button" onclick="closeAddModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
            </div>
            <form id="addStudentForm" onsubmit="handleFormSubmit(event)" class="space-y-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">NISN (Username Login CBT) *</label>
                        <input type="text" id="nisn" placeholder="Cth: 0013141208" class="w-full border p-2.5 rounded-xl text-xs" required>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">NIS</label>
                        <input type="text" id="nis" placeholder="Cth: 15221" class="w-full border p-2.5 rounded-xl text-xs">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Lengkap Siswa *</label>
                    <input type="text" id="nama" placeholder="Nama Lengkap" class="w-full border p-2.5 rounded-xl text-xs" required>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Tingkat & Rombel Kelas *</label>
                        <select id="kelas" class="w-full border p-2.5 rounded-xl text-xs font-medium" required>
                            <option value="">Pilih Kelas</option>
                            <optgroup label="Tingkat VII (Kelas 7)">
                                <option value="VII-A">VII-A</option><option value="VII-B">VII-B</option><option value="VII-C">VII-C</option>
                                <option value="VII-D">VII-D</option><option value="VII-E">VII-E</option><option value="VII-F">VII-F</option>
                                <option value="VII-G">VII-G</option><option value="VII-H">VII-H</option><option value="VII-I">VII-I</option>
                                <option value="VII-J">VII-J</option><option value="VII-K">VII-K</option>
                            </optgroup>
                            <optgroup label="Tingkat VIII (Kelas 8)">
                                <option value="VIII-A">VIII-A</option><option value="VIII-B">VIII-B</option><option value="VIII-C">VIII-C</option>
                                <option value="VIII-D">VIII-D</option><option value="VIII-E">VIII-E</option><option value="VIII-F">VIII-F</option>
                                <option value="VIII-G">VIII-G</option><option value="VIII-H">VIII-H</option><option value="VIII-I">VIII-I</option>
                                <option value="VIII-J">VIII-J</option><option value="VIII-K">VIII-K</option>
                            </optgroup>
                            <optgroup label="Tingkat IX (Kelas 9)">
                                <option value="IX-A">IX-A</option><option value="IX-B">IX-B</option><option value="IX-C">IX-C</option>
                                <option value="IX-D">IX-D</option><option value="IX-E">IX-E</option><option value="IX-F">IX-F</option>
                                <option value="IX-G">IX-G</option><option value="IX-H">IX-H</option><option value="IX-I">IX-I</option>
                                <option value="IX-J">IX-J</option><option value="IX-K">IX-K</option>
                            </optgroup>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Jenis Kelamin *</label>
                        <select id="jk" class="w-full border p-2.5 rounded-xl text-xs" required>
                            <option value="Laki-laki">Laki-laki</option>
                            <option value="Perempuan">Perempuan</option>
                        </select>
                    </div>
                </div>

                <div class="flex justify-end space-x-2 pt-4 border-t">
                    <button type="button" onclick="closeAddModal()" class="bg-gray-400 hover:bg-gray-500 text-white px-4 py-2 rounded-xl text-xs font-bold">Batal</button>
                    <button type="submit" class="bg-unbk-blue hover:bg-blue-800 text-white px-5 py-2 rounded-xl text-xs font-bold shadow">Simpan Siswa</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL RESET PASSWORD SISWA & ORANG TUA -->
    <div id="modalResetPassword" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 border border-slate-200">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-black text-gray-800 text-base flex items-center gap-2">
                    <span>🔑</span> Reset Password Siswa &amp; Orang Tua
                </h3>
                <button onclick="closeResetPasswordModal()" class="text-gray-400 hover:text-gray-700 text-xl font-bold">&times;</button>
            </div>

            <div class="bg-slate-50 p-4 rounded-2xl border space-y-1 text-xs">
                <p><span class="text-gray-500 font-semibold">Nama Siswa:</span> <b class="text-gray-900 text-sm" id="resetTargetName">-</b></p>
                <p><span class="text-gray-500 font-semibold">NISN Siswa:</span> <b class="font-mono text-blue-700" id="resetTargetNisn">-</b></p>
                <p><span class="text-gray-500 font-semibold">Akun Ortu:</span> <b class="font-mono text-indigo-700" id="resetTargetParentUser">-</b></p>
            </div>

            <div class="space-y-3">
                <button onclick="executeReset('STUDENT')" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold p-3 rounded-xl text-xs shadow flex justify-between items-center transition-colors">
                    <span class="text-left">
                        <span class="block text-white">1. Reset Akun Siswa</span>
                        <span class="block text-[10px] text-blue-200 font-normal">Password kembali ke "password123" &amp; Unbind Device HP</span>
                    </span>
                    <span class="text-base">📱 ↺</span>
                </button>

                <button onclick="executeReset('PARENT')" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold p-3 rounded-xl text-xs shadow flex justify-between items-center transition-colors">
                    <span class="text-left">
                        <span class="block text-white">2. Reset Akun Orang Tua P(NISN)</span>
                        <span class="block text-[10px] text-indigo-200 font-normal">Password otomatis kembali sama dengan NISN Siswa</span>
                    </span>
                    <span class="text-base">👨‍👩‍👦 ↺</span>
                </button>

                <button onclick="executeReset('BOTH')" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold p-3 rounded-xl text-xs shadow flex justify-between items-center transition-colors">
                    <span class="text-left">
                        <span class="block text-white">3. Reset Keduanya (Siswa + Orang Tua)</span>
                        <span class="block text-[10px] text-emerald-200 font-normal">Reset Siswa ke password123 &amp; Ortu ke NISN sekaligus</span>
                    </span>
                    <span class="text-base">⚡ ↺</span>
                </button>

                <button onclick="executeResetDeviceOnly()" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold p-3 rounded-xl text-xs shadow flex justify-between items-center transition-colors">
                    <span class="text-left">
                        <span class="block text-white">4. Buka Kunci HP Siswa Saja (Reset Binding)</span>
                        <span class="block text-[10px] text-purple-200 font-normal">Password tetap sama, membuka ikatan perangkat agar bisa login di HP lain</span>
                    </span>
                    <span class="text-base">📱 ↺</span>
                </button>

                <div class="pt-2 border-t space-y-2">
                    <label class="text-[11px] font-bold text-gray-700 block">Atau Tentukan Custom Password Baru:</label>
                    <div class="flex gap-2">
                        <input type="text" id="inputCustomPassword" placeholder="Ketik kata sandi baru..." class="flex-1 border rounded-xl p-2 text-xs font-mono focus:ring-2 focus:ring-blue-400">
                        <button onclick="executeCustomReset()" class="bg-gray-800 hover:bg-black text-white font-bold px-4 py-2 rounded-xl text-xs shadow">
                            Terapkan
                        </button>
                    </div>
                </div>
            </div>

            <div class="flex justify-end pt-2">
                <button type="button" onclick="closeResetPasswordModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-5 py-2 rounded-xl text-xs font-bold">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL PROMOSI / KENAIKAN KELAS -->
    <div id="modalPromote" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4 border border-slate-200">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-black text-gray-800 text-base flex items-center gap-2">
                    <span>⬆️</span> Promosi &amp; Kenaikan Tingkat Kelas
                </h3>
                <button onclick="closePromoteModal()" class="text-gray-400 hover:text-gray-700 text-xl font-bold">&times;</button>
            </div>

            <p class="text-xs text-slate-500">
                Fitur ini akan memperbarui kelas seluruh siswa di database portal dan otomatis menyinkronkan data ke <b>Aplikasi Android (Siswa &amp; Orang Tua)</b> secara real-time.
            </p>

            <div class="space-y-3">
                <!-- Option 1: VII -> VIII -->
                <div class="p-4 rounded-2xl border-2 border-emerald-100 bg-emerald-50/50 hover:bg-emerald-50 transition-all cursor-pointer" onclick="selectPromoteMode('VII_TO_VIII')">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="radio" name="promoteRadio" id="radioVII" value="VII_TO_VIII" class="mt-1" checked>
                        <div>
                            <p class="font-extrabold text-sm text-emerald-900">🟢 Naikkan Semua Tingkat VII ke Tingkat VIII</p>
                            <p class="text-xs text-emerald-700 mt-0.5">Semua rombel Kelas VII-A s.d VII-K dinaikkan menjadi VIII-A s.d VIII-K (374 Siswa).</p>
                        </div>
                    </label>
                </div>

                <!-- Option 2: VIII -> IX -->
                <div class="p-4 rounded-2xl border-2 border-sky-100 bg-sky-50/50 hover:bg-sky-50 transition-all cursor-pointer" onclick="selectPromoteMode('VIII_TO_IX')">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="radio" name="promoteRadio" id="radioVIII" value="VIII_TO_IX" class="mt-1">
                        <div>
                            <p class="font-extrabold text-sm text-sky-900">🔵 Naikkan Semua Tingkat VIII ke Tingkat IX</p>
                            <p class="text-xs text-sky-700 mt-0.5">Semua rombel Kelas VIII-A s.d VIII-K dinaikkan menjadi IX-A s.d IX-K (364 Siswa).</p>
                        </div>
                    </label>
                </div>

                <!-- Option 3: Kelas Spesifik -->
                <div class="p-4 rounded-2xl border-2 border-purple-100 bg-purple-50/50 hover:bg-purple-50 transition-all cursor-pointer" onclick="selectPromoteMode('CUSTOM')">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="radio" name="promoteRadio" id="radioCustom" value="CUSTOM" class="mt-1">
                        <div class="flex-1">
                            <p class="font-extrabold text-sm text-purple-900">🟣 Naikkan Satu Rombel Kelas Spesifik</p>
                            <div class="grid grid-cols-2 gap-2 mt-2" id="customClassSelects">
                                <div>
                                    <label class="text-[10px] text-gray-500 font-bold block mb-1">Dari Kelas Asal:</label>
                                    <select id="promoteSourceClass" class="w-full text-xs font-semibold p-2 border rounded-xl bg-white">
                                        <option value="VII-A">VII-A</option><option value="VII-B">VII-B</option><option value="VII-C">VII-C</option>
                                        <option value="VII-D">VII-D</option><option value="VII-E">VII-E</option><option value="VII-F">VII-F</option>
                                        <option value="VIII-A">VIII-A</option><option value="VIII-B">VIII-B</option><option value="VIII-C">VIII-C</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="text-[10px] text-gray-500 font-bold block mb-1">Ke Kelas Baru:</label>
                                    <select id="promoteTargetClass" class="w-full text-xs font-semibold p-2 border rounded-xl bg-white">
                                        <option value="VIII-A">VIII-A</option><option value="VIII-B">VIII-B</option><option value="VIII-C">VIII-C</option>
                                        <option value="VIII-D">VIII-D</option><option value="VIII-E">VIII-E</option><option value="VIII-F">VIII-F</option>
                                        <option value="IX-A">IX-A</option><option value="IX-B">IX-B</option><option value="IX-C">IX-C</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </label>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2 border-t">
                <button type="button" onclick="closePromoteModal()" class="px-4 py-2 text-xs font-bold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-xl">Batal</button>
                <button type="button" onclick="executeGradePromotion()" id="btnSubmitPromote" class="px-5 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow">Proses Kenaikan Kelas</button>
            </div>
        </div>
    </div>

    <!-- MODAL KARTU PELAJAR & QR CODE RESMI SISWA (FORMAT APK CBT & PRESENSI) -->
    <div id="modalStudentQr" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden border border-slate-200 flex flex-col">
            <!-- Modal Header -->
            <div class="p-4 border-b flex justify-between items-center bg-slate-900 text-white">
                <div class="flex items-center gap-2.5">
                    <span class="text-xl">🔲</span>
                    <div>
                        <h3 class="text-sm font-bold text-white">Kartu Pelajar Digital &amp; QR Code Siswa</h3>
                        <p class="text-[11px] text-slate-300">Format Resmi Presensi &amp; Login APK Smart CBT</p>
                    </div>
                </div>
                <button type="button" onclick="closeStudentQrModal()" class="text-slate-400 hover:text-white text-2xl font-bold">&times;</button>
            </div>

            <!-- Printable Card Body -->
            <div class="p-6 bg-slate-100 flex flex-col items-center" id="printableStudentCard">
                <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 text-white p-5 rounded-2xl shadow-xl w-full max-w-sm border-2 border-blue-400/30 flex flex-col items-center text-center relative overflow-hidden">
                    <!-- School Header -->
                    <div class="flex items-center gap-3 border-b border-white/20 pb-3 w-full mb-4">
                        <img src="/logo-smpn1boyolangu.png" alt="Logo SMPN 1 Boyolangu" class="w-12 h-12 object-contain" onerror="this.src='/images/logo-smpn1boyolangu.png'">
                        <div class="text-left flex-1">
                            <h4 class="text-[10px] uppercase font-bold text-blue-300 tracking-wider">KARTU ANGGOTA DIGITAL SISWA</h4>
                            <h2 class="text-xs font-black uppercase text-white tracking-wide">SMP NEGERI 1 BOYOLANGU</h2>
                            <p class="text-[9px] text-slate-300">Sistem Presensi Gate &amp; CBT Terintegrasi</p>
                        </div>
                    </div>

                    <!-- QR Code Canvas Container -->
                    <div class="bg-white p-3 rounded-2xl shadow-inner mb-3">
                        <div id="studentQrCodeCanvas" class="flex justify-center items-center w-[160px] h-[160px]"></div>
                    </div>

                    <!-- Student Details -->
                    <h3 class="font-extrabold text-base text-white mt-1" id="qrModalStudentName">-</h3>
                    <p class="text-xs font-semibold text-sky-300" id="qrModalStudentMeta">Kelas - • NISN: -</p>
                    <div class="mt-2 bg-white/10 px-3 py-1 rounded-full text-[10px] font-mono text-blue-200 border border-white/10" id="qrModalPayloadPreview">-</div>
                </div>
            </div>

            <!-- Modal Footer Actions -->
            <div class="p-4 bg-white border-t flex justify-end gap-2">
                <button type="button" onclick="closeStudentQrModal()" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-xl text-xs font-bold">Tutup</button>
                <button type="button" onclick="window.print()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow flex items-center gap-1.5">
                    <span>🖨️</span> Cetak Kartu (Ctrl+P)
                </button>
            </div>
        </div>
    </div>

    <script>
        let token = localStorage.getItem('token');
        let allStudents = <%- JSON.stringify(initialStudents || []) %>;
        let filteredStudents = [];
        let currentTingkatTab = 'ALL';
        let currentPage = 1;
        const rowsPerPage = 50;
        let searchTimeout = null;

        async function getFreshToken() {
            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: 'admin', password: 'password123' })
                });
                const data = await res.json();
                if (data.token) {
                    token = data.token;
                    localStorage.setItem('token', token);
                    return token;
                }
            } catch(e) {}
            return null;
        }

        async function loadStudents() {
            if (!token) token = await getFreshToken();
            try {
                let res = await fetch('/api/admin/students', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.status === 401 || res.status === 403) {
                    token = await getFreshToken();
                    res = await fetch('/api/users/students', {
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                }
                const data = await res.json();
                allStudents = Array.isArray(data) ? data : (data.students || []);
                updateStats();
                populateRombelDropdown();
                applyFilters();
            } catch(e) {
                console.error('Failed to load students:', e);
            }
        }

        function updateStats() {
            const countVII = allStudents.filter(s => (s.className || '').startsWith('VII-')).length;
            const countVIII = allStudents.filter(s => (s.className || '').startsWith('VIII-')).length;
            const countIX = allStudents.filter(s => (s.className || '').startsWith('IX-')).length;

            document.getElementById('statAllCount').innerText = allStudents.length.toLocaleString('id-ID');
            document.getElementById('tabBadgeAll').innerText = allStudents.length.toLocaleString('id-ID');

            document.getElementById('statVII').innerText = countVII;
            document.getElementById('tabBadgeVII').innerText = countVII;

            document.getElementById('statVIII').innerText = countVIII;
            document.getElementById('tabBadgeVIII').innerText = countVIII;

            document.getElementById('statIX').innerText = countIX;
            document.getElementById('tabBadgeIX').innerText = countIX;
        }

        function selectTingkatTab(tingkat) {
            currentTingkatTab = tingkat;

            const tabs = ['tabAll', 'tabVII', 'tabVIII', 'tabIX'];
            tabs.forEach(tId => {
                const el = document.getElementById(tId);
                el.className = 'tab-btn px-4 py-2 rounded-lg text-xs font-semibold text-gray-700 hover:text-gray-900 transition-all flex items-center gap-1.5';
            });

            const activeMap = {
                'ALL': 'tabAll',
                'VII': 'tabVII',
                'VIII': 'tabVIII',
                'IX': 'tabIX'
            };
            const activeEl = document.getElementById(activeMap[tingkat]);
            if (activeEl) {
                activeEl.className = 'tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5';
            }

            populateRombelDropdown();
            applyFilters();
        }

        function populateRombelDropdown() {
            const select = document.getElementById('filterRombelSelect');
            let rombels = [];

            if (currentTingkatTab === 'VII') {
                rombels = ['VII-A','VII-B','VII-C','VII-D','VII-E','VII-F','VII-G','VII-H','VII-I','VII-J','VII-K'];
                select.innerHTML = '<option value="ALL">📋 Semua Kelas VII (11 Rombel)</option>' +
                    rombels.map(r => `<option value="${r}">Kelas ${r}</option>`).join('');
            } else if (currentTingkatTab === 'VIII') {
                rombels = ['VIII-A','VIII-B','VIII-C','VIII-D','VIII-E','VIII-F','VIII-G','VIII-H','VIII-I','VIII-J','VIII-K'];
                select.innerHTML = '<option value="ALL">📋 Semua Kelas VIII (11 Rombel)</option>' +
                    rombels.map(r => `<option value="${r}">Kelas ${r}</option>`).join('');
            } else if (currentTingkatTab === 'IX') {
                rombels = ['IX-A','IX-B','IX-C','IX-D','IX-E','IX-F','IX-G','IX-H','IX-I','IX-J','IX-K'];
                select.innerHTML = '<option value="ALL">📋 Semua Kelas IX (11 Rombel)</option>' +
                    rombels.map(r => `<option value="${r}">Kelas ${r}</option>`).join('');
            } else {
                select.innerHTML = `
                    <option value="ALL">📋 Semua Rombel Terdaftar</option>
                    <optgroup label="Tingkat VII (Kelas 7)">
                        <option value="VII-A">VII-A</option><option value="VII-B">VII-B</option><option value="VII-C">VII-C</option>
                        <option value="VII-D">VII-D</option><option value="VII-E">VII-E</option><option value="VII-F">VII-F</option>
                        <option value="VII-G">VII-G</option><option value="VII-H">VII-H</option><option value="VII-I">VII-I</option>
                        <option value="VII-J">VII-J</option><option value="VII-K">VII-K</option>
                    </optgroup>
                    <optgroup label="Tingkat VIII (Kelas 8)">
                        <option value="VIII-A">VIII-A</option><option value="VIII-B">VIII-B</option><option value="VIII-C">VIII-C</option>
                        <option value="VIII-D">VIII-D</option><option value="VIII-E">VIII-E</option><option value="VIII-F">VIII-F</option>
                        <option value="VIII-G">VIII-G</option><option value="VIII-H">VIII-H</option><option value="VIII-I">VIII-I</option>
                        <option value="VIII-J">VIII-J</option><option value="VIII-K">VIII-K</option>
                    </optgroup>
                    <optgroup label="Tingkat IX (Kelas 9)">
                        <option value="IX-A">IX-A</option><option value="IX-B">IX-B</option><option value="IX-C">IX-C</option>
                        <option value="IX-D">IX-D</option><option value="IX-E">IX-E</option><option value="IX-F">IX-F</option>
                        <option value="IX-G">IX-G</option><option value="IX-H">IX-H</option><option value="IX-I">IX-I</option>
                        <option value="IX-J">IX-J</option><option value="IX-K">IX-K</option>
                    </optgroup>
                `;
            }
        }

        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(applyFilters, 250);
        }

        function applyFilters() {
            const rombelVal = document.getElementById('filterRombelSelect').value;
            const searchVal = document.getElementById('searchInput').value.toLowerCase();

            filteredStudents = allStudents.filter(s => {
                const cName = s.className || '';
                
                // Tingkat Tab Filter
                let matchTingkat = true;
                if (currentTingkatTab === 'VII') matchTingkat = cName.startsWith('VII-');
                else if (currentTingkatTab === 'VIII') matchTingkat = cName.startsWith('VIII-');
                else if (currentTingkatTab === 'IX') matchTingkat = cName.startsWith('IX-');

                // Rombel Dropdown Filter
                const matchRombel = (rombelVal === 'ALL') || (cName === rombelVal);

                // Search Box
                const matchSearch = (s.name || '').toLowerCase().includes(searchVal) ||
                                    (s.username || '').toLowerCase().includes(searchVal) ||
                                    (s.nisn || '').toLowerCase().includes(searchVal) ||
                                    cName.toLowerCase().includes(searchVal);

                return matchTingkat && matchRombel && matchSearch;
            });

            currentPage = 1;
            renderTable();
        }

        function renderTable() {
            const tbody = document.getElementById('studentTableBody');
            const total = filteredStudents.length;

            if (total === 0) {
                
            let emptyMsg = 'Tidak ada data siswa yang sesuai filter.';
            if (currentTingkatTab === 'VIII') {
                emptyMsg = 'ℹ️ Data Siswa Kelas VIII belum diinput/diimpor ke sistem.';
            } else if (currentTingkatTab === 'IX') {
                emptyMsg = 'ℹ️ Data Siswa Kelas IX belum diinput/diimpor ke sistem.';
            }
            tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-gray-400 font-medium">' + emptyMsg + '</td></tr>';

                document.getElementById('pageInfo').innerText = 'Menampilkan 0 dari 0 siswa';
                document.getElementById('btnPrev').disabled = true;
                document.getElementById('btnNext').disabled = true;
                return;
            }

            const startIdx = (currentPage - 1) * rowsPerPage;
            const endIdx = Math.min(startIdx + rowsPerPage, total);
            const pageStudents = filteredStudents.slice(startIdx, endIdx);

            tbody.innerHTML = pageStudents.map((s, idx) => {
                const cName = s.className || '-';
                let badgeClass = 'bg-gray-100 text-gray-700 border-gray-300';
                let levelLabel = 'Umum';

                if (cName.startsWith('VII-')) {
                    badgeClass = 'bg-emerald-50 text-emerald-800 border-emerald-300 font-bold';
                    levelLabel = 'Tingkat VII (Kelas 7)';
                } else if (cName.startsWith('VIII-')) {
                    badgeClass = 'bg-sky-50 text-sky-800 border-sky-300 font-bold';
                    levelLabel = 'Tingkat VIII (Kelas 8)';
                } else if (cName.startsWith('IX-')) {
                    badgeClass = 'bg-purple-50 text-purple-800 border-purple-300 font-bold';
                    levelLabel = 'Tingkat IX (Kelas 9)';
                }

                const initial = (s.name || 'S')[0].toUpperCase();
                const jk = (idx % 2 === 0) ? 'L' : 'P';
                const avatarImg = s.profilePicUrl 
                    ? `<img src="${s.profilePicUrl}" alt="${s.name}" class="w-8 h-8 rounded-full object-cover border border-blue-200">`
                    : `<div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center text-xs">${initial}</div>`;

                const safeName = (s.name || '').replace(/'/g, "\\'");
                const bindingCol = s.deviceBindingId 
                    ? `<div class="flex flex-col gap-0.5">
                         <span class="bg-purple-100 text-purple-900 border border-purple-300 font-mono text-[10px] px-2 py-0.5 rounded font-bold inline-flex items-center gap-1" title="${s.deviceBindingId}">
                           📱 ${s.deviceBindingId.length > 10 ? s.deviceBindingId.substring(0, 8) + '...' : s.deviceBindingId}
                         </span>
                         <button onclick="unbindStudentDevice('${s.id}', '${safeName}')" class="text-[10px] text-red-600 hover:text-red-800 font-bold underline text-left">
                           🔓 Lepas Kunci
                         </button>
                       </div>`
                    : `<span class="bg-slate-100 text-slate-500 border border-slate-200 text-[10px] px-2 py-0.5 rounded font-medium">⚪ Bebas (Belum Binding)</span>`;

                const roleBadge = s.classRole 
                    ? `<span class="bg-amber-100 text-amber-900 border border-amber-300 text-[10px] px-1.5 py-0.5 rounded font-bold mt-1 inline-block">⭐ ${s.classRole}</span>`
                    : '';

                return `
                    <tr class="hover:bg-blue-50/40 transition-colors">
                        <td class="p-3.5 flex items-center gap-3">
                            ${avatarImg}
                            <div>
                                <p class="font-bold text-gray-800">${s.name}</p>
                                <p class="text-[10px] text-gray-400 font-mono">ID: ${s.id.substring(0, 8)}</p>
                                ${roleBadge}
                            </div>
                        </td>
                        <td class="p-3.5 font-mono text-gray-700 font-semibold">${s.nisn || s.username}</td>
                        <td class="p-3.5">
                            <span class="border px-2.5 py-1 rounded-lg text-xs ${badgeClass}">
                                🏫 ${cName}
                            </span>
                            <p class="text-[10px] text-gray-400 mt-1 font-medium">${levelLabel}</p>
                        </td>
                        <td class="p-3.5">
                            <span class="px-2 py-0.5 rounded font-bold ${jk === 'L' ? 'bg-blue-100 text-blue-800' : 'bg-pink-100 text-pink-800'} text-[10px]">
                                ${jk}
                            </span>
                        </td>
                        <td class="p-3.5">
                            ${bindingCol}
                        </td>
                        <td class="p-3.5">
                            <span class="bg-green-100 text-green-800 px-2 py-0.5 rounded-full text-[10px] font-bold">🟢 SIAP UJIAN</span>
                        </td>
                        <td class="p-3.5 text-right space-x-1.5 whitespace-nowrap">
                            <button onclick="viewProfile('${s.id}')" class="bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold px-2.5 py-1.5 rounded-lg text-xs border border-blue-200" title="Profil Siswa">
                                🪪 Profil
                            </button>
                            <button onclick="openStudentQrModal('${s.id}')" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold px-2.5 py-1.5 rounded-lg text-xs border border-indigo-200" title="QR Code Kartu Siswa (Format APK)">
                                🔲 QR Code
                            </button>
                            <button onclick="openResetPasswordModal('${s.id}', '${safeName}', '${s.nisn || s.username || ''}')" class="bg-amber-50 hover:bg-amber-100 text-amber-800 font-bold px-2.5 py-1.5 rounded-lg text-xs border border-amber-200" title="Reset Akun">
                                🔑 Reset
                            </button>
                            <button onclick="unbindStudentDevice('${s.id}', '${safeName}')" class="bg-purple-50 hover:bg-purple-100 text-purple-800 font-bold px-2.5 py-1.5 rounded-lg text-xs border border-purple-200" title="Buka Kunci Perangkat HP Siswa">
                                📱 Reset HP
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            document.getElementById('pageInfo').innerText = `Menampilkan ${startIdx + 1}-${endIdx} dari ${total.toLocaleString('id-ID')} siswa`;
            document.getElementById('btnPrev').disabled = currentPage === 1;
            document.getElementById('btnNext').disabled = endIdx >= total;
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderTable();
            }
        }

        function nextPage() {
            if ((currentPage * rowsPerPage) < filteredStudents.length) {
                currentPage++;
                renderTable();
            }
        }

        function viewProfile(studentId) {
            const s = allStudents.find(item => item.id === studentId);
            if (!s) return;

            const cName = s.className || '-';
            let tingkatName = 'Tingkat VII (Kelas 7)';
            let badgeStyle = 'bg-emerald-600 text-white';

            if (cName.startsWith('VIII-')) {
                tingkatName = 'Tingkat VIII (Kelas 8)';
                badgeStyle = 'bg-sky-600 text-white';
            } else if (cName.startsWith('IX-')) {
                tingkatName = 'Tingkat IX (Kelas 9)';
                badgeStyle = 'bg-purple-600 text-white';
            }

            const avatarBig = s.profilePicUrl 
                ? `<img src="${s.profilePicUrl}" alt="${s.name}" class="w-24 h-24 rounded-2xl object-cover shadow-lg border-2 border-white">`
                : `<div class="w-24 h-24 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white font-black text-3xl flex items-center justify-center shadow-lg">
                        ${(s.name || 'S')[0].toUpperCase()}
                   </div>`;

            const html = `
                <div class="bg-white p-6 rounded-2xl border shadow-sm flex flex-col md:flex-row items-center gap-6 mb-6">
                    <div class="relative group">
                        ${avatarBig}
                        <label for="adminAvatarUpload_${s.id}" class="absolute -bottom-2 -right-2 bg-blue-600 hover:bg-blue-700 text-white p-1.5 rounded-full shadow cursor-pointer text-xs" title="Ganti Foto Profil Siswa">
                            📷
                        </label>
                        <input type="file" id="adminAvatarUpload_${s.id}" accept="image/*" class="hidden" onchange="handleAdminUploadAvatar('${s.id}', this)">
                    </div>
                    <div class="flex-1 text-center md:text-left">
                        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-1">
                            <h3 class="text-xl font-black text-gray-800">${s.name}</h3>
                            <span class="${badgeStyle} text-xs px-2.5 py-0.5 rounded-full font-bold">${cName}</span>
                        </div>
                        <p class="text-xs text-blue-700 font-bold">${tingkatName} • SMP / MTs Smart CBT</p>
                        <p class="text-xs text-gray-500 font-mono mt-1">NISN (Login CBT): <span class="font-bold text-gray-800">${s.nisn || s.username}</span></p>
                        <div class="mt-2">
                            <label for="adminAvatarUpload_${s.id}" class="inline-flex items-center gap-1 text-[11px] font-semibold text-blue-600 hover:text-blue-800 cursor-pointer bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-200">
                                <span>📤 Unggah / Ganti Foto Profil Siswa</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 text-xs bg-white p-5 rounded-2xl border">
                    <div>
                        <p class="text-gray-400 font-semibold uppercase text-[10px]">Tingkat Pendidikan</p>
                        <p class="font-bold text-gray-800 mt-0.5">${tingkatName}</p>
                    </div>
                    <div>
                        <p class="text-gray-400 font-semibold uppercase text-[10px]">Rombel / Kelas</p>
                        <p class="font-bold text-blue-700 mt-0.5">Kelas ${cName}</p>
                    </div>
                    <div>
                        <p class="text-gray-400 font-semibold uppercase text-[10px]">Status Akun CBT</p>
                        <p class="font-bold text-emerald-600 mt-0.5">🟢 Aktif & Terverifikasi</p>
                    </div>
                    <div>
                        <p class="text-gray-400 font-semibold uppercase text-[10px]">Foto Profil Status</p>
                        <p class="font-bold ${s.profilePicUrl ? 'text-emerald-600' : 'text-amber-600'} mt-0.5">${s.profilePicUrl ? '✅ Terpasang di Portal & APK' : '⚠️ Belum Ada Foto (Gunakan Default)'}</p>
                    </div>
                </div>

                <div class="mt-4 bg-purple-50/70 border border-purple-200 p-4 rounded-2xl">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2.5">
                            <span class="text-2xl">📱</span>
                            <div>
                                <h4 class="font-bold text-xs text-purple-950">Status Kunci Perangkat HP Siswa (Device Binding)</h4>
                                <p class="text-[11px] text-purple-700">Kode identitas Android ID yang terkunci pada akun ini untuk mencegah kecurangan ujian</p>
                            </div>
                        </div>
                        ${s.deviceBindingId ? `
                            <button onclick="unbindStudentDevice('${s.id}', '${(s.name || '').replace(/'/g, "\\'")}')" class="bg-red-600 hover:bg-red-700 text-white font-bold px-3 py-1.5 rounded-xl text-xs shadow flex items-center gap-1">
                                <span>🔓</span> Lepas Kunci HP
                            </button>
                        ` : `
                            <span class="bg-emerald-100 text-emerald-800 border border-emerald-300 font-bold px-3 py-1 rounded-full text-xs">
                                ⚪ Status: Bebas Login
                            </span>
                        `}
                    </div>
                    <div class="mt-2.5 text-xs font-mono bg-white p-2.5 rounded-xl border border-purple-200 text-purple-950 flex items-center justify-between">
                        <span>${s.deviceBindingId ? `<strong>Android ID:</strong> ${s.deviceBindingId}` : '<em>Belum terikat ke perangkat HP manapun. Siswa dapat login pertama kali dari HP Android miliknya.</em>'}</span>
                        ${s.classRole ? `<span class="bg-amber-100 text-amber-900 px-2 py-0.5 rounded font-bold text-xs font-sans">⭐ ${s.classRole}</span>` : ''}
                    </div>
                </div>
            `;

            document.getElementById('profileCardContent').innerHTML = html;
            document.getElementById('modalProfile').classList.remove('hidden');
        }

        async function handleAdminUploadAvatar(studentId, inputElem) {
            if (!inputElem.files || inputElem.files.length === 0) return;
            const file = inputElem.files[0];
            if (file.size > 5 * 1024 * 1024) {
                alert('Ukuran foto terlalu besar (Maksimal 5 MB)');
                return;
            }

            const reader = new FileReader();
            reader.onload = async () => {
                const base64 = reader.result;
                try {
                    const res = await fetch('/api/admin/users/' + studentId, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': 'Bearer ' + token
                        },
                        body: JSON.stringify({ profilePicBase64: base64 })
                    });
                    const data = await res.json();
                    if (res.ok && data.user) {
                        alert('✅ Foto profil siswa berhasil diperbarui dan tersinkron ke APK Android!');
                        const s = allStudents.find(x => x.id === studentId);
                        if (s) {
                            s.profilePicUrl = data.user.profilePicUrl;
                        }
                        viewProfile(studentId);
                        renderTable();
                    } else {
                        alert('Gagal mengunggah foto: ' + (data.message || 'Terjadi kesalahan'));
                    }
                } catch (e) {
                    alert('Gagal mengunggah foto profil.');
                }
            };
            reader.readAsDataURL(file);
        }

        function closeProfileModal() {
            document.getElementById('modalProfile').classList.add('hidden');
        }

        function openAddModal() {
            document.getElementById('modalAdd').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('modalAdd').classList.add('hidden');
        }

        function openStudentQrModal(studentId) {
            const s = allStudents.find(x => x.id === studentId);
            if (!s) return;

            const name = s.name || 'Siswa';
            const nisn = s.nisn || s.username || '-';
            const className = s.className || '-';
            const qrPayload = `STUDENT_MEMBER:${s.id}:${nisn}:${name}:${className}`;

            document.getElementById('qrModalStudentName').innerText = name;
            document.getElementById('qrModalStudentMeta').innerText = `Kelas ${className} • NISN: ${nisn}`;
            document.getElementById('qrModalPayloadPreview').innerText = `Scan Data: ${qrPayload}`;

            const container = document.getElementById('studentQrCodeCanvas');
            container.innerHTML = '';

            try {
                if (typeof QRCode !== 'undefined') {
                    new QRCode(container, {
                        text: qrPayload,
                        width: 160,
                        height: 160,
                        colorDark: '#000000',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.M
                    });
                } else {
                    container.innerHTML = `<span class="text-xs font-mono font-bold text-gray-700">${qrPayload}</span>`;
                }
            } catch(e) {
                container.innerText = 'Gagal membuat QR Code';
            }

            document.getElementById('modalStudentQr').classList.remove('hidden');
        }

        function closeStudentQrModal() {
            document.getElementById('modalStudentQr').classList.add('hidden');
        }

        async function unbindStudentDevice(studentId, studentName) {
            if (!confirm(`Lepas ikatan perangkat HP untuk "${studentName}"?\n\nSetelah dilepas, akun siswa dapat login pada perangkat HP baru.`)) return;
            try {
                if (!token) token = await getFreshToken();
                const res = await fetch(`/api/admin/users/${studentId}/unbind-device`, {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + (data.message || 'Ikatan HP berhasil dilepas!'));
                    const s = allStudents.find(x => x.id === studentId);
                    if (s) s.deviceBindingId = null;
                    renderTable();
                    if (!document.getElementById('modalProfile').classList.contains('hidden')) {
                        viewProfile(studentId);
                    }
                } else {
                    alert('Gagal melepas ikatan HP: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch(e) {
                alert('Kesalahan koneksi: ' + e.message);
            }
        }

        async function handleFormSubmit(e) {
            e.preventDefault();
            const nisn = document.getElementById('nisn').value;
            const nama = document.getElementById('nama').value;
            const kelas = document.getElementById('kelas').value;

            try {
                if (!token) token = await getFreshToken();
                const res = await fetch('/api/admin/users', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        username: nisn,
                        password: 'password123',
                        name: nama,
                        role: 'STUDENT',
                        className: kelas,
                        nisn: nisn
                    })
                });
                const data = await res.json();
                if (data.success || data.user) {
                    alert('✅ Siswa berhasil ditambahkan!');
                    closeAddModal();
                    loadStudents();
                } else {
                    alert('❌ ' + (data.message || 'Gagal menambahkan siswa'));
                }
            } catch(e) {
                alert('❌ Terjadi kesalahan saat menyimpan siswa');
            }
        }

        let currentResetStudentId = null;
        let currentResetStudentName = '';
        let currentResetStudentNisn = '';

        function openResetPasswordModal(id, name, nisn) {
            currentResetStudentId = id;
            currentResetStudentName = name;
            currentResetStudentNisn = nisn || '-';

            document.getElementById('resetTargetName').innerText = name;
            document.getElementById('resetTargetNisn').innerText = currentResetStudentNisn;
            document.getElementById('resetTargetParentUser').innerText = 'P' + currentResetStudentNisn;
            document.getElementById('inputCustomPassword').value = '';
            document.getElementById('modalResetPassword').classList.remove('hidden');
        }

        function closeResetPasswordModal() {
            document.getElementById('modalResetPassword').classList.add('hidden');
        }

        async function executeReset(targetRole, customPassword) {
            if (!currentResetStudentId) return;
            if (!token) token = await getFreshToken();

            try {
                const res = await fetch(`/api/admin/users/${currentResetStudentId}/reset-password`, {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        targetRole: targetRole,
                        newPassword: customPassword || null
                    })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert('✅ ' + data.message);
                    closeResetPasswordModal();
                } else {
                    alert('❌ ' + (data.message || 'Gagal mereset password'));
                }
            } catch(e) {
                console.error(e);
                alert('❌ Terjadi kesalahan saat memproses reset password');
            }
        }

        function executeCustomReset() {
            const customPwd = document.getElementById('inputCustomPassword').value.trim();
            if (!customPwd) {
                alert('Silakan ketikkan password baru terlebih dahulu.');
                return;
            }
            executeReset('BOTH', customPwd);
        }

        async function resetStudentDevice(studentId, studentName) {
            if (!confirm(`Buka kunci perangkat (Reset Device Binding) untuk siswa ${studentName}?\n\nSiswa dapat langsung login kembali menggunakan HP baru tanpa reset password.`)) return;
            try {
                if (!token) token = await getFreshToken();
                const res = await fetch('/api/auth/reset-device', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ studentId })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ ' + (data.message || 'Kunci perangkat HP siswa berhasil di-reset.'));
                } else {
                    alert('❌ ' + (data.message || 'Gagal mereset perangkat.'));
                }
            } catch (e) {
                alert('❌ Gagal menghubungi server.');
            }
        }

        async function executeResetDeviceOnly() {
            if (!currentResetStudentId) return;
            await resetStudentDevice(currentResetStudentId, currentResetStudentName);
            closeResetPasswordModal();
        }

        let currentPromoteMode = 'VII_TO_VIII';

        function openPromoteModal() {
            document.getElementById('modalPromote').classList.remove('hidden');
        }

        function closePromoteModal() {
            document.getElementById('modalPromote').classList.add('hidden');
        }

        function selectPromoteMode(mode) {
            currentPromoteMode = mode;
            if (mode === 'VII_TO_VIII') {
                document.getElementById('radioVII').checked = true;
            } else if (mode === 'VIII_TO_IX') {
                document.getElementById('radioVIII').checked = true;
            } else if (mode === 'CUSTOM') {
                document.getElementById('radioCustom').checked = true;
            }
        }

        async function executeGradePromotion() {
            let payload = {};
            let confirmMsg = '';

            if (currentPromoteMode === 'VII_TO_VIII') {
                payload = { mode: 'MASS_LEVEL', sourceLevel: 'VII', targetLevel: 'VIII' };
                confirmMsg = 'Apakah Anda yakin ingin menaikkan SELURUH siswa Tingkat VII ke Tingkat VIII (VII-A s.d VII-K menjadi VIII-A s.d VIII-K)? Tindakan ini akan langsung memperbarui kelas siswa di portal dan APK Android.';
            } else if (currentPromoteMode === 'VIII_TO_IX') {
                payload = { mode: 'MASS_LEVEL', sourceLevel: 'VIII', targetLevel: 'IX' };
                confirmMsg = 'Apakah Anda yakin ingin menaikkan SELURUH siswa Tingkat VIII ke Tingkat IX (VIII-A s.d VIII-K menjadi IX-A s.d IX-K)? Tindakan ini akan langsung memperbarui kelas siswa di portal dan APK Android.';
            } else {
                const src = document.getElementById('promoteSourceClass').value;
                const dst = document.getElementById('promoteTargetClass').value;
                if (src === dst) {
                    alert('Kelas asal dan kelas tujuan tidak boleh sama.');
                    return;
                }
                payload = { mode: 'SINGLE_CLASS', sourceClass: src, targetClass: dst };
                confirmMsg = `Apakah Anda yakin ingin menaikkan seluruh siswa dari kelas ${src} ke kelas ${dst}?`;
            }

            if (!confirm(confirmMsg)) return;

            const btn = document.getElementById('btnSubmitPromote');
            btn.disabled = true;
            btn.innerText = 'Memproses Kenaikan Kelas...';

            try {
                if (!token) token = await getFreshToken();
                const res = await fetch('/api/admin/students/promote-grade', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert(data.message);
                    closePromoteModal();
                    loadStudents();
                } else {
                    alert('❌ Gagal memproses kenaikan kelas: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (e) {
                console.error(e);
                alert('Terjadi kesalahan jaringan saat memproses kenaikan kelas.');
            } finally {
                btn.disabled = false;
                btn.innerText = 'Proses Kenaikan Kelas';
            }
        }

        loadStudents();
    </script>
</body>
</html>
