        function closeImageLightbox() {
            const modal = document.getElementById('modalImageLightbox');
            if(modal) modal.classList.add('hidden');
        }

        // ==================== GURU BK & PEMETAAN KELAS ====================
        let allBkCounselors = [];
        let allBkClasses = [];
        let allAvailableTeachers = [];

        async function loadBkCounselorsManagement() {
            const container = document.getElementById('counselorCardsContainer');
            if (container) {
                container.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-400 text-xs">
                        <div class="animate-spin inline-block w-6 h-6 border-2 border-teal-600 border-t-transparent rounded-full mb-2"></div>
                        <p>Memuat data Guru BK & pemetaan rombel...</p>
                    </div>`;
            }

            try {
                const res = await authFetch('/api/bk/counselors');
                const data = await res.json();
                if (data.success) {
                    allBkCounselors = data.counselors || [];
                    allBkClasses = data.allClasses || [];
                    allAvailableTeachers = data.availableTeachers || [];
                    renderCounselorCards();
                    renderClassBkTable();
                    renderTagTeacherList();
                } else {
                    if (container) container.innerHTML = `<div class="col-span-full p-4 bg-red-50 text-red-700 rounded-xl text-xs">${data.message || 'Gagal memuat data Guru BK'}</div>`;
                }
            } catch (err) {
                console.error('Error loading BK counselors:', err);
                if (container) container.innerHTML = `<div class="col-span-full p-4 bg-red-50 text-red-700 rounded-xl text-xs">Terjadi kesalahan koneksi saat memuat data Guru BK.</div>`;
            }
        }

        function updateCounselorSummaryMetrics() {
            const totalCounselors = allBkCounselors.length;
            const totalClasses = allBkClasses.length;
            const assignedClassesCount = allBkClasses.filter(c => c.counselorName).length;
            const unassignedClassesCount = Math.max(0, totalClasses - assignedClassesCount);

            const elC = document.getElementById('statBkCounselorCount');
            const elT = document.getElementById('statBkTotalClasses');
            const elA = document.getElementById('statBkAssignedClasses');
            const elU = document.getElementById('statBkUnassignedClasses');
            const elSub = document.getElementById('counselorCardSubtext');

            if (elC) elC.innerText = totalCounselors;
            if (elT) elT.innerText = totalClasses;
            if (elA) elA.innerText = assignedClassesCount;
            if (elU) elU.innerText = unassignedClassesCount;
            if (elSub) elSub.innerText = `${totalCounselors} Guru BK Aktif • ${assignedClassesCount} dari ${totalClasses} Kelas Terpetakan`;
        }

