                if(token) headers['Authorization'] = 'Bearer ' + token;

                const res = await fetch('/api/attendance/class-barcodes', { headers });
                
                if(!res.ok) {
                    const errData = await res.json().catch(() => ({}));
                    alert('Gagal memuat barcode kelas: ' + (errData.message || res.statusText));
                    return;
                }

                allClassBarcodes = await res.json();
