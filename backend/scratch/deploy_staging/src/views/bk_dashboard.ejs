                                </span>
                            </div>

                            <div class="grid grid-cols-2 gap-2 my-3 text-center">
                                <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                                    <span class="text-[10px] text-slate-400 block font-semibold">Total Kelas</span>
                                    <span class="font-extrabold text-sm text-slate-800">${c.totalClasses || assignedList.length} Kelas</span>
