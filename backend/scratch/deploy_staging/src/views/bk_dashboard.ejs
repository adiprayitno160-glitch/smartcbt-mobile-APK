    <!-- Core Script -->
    <script>
        let token = localStorage.getItem('token');
        if (!token) {
            const urlParams = new URLSearchParams(window.location.search);
            const qToken = urlParams.get('token');
            if (qToken) {
                token = qToken;
                localStorage.setItem('token', qToken);
                document.cookie = "token=" + encodeURIComponent(qToken) + "; path=/; max-age=86400";
            }
        }
        if(!token) window.location.href = '/';

        async function authFetch(url, options = {}) {
            options.headers = options.headers || {};
            let curToken = localStorage.getItem('token');
            if (curToken) options.headers['Authorization'] = 'Bearer ' + curToken;
            let res = await fetch(url, options);
            if (res.status === 401) {
                const rf = localStorage.getItem('refreshToken');
                if (rf) {
                    try {
                        const rRes = await fetch('/api/auth/refresh', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ refreshToken: rf })
                        });
                        const rData = await rRes.json();
                        if (rData.success && rData.token) {
                            localStorage.setItem('token', rData.token);
                            token = rData.token;
                            options.headers['Authorization'] = 'Bearer ' + token;
                            return await fetch(url, options);
                        }
                    } catch(e) {}
                }
            }
            return res;
        }

        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            document.getElementById('profileName').innerText = payload.name || 'Guru BK & UKS';
            if(payload.name) {
                const initials = payload.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
                document.getElementById('profileInitial').innerText = initials;
            }
        } catch(e) {}

        let currentSettings = {};
        let allStudents = [];
        let allAttendanceRecords = [];
        let filteredAttRecords = [];
        let attCurrentPage = 1;
        const attPageSize = 50;

        let allConsultations = [];
        let allParentConsultations = [];
        let allDisciplineRecords = [];
        let allLeaveRequestsBK = [];
        let allClassBarcodes = [];

        const elAttFilterDate = document.getElementById('attFilterDate');
        if (elAttFilterDate) elAttFilterDate.value = new Date().toISOString().split('T')[0];

        // Chart instances
        let chartAttendanceTrend = null;
        let chartCounselingPie = null;
        let chartClassAttendance = null;

        // Inisialisasi awal aman
        window.addEventListener('DOMContentLoaded', () => {
            try {
                loadGateSettings();
                loadClassList();
                loadAllStudents();
                loadInlineClassBarcodes();
            } catch(e) {
                console.error('Error during init loaders:', e);
            }

            try {
                const urlParams = new URLSearchParams(window.location.search);
                const tabFromUrl = urlParams.get('tab') || window.location.hash.replace('#', '') || localStorage.getItem('activeBkTab');
                localStorage.removeItem('activeBkTab');
                if (tabFromUrl && ['dashboard', 'gate', 'absensi', 'uks', 'konseling', 'chat-ortu', 'izin', 'kedisiplinan', 'guru-bk'].includes(tabFromUrl)) {
                    switchTab(tabFromUrl);
                } else {
                    switchTab('dashboard');
                }
            } catch(e) {
                console.error('Error initial tab switch:', e);
            }
        });

        // Fallback jika DOMContentLoaded sudah lewat
        setTimeout(() => {
            const activeSection = document.querySelector('main > div:not(.hidden)');
            if (!activeSection) {
                switchTab('dashboard');
            }
        }, 300);

        function switchTab(tab) {
            try {
                document.querySelectorAll('.tab-nav').forEach(b => {
                    b.className = 'tab-nav w-full text-left px-3.5 py-2.5 rounded-xl hover:bg-slate-800 text-slate-200 hover:text-white transition-all text-[13.5px] flex items-center gap-2.5';
                });
                const activeBtn = document.getElementById('tabBtn-' + tab);
                if(activeBtn) {
                    activeBtn.className = 'tab-nav w-full text-left px-3.5 py-2.5 rounded-xl font-bold transition-all bg-teal-800 text-white shadow flex items-center gap-2.5';
                }

                // Sembunyikan semua section
                ['dashboard', 'gate', 'absensi', 'uks', 'konseling', 'chat-ortu', 'izin', 'kedisiplinan', 'guru-bk'].forEach(s => {
                    const el = document.getElementById('section-' + s);
                    if(el) el.classList.add('hidden');
                });

                // Tampilkan section aktif
                const targetSection = document.getElementById('section-' + tab);
                if(targetSection) targetSection.classList.remove('hidden');

                // Header titles
                const titles = {
                    'dashboard': { title: '<span>📊</span> Dashboard &amp; Analitik BK', sub: 'Monitoring kehadiran real-time, tren kedisiplinan, kasus konseling, dan early warning SP' },
                    'gate': { title: '<span>🚪</span> Kontrol Gate Presensi Kelas &amp; Barcode Statis', sub: 'Pengaturan Jam Masuk/Pulang Otomatis, Pulang Lebih Awal & Cetak Barcode Ruang Kelas' },
                    'absensi': { title: '<span>📋</span> Rekapitulasi Presensi Kehadiran Siswa', sub: 'Monitoring kehadiran real-time kelas, sakit, izin, dan alpa' },
