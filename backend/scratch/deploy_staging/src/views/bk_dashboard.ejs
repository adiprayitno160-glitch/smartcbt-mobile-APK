        function filterManualStudentSelect() {
            const classFilter = document.getElementById('filterManualClass')?.value || 'ALL';
            const searchQuery = (document.getElementById('searchManualStudent')?.value || '').toLowerCase().trim();
            const manSel = document.getElementById('manualStudentSelect');
            if(!manSel || !Array.isArray(allStudents)) return;

            const filtered = allStudents.filter(s => {
                const matchesClass = (classFilter === 'ALL' || (s.className && s.className.toUpperCase() === classFilter.toUpperCase()));
                const nameStr = (s.name || '').toLowerCase();
                const nisnStr = (s.username || s.nisn || '').toLowerCase();
                const matchesSearch = !searchQuery || nameStr.includes(searchQuery) || nisnStr.includes(searchQuery);
                return matchesClass && matchesSearch;
            });

            manSel.innerHTML = '<option value="">-- Pilih Siswa (' + filtered.length + ' Ditemukan) --</option>';
            filtered.forEach(s => {
                manSel.innerHTML += `<option value="${s.id}">${s.name} (${s.className || '-'} - ${s.username || s.nisn || ''})</option>`;
            });

            const countEl = document.getElementById('manualStudentCount');
            if(countEl) {
                countEl.innerText = `${filtered.length} siswa ditemukan dari total ${allStudents.length} siswa`;
            }
        }

