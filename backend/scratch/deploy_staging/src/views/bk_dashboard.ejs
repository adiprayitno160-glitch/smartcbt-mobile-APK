        function renderClassBkTable() {
            updateCounselorSummaryMetrics();
            const tbody = document.getElementById('classBkMappingTableBody');
            if (!tbody) return;

            const filterGrade = document.getElementById('filterGradeMapping')?.value || 'ALL';
            const filterStatus = document.getElementById('filterStatusMapping')?.value || 'ALL';
            const searchQuery = (document.getElementById('searchClassBk')?.value || '').toLowerCase().trim();

            let list = [...allBkClasses];

            if (filterGrade !== 'ALL') {
                list = list.filter(cls => {
                    const name = cls.name.toUpperCase();
                    if (filterGrade === 'VII') return name.startsWith('VII') || name.startsWith('7');
                    if (filterGrade === 'VIII') return name.startsWith('VIII') || name.startsWith('8');
                    if (filterGrade === 'IX') return name.startsWith('IX') || name.startsWith('9');
                    return true;
                });
            }

            if (filterStatus === 'ASSIGNED') {
                list = list.filter(cls => !!cls.counselorName);
            } else if (filterStatus === 'UNASSIGNED') {
                list = list.filter(cls => !cls.counselorName);
            }

            if (searchQuery) {
                list = list.filter(cls => {
                    const cName = (cls.name || '').toLowerCase();
                    const gName = (cls.counselorName || '').toLowerCase();
                    return cName.includes(searchQuery) || gName.includes(searchQuery);
                });
            }

            const countText = document.getElementById('classBkTableCountText');
            if (countText) {
                countText.innerText = `Menampilkan ${list.length} dari ${allBkClasses.length} rombongan belajar kelas`;
            }

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-slate-400">Tidak ada rombel kelas yang cocok dengan filter atau pencarian.</td></tr>`;
                return;
            }

            tbody.innerHTML = list.map(cls => {
                let counselorBadge = '<span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">Belum Ditugaskan</span>';
                if (cls.counselorName) {
                    counselorBadge = `<span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-teal-50 text-teal-800 border border-teal-200">👩‍🏫 ${cls.counselorName}</span>`;
                }

                const lockBadge = cls.isGpsLocked
                    ? `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">🔒 Terkunci (${cls.radiusMeters || 10}m)</span>`
                    : `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">🔓 Terbuka (${cls.radiusMeters || 10}m)</span>`;

                let gradeLabel = '-';
                if (cls.name.toUpperCase().startsWith('VII') || cls.name.startsWith('7')) gradeLabel = 'Kelas 7 (VII)';
                else if (cls.name.toUpperCase().startsWith('VIII') || cls.name.startsWith('8')) gradeLabel = 'Kelas 8 (VIII)';
                else if (cls.name.toUpperCase().startsWith('IX') || cls.name.startsWith('9')) gradeLabel = 'Kelas 9 (IX)';

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-3.5 font-bold text-slate-800">Kelas ${cls.name}</td>
                        <td class="p-3.5 text-slate-600">${gradeLabel}</td>
                        <td class="p-3.5">${counselorBadge}</td>
                        <td class="p-3.5">${lockBadge}</td>
                        <td class="p-3.5 text-right">
                            <div class="flex items-center justify-end gap-2 flex-wrap">
                                ${cls.counselorName ? `
                                    <button onclick="unassignSingleClass('${cls.id}', '${cls.name}')" class="px-2.5 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-lg text-xs font-bold border border-rose-200 transition-all flex items-center gap-1 cursor-pointer" title="Hapus Guru BK dari Kelas ${cls.name}">
                                        <span>🗑️</span> Hapus Ampuan
                                    </button>
                                ` : ''}
                                <a href="/admin/kelas" class="inline-flex items-center gap-1 text-teal-700 hover:text-teal-900 font-bold hover:underline text-xs">
                                    ⚙️ Kelola Kelas &rarr;
                                </a>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function openAssignClassesModal(counselorId) {
            const counselor = allBkCounselors.find(c => c.id === counselorId);
            if (!counselor) return;

            document.getElementById('assignModalCounselorId').value = counselor.id;
            document.getElementById('assignModalCounselorName').innerText = counselor.name;

            const grid = document.getElementById('assignClassesChecklistGrid');
            if (!grid) return;

            const assignedSet = new Set(counselor.assignedClasses || []);

            grid.innerHTML = allBkClasses.map(cls => {
                const isChecked = assignedSet.has(cls.name);
                const isOther = cls.counselorName && cls.counselorName !== counselor.name;
                const otherNote = isOther ? `<span class="block text-[9px] text-amber-600 truncate">(diampu: ${cls.counselorName.split(' ')[0]})</span>` : '';

                return `
                    <label class="flex items-start gap-2 p-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 cursor-pointer text-xs font-semibold">
                        <input type="checkbox" name="assignedClassCheckbox" value="${cls.name}" ${isChecked ? 'checked' : ''} class="mt-0.5 rounded text-teal-600 focus:ring-teal-500">
                        <div class="leading-tight truncate">
                            <span class="text-slate-800 font-bold">Kelas ${cls.name}</span>
                            ${otherNote}
                        </div>
                    </label>
                `;
            }).join('');

            document.getElementById('modalAssignCounselorClasses').classList.remove('hidden');
        }

        function closeAssignClassesModal() {
            const modal = document.getElementById('modalAssignCounselorClasses');
            if (modal) modal.classList.add('hidden');
        }

        function toggleSelectGradeClasses(grade, checked) {
            const checkboxes = document.querySelectorAll('input[name="assignedClassCheckbox"]');
            checkboxes.forEach(cb => {
                const val = cb.value.toUpperCase();
                let matches = false;
                if (grade === 'VII' && (val.startsWith('VII') || val.startsWith('7'))) matches = true;
                if (grade === 'VIII' && (val.startsWith('VIII') || val.startsWith('8'))) matches = true;
                if (grade === 'IX' && (val.startsWith('IX') || val.startsWith('9'))) matches = true;

                if (matches) cb.checked = checked;
            });
        }

        function toggleSelectAllClasses(checked) {
            const checkboxes = document.querySelectorAll('input[name="assignedClassCheckbox"]');
            checkboxes.forEach(cb => cb.checked = checked);
        }

        async function saveAssignedClasses() {
            const counselorId = document.getElementById('assignModalCounselorId').value;
            const btn = document.getElementById('btnSaveAssignedClasses');
            if (!counselorId) return;

            const selectedCheckboxes = document.querySelectorAll('input[name="assignedClassCheckbox"]:checked');
            const classNames = Array.from(selectedCheckboxes).map(cb => cb.value);

            btn.disabled = true;
            btn.innerHTML = `<span>⏳</span> Menyimpan...`;

            try {
                const res = await authFetch('/api/bk/counselors/assign-classes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ counselorId, classNames })
                });

                const data = await res.json();
                if (data.success) {
                    alert('Berhasil menyimpan pembagian kelas Guru BK dan menyinkronkan data siswa!');
                    closeAssignClassesModal();
                    await loadBkCounselorsManagement();
                } else {
                    alert('Gagal: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                console.error('Error saving assigned classes:', err);
                alert('Gagal menyimpan pembagian kelas karena kesalahan server.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = `💾 Simpan Pembagian Kelas`;
            }
        }

        async function unassignSingleClass(classId, className) {
            if (!confirm(`Apakah Anda yakin ingin MENGHAPUS Guru BK untuk Kelas ${className}?\n\nKelas ini akan berstatus "Belum Ditentukan".`)) return;
            try {
                const res = await authFetch(`/api/kelas/${classId}/counselor`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ counselorId: null })
                });
                const data = await res.json();
                if (res.ok && data.success !== false) {
                    alert(`✅ Guru BK untuk Kelas ${className} berhasil dihapus/dikosongkan.`);
                    await loadBkCounselorsManagement();
                } else {
                    alert(data.message || 'Gagal menghapus ampuan kelas.');
                }
            } catch(err) {
                console.error(err);
                alert('Terjadi kesalahan koneksi saat menghapus ampuan kelas.');
            }
        }

        async function unassignAllClassesForCounselor(counselorId, counselorName) {
            if (!confirm(`Apakah Anda yakin ingin MENGHAPUS SEMUA kelas ampuan untuk ${counselorName}?\n\nSeluruh rombel yang dibina guru ini akan dikosongkan.`)) return;
            try {
                const res = await authFetch('/api/bk/counselors/assign-classes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ counselorId, classNames: [] })
                });
                const data = await res.json();
                if (data.success) {
                    alert(`✅ Seluruh ampuan kelas untuk ${counselorName} berhasil dihapus.`);
                    await loadBkCounselorsManagement();
                } else {
                    alert(data.message || 'Gagal menghapus ampuan kelas.');
                }
            } catch(err) {
                console.error(err);
                alert('Terjadi kesalahan koneksi saat menghapus ampuan kelas.');
            }
        }

        async function untagTeacherBk(teacherId, teacherName) {
            await toggleTagTeacherBK(teacherId, false, teacherName);
        }

