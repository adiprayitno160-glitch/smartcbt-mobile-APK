        async function loadLeaveRequestsBK() {
            const tbody = document.getElementById('tableLeaveRequestsBK');
            if(!tbody) return;
            tbody.innerHTML = '<tr><td colspan="8" class="p-6 text-center text-gray-400">Memuat data permohonan izin siswa dari server...</td></tr>';

            try {
                const res = await fetch('/api/teacher/leave-requests?className=ALL', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (res.status === 401 || res.status === 403) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="8" class="p-8 text-center text-amber-600 bg-amber-50 font-bold">
                                ⚠️ Sesi login telah berakhir atau Anda tidak memiliki akses. 
                                <button onclick="window.location.href='/'" class="ml-2 px-3 py-1 bg-amber-600 text-white rounded-lg text-xs font-bold shadow">
                                    Login Ulang
                                </button>
                            </td>
                        </tr>
                    `;
                    return;
                }

                const data = await res.json();
                if (!Array.isArray(data)) {
                    tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-rose-500 font-bold">Gagal memuat data: ${data.message || 'Format respon tidak sesuai'}</td></tr>`;
                    return;
                }

                allLeaveRequestsBK = data;

                // Hitung Statistik
                let pendingCount = 0;
                let approvedCount = 0;
                let rejectedCount = 0;
                allLeaveRequestsBK.forEach(r => {
                    const st = (r.status || '').toUpperCase();
                    if (st === 'PENDING') pendingCount++;
                    else if (st === 'APPROVED') approvedCount++;
                    else if (st === 'REJECTED') rejectedCount++;
                });

                const elPending = document.getElementById('statBkLeavePending');
                const elApproved = document.getElementById('statBkLeaveApproved');
                const elRejected = document.getElementById('statBkLeaveRejected');
                const elTotal = document.getElementById('statBkLeaveTotal');
                if (elPending) elPending.innerText = pendingCount;
                if (elApproved) elApproved.innerText = approvedCount;
                if (elRejected) elRejected.innerText = rejectedCount;
                if (elTotal) elTotal.innerText = allLeaveRequestsBK.length;

                renderLeaveRequestsBK();
            } catch(e) {
                console.error('Error loadLeaveRequestsBK:', e);
                tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-rose-500 font-bold">Terjadi kesalahan koneksi server: ${e.message}</td></tr>`;
            }
        }

        function renderLeaveRequestsBK() {
            const tbody = document.getElementById('tableLeaveRequestsBK');
            if(!tbody) return;

            const statusFilter = document.getElementById('leaveStatusFilter')?.value || 'ALL';
            const classFilter = document.getElementById('leaveClassFilterBK')?.value || 'ALL';
            const searchVal = (document.getElementById('leaveSearchBK')?.value || '').toLowerCase().trim();

            const filtered = allLeaveRequestsBK.filter(req => {
                const reqStatus = (req.status || 'PENDING').toUpperCase();
                const reqClass = (req.className || '').toUpperCase();
                const reqName = (req.studentName || '').toLowerCase();
                const reqParent = (req.parentName || '').toLowerCase();
                const reqReason = (req.reason || '').toLowerCase();

                const matchStatus = (statusFilter === 'ALL' || reqStatus === statusFilter);
                const matchClass = (classFilter === 'ALL' || reqClass === classFilter.toUpperCase());
                const matchSearch = (!searchVal || reqName.includes(searchVal) || reqParent.includes(searchVal) || reqReason.includes(searchVal));

                return matchStatus && matchClass && matchSearch;
            });

            tbody.innerHTML = '';
            if(filtered.length > 0) {
                filtered.forEach(req => {
                    let dateStr = '-';
                    try {
                        dateStr = new Date(req.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                    } catch(e) { dateStr = String(req.createdAt || '-'); }

                    let startStr = '-';
                    let endStr = '-';
                    try {
                        startStr = new Date(req.startDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
                        endStr = new Date(req.endDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
