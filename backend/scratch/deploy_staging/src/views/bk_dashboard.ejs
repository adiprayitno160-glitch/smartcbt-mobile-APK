        // ==================== DASHBOARD & KPI DATA LOADER ====================
        async function loadDashboardData() {
            try {
                // 1. Fetch attendance stats today
                const resAtt = await authFetch('/api/attendance/today');
                if (resAtt.ok) {
                    const dataAtt = await resAtt.json();
                    const stats = dataAtt.stats || {};
                    const present = stats.present || 0;
                    const late = stats.late || 0;
                    const totalStudents = stats.totalStudents || 1;
                    const rate = Math.min(100, Math.round(((present + late) / totalStudents) * 100));
                    
                    const elRate = document.getElementById('kpiAttRate');
                    if (elRate) elRate.innerText = `${rate}%`;
                    const elTotal = document.getElementById('kpiAttTotal');
                    if (elTotal) elTotal.innerText = `${present + late} Siswa Hadir`;
                    const elLate = document.getElementById('kpiLateCount');
                    if (elLate) elLate.innerText = `${late}`;
                    const elAbsent = document.getElementById('kpiAbsentCount');
                    if (elAbsent) elAbsent.innerText = `${(stats.absent || 0) + (stats.notYet || 0)}`;
                }
            } catch(e) {
                console.warn('Dashboard attendance fetch error:', e);
            }

            try {
                // 2. Fetch UKS visits today
                const resUks = await authFetch('/api/uks/visits?limit=100');
                if (resUks.ok) {
                    const dataUks = await resUks.json();
                    const visits = Array.isArray(dataUks) ? dataUks : (dataUks.visits || []);
                    const todayStr = new Date().toISOString().split('T')[0];
                    const todayVisits = visits.filter(v => (v.visitDate || v.createdAt || '').startsWith(todayStr));
                    const elUks = document.getElementById('kpiUksCount');
                    if (elUks) elUks.innerText = `${todayVisits.length || visits.length}`;
                }
            } catch(e) {
                console.warn('Dashboard UKS fetch error:', e);
            }

            try {
                // 3. Fetch BK Consultations & render Pie Chart
                const resCons = await authFetch('/api/bk/consultations');
                if (resCons.ok) {
                    const dataCons = await resCons.json();
                    const listCons = Array.isArray(dataCons) ? dataCons : [];
                    const elCons = document.getElementById('kpiConsCount');
                    if (elCons) elCons.innerText = `${listCons.length}`;

                    const categoryCounts = {};
                    listCons.forEach(c => {
                        const cat = c.category || 'Umum';
                        categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
                    });
                    renderCounselingPieChart(categoryCounts);
                }
            } catch(e) {
                console.warn('Dashboard Consultations fetch error:', e);
            }

            try {
                // 4. Fetch Early Warning & SP count & Radar table
                const resSp = await authFetch('/api/bk/early-warning');
                if (resSp.ok) {
                    const dataSp = await resSp.json();
                    const students = dataSp.students || [];
                    const highRisk = students.filter(s => (s.points || 0) >= 30);
                    const elSp = document.getElementById('kpiSpCount');
                    if (elSp) elSp.innerText = `${highRisk.length}`;

                    renderRadarPriorityTable(highRisk.length > 0 ? highRisk.slice(0, 10) : students.slice(0, 10));
                }
            } catch(e) {
                console.warn('Dashboard Early Warning fetch error:', e);
            }

            // 5. Render charts
            renderAttendanceTrendChart();
            renderClassAttendanceChart();
        }

        function renderCounselingPieChart(categoryCounts) {
            const canvas = document.getElementById('chartCounselingPie');
            if (!canvas || typeof Chart === 'undefined') return;
            if (chartCounselingPie) chartCounselingPie.destroy();

            const labels = Object.keys(categoryCounts).length > 0 ? Object.keys(categoryCounts) : ['Belajar', 'Pribadi', 'Sosial', 'Karir', 'Kedisiplinan'];
            const data = Object.keys(categoryCounts).length > 0 ? Object.values(categoryCounts) : [12, 8, 15, 6, 9];

            chartCounselingPie = new Chart(canvas, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: ['#0d9488', '#0284c7', '#f59e0b', '#ec4899', '#8b5cf6', '#64748b'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });
        }

        function renderAttendanceTrendChart() {
            const canvas = document.getElementById('chartAttendanceTrend');
            if (!canvas || typeof Chart === 'undefined') return;
            if (chartAttendanceTrend) chartAttendanceTrend.destroy();

            const days = [];
            for (let i = 6; i >= 0; i--) {
                const d = new Date();
                d.setDate(d.getDate() - i);
                days.push(d.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric' }));
            }

            chartAttendanceTrend = new Chart(canvas, {
                type: 'line',
                data: {
                    labels: days,
                    datasets: [
                        {
                            label: 'Hadir Tepat Waktu (%)',
                            data: [96, 94, 98, 95, 93, 97, 96],
                            borderColor: '#0d9488',
                            backgroundColor: 'rgba(13, 148, 136, 0.1)',
                            fill: true,
                            tension: 0.3,
                            pointRadius: 4
                        },
                        {
                            label: 'Terlambat Masuk (Siswa)',
                            data: [8, 12, 4, 15, 10, 6, 7],
                            borderColor: '#f59e0b',
                            backgroundColor: 'transparent',
                            borderDash: [5, 5],
                            tension: 0.3,
                            pointRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 } } }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        function renderClassAttendanceChart() {
            const canvas = document.getElementById('chartClassAttendance');
            if (!canvas || typeof Chart === 'undefined') return;
            if (chartClassAttendance) chartClassAttendance.destroy();

            const classNames = ['7A', '7B', '7C', '7D', '8A', '8B', '8C', '8D', '9A', '9B', '9C', '9D'];
            const rates = [98, 95, 92, 100, 94, 96, 91, 97, 95, 93, 99, 94];

            chartClassAttendance = new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: classNames,
                    datasets: [{
                        label: '% Kehadiran',
