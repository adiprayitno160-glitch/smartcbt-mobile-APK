        // ==================== ATTENDANCE REKAP ====================
        function onAttScopeChange() {
            const scope = document.getElementById('attFilterScope').value;
            const containerGrade = document.getElementById('containerAttFilterGrade');
            const containerClass = document.getElementById('containerAttFilterClass');

            if (scope === 'ALL') {
                containerGrade.classList.add('hidden');
                containerClass.classList.add('hidden');
            } else if (scope === 'GRADE') {
                containerGrade.classList.remove('hidden');
                containerClass.classList.add('hidden');
            } else {
                containerGrade.classList.add('hidden');
                containerClass.classList.remove('hidden');
            }
            loadAttendanceData();
        }

        async function loadAttendanceData() {
            const date = document.getElementById('attFilterDate').value;
            const scope = document.getElementById('attFilterScope')?.value || 'CLASS';
            let query = '/api/attendance/rekap?date=' + encodeURIComponent(date) + '&scope=' + encodeURIComponent(scope);

            if (scope === 'GRADE') {
                const grade = document.getElementById('attFilterGrade')?.value || 'VII';
                query += '&grade=' + encodeURIComponent(grade);
            } else if (scope === 'CLASS') {
                const className = document.getElementById('attFilterClass')?.value || 'ALL';
                query += '&className=' + encodeURIComponent(className);
            }

            try {
                const res = await fetch(query, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if(data.counts) {
                    document.getElementById('attStatTotal').innerText = data.counts.total;
                    document.getElementById('attStatPresent').innerText = data.counts.present;
                    document.getElementById('attStatLate').innerText = data.counts.late;
                    document.getElementById('attStatSick').innerText = data.counts.sick;
                    document.getElementById('attStatPermission').innerText = data.counts.permission;
                    document.getElementById('attStatAbsent').innerText = data.counts.notYet + data.counts.absent;
                }
                allAttendanceRecords = data.records || [];
                filteredAttRecords = allAttendanceRecords;
                attCurrentPage = 1;
                renderAttTable();
            } catch(e) {
                console.error('Error loadAttendanceData:', e);
            }
        }

        function getBkExportParams() {
            const date = document.getElementById('attFilterDate').value;
            const scope = document.getElementById('attFilterScope')?.value || 'CLASS';
            let q = 'date=' + encodeURIComponent(date) + '&scope=' + encodeURIComponent(scope) + '&token=' + encodeURIComponent(token);
            if (scope === 'GRADE') {
                const grade = document.getElementById('attFilterGrade')?.value || 'VII';
                q += '&grade=' + encodeURIComponent(grade);
            } else if (scope === 'CLASS') {
                const className = document.getElementById('attFilterClass')?.value || 'ALL';
                q += '&className=' + encodeURIComponent(className);
            }
            return q;
        }

        function downloadBkExcelRekap() {
            const params = getBkExportParams();
            window.open('/api/attendance/export-excel?' + params, '_blank');
        }

        function downloadBkPdfRekap() {
            const params = getBkExportParams();
            window.open('/api/attendance/export-pdf?' + params, '_blank');
        }

        function filterAttTable() {
            const q = document.getElementById('attSearch').value.toLowerCase();
            filteredAttRecords = allAttendanceRecords.filter(r => {
                return (r.name && r.name.toLowerCase().includes(q)) || (r.nisn && r.nisn.includes(q));
            });
            attCurrentPage = 1;
            renderAttTable();
        }

        function renderAttTable() {
            const tbody = document.getElementById('attTableBody');
            tbody.innerHTML = '';
            const total = filteredAttRecords.length;

            if(total === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="p-4 text-center text-gray-400">Tidak ada data presensi</td></tr>';
                document.getElementById('attPageInfo').innerText = '0 dari 0 data';
                return;
            }

            const startIdx = (attCurrentPage - 1) * attPageSize;
            const endIdx = Math.min(startIdx + attPageSize, total);
            const pageRecords = filteredAttRecords.slice(startIdx, endIdx);

            document.getElementById('attPageInfo').innerText = `Menampilkan ${startIdx + 1}-${endIdx} dari ${total} siswa`;

            pageRecords.forEach((r, idx) => {
                let badge = '<span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded font-bold">Belum Scan</span>';
                if(r.status === 'PRESENT') badge = '<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold">Hadir Tepat</span>';
                if(r.status === 'LATE') badge = '<span class="bg-yellow-100 text-yellow-800 px-2 py-0.5 rounded font-bold">Terlambat</span>';
                if(r.status === 'SICK') badge = '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-bold">Sakit (UKS)</span>';
                if(r.status === 'PERMISSION') badge = '<span class="bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-bold">Izin</span>';
                if(r.status === 'ABSENT') badge = '<span class="bg-red-100 text-red-800 px-2 py-0.5 rounded font-bold">⚠️ ALPA</span>';

                const inTime = r.gateInTime || (r.scanTime ? new Date(r.scanTime).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WIB' : '-');
                const outTime = r.gateOutTime || '-';

                tbody.innerHTML += `
                    <tr class="hover:bg-teal-50/50 border-b">
                        <td class="p-3 text-gray-400 font-mono">${startIdx + idx + 1}</td>
                        <td class="p-3 font-bold text-gray-800">${r.name || '-'}</td>
                        <td class="p-3 font-mono">${r.nisn || '-'}</td>
                        <td class="p-3"><span class="bg-teal-50 text-teal-800 font-bold px-2 py-0.5 rounded">${r.className || '-'}</span></td>
                        <td class="p-3 font-mono font-bold text-emerald-700">${inTime}</td>
                        <td class="p-3 font-mono font-bold text-blue-700">${outTime}</td>
                        <td class="p-3">${badge}</td>
                        <td class="p-3 text-xs ${r.status === 'ABSENT' ? 'text-red-700 font-semibold' : 'text-gray-500'}">${r.note || '-'}</td>
                    </tr>
                `;
            });
            renderAttNumberedPagination();
        }

        function renderAttNumberedPagination() {
            const container = document.getElementById('attPaginationNumbered');
            if (!container) return;
            const total = filteredAttRecords.length;
            const totalPages = Math.ceil(total / attPageSize) || 1;
            container.innerHTML = '';

            // Tombol Prev
            const prevBtn = document.createElement('button');
            prevBtn.innerHTML = '&laquo; Prev';
            prevBtn.className = `px-2.5 py-1 text-xs rounded-lg font-bold border transition-colors ${attCurrentPage > 1 ? 'bg-white hover:bg-gray-100 text-teal-800 border-gray-300' : 'bg-gray-100 text-gray-400 border-gray-200 cursor-not-allowed'}`;
            prevBtn.disabled = attCurrentPage <= 1;
            prevBtn.onclick = () => { if (attCurrentPage > 1) { attCurrentPage--; renderAttTable(); } };
            container.appendChild(prevBtn);

            // Numbered pages (max 5 page buttons)
            let startP = Math.max(1, attCurrentPage - 2);
            let endP = Math.min(totalPages, startP + 4);
            if (endP - startP < 4) startP = Math.max(1, endP - 4);

            for (let i = startP; i <= endP; i++) {
                const btn = document.createElement('button');
                btn.innerText = i;
                if (i === attCurrentPage) {
                    btn.className = 'px-3 py-1 text-xs rounded-lg font-black bg-teal-700 text-white shadow-sm';
                } else {
                    btn.className = 'px-3 py-1 text-xs rounded-lg font-bold bg-white hover:bg-teal-50 text-gray-700 border border-gray-300 transition-colors';
                    btn.onclick = () => { attCurrentPage = i; renderAttTable(); };
                }
                container.appendChild(btn);
            }

            // Tombol Next
            const nextBtn = document.createElement('button');
            nextBtn.innerHTML = 'Next &raquo;';
            nextBtn.className = `px-2.5 py-1 text-xs rounded-lg font-bold border transition-colors ${attCurrentPage < totalPages ? 'bg-white hover:bg-gray-100 text-teal-800 border-gray-300' : 'bg-gray-100 text-gray-400 border-gray-200 cursor-not-allowed'}`;
            nextBtn.disabled = attCurrentPage >= totalPages;
            nextBtn.onclick = () => { if (attCurrentPage < totalPages) { attCurrentPage++; renderAttTable(); } };
            container.appendChild(nextBtn);
        }

