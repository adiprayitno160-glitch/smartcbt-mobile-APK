    <!-- Early Auth Guard: Cegah akses unauthenticated/unauthorized sebelum render -->
    <script>
        (function() {
            var urlParams = new URLSearchParams(window.location.search);
            var qToken = urlParams.get('token');
            if (qToken) {
                localStorage.setItem('token', qToken);
                document.cookie = "token=" + encodeURIComponent(qToken) + "; path=/; max-age=86400";
                document.cookie = "admin_token=" + encodeURIComponent(qToken) + "; path=/; max-age=86400";
            }
            var t = localStorage.getItem('token');
            if (!t) {
                window.location.replace('/?error=unauthorized');
                return;
            }
            try {
                var p = JSON.parse(atob(t.split('.')[1]));
                var allowed = ['ADMIN', 'ADMINISTRATOR', 'SUPERADMIN', 'OPERATOR', 'COUNSELOR', 'BK', 'GURU_BK', 'GURU BK'];
                var uRole = String(p.role || '').toUpperCase().trim();
                if (!allowed.includes(uRole) && !p.isCounselor) {
                    alert('Akses Ditolak: Halaman Portal BK khusus untuk Guru BK dan Administrator.');
                    window.location.replace('/');
                    return;
                }
                if (p.exp && Date.now() >= p.exp * 1000) {
                    localStorage.removeItem('token');
                    window.location.replace('/?error=session_expired');
                    return;
                }
            } catch (e) {
                localStorage.removeItem('token');
                window.location.replace('/?error=unauthorized');
            }
        })();

        // Definisi awal switchTab agar tombol navigasi dapat diklik seketika tanpa delay
        window.switchTab = function(tab) {
            window._pendingBkTab = tab;
            try {
                document.querySelectorAll('.tab-nav').forEach(function(b) {
                    b.className = 'tab-nav w-full text-left px-3.5 py-2.5 rounded-xl hover:bg-slate-800 text-slate-200 hover:text-white transition-all text-[13.5px] flex items-center gap-2.5';
                });
                var activeBtn = document.getElementById('tabBtn-' + tab);
                if (activeBtn) {
                    activeBtn.className = 'tab-nav w-full text-left px-3.5 py-2.5 rounded-xl font-bold transition-all bg-teal-800 text-white shadow flex items-center gap-2.5';
                }
                ['dashboard', 'gate', 'absensi', 'uks', 'konseling', 'chat-ortu', 'izin', 'kedisiplinan', 'guru-bk'].forEach(function(s) {
                    var el = document.getElementById('section-' + s);
                    if (el) el.classList.add('hidden');
                });
                var targetSection = document.getElementById('section-' + tab);
                if (targetSection) targetSection.classList.remove('hidden');
            } catch(e) {}
        };
    </script>
