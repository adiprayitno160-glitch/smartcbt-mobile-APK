        function updateDailyRowState(day) {
            const isChecked = document.getElementById(`sched_active_${day}`).checked;
            const label = document.getElementById(`sched_label_active_${day}`);
            if (label) label.innerText = isChecked ? 'Masuk' : 'Libur';
            ['inStart', 'inEnd', 'inMax', 'outStart', 'outEnd'].forEach(k => {
                const el = document.getElementById(`sched_${k}_${day}`);
                if (el) el.disabled = !isChecked;
            });
        }

        async function saveDailySchedule() {
            try {
                const days = [
                    { day: 1, dayName: 'Senin' },
                    { day: 2, dayName: 'Selasa' },
                    { day: 3, dayName: 'Rabu' },
                    { day: 4, dayName: 'Kamis' },
                    { day: 5, dayName: 'Jumat' },
                    { day: 6, dayName: 'Sabtu' },
                    { day: 0, dayName: 'Minggu' }
                ];

                const scheduleList = [];
                for (const d of days) {
                    const activeEl = document.getElementById(`sched_active_${d.day}`);
                    const isActive = activeEl ? activeEl.checked : true;
                    const inStart = document.getElementById(`sched_inStart_${d.day}`)?.value || '06:00';
                    const inEnd = document.getElementById(`sched_inEnd_${d.day}`)?.value || '07:15';
                    const inMax = document.getElementById(`sched_inMax_${d.day}`)?.value || '12:00';
                    const outStart = document.getElementById(`sched_outStart_${d.day}`)?.value || (d.day === 5 ? '11:30' : '14:00');
                    const outEnd = document.getElementById(`sched_outEnd_${d.day}`)?.value || (d.day === 5 ? '16:00' : '18:00');

                    const timeRegex = /^([01][0-9]|2[0-3]):[0-5][0-9]$/;
                    if (isActive) {
                        if (!timeRegex.test(inStart) || !timeRegex.test(inEnd) || !timeRegex.test(inMax) || !timeRegex.test(outStart) || !timeRegex.test(outEnd)) {
                            alert(`Format jam pada hari ${d.dayName} tidak valid! Harap gunakan format 24 jam HH:mm (contoh: 06:00, 11:30, 14:00).`);
                            return;
                        }
                    }

                    scheduleList.push({
                        day: d.day,
                        dayName: d.dayName,
                        isActive,
                        gateInStart: inStart,
                        gateInEnd: inEnd,
                        gateInMax: inMax,
                        gateOutStart: outStart,
                        gateOutEnd: outEnd
                    });
                }

                const res = await fetch('/api/attendance/gate-settings', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ dailySchedule: scheduleList })
                });

                if (res.ok) {
                    alert('✅ Seluruh Jadwal Harian Presensi (Senin - Minggu) Berhasil Disimpan!');
                    loadGateSettings();
                } else {
                    const err = await res.json().catch(() => ({}));
                    alert('Gagal menyimpan jadwal: ' + (err.message || 'Error server'));
                }
            } catch (e) {
                console.error(e);
                alert('Gagal menyimpan jadwal harian');
            }
        }

        async function handleToggle24hTrial() {
            const isCurrentlyTrial = currentSettings && currentSettings.isEmergencyGateOut && 
                (currentSettings.emergencyReason || '').toLowerCase().includes('uji');
            
            const confirmMsg = isCurrentlyTrial 
                ? 'Apakah Anda yakin ingin MEMATIKAN Mode Uji Coba 24 Jam?\n\nJam operasional Gate-In & Gate-Out akan kembali ke jadwal normal sesuai hari.'
                : '⚡ Aktifkan Mode Uji Coba Sistem 24 Jam?\n\nKetika mode ini aktif:\n- Seluruh batas jam Gate-In dan Gate-Out dibuka 24 jam penuh.\n- Seluruh siswa dapat scan presensi kapan saja untuk simulasi/testing.\n- TIDAK memicu notifikasi kepulangan darurat ke orang tua.';
            
            if (!confirm(confirmMsg)) return;

            try {
                const res = await fetch('/api/attendance/gate-settings/toggle-trial', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ isTrial: true })
                });

                const data = await res.json();
                if (res.ok) {
                    alert(data.message || 'Status Mode Uji Coba Berhasil Diperbarui');
                    loadGateSettings();
                } else {
                    alert('Gagal mengubah mode uji coba: ' + (data.message || 'Error server'));
                }
            } catch (e) {
                console.error(e);
                alert('Gagal terhubung ke server');
            }
        }

        async function loadGateSettings() {
            try {
                const res = await fetch('/api/attendance/gate-settings');
                const data = await res.json();
                if(data && data.settings) {
                    currentSettings = data.settings;
                    const inStart = currentSettings.gateInStartTime || '06:00';
                    const inEnd = currentSettings.gateInEndTime || '07:15';
                    const inMax = currentSettings.gateInMaxTime || '12:00';
                    const outStart = currentSettings.gateOutStartTime || '14:00';
                    const outEnd = currentSettings.gateOutEndTime || '18:00';

                    document.getElementById('inputGateInStart').value = inStart;
                    document.getElementById('inputGateInEnd').value = inEnd;
                    document.getElementById('inputGateInMax').value = inMax;
                    document.getElementById('inputGateOutStart').value = outStart;
                    document.getElementById('inputGateOutEnd').value = outEnd;

                    // Update 24h preview text
                    if(document.getElementById('previewGateInStart')) document.getElementById('previewGateInStart').innerText = inStart + ' WIB';
                    if(document.getElementById('previewGateInEnd')) document.getElementById('previewGateInEnd').innerText = inEnd + ' WIB';
                    if(document.getElementById('previewGateInMax')) document.getElementById('previewGateInMax').innerText = inMax + ' WIB';
                    if(document.getElementById('previewGateOutStart')) document.getElementById('previewGateOutStart').innerText = outStart + ' WIB';
                    if(document.getElementById('previewGateOutEnd')) document.getElementById('previewGateOutEnd').innerText = outEnd + ' WIB';

                    // 1. Status 24-Hour Trial Mode
                    const isTrial = Boolean(data.status?.isTrialMode);
                    const badgeTrial = document.getElementById('badgeTrialMode');
                    const btnTrial = document.getElementById('btnTrialModeToggle');
                    const iconTrial = document.getElementById('trialToggleIcon');
                    const textTrial = document.getElementById('trialToggleText');

                    if (badgeTrial) {
                        if (isTrial) {
                            badgeTrial.innerText = 'AKTIF (24 JAM)';
                            badgeTrial.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-500 text-white border border-emerald-400 shadow animate-pulse';
                        } else {
                            badgeTrial.innerText = 'NON-AKTIF';
                            badgeTrial.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-red-500/30 text-red-200 border border-red-400';
                        }
                    }

                    if (btnTrial) {
                        if (isTrial) {
                            btnTrial.className = 'px-6 py-3 rounded-xl font-bold text-xs shadow-lg transition-all flex items-center gap-2 bg-rose-600 hover:bg-rose-700 text-white';
                            if (iconTrial) iconTrial.innerText = '🔒';
                            if (textTrial) textTrial.innerText = 'Matikan Mode Uji Coba 24 Jam';
                        } else {
                            btnTrial.className = 'px-6 py-3 rounded-xl font-bold text-xs shadow-lg transition-all flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white';
                            if (iconTrial) iconTrial.innerText = '⚡';
                            if (textTrial) textTrial.innerText = 'Nyalakan Mode Uji Coba 24 Jam';
                        }
                    }

                    // 2. Status Emergency Dismissal (Pulang Lebih Awal)
                    const isEmergency = Boolean(data.status?.isEmergencyActive);
                    const btnEmerg = document.getElementById('btnEmergencyAction');
                    if(isEmergency) {
                        if(btnEmerg) {
                            btnEmerg.innerText = '✅ Pulang Lebih Awal AKTIF (Klik untuk Normal)';
                            btnEmerg.className = 'px-5 py-2.5 rounded-xl font-bold text-xs shadow transition-all bg-green-600 hover:bg-green-700 text-white';
                        }
                        document.getElementById('emergencyStatusTitle').innerText = '🚨 Gate-Out Darurat (Pulang Lebih Awal) Sedang AKTIF';
                        document.getElementById('emergencyStatusDesc').innerText = 'Keterangan: ' + (currentSettings.emergencyReason || 'Acara Sekolah') + '. Seluruh siswa dapat scan barcode pulang sekarang.';
                    } else {
                        if(btnEmerg) {
                            btnEmerg.innerText = '🚨 Aktifkan Pulang Lebih Awal';
                            btnEmerg.className = 'px-5 py-2.5 rounded-xl font-bold text-xs shadow transition-all bg-red-600 hover:bg-red-700 text-white';
                        }
                        const curDayName = data.status?.currentDayName || 'Hari Ini';
                        const curOutStart = currentSettings.currentGateOutStart || currentSettings.gateOutStartTime || '14:00';
                        const curOutEnd = currentSettings.currentGateOutEnd || currentSettings.gateOutEndTime || '18:00';
                        document.getElementById('emergencyStatusTitle').innerText = 'Status Kepulangan Siswa (Gate-Out Normal)';
                        document.getElementById('emergencyStatusDesc').innerText = `Gate-Out hari ${curDayName} dibuka otomatis pukul ${curOutStart} - ${curOutEnd} WIB.`;
                    }

                    // 3. Live Badges Gate-In & Gate-Out
                    if(data.status) {
                        document.getElementById('liveGateInBadge').innerText = data.status.isGateInOpen ? 'Terbuka' : 'Ditutup';
                        document.getElementById('liveGateInBadge').className = data.status.isGateInOpen 
                            ? 'text-xs bg-green-100 text-green-800 font-bold px-2.5 py-1 rounded-full' 
                            : 'text-xs bg-red-100 text-red-800 font-bold px-2.5 py-1 rounded-full';
                        
                        document.getElementById('liveGateOutBadge').innerText = data.status.isGateOutOpen ? 'Terbuka' : 'Ditutup';
                        document.getElementById('liveGateOutBadge').className = data.status.isGateOutOpen 
                            ? 'text-xs bg-blue-100 text-blue-800 font-bold px-2.5 py-1 rounded-full' 
                            : 'text-xs bg-gray-100 text-gray-700 font-bold px-2.5 py-1 rounded-full';
                        
                        const badgeToday = document.getElementById('todayActiveBadge');
                        if (badgeToday) {
                            const curDayName = data.status.currentDayName || 'Hari Ini';
                            const sched = data.status.todaySchedule;
                            const schedText = sched ? `${sched.gateInStart} - ${sched.gateInEnd} WIB | Pulang: ${sched.gateOutStart} WIB` : '';
                            badgeToday.innerText = `Hari Ini: ${curDayName} (${schedText})`;
                        }
                    }

                    // 4. Render Daily Schedule Table
                    if (data.settings?.dailySchedule) {
                        dailyScheduleData = data.settings.dailySchedule;
                        renderDailyScheduleTable(dailyScheduleData, data.status?.currentDayOfWeek ?? 1);
                    }
                }
            } catch(e) {
                console.error(e);
            }
        }

        async function handleEmergencyToggle() {
            const willEnable = !currentSettings.isEmergencyGateOut;
            let reason = 'Acara Sekolah';
            if(willEnable) {
                const userReason = prompt('🚨 Masukkan alasan kepulangan lebih awal:\n\n(Sistem akan OTOMATIS mengirimkan notifikasi resmi ke seluruh Orang Tua & Siswa bahwa ananda dipulangkan lebih awal):', 'Rapat Dinas Guru & Persiapan Asesmen');
                if(userReason === null) return;
                reason = userReason || 'Rapat Dinas Guru & Persiapan Asesmen';
            }

            const payload = {
                isEmergencyGateOut: willEnable,
                emergencyReason: reason
            };

            const res = await fetch('/api/attendance/gate-settings', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify(payload)
            });

            if(res.ok) {
                const data = await res.json();
                alert(data.message || 'Status Gate Kepulangan Berhasil Diperbarui');
                loadGateSettings();
            } else {
                alert('Gagal mengubah status gate');
            }
        }

