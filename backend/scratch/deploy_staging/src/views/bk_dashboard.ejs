        function renderTagTeacherList() {
            const container = document.getElementById('tagTeacherListContainer');
            const badge = document.getElementById('tagTeacherCountBadge');
            if (!container) return;

            const query = (document.getElementById('searchTagTeacherInput')?.value || '').toLowerCase().trim();
            const filtered = allAvailableTeachers.filter(t => {
                const nameMatch = (t.name || '').toLowerCase().includes(query);
                const nipMatch = (t.nip || t.username || '').toLowerCase().includes(query);
                const subjMatch = (t.teachingSubjects || '').toLowerCase().includes(query);
                return nameMatch || nipMatch || subjMatch;
            });

            if (badge) badge.innerText = `${filtered.length} Guru`;

            if (filtered.length === 0) {
                container.innerHTML = `<div class="py-8 text-center text-slate-400 text-xs">Tidak ada data guru yang cocok dengan "${query}".</div>`;
                return;
            }

            container.innerHTML = filtered.map(t => {
                const isCounselor = t.isCounselor || t.role === 'COUNSELOR';
                const initial = t.name ? t.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'GU';
                return `
                    <div class="p-3 bg-white rounded-xl border ${isCounselor ? 'border-teal-300 bg-teal-50/40' : 'border-slate-200'} flex items-center justify-between gap-3 hover:shadow-sm transition-all">
                        <div class="flex items-center gap-3 overflow-hidden">
                            <div class="w-10 h-10 rounded-xl ${isCounselor ? 'bg-teal-600 text-white' : 'bg-slate-100 text-slate-700'} font-black text-xs flex items-center justify-center shrink-0">
                                ${initial}
                            </div>
                            <div class="truncate">
                                <div class="flex items-center gap-2">
                                    <h5 class="font-bold text-slate-800 text-xs truncate">${t.name}</h5>
                                    ${isCounselor ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-teal-100 text-teal-800 border border-teal-200">Guru BK Aktif</span>' : ''}
                                </div>
                                <p class="text-[11px] text-slate-400 font-mono">NIP/ID: ${t.nip || t.username || '-'} ${t.teachingSubjects ? '• ' + t.teachingSubjects : ''}</p>
                            </div>
                        </div>
                        <div class="shrink-0">
                            ${isCounselor ? `
                                <button onclick="toggleTagTeacherBK('${t.id}', false, '${escape(t.name)}')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl font-bold text-xs transition-all flex items-center gap-1">
                                    <span>❌</span> Lepas Status BK
                                </button>
                            ` : `
                                <button onclick="toggleTagTeacherBK('${t.id}', true, '${escape(t.name)}')" class="px-3.5 py-1.5 bg-teal-600 hover:bg-teal-700 text-white rounded-xl font-bold text-xs shadow transition-all flex items-center gap-1">
                                    <span>➕</span> Jadikan Guru BK
                                </button>
                            `}
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function toggleTagTeacherBK(teacherId, isBk, teacherName) {
            const actionText = isBk ? 'menetapkan guru ini sebagai Guru BK' : 'melepas status Guru BK untuk guru ini';
            if (!confirm(`Apakah Anda yakin ingin ${actionText}?`)) return;

            try {
                const res = await authFetch('/api/bk/counselors/tag', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ teacherId, isBk })
                });
                const data = await res.json();
                if (data.success) {
                    alert(data.message || 'Status guru berhasil diperbarui');
                    await loadBkCounselorsManagement();
                } else {
                    alert('Gagal: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                console.error('Error toggling counselor tag:', err);
                alert('Terjadi kesalahan koneksi.');
            }
        }

        // ==================== SIDEBAR TOGGLE & PERSISTENCE ====================
        function togglePortalSidebar() {
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            if (!sidebar) return;

            const isCurrentlyHidden = sidebar.classList.contains('-translate-x-full');

            if (isCurrentlyHidden) {
                sidebar.classList.remove('-translate-x-full');
                if (expandBtn) expandBtn.classList.add('hidden');
                mainEls.forEach(m => {
                    m.classList.add('ml-64');
                    m.classList.remove('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'false');
            } else {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'true');
            }
        }

        // Shortcut Ctrl+B
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                togglePortalSidebar();
            }
        });

        // Apply saved state
        (function applySavedSidebarState() {
            const isCollapsed = localStorage.getItem('portal_sidebar_collapsed') === 'true';
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            
            if (isCollapsed && sidebar) {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
            }
        })();

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.clear();
            window.location.href = '/';
        }
    </script>
</body>
