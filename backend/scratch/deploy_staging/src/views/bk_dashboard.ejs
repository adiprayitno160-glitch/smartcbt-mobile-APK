        function renderRadarPriorityTable(students) {
            const tbody = document.getElementById('radarPriorityTable');
            if (!tbody) return;

            if (!students || students.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-slate-400">Tidak ada siswa berisiko tinggi saat ini (Semua kondisi aman).</td></tr>';
                return;
            }

            tbody.innerHTML = students.map(s => {
                let badgeClass = 'bg-emerald-100 text-emerald-800';
                if ((s.points || 0) >= 50) badgeClass = 'bg-rose-100 text-rose-800 font-bold';
                else if ((s.points || 0) >= 30) badgeClass = 'bg-amber-100 text-amber-800 font-bold';

                return `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-2 font-bold text-slate-800">${s.name}</td>
                        <td class="p-2 text-slate-600 font-semibold">${s.className || '-'}</td>
                        <td class="p-2 font-black text-rose-600">${s.points || 0} Poin</td>
                        <td class="p-2"><span class="px-2 py-0.5 rounded text-[10px] ${badgeClass}">${s.suggestedSp || (s.points >= 30 ? 'Perhatian' : 'Aman')}</span></td>
                        <td class="p-2 text-right">
                            <button onclick="switchTab('kedisiplinan')" class="px-2.5 py-1 bg-teal-600 hover:bg-teal-700 text-white rounded-lg text-[10px] font-bold shadow transition-all">
                                Tindak Lanjut &rarr;
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

