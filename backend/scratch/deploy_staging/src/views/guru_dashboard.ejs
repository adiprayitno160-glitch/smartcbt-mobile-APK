        async function handleCreateHomeworkTeacher(e) {
            e.preventDefault();
            const title = document.getElementById('chHwTitle').value.trim();
            const subjectName = document.getElementById('chHwSubject').value.trim();
            const className = document.getElementById('chHwClass').value;
            const description = document.getElementById('chHwDescription').value.trim();
            const deadlineVal = document.getElementById('chHwDeadline').value;
            const deadline = deadlineVal ? new Date(deadlineVal).toISOString() : new Date(Date.now() + 86400000 * 3).toISOString();

            const btn = document.getElementById('btnSubmitCreateHw');
            btn.disabled = true;
            btn.innerText = 'Menyimpan...';

            try {
                const res = await fetch('/api/homeworks', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ title, subjectName, className, description, deadline, category: 'TUGAS_HARIAN' })
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✅ Tugas siswa berhasil dipublikasikan!');
                    closeCreateHomeworkModal();
                    loadTeacherHomeworks();
                } else {
                    alert('❌ Gagal membuat tugas: ' + (data.message || 'Error server'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerText = 'Publikasikan Tugas';
            }
        }

        function openTeacherLightbox(url, title) {
            const modal = document.getElementById('modalTeacherImageLightbox');
            const img = document.getElementById('teacherLightboxImg');
            const cap = document.getElementById('teacherLightboxCap');
            const dl = document.getElementById('teacherLightboxDl');
            if (!modal || !img) return;
            img.src = url;
            if (cap) cap.innerText = title || 'Pratinjau Bukti Surat Izin Siswa';
            if (dl) dl.href = url;
            modal.classList.remove('hidden');
        }

        function closeTeacherLightbox() {
            const modal = document.getElementById('modalTeacherImageLightbox');
            if (modal) modal.classList.add('hidden');
        }

        // ==================== SIDEBAR TOGGLE & PERSISTENCE ====================
        function togglePortalSidebar() {
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            if (!sidebar) return;

            const isCurrentlyHidden = sidebar.classList.contains('-translate-x-full');

            if (isCurrentlyHidden) {
                sidebar.classList.remove('-translate-x-full');
                if (expandBtn) expandBtn.classList.add('hidden');
                mainEls.forEach(m => {
                    m.classList.add('ml-64');
                    m.classList.remove('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'false');
            } else {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
                localStorage.setItem('portal_sidebar_collapsed', 'true');
            }
        }

        // Shortcut Ctrl+B
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                togglePortalSidebar();
            }
        });

        // Apply saved state
        (function applySavedSidebarState() {
            const isCollapsed = localStorage.getItem('portal_sidebar_collapsed') === 'true';
            const sidebar = document.getElementById('portalSidebar');
            const expandBtn = document.getElementById('sidebarExpandBtn');
            const mainEls = document.querySelectorAll('main, .main-content-portal');
            
            if (isCollapsed && sidebar) {
                sidebar.classList.add('-translate-x-full');
                if (expandBtn) expandBtn.classList.remove('hidden');
                mainEls.forEach(m => {
                    m.classList.remove('ml-64');
                    m.classList.add('ml-0');
                });
            }
        })();

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            window.location.href = '/';
        }
    </script>

    <!-- Modal Pratinjau Foto / Dokumen Surat Izin Orang Tua -->
    <div id="modalTeacherImageLightbox" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl border border-slate-200 animate-fade-in flex flex-col max-h-[90vh]">
            <div class="p-4 bg-gradient-to-r from-blue-700 to-indigo-800 text-white flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-xl">📷</span>
                    <h3 class="font-extrabold text-sm" id="teacherLightboxCap">Pratinjau Bukti Surat Izin Siswa</h3>
                </div>
                <button onclick="closeTeacherLightbox()" class="text-white hover:text-rose-200 text-xl font-bold px-2 py-1 rounded-lg">✕</button>
            </div>
            <div class="p-4 bg-slate-900 flex-1 overflow-auto flex items-center justify-center min-h-[300px]">
                <img id="teacherLightboxImg" src="" alt="Bukti Surat Izin Siswa" class="max-h-[70vh] max-w-full object-contain rounded-lg shadow-md">
            </div>
            <div class="p-3 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                <span class="text-xs text-slate-500 font-medium">Unggahan Surat Resmi dari Orang Tua / Wali Siswa</span>
                <div class="flex gap-2">
                    <a id="teacherLightboxDl" href="#" target="_blank" download class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow transition-colors flex items-center gap-1.5">
                        <span>⬇️</span> Buka / Unduh Penuh
                    </a>
                    <button onclick="closeTeacherLightbox()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold rounded-xl transition-colors">
                        Tutup
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
