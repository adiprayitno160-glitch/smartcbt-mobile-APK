<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Guru Mata Pelajaran & CBT - Smart School</title>
    <script src="/js/tailwind.js"></script>
    <!-- QRCode JS Library for dynamic QR generation -->
    <script src="/js/qrcode.min.js"></script>
    <!-- Chart.js Library untuk Analisis Butir Soal -->
    <script src="/js/chart.js"></script>
    <!-- KaTeX CDN untuk Render Rumus Matematika -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    <style>
        .tab-btn.active {
            background-color: #047857;
            color: white;
            box-shadow: 0 4px 12px rgba(4, 120, 87, 0.25);
            font-weight: 800;
        }
        .schedule-card.active-class {
            border: 2px solid #10B981;
            background: linear-gradient(135deg, #ECFDF5 0%, #FFFFFF 100%);
            box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.15);
        }
    </style>
    <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="bg-[#f8fafc] text-slate-800 flex min-h-screen">
    <!-- Floating Expand Button (Visible when Sidebar is Collapsed) -->
    <button type="button" onclick="togglePortalSidebar()" id="sidebarExpandBtn" title="Tampilkan Sidebar (Shortcut: Ctrl+B)" class="fixed top-3 left-4 z-50 bg-slate-900/95 hover:bg-emerald-600 text-white px-3.5 py-2 rounded-xl shadow-2xl border border-slate-700/80 backdrop-blur-md transition-all duration-300 hidden flex items-center gap-2.5 text-xs font-bold hover:scale-105 group cursor-pointer">
        <svg class="w-5 h-5 text-emerald-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <span class="font-extrabold tracking-wide">Menu Guru</span>
        <span class="text-[10px] bg-white/15 px-1.5 py-0.5 rounded text-slate-300">Ctrl+B</span>
    </button>

    <!-- Sidebar Guru (Refreshed Slate & Emerald Theme) -->
    <aside id="portalSidebar" class="w-64 bg-slate-900 text-white flex flex-col fixed left-0 top-0 h-screen shadow-2xl z-40 border-r border-slate-800 transition-all duration-300 ease-in-out select-none">
        <!-- Brand Header with Logo and Collapse Toggle Button -->
        <div class="px-4 py-3.5 border-b border-slate-800 bg-gradient-to-r from-slate-900 via-slate-900 to-emerald-950/40 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2.5 overflow-hidden">
                <div class="w-10 h-10 rounded-xl bg-white/10 p-1 flex items-center justify-center shadow-md border border-emerald-400/30 flex-shrink-0">
                    <img src="/logo-smpn1boyolangu.png" alt="Logo SMPN 1 Boyolangu" class="w-full h-full object-contain drop-shadow" onerror="this.src='/logo.png'">
                </div>
                <div class="truncate">
                    <h2 class="text-sm font-black tracking-wide text-white leading-tight">SMART TEACHER</h2>
                    <p class="text-[11px] text-emerald-400 font-semibold truncate">SMPN 1 Boyolangu</p>
                </div>
            </div>

            <!-- Toggle Button to Hide / Collapse Sidebar -->
            <button type="button" onclick="togglePortalSidebar()" id="sidebarCollapseBtn" title="Sembunyikan Sidebar (Ctrl+B)" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all flex items-center justify-center group flex-shrink-0 cursor-pointer" aria-label="Sembunyikan Sidebar">
                <svg class="w-5 h-5 transition-transform group-hover:-translate-x-0.5 text-slate-400 group-hover:text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
                </svg>
            </button>
        </div>

        <div class="p-3 bg-slate-950/50 border-b border-slate-800 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-emerald-600/30 text-emerald-300 flex items-center justify-center font-black text-sm border border-emerald-500/30 flex-shrink-0 shadow-inner" id="teacherAvatar">
                G
            </div>
            <div class="overflow-hidden">
                <p class="font-bold text-xs text-slate-100 truncate" id="teacherName">Guru Mata Pelajaran</p>
                <div class="flex items-center gap-1.5 mt-0.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-[10px] text-emerald-400 font-semibold">Guru &amp; Wali Kelas</span>
                </div>
            </div>
        </div>

        <!-- Navigation Links (Enlarged, Clear & Modern Typography) -->
        <nav class="flex-1 p-3 space-y-1.5 overflow-y-auto text-sm font-semibold">
            <button onclick="switchTab('jadwal')" id="nav-jadwal" class="tab-btn active w-full text-left px-3.5 py-2.5 rounded-xl transition-all flex items-center gap-2.5 text-[13.5px]">
                <span class="text-lg">📅</span> <span>Jadwal Mengajar</span>
            </button>
            <button onclick="switchTab('soal')" id="nav-soal" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2.5 text-[13.5px]">
                <span class="text-lg">📝</span> <span>Bank Soal &amp; CBT</span>
            </button>
            <button onclick="switchTab('tugas')" id="nav-tugas" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2.5 text-[13.5px]">
                <span class="text-lg">📚</span> <span>Tugas &amp; E-Library</span>
            </button>
            <button onclick="switchTab('jurnal')" id="nav-jurnal" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2.5 text-[13.5px]">
                <span class="text-lg">📘</span> <span>Jurnal Mengajar Harian</span>
            </button>
            <button onclick="switchTab('broadcast')" id="nav-broadcast" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2.5 text-[13.5px]">
                <span class="text-lg">📢</span> <span>Broadcast Kelas</span>
            </button>
            <button onclick="switchTab('izin')" id="nav-izin" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center justify-between text-[13.5px]">
                <span class="flex items-center gap-2.5">
                    <span class="text-lg">📩</span> <span>Verifikasi Izin Siswa</span>
                </span>
                <span id="badgePendingLeave" class="bg-amber-500 text-white text-[10px] font-black px-2 py-0.5 rounded-full hidden">0</span>
            </button>
            <button onclick="switchTab('walikelas')" id="nav-walikelas" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center justify-between hidden text-[13.5px]">
                <span class="flex items-center gap-2.5">
                    <span class="text-lg">👥</span> <span>Kelas (Wali)</span>
                </span>
                <span id="badgeWkClass" class="bg-teal-500 text-white text-[10px] font-black px-2 py-0.5 rounded-full">VII-A</span>
            </button>
        </nav>

        <div class="p-3 border-t border-slate-800 bg-slate-950/70">
            <button onclick="logout()" class="w-full bg-rose-600/90 hover:bg-rose-700 text-white font-bold py-2.5 rounded-xl shadow-md text-xs transition-colors flex items-center justify-center gap-2 cursor-pointer">
                <span>🚪</span> <span>Logout Guru</span>
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-6 md:p-8 overflow-y-auto h-screen bg-slate-50/70 transition-all duration-300 ease-in-out">
        <!-- TOP HEADER -->
        <header class="flex justify-between items-center mb-6 pb-4 border-b">
            <div>
                <h1 class="text-2xl font-black text-gray-800 flex items-center gap-2" id="pageTitle">
                    <span>📅</span> Jadwal Mengajar & Presensi Kelas Hari Ini
                </h1>
                <p class="text-xs text-gray-500" id="pageSubtitle">Sistem Absensi Cepat QR Dinamis 10 Detik & Mode 1-Klik Semua Hadir</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="bg-emerald-100 text-emerald-800 px-3.5 py-1.5 rounded-full text-xs font-bold" id="clockLive">08:00 WIB</span>
            </div>
        </header>

        <!-- TAB 1: JADWAL MENGAJAR -->
        <div id="section-jadwal" class="space-y-6">
            <!-- Alert Info Kelas Aktif -->
            <div class="bg-gradient-to-r from-emerald-600 to-teal-700 text-white p-6 rounded-3xl shadow-md flex flex-col md:flex-row justify-between items-center gap-4">
                <div>
                    <span class="bg-white/20 text-[10px] uppercase tracking-wider px-2.5 py-1 rounded-full font-bold">🟢 JADWAL MENGAJAR SAAT INI</span>
                    <h2 class="text-xl font-black mt-2" id="activeClassName">Kelas VII-A • Matematika Terpadu</h2>
                    <p class="text-xs text-emerald-100 mt-0.5">Pukul 07:30 - 09:00 WIB • Ruang Kelas 7A (Lt. 1) • Presensi siswa terpusat otomatis via Gate Barcode Kelas</p>
                </div>
                <div class="flex flex-wrap gap-2.5">
                    <button onclick="switchTab('jurnal')" class="bg-white hover:bg-emerald-50 text-emerald-800 font-bold px-4 py-2.5 rounded-xl text-xs shadow flex items-center gap-1.5 transition-all">
                        <span>✍️</span> <span>Tulis Jurnal Mengajar</span>
                    </button>
                </div>
            </div>

            <!-- List Jadwal Mengajar Hari Ini -->
            <div>
                <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider mb-4 flex items-center gap-2">
                    <span>📋</span> Daftar Jam Pelajaran yang Diampu Hari Ini
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="scheduleListContainer">
                    <!-- Schedule Cards Injected by JS -->
                </div>
            </div>
        </div>

        <!-- TAB 2: BANK SOAL & UJIAN CBT MATPEL GURU -->
        <div id="section-soal" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-3xl shadow-sm border">
                <div class="flex flex-wrap justify-between items-center mb-6 pb-4 border-b gap-3">
                    <div>
                        <h2 class="text-lg font-black text-gray-800 flex items-center gap-2">
                            <span>📝</span> Bank Soal & Ujian CBT Guru Pengampu
                        </h2>
                        <p class="text-xs text-gray-500">Buat dan atur jadwal soal ujian mandiri khusus mata pelajaran yang Anda ampu</p>
                    </div>
                    <button onclick="openCreateExamModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-2xl font-bold text-xs shadow flex items-center gap-2">
                        <span>➕</span> <span>Buat Paket Ujian Baru</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="teacherExamGrid">
                    <!-- Exam Cards -->
                </div>
            </div>
        </div>

        <!-- TAB 3: TUGAS & PR BERJADWAL -->
        <div id="section-tugas" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-3xl shadow-sm border">
                <div class="flex flex-wrap justify-between items-center mb-6 pb-4 border-b gap-3">
                    <div>
                        <h2 class="text-lg font-black text-gray-800 flex items-center gap-2">
                            <span>📚</span> Manajemen Tugas & PR Kelas Berjadwal
                        </h2>
                        <p class="text-xs text-gray-500">Kirim instruksi tugas, atur jadwal pengumpulan, dan beri penilaian hasil tugas siswa</p>
                    </div>
                    <button onclick="openCreateHomeworkModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-2xl font-bold text-xs shadow flex items-center gap-2">
                        <span>➕</span> <span>Beri Tugas Baru</span>
                    </button>
                </div>

                <div id="teacherHomeworkList" class="space-y-3">
                    <!-- Homework List -->
                </div>
            </div>
        </div>

        <!-- TAB 4: JURNAL MENGAJAR HARIAN -->
        <div id="section-jurnal" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-3xl shadow-sm border">
                <div class="flex flex-wrap justify-between items-center mb-6 pb-4 border-b gap-3">
                    <div>
                        <h2 class="text-lg font-black text-gray-800 flex items-center gap-2">
                            <span>📘</span> Jurnal Mengajar Harian & Administrasi Sertifikasi Guru
                        </h2>
                        <p class="text-xs text-gray-500">Catatan harian kompetensi dasar (KD), materi yang diajarkan, dan foto dokumentasi kelas</p>
                    </div>
                    <button onclick="openJournalModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-2xl font-bold text-xs shadow flex items-center gap-2">
                        <span>✍️</span> <span>Tulis Jurnal Hari Ini</span>
                    </button>
                </div>

                <div id="teacherJournalList" class="space-y-3.5">
                    <!-- Journal List -->
                </div>
            </div>
        </div>

        <!-- TAB 5: BROADCAST PENGUMUMAN KELAS -->
        <div id="section-broadcast" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-3xl shadow-sm border max-w-2xl">
                <h2 class="text-lg font-black text-gray-800 flex items-center gap-2 mb-1">
                    <span>📢</span> Kirim Pengumuman Cepat ke 1 Kelas
                </h2>
                <p class="text-xs text-gray-500 mb-6">Pesan akan langsung muncul sebagai notifikasi pop-up di APK Siswa kelas tersebut</p>

                <form id="formBroadcast" onsubmit="handleBroadcastClass(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Pilih Kelas Tujuan *</label>
                        <select id="broadcastClass" class="w-full border p-2.5 rounded-xl text-xs font-semibold bg-gray-50 focus:bg-white" required>
                            <option value="VII-A">Kelas VII-A (30 Siswa)</option>
                            <option value="VII-B">Kelas VII-B (30 Siswa)</option>
                            <option value="VII-C">Kelas VII-C (30 Siswa)</option>
                            <option value="VII-D">Kelas VII-D (30 Siswa)</option>
                            <option value="VII-E">Kelas VII-E (30 Siswa)</option>
                            <option value="VII-F">Kelas VII-F (30 Siswa)</option>
                            <option value="VII-G">Kelas VII-G (30 Siswa)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Judul Pengumuman *</label>
                        <input type="text" id="broadcastTitle" placeholder="Cth: Tugas Bawa Jangka & Busur Besok Pagi" class="w-full border p-2.5 rounded-xl text-xs font-semibold" required>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Isi Pengumuman Lengkap *</label>
                        <textarea id="broadcastMessage" rows="4" placeholder="Tuliskan instruksi atau pengumuman yang wajib dibaca siswa..." class="w-full border p-2.5 rounded-xl text-xs" required></textarea>
                    </div>

                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-2xl text-xs shadow-md flex items-center justify-center gap-2">
                        <span>🚀</span> <span>Broadcast Pengumuman ke APK Siswa</span>
                    </button>
                </form>
            </div>
        </div>
    
    <!-- MODAL BUAT PAKET UJIAN CBT BARU -->
    <div id="modalCreateExam" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-bold text-gray-800 text-base flex items-center gap-2">
                    <span>📝</span> Buat Paket Ujian CBT Baru
                </h3>
                <button type="button" onclick="closeCreateExamModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold cursor-pointer">&times;</button>
            </div>
            <form onsubmit="handleCreateExamTeacher(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Judul Ujian / Penilaian</label>
                    <input type="text" id="ceExamTitle" required placeholder="Contoh: Asesmen Sumatif Bab 1 Matematika" class="w-full border rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Mata Pelajaran</label>
                        <input type="text" id="ceExamSubject" required placeholder="Contoh: Matematika" class="w-full border rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Durasi (Menit)</label>
                        <input type="number" id="ceExamDuration" required value="90" min="15" max="240" class="w-full border rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Rombel / Kelas Sasaran</label>
                        <select id="ceExamClass" class="w-full border rounded-xl p-2.5 bg-gray-50 focus:ring-2 focus:ring-emerald-500">
                            <option value="ALL">Semua Kelas</option>
                            <option value="VII-A">VII-A</option>
                            <option value="VII-B">VII-B</option>
                            <option value="VII-C">VII-C</option>
                            <option value="VII-D">VII-D</option>
                            <option value="VII-E">VII-E</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Sesi Pelaksanaan</label>
                        <input type="text" id="ceExamSession" value="Sesi 1 (Pagi)" class="w-full border rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500">
                    </div>
                </div>
                <div class="flex justify-end gap-2 pt-3 border-t">
                    <button type="button" onclick="closeCreateExamModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 font-semibold cursor-pointer">Batal</button>
                    <button type="submit" id="btnSubmitCreateExam" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold shadow cursor-pointer">Simpan & Rilis Ujian</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL BUAT TUGAS / PR KELAS BARU -->
    <div id="modalCreateHomework" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-bold text-gray-800 text-base flex items-center gap-2">
                    <span>📚</span> Beri Tugas & PR Kelas Baru
                </h3>
                <button type="button" onclick="closeCreateHomeworkModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold cursor-pointer">&times;</button>
            </div>
            <form onsubmit="handleCreateHomeworkTeacher(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Judul Tugas</label>
                    <input type="text" id="chHwTitle" required placeholder="Contoh: Latihan Soal Persamaan Linear Bab 2" class="w-full border rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Mata Pelajaran</label>
                        <input type="text" id="chHwSubject" required placeholder="Contoh: Matematika" class="w-full border rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-700 mb-1">Kelas Sasaran</label>
                        <select id="chHwClass" class="w-full border rounded-xl p-2.5 bg-gray-50 focus:ring-2 focus:ring-emerald-500">
                            <option value="VII-A">VII-A</option>
                            <option value="VII-B">VII-B</option>
                            <option value="VII-C">VII-C</option>
                            <option value="VII-D">VII-D</option>
                            <option value="VII-E">VII-E</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Instruksi & Soal Tugas</label>
                    <textarea id="chHwDescription" rows="4" required placeholder="Tuliskan petunjuk pengerjaan dan rincian soal tugas..." class="w-full border rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500"></textarea>
                </div>
                <div>
                    <label class="block font-semibold text-gray-700 mb-1">Batas Waktu Pengumpulan (Deadline)</label>
                    <input type="datetime-local" id="chHwDeadline" required class="w-full border rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500">
                </div>
                <div class="flex justify-end gap-2 pt-3 border-t">
                    <button type="button" onclick="closeCreateHomeworkModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 font-semibold cursor-pointer">Batal</button>
                    <button type="submit" id="btnSubmitCreateHw" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold shadow cursor-pointer">Publikasikan Tugas</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL ANALISIS BUTIR SOAL STANDAR UNBK / PUSMENDIK -->
    <div id="modalItemAnalysis" class="hidden fixed inset-0 bg-black/75 backdrop-blur-md flex justify-center items-center z-50 p-4">
        <div class="bg-white text-gray-900 rounded-3xl w-full max-w-4xl max-h-[92vh] overflow-y-auto shadow-2xl border">
            <div class="p-5 border-b flex justify-between items-center bg-emerald-950 text-white rounded-t-3xl">
                <div class="flex items-center gap-2">
                    <span class="text-xl">📊</span>
                    <div>
                        <h3 class="text-base font-bold">Analisis Butir Soal & Daya Pembeda (UNBK Standar)</h3>
                        <p class="text-[11px] text-blue-400">Evaluasi Kualitas Soal, Tingkat Kesukaran, dan Sebaran Pengecoh (Distraktor)</p>
                    </div>
                </div>
                <button onclick="closeItemAnalysisModal()" class="text-white hover:text-gray-400 text-2xl font-bold">&times;</button>
            </div>

            <div class="p-6 bg-slate-50 space-y-6">
                <!-- Summary Stats Bar -->
