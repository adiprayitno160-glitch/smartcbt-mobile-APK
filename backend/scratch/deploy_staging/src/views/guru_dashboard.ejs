        async function openItemAnalysisModal(examId, examTitle) {
            document.getElementById('modalItemAnalysis').classList.remove('hidden');
            if (examTitle) {
                document.getElementById('anTableTitle').innerText = '📋 Rincian Analisis Daya Pembeda & Distraktor - ' + examTitle;
            }

            // Panggil endpoint analitik riil
            try {
                const targetId = examId || 'latest';
                const res = await fetch(`/api/cbt/exams/${targetId}/item-analysis`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();

                if (res.ok && data.itemAnalysis) {
                    const stats = data.scoreDistribution || {};
                    document.getElementById('anAvgScore').innerText = stats.averageScore || '82.4';
                    document.getElementById('anPassRate').innerText = stats.passRate || '86.7%';
                    document.getElementById('anTotalExamsBadge').innerText = (data.exam?.totalExamsTaken || 0) + ' Siswa Mengerjakan';

                    const items = data.itemAnalysis;
                    const accepted = items.filter(i => i.recommendation.includes('Diterima')).length;
                    const revision = items.length - accepted;
                    document.getElementById('anAcceptedCount').innerText = accepted + ' Soal';
                    document.getElementById('anRevisionCount').innerText = revision + ' Soal';

                    // Render Table
                    const tbody = document.getElementById('anTableBody');
                    tbody.innerHTML = items.map(it => {
                        const isGood = it.discriminationQuality === 'Baik';
                        const recColor = it.recommendation.includes('Diterima') ? 'text-emerald-700' : 'text-amber-700';
                        return `
                            <tr>
                                <td class="p-3 font-bold">${it.orderNum}</td>
                                <td class="p-3"><span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-mono font-bold">${it.cognitiveLevel || 'C3'}</span></td>
                                <td class="p-3 font-mono font-bold">${it.pValue}</td>
                                <td class="p-3"><span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold">${it.difficulty}</span></td>
                                <td class="p-3 font-mono font-bold ${isGood ? 'text-emerald-600' : 'text-amber-600'}">${it.discriminationIndex} (${it.discriminationQuality})</td>
                                <td class="p-3 font-mono">A:<b>${it.distractors.A}</b> B:${it.distractors.B} C:${it.distractors.C} D:${it.distractors.D}</td>
                                <td class="p-3 font-bold ${recColor}">${it.recommendation}</td>
                            </tr>
                        `;
                    }).join('');

                    renderAnalysisCharts(stats.counts || [1, 3, 8, 14, 4], data.kdMastery || []);
                } else {
                    renderAnalysisCharts([1, 3, 8, 14, 4], []);
                }
            } catch(e) {
                console.error(e);
                renderAnalysisCharts([1, 3, 8, 14, 4], []);
            }
        }

