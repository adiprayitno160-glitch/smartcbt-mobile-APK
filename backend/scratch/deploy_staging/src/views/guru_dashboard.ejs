            document.getElementById('modalItemAnalysis').classList.add('hidden');
        }

        function renderAnalysisCharts(histogramCounts, kdMasteryList) {
            if (chartHistogram) chartHistogram.destroy();
            if (chartRadar) chartRadar.destroy();

            // Histogram
            const ctxHist = document.getElementById('chartHistogramScore').getContext('2d');
            chartHistogram = new Chart(ctxHist, {
                type: 'bar',
                data: {
                    labels: ['0-50', '51-65', '66-74', '75-84', '85-94', '95-100'],
                    datasets: [{
                        label: 'Jumlah Siswa',
                        data: histogramCounts || [1, 2, 4, 12, 9, 2],
                        backgroundColor: '#10B981',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } }
                }
            });

            // Radar KD
            const labels = kdMasteryList && kdMasteryList.length > 0 
                ? kdMasteryList.map(k => k.kd.substring(0, 18))
                : ['Aljabar', 'SPLSV', 'Aritmatika', 'Geometri', 'Statistika'];
            const scores = kdMasteryList && kdMasteryList.length > 0
                ? kdMasteryList.map(k => k.score)
                : [88, 84, 79, 86, 92];

            const ctxRadar = document.getElementById('chartRadarKd').getContext('2d');
            chartRadar = new Chart(ctxRadar, {
                type: 'radar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Nilai Rata-rata KD',
                        data: scores,
                        borderColor: '#2563EB',
                        backgroundColor: 'rgba(37, 99, 235, 0.2)',
                        pointBackgroundColor: '#1D4ED8'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            suggestedMin: 50,
                            suggestedMax: 100
                        }
                    }
                }
            });
        }

