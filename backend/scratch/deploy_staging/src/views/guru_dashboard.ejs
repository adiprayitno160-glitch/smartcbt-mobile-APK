                                ${req.rejectionNote ? `<span class="text-[10px] text-red-600 italic">Alasan: ${req.rejectionNote}</span>` : ''}
                                <button onclick="handleDeleteLeaveTeacher('${req.id}', '${safeName}')" class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 px-2 py-1 rounded-lg font-bold text-xs" title="Hapus histori surat izin">
                                    🗑️ Hapus
                                </button>
                            </div>
                        `;
                    }

                    tbody.innerHTML += `
                        <tr class="hover:bg-emerald-50/40 border-b">
                            <td class="p-3.5 font-mono text-gray-500 whitespace-nowrap">${dateStr}</td>
                            <td class="p-3.5">
                                <p class="font-bold text-gray-900 text-xs">${req.studentName || '-'}</p>
                                <p class="text-[11px] text-emerald-800 font-semibold">Kelas: ${req.className || '-'}</p>
                                <p class="text-[10px] text-gray-400">Ortu: ${req.parentName || '-'}</p>
                            </td>
                            <td class="p-3.5">${badgeCategory}</td>
                            <td class="p-3.5 font-mono font-medium text-gray-700 whitespace-nowrap">${periodStr}</td>
                            <td class="p-3.5 max-w-xs">
                                <p class="text-gray-800 font-medium">${req.reason || '-'}</p>
                                ${attachmentLink}
                            </td>
                            <td class="p-3.5 whitespace-nowrap">${statusBadge}</td>
                            <td class="p-3.5 text-gray-500 font-medium text-[11px]">${req.verifiedBy || '-'}</td>
                            <td class="p-3.5 text-right whitespace-nowrap">${actions}</td>
                        </tr>
                    `;
            } else {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" class="p-8 text-center text-gray-400">
                            Tidak ada data permohonan izin siswa dengan filter yang dipilih (Status: <b class="text-gray-600">${statusFilter}</b>, Kelas: <b class="text-gray-600">${classFilter}</b>).
                        </td>
                    </tr>
                `;
            }
        }

        async function handleVerifyLeaveTeacher(id, status) {
            let rejectionNote = '';
            if(status === 'REJECTED') {
                const reason = prompt('Masukkan alasan penolakan surat izin siswa:', 'Foto surat buram / tidak sah');
                if(reason === null) return;
                rejectionNote = reason;
            }

            try {
                const res = await fetch(`/api/teacher/leave-requests/${id}/verify`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ status, rejectionNote })
                });
                const data = await res.json();
                if(res.ok) {
                    alert(data.message || 'Permohonan izin berhasil diproses');
                    loadLeaveRequestsTeacher();
                } else {
                    alert(data.message || 'Gagal memproses permohonan izin');
                }
            } catch(e) {
                console.error(e);
                alert('Gagal menghubungi server');
            }
        }

        async function handleDeleteLeaveTeacher(id, studentName) {
            if (!confirm(`Hapus permanen riwayat surat izin/sakit ananda ${studentName} ini dari database sekolah?\n\nCatatan: Histori yang sudah diverifikasi maupun yang belum akan dihapus secara tuntas.`)) return;

            try {
                const res = await fetch(`/api/teacher/leave-requests/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message || 'Histori surat izin berhasil dihapus');
                    loadLeaveRequestsTeacher();
                } else {
                    alert(data.message || 'Gagal menghapus riwayat izin');
                }
            } catch (err) {
                alert('Terjadi kesalahan saat menghapus: ' + err.message);
            }
        }

