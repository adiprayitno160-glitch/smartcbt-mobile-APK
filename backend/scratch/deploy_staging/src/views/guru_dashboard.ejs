        function openDynamicQrModal(className, subject) {
            activeQrClass = className;
            activeQrSubject = subject;
            document.getElementById('qrModalTitle').innerText = 'Presensi QR Dinamis (Anti-Bolos)';
            document.getElementById('qrModalSub').innerText = 'Kelas ' + className + ' • ' + subject;
            document.getElementById('modalDynamicQr').classList.remove('hidden');

            refreshQrCodeToken();
            if (qrInterval) clearInterval(qrInterval);

            qrCountdown = 10;
            qrInterval = setInterval(() => {
                qrCountdown--;
                document.getElementById('qrCountdownText').innerText = 'Berganti dalam: ' + qrCountdown + 's';
                if (qrCountdown <= 0) {
                    qrCountdown = 10;
                    refreshQrCodeToken();
                }
            }, 1000);
        }

        async function refreshQrCodeToken() {
            try {
                const res = await fetch('/api/guru/attendance/generate-qr', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ className: activeQrClass, subjectName: activeQrSubject })
                });
                const data = await res.json();

                if (data.qrToken) {
                    const canvas = document.getElementById('qrcodeCanvas');
                    canvas.innerHTML = '';
                    qrcodeObj = new QRCode(canvas, {
                        text: data.qrToken,
                        width: 200,
                        height: 200,
                        colorDark: "#064E3B",
                        colorLight: "#FFFFFF",
                        correctLevel: QRCode.CorrectLevel.H
                    });
                }
            } catch(e) {
                console.error('Failed to generate dynamic QR:', e);
            }
        }

        function closeDynamicQrModal() {
            if (qrInterval) clearInterval(qrInterval);
            document.getElementById('modalDynamicQr').classList.add('hidden');
        }

