<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Barcode Pintu Kelas - SMPN 1 Boyolangu</title>
    <script src="/js/tailwind.js"></script>
    <!-- QRCode.js Library -->
    <script src="/js/qrcode.min.js"></script>
    <style>
        @page {
            size: A4 portrait;
            margin: 4mm 6mm;
        }
        @media screen {
            .sheet {
                max-width: 210mm;
                min-height: 285mm;
                margin: 0 auto 2rem auto;
            }
        }
        @media print {
            html, body {
                width: 100% !important;
                height: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                background: white !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print {
                display: none !important;
            }
            #printContainer {
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
                width: 100% !important;
            }
            .page-break {
                page-break-after: always !important;
                break-after: page !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }
            .sheet {
                box-shadow: none !important;
                border: 2.5px solid #0f172a !important;
                margin: 0 auto !important;
                width: 100% !important;
                height: 285mm !important;
                max-height: 285mm !important;
                padding: 12px 18px !important;
                box-sizing: border-box !important;
                border-radius: 8px !important;
                display: flex !important;
                flex-direction: column !important;
                justify-content: space-between !important;
                overflow: hidden !important;
            }
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen font-sans text-gray-800">

    <!-- Top Action Bar (Non-Printable) -->
    <header class="no-print bg-slate-900 text-white p-4 sticky top-0 z-50 shadow-md">
        <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <a href="/admin/kelas" class="bg-slate-800 hover:bg-slate-700 text-white px-3 py-1.5 rounded text-sm font-semibold border border-slate-600">
                    ← Kembali ke Manajemen Kelas
                </a>
                <div>
                    <h1 class="font-bold text-lg">🖨️ Cetak Barcode Pintu Ruang Kelas (Siap Laminating)</h1>
                    <p class="text-xs text-slate-400">Format A4 Portrait Resmi • Gate-In (Datang) & Gate-Out (Pulang) • Geofence 10 Meter</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <select id="filterClassSelect" onchange="filterClassCards()" class="bg-slate-800 border border-slate-600 text-white text-sm rounded px-3 py-1.5">
                    <option value="ALL">Cetak Semua Ruang Kelas</option>
                </select>
                <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2 rounded-lg font-bold text-sm shadow flex items-center gap-2">
                    <span>🖨️</span> Cetak Sekarang (Ctrl + P)
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container for Printable Sheets -->
    <main class="max-w-4xl mx-auto py-6 px-4" id="printContainer">
        <div class="text-center py-12 text-gray-500" id="loadingNotice">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-blue-600 border-t-transparent mb-2"></div>
            <p class="font-medium">Menyiapkan barcode kelas dari sistem...</p>
        </div>
    </main>

    <script>
        const token = localStorage.getItem('token');
        const SMP_DEFAULT_LAT = -8.125506;
        const SMP_DEFAULT_LNG = 111.893526;
        const SMP_DEFAULT_RADIUS = 10;
        let allClasses = [];

        async function init() {
            try {
                const res = await fetch('/api/attendance/class-barcodes', {
                    headers: token ? { 'Authorization': 'Bearer ' + token } : {}
                });
                const data = await res.json();
                const rawList = Array.isArray(data) ? data : (data.classes || []);
                allClasses = rawList.map(item => {
                    const rawLat = item.lat;
                    const rawLng = item.lng;
                    const lat = (rawLat !== undefined && rawLat !== null && !isNaN(Number(rawLat)) && Number(rawLat) !== 0) ? Number(rawLat) : SMP_DEFAULT_LAT;
                    const lng = (rawLng !== undefined && rawLng !== null && !isNaN(Number(rawLng)) && Number(rawLng) !== 0) ? Number(rawLng) : SMP_DEFAULT_LNG;
                    const radius = (item.radiusMeters !== undefined && item.radiusMeters !== null && !isNaN(Number(item.radiusMeters)) && Number(item.radiusMeters) > 0) ? Number(item.radiusMeters) : SMP_DEFAULT_RADIUS;

                    return {
                        name: item.className || item.name,
                        gateInBarcode: item.gateInCode || item.gateInBarcode || `GATE_IN_${item.className || item.name}`,
                        gateOutBarcode: item.gateOutCode || item.gateOutBarcode || `GATE_OUT_${item.className || item.name}`,
                        radiusMeters: radius,
                        lat: lat,
                        lng: lng
                    };
                });

                const selectEl = document.getElementById('filterClassSelect');
                allClasses.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.name;
                    opt.textContent = `Kelas ${c.name}`;
                    selectEl.appendChild(opt);
                });

                renderSheets(allClasses);
            } catch (err) {
                console.error(err);
                document.getElementById('loadingNotice').innerHTML = '<p class="text-red-500">Gagal memuat data barcode kelas.</p>';
            }
        }

        function filterClassCards() {
            const val = document.getElementById('filterClassSelect').value;
            if (val === 'ALL') {
                renderSheets(allClasses);
            } else {
                const filtered = allClasses.filter(c => c.name === val);
                renderSheets(filtered);
            }
        }

        function renderSheets(classList) {
            const container = document.getElementById('printContainer');
            container.innerHTML = '';

            if (!classList || classList.length === 0) {
                container.innerHTML = '<div class="text-center py-12 text-gray-500"><p>Belum ada data kelas untuk dicetak.</p></div>';
                return;
            }

            classList.forEach((c, index) => {
                const sheet = document.createElement('div');
                sheet.className = 'sheet bg-white rounded-xl shadow-lg border-2 border-slate-900 p-5 mb-8 page-break flex flex-col justify-between';

                const gateInCode = c.gateInBarcode || `GATE_IN_${c.name}`;
                const gateOutCode = c.gateOutBarcode || `GATE_OUT_${c.name}`;
                const radius = c.radiusMeters || 10;
                const coordStr = `${Number(c.lat).toFixed(6)}, ${Number(c.lng).toFixed(6)}`;

                sheet.innerHTML = `
                    <!-- Header Kop Resmi -->
                    <div>
                        <div class="flex items-center justify-between border-b-2 border-double border-slate-800 pb-2 mb-3">
                            <div class="flex items-center gap-3">
                                <img src="/logo-smpn1boyolangu.png" alt="Logo SMPN 1 Boyolangu" class="w-14 h-14 object-contain drop-shadow" onerror="this.src='/images/logo-smpn1boyolangu.png'">
                                <div class="leading-tight">
                                    <h3 class="text-[11px] font-bold text-slate-700 tracking-wider uppercase">PEMERINTAH KABUPATEN TULUNGAGUNG</h3>
                                    <h3 class="text-[11px] font-bold text-slate-700 tracking-wider uppercase">DINAS PENDIDIKAN</h3>
                                    <h2 class="text-lg font-black text-slate-950 tracking-wider uppercase my-0.5">SMP NEGERI 1 BOYOLANGU</h2>
                                    <p class="text-[10px] font-bold text-blue-900 tracking-tight">SISTEM PRESENSI GATE KELAS TERPADU DIGITAL TERINTEGRASI (SMART CBT & SIAKAD)</p>
                                    <p class="text-[9px] text-slate-500 mt-0.5">Jalan Raya Boyolangu, Kec. Boyolangu, Kab. Tulungagung 66271 | Telp. (0355) 324146</p>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <div class="bg-blue-100 text-blue-900 px-2.5 py-1 rounded font-bold text-[10px] border border-blue-300 inline-block shadow-sm">
                                    POS PINTU KELAS
                                </div>
                                <p class="text-[8.5px] text-slate-400 mt-1">Laminating & Tempel di Pintu Depan</p>
                            </div>
                        </div>

                        <!-- Nama Ruang Kelas Banner -->
                        <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white py-2.5 px-4 rounded-xl text-center shadow-md mb-3.5">
                            <span class="text-[10px] uppercase tracking-widest text-blue-200 font-bold block mb-0.5">TITIK PRESENSI RESMI SISWA</span>
                            <h1 class="text-2xl font-black tracking-wide">RUANG KELAS ${c.name}</h1>
                            <div class="mt-1 flex items-center justify-center gap-3 text-[11px] text-blue-200 font-medium">
                                <span>📍 GPS Geofence: <strong class="text-white font-bold">${radius} Meter</strong></span>
                            </div>
                        </div>

                        <!-- 2 Barcode Columns (Gate-In & Gate-Out) -->
                        <div class="grid grid-cols-2 gap-4 mb-3">
                            <!-- Gate-In Card -->
                            <div class="border-2 border-emerald-500 rounded-xl p-3.5 bg-emerald-50/40 flex flex-col items-center text-center">
                                <span class="bg-emerald-600 text-white font-extrabold text-[11px] uppercase px-3 py-0.5 rounded-full shadow-sm mb-1.5">
                                    1. PRESENSI DATANG (GATE-IN)
                                </span>
                                <p class="text-[10px] text-emerald-800 font-semibold mb-2">Scan saat tiba di kelas pagi hari</p>
                                
                                <div class="bg-white p-2.5 rounded-xl border border-emerald-300 shadow-inner mb-2">
                                    <div id="qr-in-${index}" class="flex justify-center"></div>
                                </div>

                                <span class="font-mono text-[11px] font-bold text-emerald-950 bg-emerald-200/70 px-2 py-0.5 rounded border border-emerald-400">
                                    ${gateInCode}
                                </span>
                                <p class="text-[9.5px] text-emerald-700 mt-1.5 font-medium">Batas Tepat Waktu: Sesuai Jam Gate Sekolah</p>
                            </div>

                            <!-- Gate-Out Card -->
                            <div class="border-2 border-blue-500 rounded-xl p-3.5 bg-blue-50/40 flex flex-col items-center text-center">
                                <span class="bg-blue-600 text-white font-extrabold text-[11px] uppercase px-3 py-0.5 rounded-full shadow-sm mb-1.5">
                                    2. PRESENSI PULANG (GATE-OUT)
                                </span>
                                <p class="text-[10px] text-blue-800 font-semibold mb-2">Scan saat jam kepulangan berakhir</p>

                                <div class="bg-white p-2.5 rounded-xl border border-blue-300 shadow-inner mb-2">
                                    <div id="qr-out-${index}" class="flex justify-center"></div>
                                </div>

                                <span class="font-mono text-[11px] font-bold text-blue-950 bg-blue-200/70 px-2 py-0.5 rounded border border-blue-400">
                                    ${gateOutCode}
                                </span>
                                <p class="text-[9.5px] text-blue-700 mt-1.5 font-medium">Terbuka otomatis saat bel pulang berbunyi</p>
                            </div>
                        </div>

                        <!-- Petunjuk Pemindaian Siswa -->
                        <div class="border border-slate-300 bg-slate-50 rounded-lg p-2.5 text-slate-700 text-[10px] leading-relaxed mb-2.5">
                            <h4 class="font-bold text-slate-900 mb-1 flex items-center gap-1.5 text-[10.5px]">
                                <span>ℹ️</span> PETUNJUK PENGGUNAAN UNTUK SISWA:
                            </h4>
                            <ol class="list-decimal list-inside space-y-0.5 text-[9.5px] text-slate-600 font-medium">
                                <li>Buka aplikasi <strong>Smart School CBT</strong> pada ponsel Android Anda dan klik menu <strong>"Scan Gate Barcode"</strong>.</li>
                                <li>Pastikan <strong>GPS/Lokasi Aktif</strong> pada perangkat Anda dan Anda berada di area ruang kelas (dalam radius ${radius} meter).</li>
                                <li>Arahkan kamera ke QR Code di atas. Sistem akan otomatis memverifikasi GPS & anti-fake mock location di background.</li>
                                <li>Notifikasi jam presensi otomatis terkirim langsung ke ponsel orang tua / wali murid Anda.</li>
                                <li><strong>Dilarang keras memalsukan lokasi (Fake GPS / Mock). Sistem akan memblokir presensi otomatis dan mencatat pelanggaran ke Guru BK.</strong></li>
                            </ol>
                        </div>
                    </div>

                    <!-- Footer Kartu -->
                    <div class="border-t border-slate-200 pt-2 flex justify-between items-center text-[9px] text-slate-400">
                        <span>Dokumen Resmi SMPN 1 Boyolangu • Dicetak pada ${new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                        <span class="font-mono">ID: SS-GATE-${c.name}-${Date.now().toString().slice(-4)}</span>
                    </div>
                `;

                container.appendChild(sheet);

                // Generate QR Codes using qrcode.min.js
                setTimeout(() => {
                    const elIn = document.getElementById(`qr-in-${index}`);
                    const elOut = document.getElementById(`qr-out-${index}`);
                    if (elIn && !elIn.hasChildNodes()) {
                        new QRCode(elIn, {
                            text: gateInCode,
                            width: 155,
                            height: 155,
                            colorDark: "#065f46",
                            colorLight: "#ffffff",
                            correctLevel: QRCode.CorrectLevel.H
                        });
                    }

                    if (elOut && !elOut.hasChildNodes()) {
                        new QRCode(elOut, {
                            text: gateOutCode,
                            width: 155,
                            height: 155,
                            colorDark: "#1e40af",
                            colorLight: "#ffffff",
                            correctLevel: QRCode.CorrectLevel.H
                        });
                    }
                }, 50);
            });
        }

        window.onload = init;
    </script>
</body>
</html>
