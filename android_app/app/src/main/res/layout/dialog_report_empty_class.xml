<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8FAFC">

        <!-- Modern Premium Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0F172A"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/circle_white_alpha"
                    android:backgroundTint="#E11D48">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📢"
                        android:textSize="22sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lapor Guru Belum Masuk"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Monitoring Piket Terpadu SMPN 1 Boyolangu"
                        android:textColor="#94A3B8"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pelapor Badge (Pengurus Kelas / Ketua Kelas) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1E293B">

                <TextView
                    android:id="@+id/tvEmptyClassReporterBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp"
                    android:text="👑 Pelapor: Ketua Kelas a.n. Ahmad Fauzi (VII-A)"
                    android:textColor="#38BDF8"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Form Body Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Card: Informasi Jam Pelajaran & Mapel -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Input Jam Ke -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏰"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Jam Ke- / Sesi Pembelajaran *"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etEmptyClassPeriod"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:hint="Contoh: Jam 3-4 (08:30 - 09:50)"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:textColor="#0F172A" />

                    <!-- Input Mapel -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📚"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Mata Pelajaran *"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etEmptyClassSubject"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:hint="Contoh: Matematika"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:textColor="#0F172A" />

                    <!-- Input Guru Pengajar -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👨‍🏫"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Nama Guru Pengajar *"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etEmptyClassTeacher"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:hint="Contoh: Bpk. Drs. Budi Santoso"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:textColor="#0F172A" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Status Kehadiran Guru di Kelas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status Kehadiran Guru di Ruang Kelas *"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgTeacherPresence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbPresenceHadir"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✅ Hadir"
                            android:checked="true"
                            android:textColor="#059669"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/rbPresenceBelumHadir"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="❌ Belum Hadir"
                            android:textColor="#DC2626"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RadioGroup>

                    <!-- Dynamic Container saat Belum Hadir dipilih -->
                    <LinearLayout
                        android:id="@+id/layoutBelumHadirDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:background="#FEF2F2"
                        android:padding="14dp"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alasan Guru Belum Masuk Kelas:"
                            android:textColor="#991B1B"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rgAbsenceReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp">

                            <RadioButton
                                android:id="@+id/rbReasonTanpaKeterangan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Belum Datang / Tanpa Keterangan"
                                android:checked="true"
                                android:textColor="#7F1D1D"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rbReasonSakit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sakit (Izin ke UKS / Dokter)"
                                android:textColor="#7F1D1D"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rbReasonDinasLuar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dinas Luar / Rapat Koordinasi"
                                android:textColor="#7F1D1D"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rbReasonIzin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Izin Keperluan Mendesak"
                                android:textColor="#7F1D1D"
                                android:textSize="12sp" />
                        </RadioGroup>

                        <!-- Opsi Tugas Guru -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="#FECACA" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apakah Guru Memberikan Tugas Mandiri?"
                            android:textColor="#991B1B"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rgTeacherAssignment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbTaskNone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tidak Ada Tugas"
                                android:checked="true"
                                android:textColor="#991B1B"
                                android:textSize="12sp" />

                            <RadioButton
                                android:id="@+id/rbTaskExists"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                android:text="Ada Tugas"
                                android:textColor="#991B1B"
                                android:textSize="12sp" />
                        </RadioGroup>

                        <EditText
                            android:id="@+id/etAssignmentDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            android:background="@android:drawable/editbox_background_normal"
                            android:hint="Tuliskan rincian tugas guru (misal: Kerjakan LKS Hal 45 No 1-10)..."
                            android:minLines="2"
                            android:padding="10dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tombol Kirim & Batal -->
            <Button
                android:id="@+id/btnSubmitEmptyClassReport"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#E11D48"
                android:text="🚀 Kirim Laporan ke Guru Piket"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnCancelEmptyClassReport"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E2E8F0"
                android:text="Batal"
                android:textColor="#475569"
                android:textSize="13sp"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
