<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top App Bar Overlay -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="14dp"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF"
            android:contentDescription="Kembali" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvScannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan QR Pintu Kelas"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScannerSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arahkan kamera ke QR Gate Pintu Kelas"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnFlashToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="#FFFFFF"
            android:contentDescription="Lampu Flash" />
    </LinearLayout>

    <!-- TOP SERVER DIGITAL CLOCK (REAL-TIME WIB & DATE) -->
    <LinearLayout
        android:id="@+id/layoutTopServerClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_scanner_clock_pill"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvServerClockPulse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvServerClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="07:00:00 WIB"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:text="•"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvServerDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Senin, 28 Sep 2026"
            android:textColor="#F1F5F9"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Class Badge Indicator -->
    <TextView
        android:id="@+id/tvClassIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_icon_blue"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="📍 Titik Presensi: Kelas VII-A"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/layoutTopServerClock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Live Real-Time Device GPS Coordinates Badge -->
    <LinearLayout
        android:id="@+id/layoutLiveGpsBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#D90F172A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvClassIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvLiveGpsCoords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Koordinat GPS HP: Mengunci lokasi..."
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Scanner Target Box -->
    <View
        android:id="@+id/overlay"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_scan_frame"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Target Center Hint -->
    <TextView
        android:id="@+id/tvScanHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Posisikan QR Code di dalam kotak"
        android:textColor="#E2E8F0"
        android:textSize="13sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        app:layout_constraintTop_toBottomOf="@id/overlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Controls & Fallback Simulation -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC0F172A"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Kamera Aktif: Pindai QR Code Pintu Kelas"
            android:textAlignment="center"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGpsAccuracySub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📡 Koordinat GPS HP: Memuat sinyal lokasi..."
            android:textAlignment="center"
            android:textColor="#A7F3D0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Koordinat GPS HP yang tampil akan tercatat langsung di Portal Sekolah saat QR dipindai"
            android:textAlignment="center"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
