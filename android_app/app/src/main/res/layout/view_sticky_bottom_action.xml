<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerStickyBottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:elevation="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/layoutStickySecondaryInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStickyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                style="@style/SmartSchool_Text_Caption" />

            <TextView
                android:id="@+id/tvStickyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktif"
                style="@style/SmartSchool_Text_H2"
                android:textColor="@color/emerald_green" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStickyAction"
            style="@style/SmartSchool_Button_Sticky"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="50dp"
            android:text="Aksi Utama"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
