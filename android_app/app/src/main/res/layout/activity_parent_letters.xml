<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0F172A"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBackLetters"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 Surat Resmi &amp; Edaran Sekolah"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLettersSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Portal Resmi Dokumen &amp; Konfirmasi Wali Murid"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRefreshLetters"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Segarkan"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Filter Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:gravity="center"
            android:text="Semua"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabPending"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.2"
            android:background="#F1F5F9"
            android:gravity="center"
            android:text="⚠️ Perlu Konfirmasi"
            android:textColor="#475569"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabConfirmed"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="#F1F5F9"
            android:gravity="center"
            android:text="✅ Disetujui"
            android:textColor="#475569"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Letters List Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerLetters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvEmptyLetters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="40dp"
                android:text="Memuat arsip surat resmi sekolah..."
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>