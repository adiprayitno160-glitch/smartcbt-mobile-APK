<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Light theme with elegant blue nuance & pure white background -->
    <style name="Theme.SmartCBT" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color: Elegant Royal Blue -->
        <item name="colorPrimary">#0D47A1</item>
        <item name="colorPrimaryVariant">#0A2E5C</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand color: Cyan / Light Blue accent -->
        <item name="colorSecondary">#0284C7</item>
        <item name="colorSecondaryVariant">#0369A1</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- Backgrounds: Pure White to prevent dark mode inversion -->
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SmartCBT.NoActionBar" parent="Theme.SmartCBT">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
