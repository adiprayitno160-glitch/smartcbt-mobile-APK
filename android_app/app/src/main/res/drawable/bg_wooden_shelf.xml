<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Wood Plank -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#8B4513"
                android:centerColor="#A0522D"
                android:endColor="#5C2C16" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Top Highlight Edge -->
    <item android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#CD853F" />
            <corners android:topLeftRadius="6dp" android:topRightRadius="6dp" />
        </shape>
    </item>
    <!-- Bottom Shadow -->
    <item android:top="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#3D1C06" />
            <corners android:bottomLeftRadius="6dp" android:bottomRightRadius="6dp" />
        </shape>
    </item>
</layer-list>
